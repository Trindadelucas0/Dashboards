    renderDRE(appMesFiscal || getFiscal().meses[getFiscal().meses.length - 1]);
  }

  function setPatrimDot(id, cls) {
    const el = document.getElementById(id);
    if (el) el.className = 'dot ' + cls;
  }

  function renderIndicadoresPatrimoniais(mesKey) {
    const pat = D().indicadoresPatrimoniais;
    if (!pat || !pat.porMes) return;
    const key = mesKey || pat.mesRef;
    const pack = key ? pat.porMes[key] : null;
    if (!pack) return;
    const c = pack.componentes || {};
    const bal = D().balancete;
    let lbl = key;
    if (bal && bal.meses) {
      const i = bal.meses.indexOf(key);
      if (i >= 0 && bal.mesLabels) lbl = bal.mesLabels[i];
    }
    setMesBarActive('ind-patrim-mes-bar', key);
    setText('#ind-patrim-sub', 'Balancete ' + lbl + (pack.dataRef ? ' | Ref. ' + pack.dataRef : ''));

    if (pack.liquidezCorrente != null) {
      setHTML('#ind-lc-val', pack.liquidezCorrente.toFixed(2).replace('.', ','));
      setHTML('#ind-lc-formula', 'LC = ' + fmt(c.ativoCirculante) + ' / ' + fmt(c.passivoCirculante) + ' = ' + pack.liquidezCorrente.toFixed(2).replace('.', ','));
      setPatrimDot('ind-lc-dot', pack.liquidezCorrente >= 1.5 ? 'gr' : pack.liquidezCorrente >= 1 ? 'ye' : 'rd');
    }
    if (pack.liquidezSeca != null) {
      setHTML('#ind-ls-val', pack.liquidezSeca.toFixed(2).replace('.', ','));
      setHTML('#ind-ls-formula', 'LS = (' + fmt(c.ativoCirculante) + ' - ' + fmt(c.estoque) + ') / ' + fmt(c.passivoCirculante));
      setPatrimDot('ind-ls-dot', pack.liquidezSeca >= 1 ? 'gr' : pack.liquidezSeca >= 0.7 ? 'ye' : 'rd');
    }
    if (pack.capitalGiro != null) {
      setHTML('#ind-cg-val', 'R$ ' + fmt(pack.capitalGiro));
      setHTML('#ind-cg-formula', 'CG = ' + fmt(c.ativoCirculante) + ' - ' + fmt(c.passivoCirculante));
      setPatrimDot('ind-cg-dot', pack.capitalGiro > 0 ? 'gr' : 'rd');
    }
    if (pack.grauEndividamento != null) {
      setHTML('#ind-end-val', pack.grauEndividamento.toFixed(2).replace('.', ',') + '%');
      setHTML('#ind-end-formula', 'END = ' + fmt(c.passivoTotal) + ' / ' + fmt(c.ativoTotal) + ' = ' + pack.grauEndividamento.toFixed(2).replace('.', ',') + '%');
      setPatrimDot('ind-end-dot', pack.grauEndividamento < 60 ? 'gr' : pack.grauEndividamento <= 80 ? 'ye' : 'rd');
    }
  }

function renderIndicadoresFiscal(mesKey) {
    const pack = getFiscalPack(mesKey);
    const lbl = fiscalMesLabel(mesKey);
    const marg = D().margens && D().margens.porMes ? D().margens.porMes[mesKey] : null;
    const margLbl = (() => {
      const m = D().margens;
      if (m && m.meses) {
        const i = m.meses.indexOf(mesKey);
        if (i >= 0 && m.mesLabels) return m.mesLabels[i];
      }
      return lbl;
    })();
    const empresa = D().empresa;

    setText('#ind-header-period', lbl.replace('/', ' / '));
    setText('#ind-margens-period', 'Margens Gerenciais — ' + margLbl);
    setText('#ind-fiscal-period', 'Carga Tributaria Fiscal — ' + lbl);

    if (pack) {
      setHTML('#ind-alert-text', 'Carga tributaria fiscal de <strong id="ind-alert-period">' + lbl + '</strong>. Margens gerenciais abaixo via Demonstrativo de Margens (nao DRE contabil).');
    } else {
      setHTML('#ind-alert-text', 'Margens gerenciais de <strong id="ind-alert-period">' + margLbl + '</strong>. Carga tributaria fiscal indisponivel — livros ENTRADA-SAIDA nao fornecidos para esta competencia.');
    }

    if (marg && marg.totais) {
      const t = marg.totais;
      setHTML('#ind-marg-bruta', t.margemBrutaPct.toFixed(2) + '%');
      setHTML('#ind-marg-liq', t.margemLiquidaPct.toFixed(2) + '%');
      setHTML('#ind-marg-bruta-formula', 'Lucro bruto R$ ' + fmt(t.lucroBruto) + ' / Vendas R$ ' + fmt(t.vendas));
      setHTML('#ind-marg-liq-formula', 'Lucro liq. R$ ' + fmt(t.lucroLiquido) + ' / Vendas R$ ' + fmt(t.vendas));
      setText('#ind-marg-liq-interp', 'Fonte: Demonstrativo Margens de Venda — ' + margLbl + '.');
    } else {
      setHTML('#ind-marg-bruta', '<span class="td-mute">—</span>');
      setHTML('#ind-marg-liq', '<span class="td-mute">—</span>');
      setHTML('#ind-marg-bruta-formula', 'Demonstrativo de Margens indisponivel para ' + margLbl);
      setHTML('#ind-marg-liq-formula', '—');
      setText('#ind-marg-liq-interp', 'Fonte: Demonstrativo Margens de Venda — sem dados para ' + margLbl + '.');
    }

    if (!pack) {
      setHTML('#ind-ded-pct', '<span class="td-mute">—</span>');
      setHTML('#ind-ded-total', '<span class="td-mute">—</span>');
      setHTML('#ind-ded-formula', 'Livro ENTRADA-SAIDA indisponivel para ' + lbl);
      setHTML('#ind-rb-formula', '—');
      setText('#ind-ded-interp', 'Dados fiscais disponiveis apenas para competencias com livros ENTRADA-SAIDA fornecidos.');
      const grid = document.getElementById('ind-tributos-grid');
      if (grid) {
        grid.innerHTML = '<div class="ind-card" style="grid-column:1/-1;opacity:0.7;"><div class="ind-interp" style="border:none;padding:0;">Sem composicao fiscal para ' + lbl + '.</div></div>';
      }
      setMesBarActive('ind-fiscal-mes-bar', mesKey);
      return;
    }

    const rb = pack.receitaBruta;
    const ded = pack.deducoes;
    const dedPct = pack.dedPct;
    setHTML('#ind-ded-pct', dedPct.toFixed(2) + '%');
    setHTML('#ind-ded-total', 'R$ ' + fmt(ded));
    setHTML('#ind-ded-formula', 'Ded% = ' + fmt(ded) + ' / ' + fmt(rb));
    setHTML('#ind-rb-formula', 'RB = R$ ' + fmt(rb) + ' (livro ICMS ' + lbl + ')');
    setText('#ind-ded-interp', 'Competencia ' + lbl + ' — ' + (empresa.nome || 'Empresa') + ' (' + (empresa.uf || 'PR') + ').');
    const grid = document.getElementById('ind-tributos-grid');
    if (grid) {
      grid.innerHTML = '';
      pack.composicao.filter((c) => c.valor > 0).forEach((c) => {
        const p = rb > 0 ? ((c.valor / rb) * 100).toFixed(2) : '0.00';
        const card = document.createElement('div');
        card.className = 'ind-card';
        card.innerHTML = '<div class="ind-head"><div class="ind-name">' + c.label + '</div><span class="dot gr"></span></div><div class="ind-val t-accent">R$ ' + fmt(c.valor) + '</div><div class="ind-formula">' + p + '% s/ Receita Bruta</div><div class="ind-interp">A recolher — livro ENTRADA-SAIDA ' + c.label + ' ' + lbl + '.</div>';
        grid.appendChild(card);
      });
    }
    setMesBarActive('ind-fiscal-mes-bar', mesKey);
  }

  function initIndicadores() {
    const data = D();
    const marg = data.margens;
    const indMeses = marg && marg.meses && marg.meses.length ? marg.meses.slice() : getFiscal().meses.slice();
    const indLabels = marg && marg.mesLabels ? marg.mesLabels.slice() : getFiscal().mesLabels.slice();
    const defaultKey = data.competencia && indMeses.indexOf(data.competencia) >= 0
      ? data.competencia
      : indMeses[indMeses.length - 1];

    buildMesBar('ind-fiscal-mes-bar', {
      meses: indMeses,
      mesLabels: indLabels,
      defaultKey: defaultKey,
      onSelect: (m) => {
        indMesKey = m;
        renderIndicadoresFiscal(m);
      },
    });
    indMesKey = defaultKey;
    renderIndicadoresFiscal(defaultKey);
    const pat = data.indicadoresPatrimoniais;
    const bal = data.balancete;
    if (pat && pat.meses && pat.meses.length) {
      buildMesBar('ind-patrim-mes-bar', {
        meses: pat.meses,
        mesLabels: pat.meses.map((m, i) => (bal && bal.mesLabels && bal.mesLabels[i]) ? bal.mesLabels[i] : m),
        defaultKey: pat.mesRef || pat.meses[pat.meses.length - 1],
        onSelect: (m) => {
          patrimMesKey = m;
          renderIndicadoresPatrimoniais(m);
        },
      });
      patrimMesKey = pat.mesRef || pat.meses[pat.meses.length - 1];
      renderIndicadoresPatrimoniais(patrimMesKey);
    } else {
      const bar = document.getElementById('ind-patrim-mes-bar');
      if (bar) bar.innerHTML = '<span class="td-mute" style="font-size:12px;">Balancete indisponivel</span>';
    }

    const margMeses = data.margens && data.margens.meses ? data.margens.meses : [];
    const margLabels = data.margens && data.margens.mesLabels ? data.margens.mesLabels : margMeses;
    const margBruta = margMeses.map((m) => (data.margens.porMes[m] && data.margens.porMes[m].totais ? data.margens.porMes[m].totais.margemBrutaPct : null));
    const margLiq = margMeses.map((m) => (data.margens.porMes[m] && data.margens.porMes[m].totais ? data.margens.porMes[m].totais.margemLiquidaPct : null));
    const fp = getFiscal();
    const dedSeries = fp.meses.map((m) => (fp.porMes[m] ? fp.porMes[m].dedPct : null));

    safeChart('chartIndicadores', {
      type: 'line',
      data: {
        labels: margLabels.length ? margLabels : data.months,
        datasets: [
          { label: 'Deducoes % s/ RB (fiscal)', data: dedSeries.length ? dedSeries : data.dedPct, borderColor: PAL[4], borderWidth: 2, pointRadius: 4, tension: 0.3 },
          { label: 'Margem bruta % (gerencial)', data: margBruta, borderColor: PAL[0], borderWidth: 2, pointRadius: 4, tension: 0.3 },
          { label: 'Margem liquida % (gerencial)', data: margLiq, borderColor: PAL[1], borderWidth: 2, pointRadius: 4, tension: 0.3 },
        ],
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: leg() }, scales: { y: { ticks: { callback: (v) => v + '%' } } } },
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof DASHBOARD_DATA === 'undefined') {
      console.error('DASHBOARD_DATA nao carregado. Verifique data/schumacher-data.js');
      return;
    }
    applyBranding();
    initPeriodSelector();
    const vgAlert = document.getElementById('vg-fontes-alert');
    if (vgAlert) vgAlert.textContent = DASHBOARD_DATA.empresa.nome;
    showTab('visao-geral');
  });
  window.chartInst = chartInst;
  window.SchumacherDashboard = {
    getActiveFiscalPack: () => getFiscalPack(appMesFiscal),
    getActiveCompetenciaLabel: () => fiscalDisplayLabel(appMesFiscal),
    refreshActiveTab: () => rerenderActiveFiscalTab(),
  };
})();

</script>
<script>
/* Relatorio Gerencial PDF - Industria Schumacher (molde FullBPO/JPG) */
(function () {
  'use strict';

  const MARGEM_LIMITE_ATENCAO = 20;
  const MARGEM_LIMITE_CRITICO = 15;
  const MARGIN = 14;
  const HEADER_H = 14;
  const FOOTER_H = 10;
  const PAGE_W = 210;
  const CONTENT_W = PAGE_W - MARGIN * 2;

  const fmt = (v) => (v == null || isNaN(v) ? '-' : Number(v).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
  const fmtK = (v) => {
    if (v == null || isNaN(v)) return '-';
    const n = Number(v);
    if (Math.abs(n) >= 1e6) return 'R$ ' + (n / 1e6).toFixed(2).replace('.', ',') + ' mi';
    if (Math.abs(n) >= 1e3) return 'R$ ' + (n / 1e3).toFixed(0) + ' mil';
    return 'R$ ' + fmt(n);
  };
  const fmtPct = (v, digits = 1) => (v == null || isNaN(v) ? '-' : Number(v).toFixed(digits).replace('.', ',') + '%');
  const fmtVar = (v) => {
    if (v == null || isNaN(v)) return '-';
    const n = Number(v);
    const sign = n > 0 ? '+' : '';
    return sign + n.toFixed(0) + '%';
  };
  const fmtMoeda = (v) => (v == null || isNaN(v) ? '-' : 'R$ ' + fmt(v));

  function calcVariacao(atual, anterior) {
    const a = Number(atual) || 0;
    const p = Number(anterior) || 0;
    const abs = a - p;
    const pct = p !== 0 ? (abs / Math.abs(p)) * 100 : (a !== 0 ? 100 : 0);
    return { abs, pct };
  }

  function getFiscalPack(D, mesKey) {
    const fp = D.fiscalPorMes;
    if (fp?.porMes?.[mesKey]) return fp.porMes[mesKey];
    if (mesKey === D.competencia) {
      return {
        competencia: D.competencia,
        competenciaLabel: D.competenciaLabel,
        receitaBruta: D.receitaBruta,
        totalCompras: D.totalCompras,
        deducoes: Array.isArray(D.deducoes) ? D.deducoes[0] : D.deducoes,
        dedPct: Array.isArray(D.dedPct) ? D.dedPct[0] : D.dedPct,
        composicao: D.composicao,
        impostosTabela: D.impostosTabela,
        cfopEntradas: D.cfopEntradas,
        sped: D.sped,
      };
    }
    return null;
  }

  function somaImpostosRecolher(fiscal) {
    if (!fiscal?.impostosTabela) return 0;
    return fiscal.impostosTabela.reduce((s, t) => s + (t.recolher || 0), 0);
  }

  function agruparComprasPorFinalidade(cfopEntradas, catalog) {
    const map = {};
    const cat = catalog || (typeof DASHBOARD_DATA !== 'undefined' ? (DASHBOARD_DATA.cfopFinalidade || {}) : {});
    (cfopEntradas || []).forEach((c) => {
      const fromMap = cat[c.cfop];
      const fin = (fromMap && fromMap.finalidade) || c.finalidade || 'Outras';
      if (!map[fin]) map[fin] = 0;
      map[fin] += c.total || 0;
    });
    return Object.entries(map)
      .map(([finalidade, total]) => ({ finalidade, total }))
      .sort((a, b) => b.total - a.total);
  }

  function margemProdutoNivel(mLiq) {
    const m = mLiq != null ? mLiq : 0;
    if (m < 0) return 'negativo';
    if (m < MARGEM_LIMITE_CRITICO) return 'critico';
    if (m < MARGEM_LIMITE_ATENCAO) return 'atencao';
    return 'ok';
  }

  function coletarAlertasProdutos(pack) {
    const produtos = pack?.produtos || [];
    const neg = [];
    const crit = [];
    const warn = [];
    produtos.forEach((p) => {
      const n = margemProdutoNivel(p.margemLiquidaPct);
      if (n === 'negativo') neg.push(p);
      else if (n === 'critico') crit.push(p);
      else if (n === 'atencao') warn.push(p);
    });
    const emAtencao = neg.concat(crit, warn).sort((a, b) => {
      const d = (a.margemLiquidaPct || 0) - (b.margemLiquidaPct || 0);
      return d !== 0 ? d : (b.total || 0) - (a.total || 0);
    });
    return { neg, crit, warn, emAtencao, total: emAtencao.length };
  }

  function gerarNarrativaMes(margAbr, margMai, fiscal) {
    if (!margAbr || !margMai) {
      return 'Dados de margens gerenciais insuficientes para comparativo abr x mai. Consulte as tabelas abaixo.';
    }
    const vVar = calcVariacao(margMai.totais.vendas, margAbr.totais.vendas);
    const lVar = calcVariacao(margMai.totais.lucroLiquido, margAbr.totais.lucroLiquido);
    const mAbr = margAbr.totais.margemLiquidaPct;
    const mMai = margMai.totais.margemLiquidaPct;
    const mDelta = mMai - mAbr;

    const vendasDir = vVar.pct >= 0 ? 'subiu' : 'caiu';
    const lucroDir = lVar.pct >= 0 ? 'melhorou' : 'piorou';
    const margemTxt = mDelta >= 0
      ? 'a margem liquida subiu ' + Math.abs(mDelta).toFixed(1).replace('.', ',') + ' p.p.'
      : 'a margem liquida caiu ' + Math.abs(mDelta).toFixed(1).replace('.', ',') + ' p.p.';

    let txt = 'Maio fechou com vendas de ' + fmtK(margMai.totais.vendas) + ' no demonstrativo de margens, '
      + vendasDir + ' cerca de ' + Math.abs(vVar.pct).toFixed(0) + '% frente a abril ('
      + fmtK(margAbr.totais.vendas) + '). O lucro liquido gerencial ' + lucroDir + ' '
      + Math.abs(lVar.pct).toFixed(0) + '% (' + fmtK(margMai.totais.lucroLiquido) + ' vs '
      + fmtK(margAbr.totais.lucroLiquido) + ') e ' + margemTxt + ' (' + fmtPct(mMai) + ' vs ' + fmtPct(mAbr) + ').';

    if (fiscal) {
      txt += ' Na visao fiscal de maio, a receita bruta foi ' + fmtK(fiscal.receitaBruta)
        + ', com compras de ' + fmtK(fiscal.totalCompras) + ' e carga tributaria de '
        + fmtPct(fiscal.dedPct) + ' sobre a receita (impostos a recolher: '
        + fmtK(somaImpostosRecolher(fiscal)) + ').';
    }

    txt += ' Este relatorio usa margens gerenciais como proxy do resultado; o DRE contabil aguarda arquivo em CONTABIL/DRE/.';
    return txt;
  }

  function gerarLeituraIntegrada(model) {
    const linhas = [];
    const cons = model.consolidado;
    if (cons) {
      linhas.push('Faturamento acumulado Jan-Mai: ' + fmtK(cons.vendas) + ' com margem liquida media de ' + fmtPct(cons.margemLiquidaPct) + '.');
    }
    if (model.fiscal) {
      linhas.push('Competencia fiscal ' + model.competenciaLabel + ': receita bruta ' + fmtK(model.fiscal.receitaBruta) + ', compras ' + fmtK(model.fiscal.totalCompras) + '.');
    }
    if (model.alertas.total > 0) {
      linhas.push('Ha ' + model.alertas.total + ' produto(s) com margem liquida abaixo de 20% em maio - revisar precificacao e custo.');
    } else {
      linhas.push('Nenhum produto com margem liquida abaixo de 20% em maio no demonstrativo de margens.');
    }
    const pat = model.patrimonial;
    if (pat?.ultimo) {
      linhas.push('Liquidez corrente em ' + pat.ultimo.label + ': ' + pat.ultimo.liquidezCorrente.toFixed(2).replace('.', ',') + '; grau de endividamento ' + fmtPct(pat.ultimo.grauEndividamento) + '.');
    }
    return linhas;
  }

  function gerarAcoes(model) {
    const acoes = [];
    if (model.pendentes.dre) acoes.push('Integrar DRE contabil (CONTABIL/DRE/) para substituir proxy de margens por resultado oficial.');
    if (model.pendentes.recebimentos) acoes.push('Enviar extrato bancario ou contas a pagar/receber para habilitar fluxo de caixa (DFC).');
    if (model.alertas.neg.length > 0) acoes.push('Revisar ' + model.alertas.neg.length + ' produto(s) com margem negativa em maio.');
    if (model.alertas.crit.length > 0) acoes.push('Acompanhar ' + model.alertas.crit.length + ' produto(s) com margem liquida abaixo de 15%.');
    if (model.fiscal) acoes.push('Monitorar carga tributaria de ' + fmtPct(model.fiscal.dedPct) + ' e creditos de ICMS disponiveis.');
    acoes.push('Validar balancete de maio/2026 quando disponivel para atualizar indicadores patrimoniais.');
    return acoes;
  }

  function buildRelatorioModel(D) {
    const marg = D.margens || {};
    const meses = marg.meses || [];
    const mesMai = '2026-05';
    const mesAbr = '2026-04';
    const margMai = marg.porMes?.[mesMai];
    const margAbr = marg.porMes?.[mesAbr];
    const fiscal = getFiscalPack(D, D.competencia || mesMai);
    const consolidado = marg.consolidado?.totais || null;

    const evolucaoMargens = meses.map((k, i) => {
      const t = marg.porMes[k]?.totais || {};
      return {
        key: k,
        label: marg.mesLabels?.[i] || k,
        vendas: t.vendas || 0,
        custo: t.custo || 0,
        lucroBruto: t.lucroBruto || 0,
        lucroLiquido: t.lucroLiquido || 0,
        margemBrutaPct: t.margemBrutaPct || 0,
        margemLiquidaPct: t.margemLiquidaPct || 0,
      };
    });

    const nMeses = evolucaoMargens.length || 1;
    const mediaMensal = consolidado ? {
      vendas: consolidado.vendas / nMeses,
      lucroLiquido: consolidado.lucroLiquido / nMeses,
      margemLiquidaPct: consolidado.margemLiquidaPct,
      margemBrutaPct: consolidado.margemBrutaPct,
    } : null;

    const comprasFinalidade = agruparComprasPorFinalidade(
      fiscal?.cfopEntradas || D.cfopEntradas,
      D.cfopFinalidade || {}
    );
    const alertas = coletarAlertasProdutos(margMai || {});

    const pat = D.indicadoresPatrimoniais;
    const patrimonial = { meses: [], ultimo: null };
    if (pat?.meses) {
      pat.meses.forEach((k, i) => {
        const p = pat.porMes[k];
        if (!p) return;
        const row = {
          key: k,
          label: pat.mesLabels?.[i] || k,
          liquidezCorrente: p.liquidezCorrente,
          liquidezSeca: p.liquidezSeca,
          capitalGiro: p.capitalGiro,
          grauEndividamento: p.grauEndividamento,
        };
        patrimonial.meses.push(row);
        patrimonial.ultimo = row;
      });
    }

    const impostosAcum = somaImpostosRecolher(fiscal);
    const composicaoFaturamento = consolidado ? [
      { item: 'Custo dos produtos/servicos', valor: -consolidado.custo, pct: (consolidado.custo / consolidado.vendas) * 100 },
      { item: 'Lucro liquido gerencial', valor: consolidado.lucroLiquido, pct: (consolidado.lucroLiquido / consolidado.vendas) * 100 },
      { item: 'Impostos a recolher (comp. fiscal)', valor: -impostosAcum, pct: fiscal ? (impostosAcum / consolidado.vendas) * 100 : 0 },
    ] : [];

    const comparativoMargens = margAbr && margMai ? [
      { linha: '(+) Vendas', abr: margAbr.totais.vendas, mai: margMai.totais.vendas },
      { linha: '(-) Custo', abr: -margAbr.totais.custo, mai: -margMai.totais.custo },
      { linha: '(=) Lucro Bruto', abr: margAbr.totais.lucroBruto, mai: margMai.totais.lucroBruto },
      { linha: '(=) Lucro Liquido', abr: margAbr.totais.lucroLiquido, mai: margMai.totais.lucroLiquido },
      { linha: '% Margem Liquida', abr: margAbr.totais.margemLiquidaPct, mai: margMai.totais.margemLiquidaPct, isPct: true },
    ] : [];

    return {
      empresa: D.empresa,
      competencia: D.competencia || mesMai,
      competenciaLabel: D.competenciaLabel || 'Mai / 2026',
      narrativa: gerarNarrativaMes(margAbr, margMai, fiscal),
      comparativoMargens,
      fiscal,
      comprasFinalidade,
      evolucaoMargens,
      consolidado,
      mediaMensal,
      composicaoFaturamento,
      patrimonial,
      alertas,
      leitura: [],
      acoes: [],
      pendentes: D.pendentes || {},
      temDre: !!(D.dre?.meses?.length),
    };
  }

  /* ---- PDF rendering helpers ---- */

  function createPdfContext(D) {
    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
    const model = buildRelatorioModel(D);
    model.leitura = gerarLeituraIntegrada(model);
    model.acoes = gerarAcoes(model);

    const pageH = pdf.internal.pageSize.getHeight();
    let y = MARGIN + HEADER_H;
    let pageNum = 1;
    const empresaNome = (model.empresa?.nome || 'SCHUMACHER').split(' ')[0];

    function addHeader() {
      pdf.setFont('helvetica', 'normal');
      pdf.setFontSize(8);
      pdf.setTextColor(100, 116, 139);
      pdf.text(empresaNome + ' - pag. ' + pageNum, MARGIN, MARGIN + 4);
      pdf.setDrawColor(226, 232, 240);
      pdf.line(MARGIN, MARGIN + 7, PAGE_W - MARGIN, MARGIN + 7);
    }

    function addFooter() {
      const foot = (model.empresa?.nome || 'INDUSTRIA SCHUMACHER LTDA')
        + ' - Relatorio gerencial - margens gerenciais e fiscal - ' + model.competenciaLabel;
      pdf.setFontSize(7);
      pdf.setTextColor(148, 163, 184);
      pdf.text(foot, MARGIN, pageH - 5, { maxWidth: CONTENT_W });
    }

    function newPage() {
      addFooter();
      pdf.addPage();
      pageNum++;
      addHeader();
      y = MARGIN + HEADER_H + 4;
    }

    function ensureSpace(need) {
      if (y + need > pageH - FOOTER_H - MARGIN) newPage();
    }

    function writeTitle(text, size = 14) {
      ensureSpace(12);
      pdf.setFont('helvetica', 'bold');
      pdf.setFontSize(size);
      pdf.setTextColor(30, 41, 59);
      pdf.text(text, MARGIN, y);
      y += size * 0.45 + 4;
    }

    function writeSubtitle(text) {
      ensureSpace(8);
      pdf.setFont('helvetica', 'normal');
      pdf.setFontSize(10);
      pdf.setTextColor(71, 85, 105);
      pdf.text(text, MARGIN, y);
      y += 6;
    }

    function writeParagraph(text, size = 9) {
      pdf.setFont('helvetica', 'normal');
      pdf.setFontSize(size);
      pdf.setTextColor(51, 65, 85);
      const lines = pdf.splitTextToSize(text, CONTENT_W);
      ensureSpace(lines.length * 4 + 4);
      pdf.text(lines, MARGIN, y);
      y += lines.length * 4 + 4;
    }

    function writeSectionLabel(text) {
      ensureSpace(10);
      pdf.setFont('helvetica', 'bold');
      pdf.setFontSize(10);
      pdf.setTextColor(30, 41, 59);
      pdf.text(text, MARGIN, y);
      y += 6;
    }

    function writePending(text) {
      ensureSpace(16);
      pdf.setFillColor(254, 243, 199);
      pdf.setDrawColor(251, 191, 36);
      const lines = pdf.splitTextToSize(text, CONTENT_W - 8);
      const boxH = lines.length * 4 + 8;
      pdf.rect(MARGIN, y - 3, CONTENT_W, boxH, 'FD');
      pdf.setFont('helvetica', 'italic');
      pdf.setFontSize(8);
      pdf.setTextColor(146, 64, 14);
      pdf.text(lines, MARGIN + 4, y + 2);
      y += boxH + 4;
    }

    function writeBullets(items) {
      pdf.setFont('helvetica', 'normal');
      pdf.setFontSize(9);
      pdf.setTextColor(51, 65, 85);
      items.forEach((item) => {
        const lines = pdf.splitTextToSize('- ' + item, CONTENT_W - 4);
        ensureSpace(lines.length * 4 + 2);
        pdf.text(lines, MARGIN + 2, y);
        y += lines.length * 4 + 2;
      });
      y += 2;
    }

    function addTable(head, body, opts = {}) {
      ensureSpace(20);
      pdf.autoTable({
        startY: y,
        margin: { top: y, left: MARGIN, right: MARGIN, bottom: FOOTER_H + MARGIN },
        head: [head],
        body,
        theme: 'grid',
        styles: { fontSize: 8, cellPadding: 2, textColor: [51, 65, 85] },
        headStyles: { fillColor: [241, 245, 249], textColor: [71, 85, 105], fontStyle: 'bold' },
        columnStyles: opts.columnStyles || {},
        ...opts,
      });
      y = pdf.lastAutoTable.finalY + 6;
    }

    addHeader();

    return { pdf, model, y, setY: (v) => { y = v; }, getY: () => y, newPage, ensureSpace, writeTitle, writeSubtitle, writeParagraph, writeSectionLabel, writePending, writeBullets, addTable, addFooter, pageNum };
  }

  function renderPage1(ctx) {
    const { model, writeTitle, writeSubtitle, writeParagraph, writeSectionLabel, addTable } = ctx;
  let y = ctx.getY();

    writeTitle('Relatorio Gerencial Mensal');
    writeSubtitle(model.empresa?.nome + ' - Resultado - ' + model.competenciaLabel.replace(' / ', '/').toLowerCase());

    writeSectionLabel('O mes em uma frase');
    writeParagraph(model.narrativa);

    writeSectionLabel('Resultado do mes - Margens Gerenciais (abr x mai/2026)');
    writeParagraph('Fonte: Demonstrativo de Margens de Venda. Nao substitui o DRE contabil (competencia).');

    if (model.comparativoMargens.length) {
      const body = model.comparativoMargens.map((r) => {
        const isPct = r.isPct;
        const v = calcVariacao(r.mai, r.abr);
        return [
          r.linha,
          isPct ? fmtPct(r.abr) : fmtMoeda(r.abr),
          isPct ? fmtPct(r.mai) : fmtMoeda(r.mai),
          isPct ? fmtVar(v.pct) : fmtVar(v.pct),
        ];
      });
      addTable(['Linha', 'Abr/26', 'Mai/26', 'Var.'], body, {
        columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' }, 3: { halign: 'right' } },
      });
    }

    ctx.setY(y);
  }

  function renderPage2(ctx) {
    ctx.newPage();
    const { model, writeTitle, writeParagraph, writeSectionLabel, addTable, writePending } = ctx;

    writeTitle('Visao Fiscal e Compras - ' + model.competenciaLabel);

    if (model.fiscal) {
      const f = model.fiscal;
      const imp = somaImpostosRecolher(f);
      addTable(['Indicador', 'Valor'], [
        ['(+) Receita Bruta', fmtMoeda(f.receitaBruta)],
        ['(-) Deducoes / Impostos s/ vendas', fmtMoeda(-(f.deducoes || 0))],
        ['% Carga tributaria', fmtPct(f.dedPct)],
        ['(-) Compras do mes', fmtMoeda(-(f.totalCompras || 0))],
        ['(=) Impostos a recolher (total)', fmtMoeda(imp)],
      ], { columnStyles: { 1: { halign: 'right' } } });

      if (model.comprasFinalidade.length) {
        writeSectionLabel('Compras por finalidade (CFOP)');
        const top = model.comprasFinalidade.slice(0, 10);
        const total = top.reduce((s, c) => s + c.total, 0);
        addTable(['Finalidade', 'Valor', '%'], top.map((c) => [
          c.finalidade,
          fmtMoeda(c.total),
          fmtPct((c.total / (f.totalCompras || total)) * 100),
        ]), { columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' } } });
      }
    }

    writePending('Pendente: DRE contabil (CMV e Compras) - aguardando arquivos em CONTABIL/DRE/<mm-yyyy>/.');
    writePending('Pendente: Despesas operacionais por categoria (linha 36) - requer DRE ou razao contabil detalhado.');
  }

  function renderPage3(ctx) {
    ctx.newPage();
    const { model, writeTitle, writeParagraph, writeSectionLabel, addTable, writePending } = ctx;

    writeTitle('Evolucao Mensal - Margens Gerenciais 2026');
    writeParagraph('Demonstrativo de margens mes a mes (jan-mai). Visao de resultado gerencial por produto/cidade; nao - fluxo de caixa.');

    if (model.evolucaoMargens.length) {
      const body = model.evolucaoMargens.map((m) => [
        m.label,
        fmtMoeda(m.vendas),
        fmtMoeda(m.lucroLiquido),
        fmtPct(m.margemLiquidaPct),
      ]);
      if (model.consolidado) {
        body.push([
          'Acum.',
          fmtMoeda(model.consolidado.vendas),
          fmtMoeda(model.consolidado.lucroLiquido),
          fmtPct(model.consolidado.margemLiquidaPct),
        ]);
      }
      addTable(['Mes', 'Vendas', 'Lucro Liq.', 'Margem %'], body, {
        columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' }, 3: { halign: 'right' } },
      });
    }

    writePending('Pendente: Fluxo de Caixa (DFC) - aguardando extrato bancario ou relatorio de contas a pagar/receber.');
  }

  function renderPage4(ctx) {
    ctx.newPage();
    const { model, writeTitle, writeSectionLabel, writeParagraph, writeBullets } = ctx;

    writeTitle('A leitura integrada - resultado e fiscal');
    model.leitura.forEach((p) => writeParagraph(p));

    writeSectionLabel('Para onde olhar no proximo mes');
    writeBullets(model.acoes);
  }

  function renderPage5(ctx) {
    ctx.newPage();
    const { model, writeTitle, writeSubtitle, writeSectionLabel, addTable } = ctx;

    writeTitle('Resumo Executivo Acumulado');
    writeSubtitle('Jan-Mai/2026 - Demonstrativo de Margens');

    if (model.consolidado) {
      const c = model.consolidado;
      addTable(['Indicador', 'Valor', '%'], [
        ['Faturamento (vendas)', fmtMoeda(c.vendas), '100%'],
        ['Lucro Bruto', fmtMoeda(c.lucroBruto), fmtPct((c.lucroBruto / c.vendas) * 100)],
        ['Lucro Liquido', fmtMoeda(c.lucroLiquido), fmtPct(c.margemLiquidaPct)],
        ['Margem Bruta', fmtPct(c.margemBrutaPct), '-'],
        ['Margem Liquida', fmtPct(c.margemLiquidaPct), '-'],
      ], { columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' } } });
    }

    if (model.alertas.total > 0) {
      writeSectionLabel('Alertas de margem - maio/2026');
      const top = model.alertas.emAtencao.slice(0, 8);
      addTable(['Produto', 'Vendas', 'Margem Liq. %'], top.map((p) => [
        (p.nome || p.descricao || '-').substring(0, 45),
        fmtMoeda(p.total),
        fmtPct(p.margemLiquidaPct),
      ]), { columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' } } });
    }
  }

  function renderPage6(ctx) {
    ctx.newPage();
    const { model, writeTitle, writeParagraph, writeSectionLabel, addTable } = ctx;

    writeTitle('Media mensal e evolucao 2026');

    if (model.mediaMensal && model.consolidado) {
      writeParagraph('Media mensal Jan-Mai/2026 com base no demonstrativo de margens (5 meses).');
      addTable(['Indicador', 'Media mensal 2026'], [
        ['Vendas', fmtMoeda(model.mediaMensal.vendas)],
        ['Lucro Liquido', fmtMoeda(model.mediaMensal.lucroLiquido)],
        ['Margem Liquida', fmtPct(model.mediaMensal.margemLiquidaPct)],
        ['Margem Bruta', fmtPct(model.mediaMensal.margemBrutaPct)],
      ], { columnStyles: { 1: { halign: 'right' } } });
    }

    writeSectionLabel('Evolucao mensal detalhada');
    if (model.evolucaoMargens.length) {
      const body = model.evolucaoMargens.map((m) => [
        m.label,
        fmtMoeda(m.vendas),
        fmtMoeda(m.custo),
        fmtMoeda(m.lucroBruto),
        fmtMoeda(m.lucroLiquido),
        fmtPct(m.margemBrutaPct),
        fmtPct(m.margemLiquidaPct),
      ]);
      if (model.consolidado) {
        const c = model.consolidado;
        body.push(['Acum.', fmtMoeda(c.vendas), fmtMoeda(c.custo), fmtMoeda(c.lucroBruto), fmtMoeda(c.lucroLiquido), fmtPct(c.margemBrutaPct), fmtPct(c.margemLiquidaPct)]);
      }
      addTable(['Mes', 'Vendas', 'Custo', 'Lucro Bruto', 'Lucro Liq.', 'Marg.Br.%', 'Marg.Liq.%'], body, {
        columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' }, 3: { halign: 'right' }, 4: { halign: 'right' }, 5: { halign: 'right' }, 6: { halign: 'right' } },
        styles: { fontSize: 7 },
      });
    }
  }

  function renderPage7(ctx) {
    ctx.newPage();
    const { model, writeTitle, writeParagraph, writeSectionLabel, addTable } = ctx;

    writeTitle('Onde vai cada real do faturamento');
    writeParagraph('Composicao acumulada Jan-Mai/2026 (margens gerenciais + impostos da competencia fiscal).');

    if (model.composicaoFaturamento.length && model.consolidado) {
      addTable(['Item', 'R$ acumulado', '% do faturamento'], model.composicaoFaturamento.map((r) => [
        r.item,
        fmtMoeda(r.valor),
        fmtPct(Math.abs(r.pct)),
      ]), { columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' } } });

      const resto = model.consolidado.vendas + model.composicaoFaturamento.reduce((s, r) => s + r.valor, 0);
      writeParagraph('De cada R$ 1,00 faturado no periodo, ' + fmtPct((model.consolidado.custo / model.consolidado.vendas) * 100)
        + ' saem em custo e ' + fmtPct(model.consolidado.margemLiquidaPct) + ' permanecem como lucro liquido gerencial (antes de despesas operacionais e resultado financeiro do DRE).');
    }
  }

  function renderPage8(ctx) {
    ctx.newPage();
    const { model, writeTitle, writeParagraph, writeSectionLabel, addTable, writePending } = ctx;

    writeTitle('Indicadores patrimoniais');
    writeParagraph('Balancete contabil Jan-Abr/2026. Balancete de maio/2026 ainda nao disponivel.');

    if (model.patrimonial.meses.length) {
      addTable(['Mes', 'Liq. Corrente', 'Liq. Seca', 'Cap. Giro', 'Endiv. %'], model.patrimonial.meses.map((p) => [
        p.label,
        p.liquidezCorrente.toFixed(2).replace('.', ','),
        p.liquidezSeca.toFixed(2).replace('.', ','),
        fmtMoeda(p.capitalGiro),
        fmtPct(p.grauEndividamento),
      ]), { columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' }, 3: { halign: 'right' }, 4: { halign: 'right' } } });
    }

    writePending('Pendente: Ponto de equilibrio economico - requer DRE contabil com despesas operacionais e distribuicao de lucros.');
  }

  function renderPage9(ctx) {
    ctx.newPage();
    const { model, writeTitle, writeSectionLabel, writeBullets, writeParagraph } = ctx;

    writeTitle('Pendencias e proximos passos');

    const pendList = [];
    if (model.pendentes.dre) pendList.push('DRE contabil (CONTABIL/DRE/)');
    if (model.pendentes.recebimentos) pendList.push('Extrato / contas a pagar e receber (DFC)');
    if (model.pendentes.balancete) pendList.push('Balancete maio/2026');
    if (model.pendentes.fornecedores) pendList.push('Ranking de fornecedores (SPED entradas C100)');
    if (model.pendentes.pessoal) pendList.push('Folha analitica 2026');
    if (pendList.length) {
      writeSectionLabel('Fontes pendentes de integracao');
      writeBullets(pendList);
    }

    writeSectionLabel('Acoes recomendadas');
    writeBullets(model.acoes);

    writeParagraph('Relatorio gerencial - ' + (model.empresa?.nome || 'INDUSTRIA SCHUMACHER LTDA')
      + ' - resultado via demonstrativo de margens; fiscal em regime de competencia - '
      + model.competenciaLabel + '.');
  }

  async function exportRelatorioGerencial() {
    if (typeof DASHBOARD_DATA === 'undefined') {
      alert('Dados do dashboard nao carregados.');
      return;
    }
    if (!window.jspdf?.jsPDF) {
      alert('Biblioteca jsPDF nao carregada.');
      return;
    }
    const { jsPDF } = window.jspdf;
    const probe = new jsPDF();
    if (typeof probe.autoTable !== 'function') {
      alert('Biblioteca jspdf-autotable nao carregada.');
      return;
    }

    const btn = typeof event !== 'undefined' ? event?.currentTarget : null;
    const origHtml = btn?.innerHTML;
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Gerando...';
    }

    try {
      const ctx = createPdfContext(DASHBOARD_DATA);
      renderPage1(ctx);
      renderPage2(ctx);
      renderPage3(ctx);
      renderPage4(ctx);
      renderPage5(ctx);
      renderPage6(ctx);
      renderPage7(ctx);
      renderPage8(ctx);
      renderPage9(ctx);
      ctx.addFooter();

      const comp = (DASHBOARD_DATA.competencia || '2026-05').replace('-', '_');
      const fname = 'Relatorio_Gerencial_SCHUMACHER_' + comp + '.pdf';
      ctx.pdf.save(fname);
    } catch (err) {
      console.error(err);
      alert('Erro ao gerar Relatorio Gerencial. Tente novamente.');
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = origHtml;
      }
    }
  }

  window.exportRelatorioGerencial = exportRelatorioGerencial;
  window.buildRelatorioModel = buildRelatorioModel;
})();

</script>
<script>

  const chartInst = window.chartInst || {};
  let sbCollapsed = false;
  function toggleSidebar() {
    const sb = document.getElementById('sidebar');
    const mw = document.getElementById('mainWrapper');
    if (window.innerWidth <= 768) {
      sb.classList.toggle('mob-open');
      document.getElementById('overlay').classList.toggle('hidden');
    } else {
      sbCollapsed = !sbCollapsed;
      sb.classList.toggle('collapsed', sbCollapsed);
      mw.classList.toggle('sb-collapsed', sbCollapsed);
    }
  }
  function closeMob() {
    document.getElementById('sidebar').classList.remove('mob-open');
    document.getElementById('overlay').classList.add('hidden');
  }
/* -----------------------------------------------
     EXPORTAÇÃO PDF / EXCEL / IMPRESSÃO FORNECEDOR / RELATÓRIO GERENCIAL (relatorio-gerencial.js)
     ----------------------------------------------- */
