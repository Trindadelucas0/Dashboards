  let vdMargMesKey = null;

  function getMargensPack(mesKey) {
    const marg = D().margens;
    if (!marg) return null;
    if (mesKey === 'total' && marg.consolidado) return marg.consolidado;
    return marg.porMes && marg.porMes[mesKey] ? marg.porMes[mesKey] : null;
  }

  function margPeriodLabel(mesKey) {
    const marg = D().margens;
    if (!marg) return mesKey;
    if (mesKey === 'total') return 'Jan a Mai/2026 (consolidado)';
    const i = marg.meses.indexOf(mesKey);
    return i >= 0 && marg.mesLabels ? marg.mesLabels[i] : mesKey;
  }

  const MARGEM_LIMITE_ATENCAO = 20;
  const MARGEM_LIMITE_CRITICO = 15;

  function margemProdutoNivel(mLiq) {
    const m = mLiq != null ? mLiq : 0;
    if (m < 0) return 'negativo';
    if (m < MARGEM_LIMITE_CRITICO) return 'critico';
    if (m < MARGEM_LIMITE_ATENCAO) return 'atencao';
    return 'ok';
  }

  function margemProdutoStatusChip(nivel) {
    if (nivel === 'negativo') return '<span class="chip rd"><i class="fas fa-circle" style="font-size:6px"></i> Negativa</span>';
    if (nivel === 'critico') return '<span class="chip rd"><i class="fas fa-circle" style="font-size:6px"></i> &lt; 15%</span>';
    if (nivel === 'atencao') return '<span class="chip ye"><i class="fas fa-circle" style="font-size:6px"></i> 15\u201320%</span>';
    return '<span class="chip gr">OK</span>';
  }

  function margemPctClass(mLiq) {
    const n = margemProdutoNivel(mLiq);
    if (n === 'negativo' || n === 'critico') return 'marg-pct-crit';
    if (n === 'atencao') return 'marg-pct-warn';
    return '';
  }

  function renderMargensAlertaProdutos(pack, totVendas, lbl) {
    const produtos = pack.produtos || [];
    const neg = [];
    const crit = [];
    const warn = [];
    produtos.forEach((p) => {
      const m = p.margemLiquidaPct != null ? p.margemLiquidaPct : 0;
      const n = margemProdutoNivel(m);
      if (n === 'negativo') neg.push(p);
      else if (n === 'critico') crit.push(p);
      else if (n === 'atencao') warn.push(p);
    });
    const emAtencao = neg.concat(crit, warn).sort((a, b) => {
      const d = (a.margemLiquidaPct || 0) - (b.margemLiquidaPct || 0);
      return d !== 0 ? d : (b.total || 0) - (a.total || 0);
    });
    const sumVendas = (arr) => arr.reduce((a, p) => a + (p.total || 0), 0);
    const fmtSub = (arr) => arr.length ? fmtK(sumVendas(arr)) + ' em vendas' : 'Nenhum produto';

    setText('#vd-alerta-neg-qtd', neg.length);
    setText('#vd-alerta-neg-sub', fmtSub(neg));
    setText('#vd-alerta-crit-qtd', crit.length);
    setText('#vd-alerta-crit-sub', fmtSub(crit));
    setText('#vd-alerta-warn-qtd', warn.length);
    setText('#vd-alerta-warn-sub', fmtSub(warn));
    setText('#vd-alerta-tot-qtd', emAtencao.length);
    const totVendasAtencao = sumVendas(emAtencao);
    setText('#vd-alerta-tot-sub', emAtencao.length
      ? fmtK(totVendasAtencao) + ' (' + pct(totVendasAtencao, totVendas) + '% das vendas)'
      : 'Nenhum produto abaixo de 20%');
    setText('#vd-marg-alerta-sub', emAtencao.length + ' produto(s) com margem liq. < 20% \u2014 ' + lbl);

    const banner = document.getElementById('vd-marg-alerta-banner');
    if (banner) {
      if (!emAtencao.length) {
        banner.style.borderColor = 'rgba(34,163,41,0.35)';
        banner.style.background = 'rgba(34,163,41,0.06)';
        banner.innerHTML = '<i class="fas fa-check-circle t-accent" style="margin-right:8px;"></i><strong>Sem alertas:</strong> nenhum produto com margem l\u00edquida abaixo de 20% no per\u00edodo selecionado (' + lbl + ').';
      } else {
        banner.style.borderColor = 'rgba(239,68,68,0.35)';
        banner.style.background = 'rgba(239,68,68,0.06)';
        banner.innerHTML =
          '<i class="fas fa-exclamation-triangle t-danger" style="margin-right:8px;"></i>' +
          '<strong>Aten\u00e7\u00e3o \u2014 margem l\u00edquida baixa (' + lbl + '):</strong> ' +
          emAtencao.length + ' produto(s) abaixo de 20% \u2014 ' +
          neg.length + ' negativa(s), ' + crit.length + ' cr\u00edtico(s) (&lt;15%), ' + warn.length + ' em faixa 15\u201320%.';
      }
    }

    const aTbody = document.getElementById('vd-marg-alerta-tbody');
    if (!aTbody) return;
    aTbody.innerHTML = '';
    if (!emAtencao.length) {
      aTbody.innerHTML = '<tr><td colspan="10" class="td-mute" style="text-align:center;padding:24px;">Nenhum produto com margem l\u00edquida abaixo de 20%</td></tr>';
      return;
    }
    emAtencao.forEach((p) => {
      const mLiq = p.margemLiquidaPct || 0;
      const mBruta = p.margemBrutaPct || 0;
      const nivel = margemProdutoNivel(mLiq);
      const tr = document.createElement('tr');
