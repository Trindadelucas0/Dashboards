  function applyPdfLiveTheme(el) {
    el.style.setProperty('--text', '#1e293b');
    el.style.setProperty('--text-sec', '#475569');
    el.style.setProperty('--text-muted', '#64748b');
    el.style.setProperty('--bg-card', '#ffffff');
    el.style.setProperty('--border', 'rgba(0,0,0,0.12)');
    el.style.opacity = '1';
    el.style.animation = 'none';
  }

  function clearPdfLiveTheme(el) {
    ['--text', '--text-sec', '--text-muted', '--bg-card', '--border', 'opacity', 'animation'].forEach((p) => el.style.removeProperty(p));
  }

  function applyPdfCloneTheme(doc, el) {
    el.classList.add('pdf-export-target');
    applyPdfLiveTheme(el);
    const bar = el.querySelector('.export-bar');
    if (bar) bar.style.display = 'none';
    const style = doc.createElement('style');
    style.textContent = PDF_CLONE_CSS;
    el.insertBefore(style, el.firstChild);
  }

  function solidifyRgba(color) {
    if (typeof color !== 'string' || !color.startsWith('rgba')) return color;
    return color.replace(/,\s*[\d.]+\)\s*$/, ', 1)');
  }

  function prepareChartsForPdf(section) {
    const saved = [];
    Object.entries(chartInst).forEach(([id, chart]) => {
      if (!chart?.canvas || !section.contains(chart.canvas)) return;
      const snap = { id, ticks: [], grids: [], legend: null, datasets: [] };
      if (chart.options.scales) {
        Object.keys(chart.options.scales).forEach((key) => {
          const s = chart.options.scales[key];
          if (!s) return;
          if (s.ticks) { snap.ticks.push({ key, color: s.ticks.color }); s.ticks.color = '#475569'; }
          if (s.grid) { snap.grids.push({ key, color: s.grid.color }); s.grid.color = 'rgba(0,0,0,0.1)'; }
        });
      }
      if (chart.options.plugins?.legend?.labels) {
        snap.legend = chart.options.plugins.legend.labels.color;
        chart.options.plugins.legend.labels.color = '#475569';
      }
      chart.data.datasets.forEach((d) => {
        snap.datasets.push({ backgroundColor: d.backgroundColor, borderColor: d.borderColor, fill: d.fill });
        if (d.fill && typeof d.backgroundColor === 'string' && d.backgroundColor.startsWith('rgba')) {
          d.backgroundColor = d.backgroundColor.replace(/,\s*[\d.]+\)/, ', 0.18)');
        } else {
          d.backgroundColor = solidifyRgba(d.backgroundColor);
        }
        if (d.borderColor) d.borderColor = solidifyRgba(d.borderColor) || d.borderColor;
      });
      chart.update('none');
      saved.push(snap);
    });
    return saved;
  }

  function restoreChartsFromPdf(saved) {
    saved.forEach((snap) => {
      const chart = chartInst[snap.id];
      if (!chart) return;
      snap.ticks.forEach(({ key, color }) => { if (chart.options.scales?.[key]?.ticks) chart.options.scales[key].ticks.color = color; });
      snap.grids.forEach(({ key, color }) => { if (chart.options.scales?.[key]?.grid) chart.options.scales[key].grid.color = color; });
      if (snap.legend != null && chart.options.plugins?.legend?.labels) chart.options.plugins.legend.labels.color = snap.legend;
      snap.datasets.forEach((orig, i) => {
        const d = chart.data.datasets[i];
        if (!d) return;
        d.backgroundColor = orig.backgroundColor;
        d.borderColor = orig.borderColor;
        d.fill = orig.fill;
      });
      chart.update('none');
    });
  }

  async function exportPDF(sectionId, filename) {
    const section = document.getElementById(sectionId);
    if (!section) return;
    if (typeof html2canvas === 'undefined') {
      alert('Biblioteca html2canvas nao carregada.');
      return;
    }
    const btn = event?.currentTarget;
    const origHtml = btn?.innerHTML;
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Gerando...'; }

    window.SchumacherDashboard?.refreshActiveTab?.();
    await new Promise((r) => setTimeout(r, 150));

    const wasHidden = !section.classList.contains('active');
    if (wasHidden) section.classList.add('export-capture');
    section.classList.add('pdf-export-target');
    document.body.classList.add('pdf-capturing');
    section.scrollTop = 0;
    applyPdfLiveTheme(section);
    const chartSnap = prepareChartsForPdf(section);

    try {
      await new Promise((r) => setTimeout(r, 500));
      const canvas = await html2canvas(section, {
        scale: 2,
        useCORS: true,
        backgroundColor: '#f8fafc',
        logging: false,
        onclone: (doc, el) => applyPdfCloneTheme(doc, el),
      });
      const imgData = canvas.toDataURL('image/png');
      const { jsPDF } = window.jspdf;
      const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const pageW = pdf.internal.pageSize.getWidth();
      const pageH = pdf.internal.pageSize.getHeight();
      const margin = 10;
      const headerH = 12;
      const contentW = pageW - margin * 2;
      const pdfHeight = (canvas.height * contentW) / canvas.width;
      let heightLeft = pdfHeight;
      let position = margin + headerH;

      const addHeader = () => {
        pdf.setFontSize(10);
        pdf.setTextColor(26, 26, 46);
        pdf.text(getCompanyName() + ' — ' + new Date().toLocaleDateString('pt-BR'), margin, margin + 4);
        pdf.setDrawColor(200);
        pdf.line(margin, margin + 7, pageW - margin, margin + 7);
      };

      addHeader();
      pdf.addImage(imgData, 'PNG', margin, position, contentW, pdfHeight);
      heightLeft -= (pageH - margin - headerH);

      while (heightLeft > 0) {
        position = margin + headerH - (pdfHeight - heightLeft);
        pdf.addPage();
        addHeader();
        pdf.addImage(imgData, 'PNG', margin, position, contentW, pdfHeight);
        heightLeft -= (pageH - margin - headerH);
      }

      pdf.save(filename + '_' + getExportDate() + '.pdf');
    } catch (err) {
      console.error(err);
      alert('Erro ao gerar PDF. Tente novamente.');
    } finally {
      restoreChartsFromPdf(chartSnap);
      clearPdfLiveTheme(section);
      document.body.classList.remove('pdf-capturing');
      section.classList.remove('pdf-export-target', 'export-capture');
      if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
    }
  }

  function exportExcel(sectionId, filename) {
    const section = document.getElementById(sectionId);
    if (!section) return;
    const tables = section.querySelectorAll('table');
    const wb = XLSX.utils.book_new();

    if (tables.length > 0) {
      tables.forEach((tbl, i) => {
        const ws = XLSX.utils.table_to_sheet(tbl);
        const range = XLSX.utils.decode_range(ws['!ref'] || 'A1');
        const colWidths = [];
        for (let C = range.s.c; C <= range.e.c; C++) {
          let max = 10;
          for (let R = range.s.r; R <= range.e.r; R++) {
            const cell = ws[XLSX.utils.encode_cell({ r: R, c: C })];
            if (cell && cell.v != null) max = Math.max(max, String(cell.v).length + 2);
          }
          colWidths.push({ wch: Math.min(max, 50) });
        }
        ws['!cols'] = colWidths;
        XLSX.utils.book_append_sheet(wb, ws, 'Tabela_' + (i + 1));
      });
    } else {
      const cards = section.querySelectorAll('.ind-card');
      const rows = [['Indicador', 'Valor', 'Fórmula', 'Interpretação']];
      cards.forEach(card => {
        rows.push([
          card.querySelector('.ind-name')?.textContent?.trim() || '',
          card.querySelector('.ind-val')?.textContent?.trim() || '',
          card.querySelector('.ind-formula')?.textContent?.trim() || '',
          card.querySelector('.ind-interp')?.textContent?.trim() || ''
        ]);
      });
      const ws = XLSX.utils.aoa_to_sheet(rows);
      ws['!cols'] = [{ wch: 30 }, { wch: 15 }, { wch: 40 }, { wch: 60 }];
      XLSX.utils.book_append_sheet(wb, ws, 'Indicadores');
    }

    if (!wb.SheetNames.length) {
      alert('Nenhum dado encontrado para exportar.');
      return;
    }
    XLSX.writeFile(wb, filename + '_' + getExportDate() + '.xlsx');
  }

  function collectUniqueSuppliers() {
    const map = new Map();
    getActiveCfopEntradas().forEach((cfop) => {
      (cfop.fornecedores || []).forEach((f) => {
        const key = f.cnpj || f.nome;
        if (!map.has(key)) map.set(key, { nome: f.nome, cnpj: f.cnpj, uf: f.uf });
      });
    });
    return Array.from(map.values()).sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));
  }

  function buildSupplierReportData(selected) {
    const cfops = getActiveCfopEntradas();
    const competencia = getActiveCompetenciaLabel();
    const suppliers = [];

    selected.forEach((cb) => {
      const cnpj = cb.value;
      const nome = cb.dataset.nome;
      const rows = [];
      let subtotal = 0;
      let uf = '—';

      cfops.forEach((cfop) => {
        const f = (cfop.fornecedores || []).find((x) => x.cnpj === cnpj);
        if (f) {
          rows.push({
            cfop: cfop.cfop,
            desc: cfop.descricao || '—',
            fin: cfop.finalidade || '—',
            qtd: f.qtd,
            total: f.total,
          });
          subtotal += f.total;
          uf = f.uf;
        }
      });

      suppliers.push({ nome, cnpj, uf, rows, subtotal });
    });

    const totalGeral = suppliers.reduce((a, s) => a + s.subtotal, 0);
    return { suppliers, totalGeral, competencia };
  }

  function openSupplierModal() {
    const list = document.getElementById('supplierList');
    const btnPrint = document.querySelector('#supplierModal .btn-confirm:not(.btn-pdf-supplier)');
    const btnPdf = document.querySelector('#supplierModal .btn-pdf-supplier');
    const suppliers = collectUniqueSuppliers();
    if (!suppliers.length) {
      list.innerHTML = '<div class="td-mute" style="padding:24px;text-align:center;font-size:13px;line-height:1.6;">' +
        '<i class="fas fa-truck" style="font-size:24px;margin-bottom:12px;display:block;opacity:0.5;"></i>' +
        'Detalhe por fornecedor indisponivel neste pacote.<br><br>' +
        'O livro ENTRADA-SAIDA agrega apenas por CFOP. Para listar fornecedores reais, envie SPED ICMS/IPI com notas de entrada (C100) ou relatorio de compras por fornecedor.' +
        '</div>';
      if (btnPrint) { btnPrint.disabled = true; btnPrint.style.opacity = '0.45'; }
      if (btnPdf) { btnPdf.disabled = true; btnPdf.style.opacity = '0.45'; }
    } else {
      list.innerHTML = suppliers.map((s) => {
        const search = (s.nome + ' ' + s.cnpj).toLowerCase();
        const esc = (v) => v.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
        return '<label class="supplier-item" data-search="' + esc(search) + '">' +
          '<input type="checkbox" value="' + esc(s.cnpj) + '" data-nome="' + esc(s.nome) + '">' +
          '<span class="supplier-info"><strong>' + esc(s.nome) + '</strong>' +
          '<small>' + esc(s.cnpj) + ' · ' + esc(s.uf) + '</small></span></label>';
      }).join('');
      if (btnPrint) { btnPrint.disabled = false; btnPrint.style.opacity = '1'; }
      if (btnPdf) { btnPdf.disabled = false; btnPdf.style.opacity = '1'; }
    }
    document.getElementById('supplierSearch').value = '';
    document.getElementById('supplierModal').style.display = 'flex';
  }

  function closeSupplierModal() {
    document.getElementById('supplierModal').style.display = 'none';
    const search = document.getElementById('supplierSearch');
    if (search) search.value = '';
  }

  function filterSuppliers(query) {
    const q = query.toLowerCase();
    document.querySelectorAll('#supplierList .supplier-item').forEach(el => {
      el.style.display = el.dataset.search.includes(q) ? '' : 'none';
    });
  }

  function toggleAllSuppliers(state) {
    document.querySelectorAll('#supplierList .supplier-item').forEach(el => {
      if (el.style.display === 'none') return;
      const cb = el.querySelector('input');
      if (cb) cb.checked = state;
    });
  }

  function printBySupplier() {
    const selected = Array.from(document.querySelectorAll('#supplierList input:checked'));
    if (!selected.length) { alert('Selecione ao menos um fornecedor.'); return; }

    const { suppliers, totalGeral, competencia } = buildSupplierReportData(selected);
    closeSupplierModal();

    let html = '<div class="supplier-print-root" style="font-family:Inter,sans-serif;padding:0;margin:0;color:#1a1a2e;background:#fff;width:100%;max-width:100%;box-sizing:border-box;">';
    html += '<h1 style="font-size:18px;margin-bottom:4px;">Relatório por Fornecedor</h1>';
    html += '<p style="font-size:12px;color:#555;margin-bottom:24px;">' + getCompanyName() + ' — Competência ' + competencia + ' — ' + new Date().toLocaleDateString('pt-BR') + '</p>';

    suppliers.forEach((s) => {
      html += '<div class="supplier-print-block" style="margin-bottom:12px;page-break-inside:auto;width:100%;max-width:100%;box-sizing:border-box;">';
      html += '<h2 style="font-size:14px;border-bottom:2px solid #22a329;padding-bottom:6px;">' + s.nome + '</h2>';
      html += '<p style="font-size:11px;color:#555;">CNPJ: ' + s.cnpj + ' · UF: ' + s.uf + '</p>';
      html += '<table style="width:100%;max-width:100%;border-collapse:collapse;margin-top:8px;font-size:10px;table-layout:fixed;"><colgroup><col class="cfop"><col class="desc"><col class="fin"><col class="qtd"><col class="val"></colgroup>';
      html += '<thead><tr style="background:#f0f0f0;"><th style="padding:4px 5px;text-align:left;">CFOP</th>';
      html += '<th style="padding:4px 5px;text-align:left;">Descrição</th><th style="padding:4px 5px;text-align:left;">Finalidade</th>';
      html += '<th style="padding:4px 5px;text-align:right;">Qtd NFs</th><th style="padding:4px 5px;text-align:right;">Valor (R$)</th></tr></thead><tbody>';
      s.rows.forEach((r) => {
        html += '<tr><td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;">' + r.cfop + '</td>';
        html += '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;">' + r.desc + '</td>';
        html += '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;">' + r.fin + '</td>';
        html += '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;text-align:right;">' + r.qtd + '</td>';
        html += '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;text-align:right;font-weight:600;">' +
          r.total.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</td></tr>';
      });
      html += '</tbody><tfoot><tr><td colspan="4" style="padding:6px 5px;text-align:right;font-weight:700;">Subtotal:</td>';
      html += '<td style="padding:6px 5px;text-align:right;font-weight:700;">R$ ' +
        s.subtotal.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</td></tr></tfoot></table></div>';
    });

    html += '<div style="border-top:2px solid #1a1a2e;padding-top:12px;margin-top:16px;text-align:right;font-size:14px;font-weight:700;">';
    html += 'Total Geral: R$ ' + totalGeral.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</div></div>';

    const old = document.getElementById('print-supplier-report');
    if (old) old.remove();
    const div = document.createElement('div');
    div.id = 'print-supplier-report';
    div.innerHTML = html;
    document.body.appendChild(div);
    document.body.classList.add('supplier-printing');

    const cleanup = () => {
      document.body.classList.remove('supplier-printing');
      div.remove();
      window.removeEventListener('afterprint', cleanup);
    };
    window.addEventListener('afterprint', cleanup);
    window.print();
  }

  function exportSupplierPdf() {
    const selected = Array.from(document.querySelectorAll('#supplierList input:checked'));
    if (!selected.length) { alert('Selecione ao menos um fornecedor.'); return; }
    if (!window.jspdf?.jsPDF) {
      alert('Biblioteca jsPDF nao carregada.');
      return;
    }
    if (typeof window.jspdf.jsPDF.prototype.autoTable !== 'function') {
      alert('Biblioteca jspdf-autotable nao carregada.');
      return;
    }

    const { suppliers, totalGeral, competencia } = buildSupplierReportData(selected);
    closeSupplierModal();

    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
    const margin = 14;
    const pageW = pdf.internal.pageSize.getWidth();
    const pageH = pdf.internal.pageSize.getHeight();
    let y = margin;

    const ensureSpace = (need) => {
      if (y + need > pageH - margin) {
        pdf.addPage();
        y = margin;
      }
    };

    pdf.setFont('helvetica', 'bold');
    pdf.setFontSize(14);
    pdf.text('Relatorio por Fornecedor', margin, y);
    y += 7;
    pdf.setFont('helvetica', 'normal');
    pdf.setFontSize(9);
    pdf.setTextColor(80, 80, 80);
    pdf.text(getCompanyName() + ' — Competencia ' + competencia + ' — ' + new Date().toLocaleDateString('pt-BR'), margin, y);
    y += 10;
    pdf.setTextColor(0, 0, 0);

    const fmtBrl = (v) => 'R$ ' + Number(v).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    suppliers.forEach((s) => {
      ensureSpace(20);
      pdf.setFont('helvetica', 'bold');
      pdf.setFontSize(11);
      pdf.text(s.nome, margin, y);
      y += 5;
      pdf.setFont('helvetica', 'normal');
      pdf.setFontSize(8);
      pdf.setTextColor(100, 100, 100);
      pdf.text('CNPJ: ' + s.cnpj + ' · UF: ' + s.uf, margin, y);
      y += 4;
      pdf.setTextColor(0, 0, 0);

      pdf.autoTable({
        startY: y,
        margin: { left: margin, right: margin },
        tableWidth: 'auto',
        head: [['CFOP', 'Descricao', 'Finalidade', 'Qtd NFs', 'Valor (R$)']],
        body: s.rows.map((r) => [
          r.cfop,
          r.desc,
          r.fin,
          String(r.qtd),
          fmtBrl(r.total),
        ]),
        foot: [['', '', '', 'Subtotal:', fmtBrl(s.subtotal)]],
        styles: { fontSize: 7, cellPadding: 1.5, overflow: 'linebreak' },
        headStyles: { fillColor: [34, 163, 41], textColor: 255 },
        footStyles: { fillColor: [241, 245, 249], textColor: [30, 41, 59], fontStyle: 'bold' },
        columnStyles: {
          3: { halign: 'right' },
          4: { halign: 'right' },
        },
      });
      y = pdf.lastAutoTable.finalY + 8;
    });

    ensureSpace(12);
    pdf.setFont('helvetica', 'bold');
    pdf.setFontSize(11);
    pdf.text('Total Geral: ' + fmtBrl(totalGeral), pageW - margin, y, { align: 'right' });

    const compSlug = (competencia || 'competencia').replace(/\s+/g, '_').replace(/\//g, '-');
    pdf.save('Fornecedores_' + compSlug + '_' + getExportDate() + '.pdf');
  }

  </script>
