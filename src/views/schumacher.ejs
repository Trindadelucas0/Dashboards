  function initPeriodSelector() {
    const fp = getFiscal();
    const sel = document.querySelector('.period-sel');
    if (!sel || !fp.meses.length) return;
    const q1 = fp.meses.filter((m) => ['01', '02', '03'].includes(mmOfKey(m)));
    const q2 = fp.meses.filter((m) => !q1.includes(m));
    const optLabel = (key, base) => {
      const v = fiscalMetricValue(key, 'receitaBruta');
      return base + (v != null ? ' — ' + fmtK(v) : '');
    };
    let html = '<optgroup label="Período">';
    html += '<option value="total">' + optLabel('total', fiscalPeriodTotalLabel()) + '</option>';
    if (q1.length) html += '<option value="q1">' + optLabel('q1', '1º Trimestre 2026') + '</option>';
    if (q2.length) html += '<option value="q2">' + optLabel('q2', '2º Trimestre 2026') + '</option>';
    html += '</optgroup>';
    if (q1.length) {
      html += '<optgroup label="1º Trimestre — meses">';
      q1.forEach((m) => {
        const i = fp.meses.indexOf(m);
        html += '<option value="' + m + '">' + optLabel(m, fp.mesLabels[i] || m) + '</option>';
      });
      html += '</optgroup>';
    }
    if (q2.length) {
      html += '<optgroup label="2º Trimestre — meses">';
      q2.forEach((m) => {
        const i = fp.meses.indexOf(m);
        html += '<option value="' + m + '">' + optLabel(m, fp.mesLabels[i] || m) + '</option>';
      });
      html += '</optgroup>';
    }
    sel.innerHTML = html;
    // Preferir mes com compras/CFOPs (ex.: Mai); ultimo mes pode estar zerado (Jun).
    const withCompras = fp.meses.filter((m) => {
      const p = fp.porMes && fp.porMes[m];
      return p && ((p.totalCompras || 0) > 0 || (p.cfopEntradas || []).length > 0);
    });
    const def = D().competencia && fp.meses.includes(D().competencia)
      ? D().competencia
      : (withCompras[withCompras.length - 1] || fp.meses[fp.meses.length - 1]);
    appMesFiscal = def;
    sel.value = def;
    sel.onchange = () => setAppMesFiscal(sel.value);
  }

