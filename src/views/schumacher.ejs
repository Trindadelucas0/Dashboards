      if (vdTbody) vdTbody.innerHTML = '<tr><td colspan="5" class="td-mute" style="text-align:center;padding:20px;">SPED indisponivel para ' + lbl + '</td></tr>';
    } else {
      safeChart('chartClientes', {
        type: 'bar',
        data: {
          labels: clientes.map((c) => (c.nome || 'Cliente').substring(0, 22)),
          datasets: [{ label: 'R$ mil', data: clientes.map((c) => +(c.total / 1000).toFixed(1)), backgroundColor: PAL, borderRadius: 5 }],
        },
        options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { ticks: { callback: (v) => 'R$' + v + 'K' } } } },
      });
      const ufTotals = {};
      sped.clientes.forEach((c) => { const u = c.uf && c.uf !== '-' ? c.uf : 'N/I'; ufTotals[u] = (ufTotals[u] || 0) + c.total; });
      const ufLabels = Object.keys(ufTotals).sort((a, b) => ufTotals[b] - ufTotals[a]).slice(0, 8);
