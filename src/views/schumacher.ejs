    setHTML('#vg-kpi-ded', fmtK(ded));
    setHTML('#vg-kpi-ded-pct', pack.dedPct.toFixed(2) + '%');
    setHTML('#vg-kpi-icms', 'R$ ' + fmt(ap.icms.aRecolher));
    const subs = document.querySelectorAll('#tab-visao-geral .kpi-grid.kpi-grid-4 .kpi-sub');
