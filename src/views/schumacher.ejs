function renderVendasFiscal(mesKey) {
    const pack = getFiscalPack(mesKey);
    if (!pack) return;
    const lbl = fiscalMesLabel(mesKey);
    const sped = pack.sped || { clientes: [], c100Total: 0, totalClientes: 0, nfSaidas: 0 };
    const clientes = (sped.clientes || []).slice(0, 10);
    const spedTotal = sped.c100Total || (sped.clientes || []).reduce((a, c) => a + c.total, 0);
    const totalLivro = pack.cfopSaidasTotal;
    const rb = pack.receitaBruta;
    setText('#vd-fiscal-competencia', lbl);
    setHTML('#vd-kpi-rb', fmtK(rb));
    setHTML('#vd-kpi-total', fmtK(totalLivro));
    setHTML('#vd-kpi-clientes', sped.totalClientes || 0);
    setHTML('#vd-kpi-sped', fmtK(spedTotal));
    const nfs = document.getElementById('vd-kpi-nfs');
    if (nfs) nfs.textContent = (sped.nfSaidas || 0) + ' NFs de saida';
    if (!sped.clientes || !sped.clientes.length) {
      const vdTbody = document.getElementById('vd-clientes-tbody');
      if (vdTbody) vdTbody.innerHTML = '<tr><td colspan="5" class="td-mute" style="text-align:center;padding:20px;">SPED indisponivel para ' + lbl + '</td></tr>';
    } else {
      safeChart('chartClientes', {
        type: 'bar',
        data: {
          labels: clientes.map((c) => (c.nome || 'Cliente').substring(0, 22)),
          datasets: [{ label: 'R$ mil', data: clientes.map((c) => +(c.total / 1000).toFixed(1)), backgroundColor: PAL, borderRadius: 5 }],
        },
        options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { ticks: { callback: (v) => 'R$' + v + 'K' } } } },
      });
      const ufTotals = {};
      sped.clientes.forEach((c) => { const u = c.uf && c.uf !== '-' ? c.uf : 'N/I'; ufTotals[u] = (ufTotals[u] || 0) + c.total; });
      const ufLabels = Object.keys(ufTotals).sort((a, b) => ufTotals[b] - ufTotals[a]).slice(0, 8);
      safeChart('chartVendasUF', {
        type: 'doughnut',
        data: { labels: ufLabels, datasets: [{ data: ufLabels.map((k) => ufTotals[k]), backgroundColor: PAL, borderWidth: 0 }] },
        options: { responsive: true, maintainAspectRatio: false, cutout: '58%', plugins: { legend: { ...leg(), position: 'right' } } },
      });
      const vdTbody = document.getElementById('vd-clientes-tbody');
      if (vdTbody) {
        vdTbody.innerHTML = '';
        const top = sped.clientes.slice(0, 10);
        const topSum = top.reduce((a, c) => a + c.total, 0);
        top.forEach((c, i) => {
          const p = pct(c.total, spedTotal);
          const rank = i < 3 ? ['g1', 'g2', 'g3'][i] : 'gn';
          const tr = document.createElement('tr');
          tr.innerHTML = '<td><div class="rank ' + rank + '">' + (i + 1) + '</div></td><td><div class="fw7">' + (c.nome || 'Cliente') + '</div><div class="td-mute">' + c.cnpj + ' &middot; ' + c.qtd + ' NF(s)</div></td><td><span class="chip bl">' + (c.uf || '-') + '</span></td><td class="r td-val">R$ ' + fmt(c.total) + '</td><td style="min-width:180px"><div class="pb-wrap"><div class="pb-bar"><div class="pb-fill" style="width:' + p + '%"></div></div><div class="pb-pct">' + p + '%</div></div></td>';
          vdTbody.appendChild(tr);
        });
        if (spedTotal > topSum) {
          const tr = document.createElement('tr');
          tr.innerHTML = '<td><div class="rank gn">+</div></td><td><div class="fw7">Demais clientes</div><div class="td-mute">SPED EFD</div></td><td><span class="chip gy">-</span></td><td class="r td-val">R$ ' + fmt(spedTotal - topSum) + '</td><td><div class="pb-wrap"><div class="pb-bar"><div class="pb-fill" style="width:' + pct(spedTotal - topSum, spedTotal) + '%;background:var(--text-muted)"></div></div><div class="pb-pct">' + pct(spedTotal - topSum, spedTotal) + '%</div></div></td>';
          vdTbody.appendChild(tr);
        }
      }
    }
    const tbody = document.getElementById('cfop-saidas-tbody');
    if (tbody) {
      tbody.innerHTML = '';
      pack.cfopSaidas.slice(0, 15).forEach((d) => {
        const p = pct(d.total, totalLivro);
        const tr = document.createElement('tr');
        tr.innerHTML = '<td><span class="chip" style="font-family:monospace;font-weight:700;">' + d.cfop + '</span></td><td class="r">' + d.qtd + '</td><td class="r td-val">R$ ' + fmt(d.total) + '</td><td class="r"><div class="pb-wrap"><div class="pb-bar"><div class="pb-fill" style="width:' + p + '%"></div></div><div class="pb-pct">' + p + '%</div></div></td>';
        tbody.appendChild(tr);
      });
    }
    syncFiscalMesBars(mesKey);
  }

