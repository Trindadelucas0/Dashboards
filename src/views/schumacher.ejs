    if (subs[2]) subs[2].textContent = 'Sobre receita bruta ' + lbl;
    const compParts = (pack.competencia || '').split('-');
    const livroRef = compParts.length === 2 ? compParts[1] + '/' + compParts[0] : lbl;
    if (subs[3]) subs[3].textContent = 'Fonte: Livro ICMS ' + livroRef;
    const icmsLbl = document.querySelector('#tab-visao-geral .kpi-card.c-purple .kpi-lbl');
    if (icmsLbl) icmsLbl.textContent = 'ICMS a Recolher – ' + lbl;
    const chartSubs = document.querySelectorAll('#tab-visao-geral .chart-sub');
    if (chartSubs[0]) chartSubs[0].textContent = 'Valores mensais ' + lbl + ' (R$ mil) — Livros fiscais';
    if (chartSubs[1]) chartSubs[1].textContent = '% de impostos a recolher sobre RB — ' + lbl;
    if (chartSubs[2]) chartSubs[2].textContent = 'Participação de cada tributo no total de deduções — ' + lbl;
    const chartTtls = document.querySelectorAll('#tab-visao-geral .chart-ttl');
    if (chartTtls[2]) chartTtls[2].textContent = 'Composição das Deduções – ' + lbl;
    if (chartTtls[3]) chartTtls[3].textContent = 'Análise de Impostos sobre Vendas – ' + lbl;
    if (chartSubs[3]) chartSubs[3].textContent = 'Valores apurados / % sobre Receita Bruta de R$ ' + fmt(rb);
    const tbody = document.getElementById('vg-impostos-tbody');
    if (tbody) {
      tbody.innerHTML = '';
      pack.impostosTabela.forEach((row) => {
