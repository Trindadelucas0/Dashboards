    document.getElementById('dd-title').textContent = 'CFOP ' + cfop + ' � ' + item.descricao;
    document.getElementById('dd-sub').textContent = 'Finalidade: ' + item.finalidade + ' | Total: R$ ' + fmt(item.total);
    const tbody = document.getElementById('dd-tbody');
    tbody.innerHTML = '';
    const forn = item.fornecedores || [];
    if (!forn.length) {
      const tr = document.createElement('tr');
      tr.innerHTML = '<td colspan="7" class="td-mute" style="text-align:center;padding:20px;">Detalhe por fornecedor indisponivel. Livro agrega por CFOP; envie SPED com entradas ou relatorio de fornecedores.</td>';
      tbody.appendChild(tr);
