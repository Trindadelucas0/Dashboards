  function initVendas() {
    buildFiscalMesBar('vd-fiscal-mes-bar');
    renderVendasFiscal(appMesFiscal || getFiscal().meses[getFiscal().meses.length - 1]);
    initMapaAgrupamento();
    initMargensVendas();
  }

  let vdMargMesKey = null;

  function margensMonthKeys(mesKey) {
    const marg = D().margens;
    if (!marg || !marg.meses) return [];
    if (mesKey === 'total') return marg.meses.slice();
    if (mesKey === 'q1') return marg.meses.filter((m) => ['01', '02', '03'].includes(mmOfKey(m)));
    if (mesKey === 'q2') return marg.meses.filter((m) => !['01', '02', '03'].includes(mmOfKey(m)));
    return marg.meses.indexOf(mesKey) >= 0 ? [mesKey] : [];
  }

  function mergeMargensList(items, keyFn) {
    const map = {};
    (items || []).forEach((item) => {
      const k = keyFn(item);
      if (!k) return;
      if (!map[k]) {
        map[k] = Object.assign({}, item);
        return;
      }
      const dest = map[k];
      ['qtde', 'total', 'custo', 'lucroBruto', 'lucroLiquido'].forEach((f) => {
        dest[f] = (dest[f] || 0) + (item[f] || 0);
      });
    });
    return Object.values(map).map((row) => {
      const vendas = row.total || 0;
      row.margemBrutaPct = vendas > 0 ? ((row.lucroBruto || 0) / vendas) * 100 : 0;
      row.margemLiquidaPct = vendas > 0 ? ((row.lucroLiquido || 0) / vendas) * 100 : 0;
      return row;
    }).sort((a, b) => (b.total || 0) - (a.total || 0));
  }

  function buildMargensAggregate(keys) {
    const marg = D().margens;
    if (!marg || !keys.length) return null;
    const packs = keys.map((k) => marg.porMes && marg.porMes[k]).filter(Boolean);
    if (!packs.length) return null;
    const totais = { vendas: 0, custo: 0, lucroBruto: 0, lucroLiquido: 0 };
    packs.forEach((p) => {
      const t = p.totais || {};
      totais.vendas += t.vendas || 0;
      totais.custo += t.custo || 0;
      totais.lucroBruto += t.lucroBruto || 0;
      totais.lucroLiquido += t.lucroLiquido || 0;
    });
    totais.margemBrutaPct = totais.vendas > 0 ? (totais.lucroBruto / totais.vendas) * 100 : 0;
    totais.margemLiquidaPct = totais.vendas > 0 ? (totais.lucroLiquido / totais.vendas) * 100 : 0;
    return {
      totais: totais,
      produtos: mergeMargensList(packs.flatMap((p) => p.produtos || []), (p) => p.codigo || p.nome),
      cidades: mergeMargensList(packs.flatMap((p) => p.cidades || []), (c) => (c.cidade || '') + '|' + (c.uf || '')),
      estados: mergeMargensList(packs.flatMap((p) => p.estados || []), (e) => e.uf || e.estado || e.nome),
    };
  }

  function getMargensPack(mesKey) {
    const marg = D().margens;
    if (!marg) return null;
    if (mesKey === 'total' && marg.consolidado) return marg.consolidado;
    if (mesKey === 'q1' || mesKey === 'q2') return buildMargensAggregate(margensMonthKeys(mesKey));
    return marg.porMes && marg.porMes[mesKey] ? marg.porMes[mesKey] : null;
  }

  function margPeriodLabel(mesKey) {
    const marg = D().margens;
    if (!marg) return mesKey;
    if (mesKey === 'total') {
      const labels = marg.mesLabels || marg.meses || [];
      if (labels.length > 1) return labels[0] + ' a ' + labels[labels.length - 1] + ' (consolidado)';
      return 'Total consolidado';
    }
    if (mesKey === 'q1') return '1º Trimestre 2026';
    if (mesKey === 'q2') return '2º Trimestre 2026';
    const i = marg.meses.indexOf(mesKey);
    return i >= 0 && marg.mesLabels ? marg.mesLabels[i] : mesKey;
  }

  const MARGEM_LIMITE_ATENCAO = 20;
  const MARGEM_LIMITE_CRITICO = 15;

  function margemProdutoNivel(mLiq) {
    const m = mLiq != null ? mLiq : 0;
    if (m < 0) return 'negativo';
    if (m < MARGEM_LIMITE_CRITICO) return 'critico';
    if (m < MARGEM_LIMITE_ATENCAO) return 'atencao';
    return 'ok';
  }

  function margemProdutoStatusChip(nivel) {
    if (nivel === 'negativo') return '<span class="chip rd"><i class="fas fa-circle" style="font-size:6px"></i> Negativa</span>';
    if (nivel === 'critico') return '<span class="chip rd"><i class="fas fa-circle" style="font-size:6px"></i> &lt; 15%</span>';
    if (nivel === 'atencao') return '<span class="chip ye"><i class="fas fa-circle" style="font-size:6px"></i> 15\u201320%</span>';
    return '<span class="chip gr">OK</span>';
  }

  function margemPctClass(mLiq) {
    const n = margemProdutoNivel(mLiq);
    if (n === 'negativo' || n === 'critico') return 'marg-pct-crit';
    if (n === 'atencao') return 'marg-pct-warn';
    return '';
  }

  function renderMargensAlertaProdutos(pack, totVendas, lbl) {
    const produtos = pack.produtos || [];
    const neg = [];
    const crit = [];
    const warn = [];
    produtos.forEach((p) => {
      const m = p.margemLiquidaPct != null ? p.margemLiquidaPct : 0;
      const n = margemProdutoNivel(m);
      if (n === 'negativo') neg.push(p);
      else if (n === 'critico') crit.push(p);
      else if (n === 'atencao') warn.push(p);
    });
    const emAtencao = neg.concat(crit, warn).sort((a, b) => {
      const d = (a.margemLiquidaPct || 0) - (b.margemLiquidaPct || 0);
      return d !== 0 ? d : (b.total || 0) - (a.total || 0);
    });
    const sumVendas = (arr) => arr.reduce((a, p) => a + (p.total || 0), 0);
    const fmtSub = (arr) => arr.length ? fmtK(sumVendas(arr)) + ' em vendas' : 'Nenhum produto';

    setText('#vd-alerta-neg-qtd', neg.length);
    setText('#vd-alerta-neg-sub', fmtSub(neg));
    setText('#vd-alerta-crit-qtd', crit.length);
    setText('#vd-alerta-crit-sub', fmtSub(crit));
    setText('#vd-alerta-warn-qtd', warn.length);
    setText('#vd-alerta-warn-sub', fmtSub(warn));
    setText('#vd-alerta-tot-qtd', emAtencao.length);
    const totVendasAtencao = sumVendas(emAtencao);
    setText('#vd-alerta-tot-sub', emAtencao.length
      ? fmtK(totVendasAtencao) + ' (' + pct(totVendasAtencao, totVendas) + '% das vendas)'
      : 'Nenhum produto abaixo de 20%');
    setText('#vd-marg-alerta-sub', emAtencao.length + ' produto(s) com margem liq. < 20% \u2014 ' + lbl);

    const banner = document.getElementById('vd-marg-alerta-banner');
    if (banner) {
      if (!emAtencao.length) {
        banner.style.borderColor = 'rgba(34,163,41,0.35)';
        banner.style.background = 'rgba(34,163,41,0.06)';
        banner.innerHTML = '<i class="fas fa-check-circle t-accent" style="margin-right:8px;"></i><strong>Sem alertas:</strong> nenhum produto com margem l\u00edquida abaixo de 20% no per\u00edodo selecionado (' + lbl + ').';
      } else {
        banner.style.borderColor = 'rgba(239,68,68,0.35)';
        banner.style.background = 'rgba(239,68,68,0.06)';
        banner.innerHTML =
          '<i class="fas fa-exclamation-triangle t-danger" style="margin-right:8px;"></i>' +
          '<strong>Aten\u00e7\u00e3o \u2014 margem l\u00edquida baixa (' + lbl + '):</strong> ' +
          emAtencao.length + ' produto(s) abaixo de 20% \u2014 ' +
          neg.length + ' negativa(s), ' + crit.length + ' cr\u00edtico(s) (&lt;15%), ' + warn.length + ' em faixa 15\u201320%.';
      }
    }

    const aTbody = document.getElementById('vd-marg-alerta-tbody');
    if (!aTbody) return;
    aTbody.innerHTML = '';
    if (!emAtencao.length) {
      aTbody.innerHTML = '<tr><td colspan="10" class="td-mute" style="text-align:center;padding:24px;">Nenhum produto com margem l\u00edquida abaixo de 20%</td></tr>';
      return;
    }
    emAtencao.forEach((p) => {
      const mLiq = p.margemLiquidaPct || 0;
      const mBruta = p.margemBrutaPct || 0;
      const nivel = margemProdutoNivel(mLiq);
      const tr = document.createElement('tr');
      if (nivel === 'negativo') tr.className = 'vd-prod-neg';
      else if (nivel === 'critico') tr.className = 'vd-prod-crit';
      else tr.className = 'vd-prod-atencao';
      const mCls = margemPctClass(mLiq);
      const mClsB = margemPctClass(mBruta);
      tr.innerHTML =
        '<td>' + margemProdutoStatusChip(nivel) + '</td>' +
        '<td style="font-family:monospace;font-size:11px;">' + p.codigo + '</td>' +
        '<td class="fw7">' + p.nome + '</td>' +
        '<td class="r">' + fmt(p.qtde) + '</td>' +
        '<td class="r td-val">R$ ' + fmt(p.total) + '</td>' +
        '<td class="r">R$ ' + fmt(p.custo) + '</td>' +
        '<td class="r">R$ ' + fmt(p.lucroLiquido) + '</td>' +
        '<td class="r ' + mClsB + '">' + mBruta.toFixed(2) + '%</td>' +
        '<td class="r ' + mCls + '">' + mLiq.toFixed(2) + '%</td>' +
        '<td class="r">' + pct(p.total, totVendas) + '%</td>';
      aTbody.appendChild(tr);
    });
  }

  function renderMargensTableFoot(tfootId, t, extraColspan) {
    const tfoot = document.getElementById(tfootId);
    if (!tfoot || !t) return;
    const cs = extraColspan || 2;
    tfoot.innerHTML =
      '<tr style="font-weight:700;background:rgba(34,163,41,0.06);">' +
      '<td colspan="' + cs + '">TOTAL</td>' +
      '<td class="r">' + fmt(t.qtde || 0) + '</td>' +
      '<td class="r td-val">R$ ' + fmt(t.vendas || t.total || 0) + '</td>' +
      '<td class="r">R$ ' + fmt(t.custo || 0) + '</td>' +
      '<td class="r">R$ ' + fmt(t.lucroLiquido || t.lucroBruto || 0) + '</td>' +
      '<td class="r">' + (t.margemBrutaPct != null ? t.margemBrutaPct.toFixed(2) + '%' : '\u2014') + '</td>' +
      '<td class="r">' + (t.margemLiquidaPct != null ? t.margemLiquidaPct.toFixed(2) + '%' : '\u2014') + '</td>' +
      (tfootId.indexOf('estados') !== -1 ? '<td class="r">100%</td>' : '') +
      '</tr>';
  }

  function renderMargensVendas(mesKey) {
    vdMargMesKey = mesKey;
    const marg = D().margens;
    const pack = getMargensPack(mesKey);
    if (!marg || !pack) return;
    const t = pack.totais || {};
    const lbl = margPeriodLabel(mesKey);

    setText('#vd-marg-period-label', lbl);
    setHTML('#vd-marg-vendas', fmtK(t.vendas || 0));
    setText('#vd-marg-vendas-sub', lbl);
    setHTML('#vd-marg-custo', fmtK(t.custo || 0));
