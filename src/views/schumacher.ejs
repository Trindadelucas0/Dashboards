          '<td class="r td-val">R$ ' + fmt(p.total) + '</td>' +
          '<td class="r">R$ ' + fmt(p.custo) + '</td>' +
          '<td class="r">R$ ' + fmt(p.lucroLiquido) + '</td>' +
          '<td class="r ' + margemPctClass(mBruta) + '">' + mBruta.toFixed(2) + '%</td>' +
          '<td class="r ' + margemPctClass(mLiq) + '">' + mLiq.toFixed(2) + '%</td>';
