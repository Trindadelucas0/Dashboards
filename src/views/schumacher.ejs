          tr.innerHTML = '<td><div class="rank ' + rank + '">' + (i + 1) + '</div></td><td><div class="fw7">' + (c.nome || 'Cliente') + '</div><div class="td-mute">' + c.cnpj + ' &middot; ' + c.qtd + ' NF(s)</div></td><td><span class="chip bl">' + (c.uf || '-') + '</span></td><td class="r td-val">R$ ' + fmt(c.total) + '</td><td style="min-width:180px"><div class="pb-wrap"><div class="pb-bar"><div class="pb-fill" style="width:' + p + '%"></div></div><div class="pb-pct">' + p + '%</div></div></td>';
          vdTbody.appendChild(tr);
        });
        if (spedTotal > topSum) {
          const tr = document.createElement('tr');
          tr.innerHTML = '<td><div class="rank gn">+</div></td><td><div class="fw7">Demais clientes</div><div class="td-mute">SPED EFD</div></td><td><span class="chip gy">-</span></td><td class="r td-val">R$ ' + fmt(spedTotal - topSum) + '</td><td><div class="pb-wrap"><div class="pb-bar"><div class="pb-fill" style="width:' + pct(spedTotal - topSum, spedTotal) + '%;background:var(--text-muted)"></div></div><div class="pb-pct">' + pct(spedTotal - topSum, spedTotal) + '%</div></div></td>';
          vdTbody.appendChild(tr);
        }
      }
    }
    const tbody = document.getElementById('cfop-saidas-tbody');
    if (tbody) {
      tbody.innerHTML = '';
      pack.cfopSaidas.slice(0, 15).forEach((d) => {
        const p = pct(d.total, totalLivro);
        const tr = document.createElement('tr');
        tr.innerHTML = '<td><span class="chip" style="font-family:monospace;font-weight:700;">' + d.cfop + '</span></td><td class="r">' + d.qtd + '</td><td class="r td-val">R$ ' + fmt(d.total) + '</td><td class="r"><div class="pb-wrap"><div class="pb-bar"><div class="pb-fill" style="width:' + p + '%"></div></div><div class="pb-pct">' + p + '%</div></div></td>';
        tbody.appendChild(tr);
