        if (nivel === 'negativo') tr.className = 'vd-prod-neg';
        else if (nivel === 'critico') tr.className = 'vd-prod-crit';
        else if (nivel === 'atencao') tr.className = 'vd-prod-atencao';
        const status = nivel !== 'ok' ? ' ' + margemProdutoStatusChip(nivel) : '';
        tr.innerHTML =
          '<td style="font-family:monospace;font-size:11px;">' + p.codigo + '</td>' +
          '<td>' + p.nome + status + '</td>' +
