<script>
/* Dashboard Schumacher � renderizacao data-driven (DASHBOARD_DATA) */
(function () {
  const D = () => DASHBOARD_DATA;
  const PAL = ['#22a329', '#10b981', '#f59e0b', '#8b5cf6', '#ef4444', '#06b6d4', '#f97316', '#ec4899'];

  const fmt = (v) => (v == null || isNaN(v) ? '�' : Number(v).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
  const fmtK = (v) => {
    if (v >= 1e6) return 'R$ ' + (v / 1e6).toFixed(2).replace('.', ',') + 'M';
    if (v >= 1e3) return 'R$ ' + (v / 1e3).toFixed(0) + 'K';
    return 'R$ ' + fmt(v);
  };
  const pct = (v, t) => (t > 0 ? ((v / t) * 100).toFixed(1) : '0.0');
  const fmtCredito = (v) => (v > 0 ? 'R$ (' + fmt(v) + ')' : '\u2014');

  Chart.defaults.color = '#94a3b8';
  Chart.defaults.borderColor = 'rgba(255,255,255,0.07)';
  Chart.defaults.font.family = "'Inter', sans-serif";
  Chart.defaults.font.size = 12;

  function tip() {
    return { backgroundColor: '#1e2535', borderColor: 'rgba(255,255,255,0.1)', borderWidth: 1, padding: 12, titleColor: '#e2e8f0', bodyColor: '#94a3b8', cornerRadius: 8 };
  }
  function leg() { return { labels: { usePointStyle: true, padding: 16, boxWidth: 8, boxHeight: 8 } }; }

  const chartInst = {};
  const tabsInit = {};
  let appMesFiscal = null;
  let patrimMesKey = null;
  let indMesKey = null;
  let activeTabName = 'visao-geral';
  const FISCAL_MES_BAR_IDS = ['vg-mes-bar', 'cp-mes-bar', 'fn-mes-bar', 'tax-mes-bar', 'mem-mes-bar', 'vd-fiscal-mes-bar', 'dre-mes-bar'];

  function getFiscal() {
    const fp = D().fiscalPorMes;
    if (fp && fp.meses && fp.meses.length) return fp;
    const k = D().competencia || '2026-05';
    return {
      meses: [k],
      mesLabels: [D().competenciaLabel || k],
      porMes: {},
    };
  }

  function getFiscalPack(mesKey) {
    const fp = getFiscal();
    const key = mesKey || appMesFiscal || fp.meses[fp.meses.length - 1];
    if (key === 'total') return buildFiscalTotalPack();
    if (key === 'q1' || key === 'q2') return buildFiscalTrimPack(key);
    if (fp.porMes && fp.porMes[key]) return fp.porMes[key];
    if (key === D().competencia) {
      return {
        competencia: D().competencia,
        competenciaLabel: D().competenciaLabel,
        receitaBruta: D().receitaBruta,
        totalCompras: D().totalCompras,
        deducoes: D().deducoes[0],
        dedPct: D().dedPct[0],
        composicao: D().composicao,
        impostosTabela: D().impostosTabela,
        apuracao: D().apuracao,
        cfopEntradas: D().cfopEntradas,
        cfopSaidas: D().cfopSaidas,
        cfopSaidasTotal: D().cfopSaidasTotal,
        sped: D().sped,
      };
    }
    return null;
  }

  function fiscalQMeses(qid) {
    const fp = getFiscal();
    const meses = fp.meses || [];
    const mmOf = (k) => {
      const s = String(k);
      if (s.includes('-')) return s.split('-')[1];
      return s.length === 2 ? s : s.slice(-2);
    };
    if (qid === 'q1') return meses.filter((m) => ['01', '02', '03'].includes(mmOf(m)));
    return meses.filter((m) => ['04', '05', '06', '07', '08', '09', '10', '11', '12'].includes(mmOf(m)));
  }

  function buildFiscalTrimPack(qid) {
    const fp = getFiscal();
    const keys = fiscalQMeses(qid);
    const monthPacks = keys.map((m) => fp.porMes && fp.porMes[m]).filter(Boolean);
    if (!monthPacks.length) return null;
    const ap = mergeApuracao(monthPacks);
    const receitaBruta = monthPacks.reduce((a, p) => a + (p.receitaBruta || 0), 0);
    const totalCompras = monthPacks.reduce((a, p) => a + (p.totalCompras || 0), 0);
    const deducoes = monthPacks.reduce((a, p) => a + (p.deducoes || 0), 0);
    const dedPct = receitaBruta > 0 ? Math.round(deducoes / receitaBruta * 10000) / 100 : 0;
    const label = qid === 'q1' ? '1º Trimestre 2026' : '2º Trimestre 2026';
    return {
      competencia: qid,
      competenciaLabel: label,
      receitaBruta: Math.round(receitaBruta * 100) / 100,
      totalCompras: Math.round(totalCompras * 100) / 100,
      deducoes: Math.round(deducoes * 100) / 100,
      dedPct: dedPct,
      composicao: [
        { label: 'ICMS', valor: ap.icms.aRecolher },
        { label: 'ICMS ST', valor: ap.icmsSt.aRecolher },
        { label: 'PIS', valor: ap.pis.aRecolher },
        { label: 'COFINS', valor: ap.cofins.aRecolher },
        { label: 'IPI', valor: ap.ipi.aRecolher },
      ],
      impostosTabela: buildImpostosTabelaFromAp(ap),
      apuracao: ap,
      cfopEntradas: mergeCfopEntradas(monthPacks),
      cfopSaidas: monthPacks[monthPacks.length - 1].cfopSaidas || [],
      cfopSaidasTotal: monthPacks.reduce((a, p) => a + (p.cfopSaidasTotal || 0), 0),
      sped: monthPacks[monthPacks.length - 1].sped || {},
    };
  }

  function fiscalPeriodTotalLabel() {
    const fp = getFiscal();
    if (!fp.meses || !fp.meses.length) return 'Total';
    const a = fp.mesLabels && fp.mesLabels[0] ? fp.mesLabels[0].split('/')[0] : fp.meses[0];
    const b = fp.mesLabels && fp.mesLabels.length
      ? fp.mesLabels[fp.mesLabels.length - 1].split('/')[0]
      : fp.meses[fp.meses.length - 1];
    return 'Total ' + a + '\u2013' + b;
  }

  function fiscalDisplayLabel(mesKey) {
    if (mesKey === 'total') return fiscalPeriodTotalLabel();
    if (mesKey === 'q1') return '1º Trimestre 2026';
    if (mesKey === 'q2') return '2º Trimestre 2026';
    return fiscalMesLabel(mesKey);
  }

  function mmOfKey(k) {
    const s = String(k);
    if (s.includes('-')) return s.split('-')[1];
    return s.length === 2 ? s : s.slice(-2);
  }

  function activeTrimContextSchu() {
    if (appMesFiscal === 'q1') return 'q1';
    if (appMesFiscal === 'q2') return 'q2';
    if (appMesFiscal && appMesFiscal !== 'total') {
      const mm = mmOfKey(appMesFiscal);
      if (['01', '02', '03'].includes(mm)) return 'q1';
      if (['04', '05', '06', '07', '08', '09', '10', '11', '12'].includes(mm)) return 'q2';
    }
    return null;
  }

  function mergeCfopEntradas(monthPacks) {
    const map = {};
    monthPacks.forEach((pack) => {
      (pack.cfopEntradas || []).forEach((c) => {
        if (!map[c.cfop]) {
          map[c.cfop] = Object.assign({}, c);
        } else {
          map[c.cfop].total = (map[c.cfop].total || 0) + (c.total || 0);
          map[c.cfop].qtd = (map[c.cfop].qtd || 0) + (c.qtd || 0);
          map[c.cfop].fiscal = (map[c.cfop].fiscal || 0) + (c.fiscal || 0);
        }
      });
    });
    return Object.values(map).sort((a, b) => (b.total || 0) - (a.total || 0));
  }

  function mergeApuracao(monthPacks) {
    const keys = ['icms', 'icmsSt', 'pis', 'cofins', 'ipi'];
    const ap = {};
    keys.forEach((k) => {
      ap[k] = {
        debitoSaidas: 0, creditoEntradas: 0, outrosDebitos: 0, outrosCreditos: 0,
        saldoDevedor: 0, saldoCredor: 0, aRecolher: 0, saldoCredorTransportar: 0,
      };
      monthPacks.forEach((pack) => {
        const src = pack.apuracao && pack.apuracao[k] ? pack.apuracao[k] : {};
        Object.keys(ap[k]).forEach((field) => {
          ap[k][field] += src[field] || 0;
        });
      });
      Object.keys(ap[k]).forEach((field) => {
        ap[k][field] = Math.round(ap[k][field] * 100) / 100;
      });
    });
    return ap;
  }

  function buildImpostosTabelaFromAp(ap) {
    return [
      { tributo: 'ICMS', apurado: ap.icms.debitoSaidas, recolher: ap.icms.aRecolher, chip: 'bl' },
      { tributo: 'ICMS ST', apurado: ap.icmsSt.debitoSaidas, recolher: ap.icmsSt.aRecolher, chip: 'pu' },
      { tributo: 'PIS', apurado: ap.pis.debitoSaidas, recolher: ap.pis.aRecolher, chip: 'gr' },
      { tributo: 'COFINS', apurado: ap.cofins.debitoSaidas, recolher: ap.cofins.aRecolher, chip: 'ye' },
      { tributo: 'IPI', apurado: ap.ipi.debitoSaidas, recolher: ap.ipi.aRecolher, chip: 'or' },
    ];
  }

  function buildFiscalTotalPack() {
    const fp = getFiscal();
    const monthPacks = (fp.meses || []).map((m) => fp.porMes && fp.porMes[m]).filter(Boolean);
    if (!monthPacks.length) return null;
    const ap = mergeApuracao(monthPacks);
    const receitaBruta = monthPacks.reduce((a, p) => a + (p.receitaBruta || 0), 0);
    const totalCompras = monthPacks.reduce((a, p) => a + (p.totalCompras || 0), 0);
    const deducoes = monthPacks.reduce((a, p) => a + (p.deducoes || 0), 0);
    const dedPct = receitaBruta > 0 ? Math.round(deducoes / receitaBruta * 10000) / 100 : 0;
    return {
      competencia: 'total',
      competenciaLabel: fiscalPeriodTotalLabel(),
      receitaBruta: Math.round(receitaBruta * 100) / 100,
      totalCompras: Math.round(totalCompras * 100) / 100,
      deducoes: Math.round(deducoes * 100) / 100,
      dedPct: dedPct,
      composicao: [
        { label: 'ICMS', valor: ap.icms.aRecolher },
        { label: 'ICMS ST', valor: ap.icmsSt.aRecolher },
        { label: 'PIS', valor: ap.pis.aRecolher },
        { label: 'COFINS', valor: ap.cofins.aRecolher },
        { label: 'IPI', valor: ap.ipi.aRecolher },
      ],
      impostosTabela: buildImpostosTabelaFromAp(ap),
      apuracao: ap,
      cfopEntradas: mergeCfopEntradas(monthPacks),
      cfopSaidas: monthPacks[monthPacks.length - 1].cfopSaidas || [],
      cfopSaidasTotal: monthPacks.reduce((a, p) => a + (p.cfopSaidasTotal || 0), 0),
      sped: monthPacks[monthPacks.length - 1].sped || {},
    };
  }

  function validateComprasPack(pack) {
    const cfops = pack.cfopEntradas || [];
    const sum = cfops.reduce((a, c) => a + (c.total || 0), 0);
    const total = pack.totalCompras || 0;
    return { ok: Math.abs(sum - total) < 0.02, sum: sum, total: total, n: cfops.length };
  }

  function validateApuracaoPack(pack) {
    const ap = pack.apuracao || {};
    const keys = ['icms', 'icmsSt', 'pis', 'cofins', 'ipi'];
    let taxOk = true;
    keys.forEach((k) => {
      const t = ap[k];
      if (!t) return;
      const cred = (t.creditoEntradas || 0) + (t.outrosCreditos || 0);
      const deb = (t.debitoSaidas || 0) + (t.outrosDebitos || 0);
      if (deb > 0 && Math.abs(deb - cred - (t.aRecolher || 0)) > 2) taxOk = false;
    });
    const sumRec = keys.reduce((a, k) => a + ((ap[k] && ap[k].aRecolher) || 0), 0);
    const dedOk = Math.abs(sumRec - (pack.deducoes || 0)) < 0.02;
    return { ok: taxOk && dedOk, sumRec: sumRec, deducoes: pack.deducoes || 0 };
  }

  function setFiscalDataStatus(elId, result, okMsg, failMsg) {
    const el = document.getElementById(elId);
    if (!el) return;
    if (result.ok) {
      el.className = 'fiscal-data-status ok';
      el.innerHTML = '<i class="fas fa-check-circle"></i> ' + okMsg;
    } else {
      el.className = 'fiscal-data-status warn';
      el.innerHTML = '<i class="fas fa-exclamation-triangle"></i> ' + failMsg;
    }
  }

  function buildFiscalTabMesBar(containerId) {
    const fp = getFiscal();
    buildMesBar(containerId, {
      meses: fp.meses,
      mesLabels: fp.mesLabels,
      defaultKey: appMesFiscal || fp.meses[fp.meses.length - 1],
      showTotal: true,
      totalLabel: 'Total',
      onSelect: (m) => setAppMesFiscal(m),
      skipInitialSelect: true,
      valueFn: valueFnForFiscalBar(containerId),
    });
  }

  function renderComprasEvolutionChart() {
    const fp = getFiscal();
    const labels = fp.mesLabels || fp.meses;
    const data = (fp.meses || []).map((m) => {
      const p = fp.porMes && fp.porMes[m];
      return p ? +(p.totalCompras / 1000).toFixed(1) : 0;
    });
    const evSub = document.getElementById('cp-chart-sub-ev');
    if (evSub) {
      evSub.textContent = fp.meses.length > 1
        ? 'Evolucao mensal de compras (R$ mil) \u2014 livros ICMS'
        : 'Total de entradas (R$ mil) \u2014 ' + (labels[0] || fp.meses[0]);
    }
    safeChart('chartComprasEv', {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [{ label: 'R$ mil', data: data, backgroundColor: 'rgba(34,163,41,0.7)', borderRadius: 5 }],
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { ...tip(), callbacks: { label: (c) => 'R$ ' + (c.parsed.y * 1000).toLocaleString('pt-BR') } } },
        scales: { y: { ticks: { callback: (v) => 'R$' + v + 'K' }, grid: { color: 'rgba(255,255,255,0.05)' } }, x: { grid: { display: false } } },
      },
    });
  }

  function fiscalMesLabel(mesKey) {
    const fp = getFiscal();
    const i = fp.meses.indexOf(mesKey);
    if (i >= 0) return fp.mesLabels[i];
    const m = D().margens;
    if (m && m.meses) {
      const j = m.meses.indexOf(mesKey);
      if (j >= 0 && m.mesLabels) return m.mesLabels[j];
    }
    return mesKey;
  }

  function setMesBarActive(containerId, mesKey) {
    const bar = document.getElementById(containerId);
    if (!bar) return;
    bar.querySelectorAll('.vd-mes-chip').forEach((chip) => {
      chip.classList.toggle('active', chip.getAttribute('data-mes') === mesKey);
    });
  }

  function syncFiscalMesBars(mesKey) {
    FISCAL_MES_BAR_IDS.forEach((id) => setMesBarActive(id, mesKey));
  }

  function chipValueHtml(label, value) {
    const lbl = '<span class="vd-mes-chip-lbl">' + label + '</span>';
    if (value == null || value === '' || (typeof value === 'number' && isNaN(value))) return lbl;
    return lbl + '<span class="vd-mes-chip-val">' + fmtK(value) + '</span>';
  }

  function fiscalMetricValue(mesKey, metric) {
    const pack = getFiscalPack(mesKey);
    if (!pack) return null;
    const v = pack[metric];
    return v == null || isNaN(v) ? null : Number(v);
  }

  function sumDreReceita(keys) {
    const dre = D().dre;
    if (!dre || !dre.porMes) return null;
    let sum = 0;
    let n = 0;
    keys.forEach((k) => {
      const t = dre.porMes[k] && dre.porMes[k].totais;
      if (t && t.receita != null) {
        sum += t.receita;
        n += 1;
      }
    });
    return n ? sum : null;
  }

  function dreMetricValue(mesKey) {
    const dre = D().dre;
    if (!dre) return null;
    if (mesKey === 'total') return sumDreReceita(dre.meses || []);
    if (mesKey === 'q1' || mesKey === 'q2') {
      const keys = (dre.meses || []).filter((m) => {
        const mm = mmOfKey(m);
        return mesKey === 'q1' ? ['01', '02', '03'].includes(mm) : !['01', '02', '03'].includes(mm);
      });
      return sumDreReceita(keys);
    }
    const t = dre.porMes && dre.porMes[mesKey] && dre.porMes[mesKey].totais;
    return t && t.receita != null ? t.receita : null;
  }

  function mapaMetricValue(mesKey) {
    const mapa = D().mapaAgrupamento;
    if (!mapa || !mapa.totaisPorMes) return null;
    if (mesKey === 'total') {
      return (mapa.meses || []).reduce((a, m) => a + (mapa.totaisPorMes[m] || 0), 0);
    }
    if (mesKey === 'q1' || mesKey === 'q2') {
      const keys = (mapa.meses || []).filter((m) => {
        const mm = mmOfKey(m);
        return mesKey === 'q1' ? ['01', '02', '03'].includes(mm) : !['01', '02', '03'].includes(mm);
      });
      return keys.reduce((a, m) => a + (mapa.totaisPorMes[m] || 0), 0);
    }
    return mapa.totaisPorMes[mesKey] != null ? mapa.totaisPorMes[mesKey] : null;
  }

  function margensMetricValue(mesKey) {
    const pack = getMargensPack(mesKey);
    if (!pack || !pack.totais) return null;
    return pack.totais.vendas != null ? pack.totais.vendas : null;
  }

  const FISCAL_BAR_METRIC = {
    'vg-mes-bar': 'receitaBruta',
    'vd-fiscal-mes-bar': 'receitaBruta',
    'cp-mes-bar': 'totalCompras',
    'fn-mes-bar': 'totalCompras',
    'tax-mes-bar': 'deducoes',
    'mem-mes-bar': 'deducoes',
  };

  function valueFnForFiscalBar(containerId) {
    if (containerId === 'dre-mes-bar') return (key) => dreMetricValue(key);
    const metric = FISCAL_BAR_METRIC[containerId];
    if (!metric) return null;
    return (key) => fiscalMetricValue(key, metric);
  }

  function buildMesBar(containerId, options) {
    const bar = document.getElementById(containerId);
    if (!bar) return;
    const meses = options.meses || [];
    const mesLabels = options.mesLabels || meses;
    const q1 = meses.filter((m) => ['01', '02', '03'].includes(mmOfKey(m)));
    const q2 = meses.filter((m) => !q1.includes(m));
    const trimCtx = activeTrimContextSchu();
    const valueFn = typeof options.valueFn === 'function' ? options.valueFn : null;
    const showTrim = options.showTrim !== false;
    bar.innerHTML = '';

    const addBtn = (key, label, extras) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      const classes = ['vd-mes-chip'];
      if (extras) classes.push(extras);
      const isMonth = meses.includes(key);
      if (isMonth) {
        if (trimCtx === 'q1' && q1.includes(key)) classes.push('in-trim');
        if (trimCtx === 'q2' && q2.includes(key)) classes.push('in-trim');
        if (trimCtx === 'q1' && q2.includes(key)) classes.push('dim');
        if (trimCtx === 'q2' && q1.includes(key)) classes.push('dim');
      }
      btn.className = classes.join(' ');
      btn.setAttribute('data-mes', key);
      const val = valueFn ? valueFn(key) : null;
      btn.innerHTML = chipValueHtml(label, val);
      btn.title = label + (val != null && !isNaN(val) ? ' — ' + fmtK(val) : '');
      btn.onclick = () => {
        if (options.syncGlobal) setAppMesFiscal(key);
        else if (options.onSelect) options.onSelect(key);
      };
      bar.appendChild(btn);
    };
    const sep = () => {
      const s = document.createElement('span');
      s.className = 'vd-mes-sep';
      s.textContent = '|';
      bar.appendChild(s);
    };

    if (options.showTotal !== false && meses.length) {
      addBtn(options.totalKey || 'total', options.totalLabel || 'Total', 'tot');
    }
    if (showTrim && q1.length) {
      sep();
      addBtn('q1', '1º Trim', 'tot');
      q1.forEach((m) => {
        const i = meses.indexOf(m);
        addBtn(m, mesLabels[i] || m, '');
      });
    }
    if (showTrim && q2.length) {
      sep();
      addBtn('q2', '2º Trim', 'tot');
      q2.forEach((m) => {
        const i = meses.indexOf(m);
        addBtn(m, mesLabels[i] || m, '');
      });
    }
    if (!showTrim || (!q1.length && !q2.length)) {
      if (!showTrim) {
        meses.forEach((m, i) => addBtn(m, mesLabels[i] || m, ''));
      } else if (!q1.length && !q2.length) {
        meses.forEach((m, i) => addBtn(m, mesLabels[i] || m, ''));
      }
    }

    const active = options.defaultKey || meses[meses.length - 1];
    setMesBarActive(containerId, active);
    if (options.syncGlobal) {
      if (!appMesFiscal) appMesFiscal = active;
    } else if (options.onSelect && !options.skipInitialSelect) {
      options.onSelect(active);
    }
  }

  function buildFiscalMesBar(containerId, onSelect, skipInitialSelect) {
    const fp = getFiscal();
    buildMesBar(containerId, {
      meses: fp.meses,
      mesLabels: fp.mesLabels,
      defaultKey: appMesFiscal || fp.meses[fp.meses.length - 1],
      showTotal: true,
      totalLabel: 'Total',
