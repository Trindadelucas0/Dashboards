function resolveDreKeys(mesKey) {
    const dreData = D().dre || {};
    const dreMeses = dreData.meses || [];
    if (mesKey === 'total') return { keys: dreMeses.slice(), lbl: fiscalPeriodTotalLabel(), active: 'total' };
    if (mesKey === 'q1' || mesKey === 'q2') {
      const keys = dreMeses.filter((m) => {
        const mm = mmOfKey(m);
        return mesKey === 'q1' ? ['01', '02', '03'].includes(mm) : !['01', '02', '03'].includes(mm);
      });
      return {
        keys: keys,
        lbl: mesKey === 'q1' ? '1º Trimestre 2026' : '2º Trimestre 2026',
        active: mesKey,
      };
    }
    if (mesKey && dreData.porMes && dreData.porMes[mesKey]) {
      const i = dreMeses.indexOf(mesKey);
      return {
        keys: [mesKey],
        lbl: (i >= 0 && dreData.mesLabels) ? dreData.mesLabels[i] : mesKey,
        active: mesKey,
      };
    }
    const fallback = dreMeses.length ? dreMeses[dreMeses.length - 1] : mesKey;
    const i = dreMeses.indexOf(fallback);
    return {
      keys: fallback ? [fallback] : [],
      lbl: (i >= 0 && dreData.mesLabels) ? dreData.mesLabels[i] : fiscalMesLabel(fallback),
      active: fallback,
    };
  }

  function buildDreAggregate(keys) {
    const dreData = D().dre || {};
    const packs = keys.map((k) => dreData.porMes && dreData.porMes[k]).filter(Boolean);
    if (!packs.length) return null;
    if (packs.length === 1) return packs[0];
    const lineMap = {};
    const order = [];
    packs.forEach((p) => {
      (p.linhas || []).forEach((ln) => {
        if (!ln.descricao) return;
        if (!lineMap[ln.descricao]) {
          lineMap[ln.descricao] = { descricao: ln.descricao, valor: 0 };
          order.push(ln.descricao);
        }
        lineMap[ln.descricao].valor += ln.valor || 0;
      });
    });
    const totais = { receita: 0, cmv: 0, lucroBruto: 0, lucroLiquido: 0 };
    packs.forEach((p) => {
      const t = p.totais || {};
      totais.receita += t.receita || 0;
      totais.cmv += t.cmv || 0;
      totais.lucroBruto += t.lucroBruto || 0;
      totais.lucroLiquido += t.lucroLiquido || 0;
    });
    totais.margemBrutaPct = totais.receita > 0 ? (totais.lucroBruto / totais.receita) * 100 : 0;
    totais.margemLiquidaPct = totais.receita > 0 ? (totais.lucroLiquido / totais.receita) * 100 : 0;
    return {
      linhas: order.map((d) => lineMap[d]),
      totais: totais,
      arquivo: 'soma ' + keys.length + ' competencias',
    };
  }

function renderDRE(mesKey) {
    const dreData = D().dre || {};
    const resolved = resolveDreKeys(mesKey);
    const lbl = resolved.lbl;
    const active = resolved.active;
    setText('#dre-sec-competencia', lbl);
    setMesBarActive('dre-mes-bar', active);
    const pack = getFiscalPack(active === 'total' || active === 'q1' || active === 'q2' ? active : resolved.keys[0]);
    const el = document.getElementById('dre-carga-trib');
    if (el && pack) el.textContent = pack.dedPct.toFixed(2) + '%';
    else if (el) el.textContent = '—';
    const alertBox = document.getElementById('dre-alert-box');
    const tbody = document.getElementById('dre-tbody');
    if (!tbody) return;
    const drePack = buildDreAggregate(resolved.keys);
    if (drePack && drePack.linhas && drePack.linhas.length) {
      if (alertBox) alertBox.style.display = 'none';
      setText('#dre-sec-sub', 'DRE contabil — ' + lbl + (drePack.arquivo ? ' (' + drePack.arquivo + ')' : ''));
      setText('#dre-table-sub', 'Fonte CONTABIL/DRE' + (drePack.dataRef ? ' | Ref. ' + drePack.dataRef : ''));
      tbody.innerHTML = '';
      drePack.linhas.forEach((ln) => {
        if (!ln.descricao) return;
        const tr = document.createElement('tr');
        const neg = ln.valor < 0 ? ' dre-neg' : '';
        tr.innerHTML = '<td>' + ln.descricao + '</td><td class="r td-val' + neg + '">R$ ' + fmt(ln.valor) + '</td>';
        tbody.appendChild(tr);
      });
      const t = drePack.totais || {};
      if (t.margemBrutaPct != null) {
        setHTML('#dre-marg-bruta', t.margemBrutaPct.toFixed(2) + '%');
        setText('#dre-marg-bruta-sub', 'Lucro bruto / Receita operacional');
      }
      if (t.margemLiquidaPct != null) {
        setHTML('#dre-marg-liq', t.margemLiquidaPct.toFixed(2) + '%');
        setText('#dre-marg-liq-sub', 'Resultado antes provisoes / Receita');
      }
    } else {
      if (alertBox) alertBox.style.display = '';
      tbody.innerHTML = '<tr><td colspan="2" class="td-mute" style="text-align:center;padding:32px;">Aguardando arquivo DRE em CONTABIL/DRE/ para ' + lbl + '</td></tr>';
    }
  }

  function initDRE() {
    const dre = D().dre || {};
    const meses = (dre.meses && dre.meses.length) ? dre.meses : getFiscal().meses;
    const labels = (dre.mesLabels && dre.mesLabels.length) ? dre.mesLabels : getFiscal().mesLabels;
    const defaultKey = (dre.meses && dre.meses.length)
      ? dre.meses[dre.meses.length - 1]
      : (appMesFiscal || getFiscal().meses[getFiscal().meses.length - 1]);
    buildMesBar('dre-mes-bar', {
      meses: meses,
      mesLabels: labels,
      defaultKey: defaultKey,
      syncGlobal: true,
      skipInitialSelect: true,
      valueFn: (key) => dreMetricValue(key),
    });
    renderDRE(defaultKey);
  }

  let mapaMesKey = null;

  function renderMapaAgrupamento(mesKey) {
    const mapa = D().mapaAgrupamento;
    const card = document.getElementById('vd-mapa-card');
    const tbody = document.getElementById('vd-mapa-tbody');
    if (!mapa || !mapa.clientes || !mapa.clientes.length) {
      if (card) card.style.display = 'none';
      return;
    }
    if (card) card.style.display = '';
    const meses = mapa.meses || [];
    let keys = [];
    let key = mesKey;
    let lbl = mesKey;
    if (mesKey === 'total') {
      keys = meses.slice();
      lbl = fiscalPeriodTotalLabel();
    } else if (mesKey === 'q1' || mesKey === 'q2') {
      keys = meses.filter((m) => {
        const mm = mmOfKey(m);
        return mesKey === 'q1' ? ['01', '02', '03'].includes(mm) : !['01', '02', '03'].includes(mm);
      });
      lbl = mesKey === 'q1' ? '1º Trimestre 2026' : '2º Trimestre 2026';
    } else if (mesKey && meses.indexOf(mesKey) >= 0) {
      keys = [mesKey];
      const i = meses.indexOf(mesKey);
      lbl = (mapa.mesLabels && mapa.mesLabels[i]) ? mapa.mesLabels[i] : mesKey;
      key = mesKey;
    } else {
      key = meses[meses.length - 1] || null;
      keys = key ? [key] : [];
      const i = meses.indexOf(key);
      lbl = (i >= 0 && mapa.mesLabels) ? mapa.mesLabels[i] : key;
    }
    mapaMesKey = mesKey || key;
    setMesBarActive('vd-mapa-mes-bar', mapaMesKey);
    setText('#vd-mapa-sub', 'Fonte FISCAL/MAPA POR AGRUPAMENTO — ' + (mapa.clientes.length) + ' clientes | ' + lbl);
    setText('#vd-mapa-col-mes', lbl || 'Mes');
    if (!tbody) return;
    tbody.innerHTML = '';
    const ranked = mapa.clientes
      .map((c) => {
        const mesVal = keys.reduce((a, m) => a + ((c.valores && c.valores[m]) || 0), 0);
        return {
          codigo: c.codigo,
          nome: c.nome,
          cidade: c.cidade,
          uf: c.uf,
          total: c.total,
          mesVal: mesVal,
        };
      })
      .filter((c) => c.mesVal > 0 || !keys.length)
      .sort((a, b) => b.mesVal - a.mesVal)
      .slice(0, 25);
    ranked.forEach((c, idx) => {
      const tr = document.createElement('tr');
      const rank = idx < 3 ? ['g1', 'g2', 'g3'][idx] : 'gn';
      tr.innerHTML = '<td><div class="rank ' + rank + '">' + (idx + 1) + '</div></td>'
        + '<td><div class="fw7">' + (c.nome || 'Cliente') + '</div><div class="td-mute">Cod. ' + c.codigo + '</div></td>'
        + '<td>' + (c.cidade || '—') + '</td>'
        + '<td><span class="chip bl">' + (c.uf || '-') + '</span></td>'
        + '<td class="r td-val">R$ ' + fmt(c.mesVal) + '</td>'
        + '<td class="r">R$ ' + fmt(c.total) + '</td>';
      tbody.appendChild(tr);
    });
    if (!ranked.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="td-mute" style="text-align:center;padding:20px;">Sem vendas no mapa para ' + (lbl || 'o periodo') + '</td></tr>';
    }
  }

  function initMapaAgrupamento() {
    const mapa = D().mapaAgrupamento;
    if (!mapa || !mapa.meses || !mapa.meses.length) {
      const card = document.getElementById('vd-mapa-card');
      if (card) card.style.display = 'none';
      return;
    }
    buildMesBar('vd-mapa-mes-bar', {
      meses: mapa.meses,
      mesLabels: mapa.mesLabels || mapa.meses,
      defaultKey: mapa.meses[mapa.meses.length - 1],
      onSelect: (m) => renderMapaAgrupamento(m),
      valueFn: (key) => mapaMetricValue(key),
    });
    renderMapaAgrupamento(mapa.meses[mapa.meses.length - 1]);
  }

  function setPatrimDot(id, cls) {
    const el = document.getElementById(id);
    if (el) el.className = 'dot ' + cls;
  }

  function renderIndicadoresPatrimoniais(mesKey) {
    const pat = D().indicadoresPatrimoniais;
    if (!pat || !pat.porMes) return;
    const key = mesKey || pat.mesRef;
    const pack = key ? pat.porMes[key] : null;
    if (!pack) return;
    const c = pack.componentes || {};
    const bal = D().balancete;
    let lbl = key;
    if (bal && bal.meses) {
      const i = bal.meses.indexOf(key);
      if (i >= 0 && bal.mesLabels) lbl = bal.mesLabels[i];
    }
    setMesBarActive('ind-patrim-mes-bar', key);
    setText('#ind-patrim-sub', 'Balancete ' + lbl + (pack.dataRef ? ' | Ref. ' + pack.dataRef : ''));

    if (pack.liquidezCorrente != null) {
      setHTML('#ind-lc-val', pack.liquidezCorrente.toFixed(2).replace('.', ','));
      setHTML('#ind-lc-formula', 'LC = ' + fmt(c.ativoCirculante) + ' / ' + fmt(c.passivoCirculante) + ' = ' + pack.liquidezCorrente.toFixed(2).replace('.', ','));
      setPatrimDot('ind-lc-dot', pack.liquidezCorrente >= 1.5 ? 'gr' : pack.liquidezCorrente >= 1 ? 'ye' : 'rd');
    }
    if (pack.liquidezSeca != null) {
      setHTML('#ind-ls-val', pack.liquidezSeca.toFixed(2).replace('.', ','));
      setHTML('#ind-ls-formula', 'LS = (' + fmt(c.ativoCirculante) + ' - ' + fmt(c.estoque) + ') / ' + fmt(c.passivoCirculante));
      setPatrimDot('ind-ls-dot', pack.liquidezSeca >= 1 ? 'gr' : pack.liquidezSeca >= 0.7 ? 'ye' : 'rd');
    }
    if (pack.capitalGiro != null) {
      setHTML('#ind-cg-val', 'R$ ' + fmt(pack.capitalGiro));
      setHTML('#ind-cg-formula', 'CG = ' + fmt(c.ativoCirculante) + ' - ' + fmt(c.passivoCirculante));
      setPatrimDot('ind-cg-dot', pack.capitalGiro > 0 ? 'gr' : 'rd');
    }
    if (pack.grauEndividamento != null) {
      setHTML('#ind-end-val', pack.grauEndividamento.toFixed(2).replace('.', ',') + '%');
      setHTML('#ind-end-formula', 'END = ' + fmt(c.passivoTotal) + ' / ' + fmt(c.ativoTotal) + ' = ' + pack.grauEndividamento.toFixed(2).replace('.', ',') + '%');
      setPatrimDot('ind-end-dot', pack.grauEndividamento < 60 ? 'gr' : pack.grauEndividamento <= 80 ? 'ye' : 'rd');
    }
  }

function renderIndicadoresFiscal(mesKey) {
    const pack = getFiscalPack(mesKey);
    const lbl = fiscalMesLabel(mesKey);
    const marg = D().margens && D().margens.porMes ? D().margens.porMes[mesKey] : null;
    const margLbl = (() => {
      const m = D().margens;
      if (m && m.meses) {
        const i = m.meses.indexOf(mesKey);
        if (i >= 0 && m.mesLabels) return m.mesLabels[i];
      }
      return lbl;
    })();
    const empresa = D().empresa;

    setText('#ind-header-period', lbl.replace('/', ' / '));
    setText('#ind-margens-period', 'Margens Gerenciais — ' + margLbl);
    setText('#ind-fiscal-period', 'Carga Tributaria Fiscal — ' + lbl);

    if (pack) {
      setHTML('#ind-alert-text', 'Carga tributaria fiscal de <strong id="ind-alert-period">' + lbl + '</strong>. Margens gerenciais abaixo via Demonstrativo de Margens (nao DRE contabil).');
    } else {
      setHTML('#ind-alert-text', 'Margens gerenciais de <strong id="ind-alert-period">' + margLbl + '</strong>. Carga tributaria fiscal indisponivel — livros ENTRADA-SAIDA nao fornecidos para esta competencia.');
    }

    if (marg && marg.totais) {
      const t = marg.totais;
      setHTML('#ind-marg-bruta', t.margemBrutaPct.toFixed(2) + '%');
      setHTML('#ind-marg-liq', t.margemLiquidaPct.toFixed(2) + '%');
      setHTML('#ind-marg-bruta-formula', 'Lucro bruto R$ ' + fmt(t.lucroBruto) + ' / Vendas R$ ' + fmt(t.vendas));
      setHTML('#ind-marg-liq-formula', 'Lucro liq. R$ ' + fmt(t.lucroLiquido) + ' / Vendas R$ ' + fmt(t.vendas));
      setText('#ind-marg-liq-interp', 'Fonte: Demonstrativo Margens de Venda — ' + margLbl + '.');
    } else {
      setHTML('#ind-marg-bruta', '<span class="td-mute">—</span>');
      setHTML('#ind-marg-liq', '<span class="td-mute">—</span>');
      setHTML('#ind-marg-bruta-formula', 'Demonstrativo de Margens indisponivel para ' + margLbl);
      setHTML('#ind-marg-liq-formula', '—');
      setText('#ind-marg-liq-interp', 'Fonte: Demonstrativo Margens de Venda — sem dados para ' + margLbl + '.');
    }

    if (!pack) {
      setHTML('#ind-ded-pct', '<span class="td-mute">—</span>');
      setHTML('#ind-ded-total', '<span class="td-mute">—</span>');
      setHTML('#ind-ded-formula', 'Livro ENTRADA-SAIDA indisponivel para ' + lbl);
      setHTML('#ind-rb-formula', '—');
      setText('#ind-ded-interp', 'Dados fiscais disponiveis apenas para competencias com livros ENTRADA-SAIDA fornecidos.');
      const grid = document.getElementById('ind-tributos-grid');
      if (grid) {
        grid.innerHTML = '<div class="ind-card" style="grid-column:1/-1;opacity:0.7;"><div class="ind-interp" style="border:none;padding:0;">Sem composicao fiscal para ' + lbl + '.</div></div>';
      }
      setMesBarActive('ind-fiscal-mes-bar', mesKey);
      return;
    }

    const rb = pack.receitaBruta;
    const ded = pack.deducoes;
    const dedPct = pack.dedPct;
    setHTML('#ind-ded-pct', dedPct.toFixed(2) + '%');
    setHTML('#ind-ded-total', 'R$ ' + fmt(ded));
    setHTML('#ind-ded-formula', 'Ded% = ' + fmt(ded) + ' / ' + fmt(rb));
    setHTML('#ind-rb-formula', 'RB = R$ ' + fmt(rb) + ' (livro ICMS ' + lbl + ')');
    setText('#ind-ded-interp', 'Competencia ' + lbl + ' — ' + (empresa.nome || 'Empresa') + ' (' + (empresa.uf || 'PR') + ').');
    const grid = document.getElementById('ind-tributos-grid');
    if (grid) {
      grid.innerHTML = '';
      pack.composicao.filter((c) => c.valor > 0).forEach((c) => {
        const p = rb > 0 ? ((c.valor / rb) * 100).toFixed(2) : '0.00';
        const card = document.createElement('div');
        card.className = 'ind-card';
        card.innerHTML = '<div class="ind-head"><div class="ind-name">' + c.label + '</div><span class="dot gr"></span></div><div class="ind-val t-accent">R$ ' + fmt(c.valor) + '</div><div class="ind-formula">' + p + '% s/ Receita Bruta</div><div class="ind-interp">A recolher — livro ENTRADA-SAIDA ' + c.label + ' ' + lbl + '.</div>';
        grid.appendChild(card);
      });
    }
    setMesBarActive('ind-fiscal-mes-bar', mesKey);
  }

  function initIndicadores() {
    const data = D();
    const marg = data.margens;
    const indMeses = marg && marg.meses && marg.meses.length ? marg.meses.slice() : getFiscal().meses.slice();
    const indLabels = marg && marg.mesLabels ? marg.mesLabels.slice() : getFiscal().mesLabels.slice();
    const defaultKey = data.competencia && indMeses.indexOf(data.competencia) >= 0
      ? data.competencia
      : indMeses[indMeses.length - 1];

    buildMesBar('ind-fiscal-mes-bar', {
      meses: indMeses,
      mesLabels: indLabels,
      defaultKey: defaultKey,
      onSelect: (m) => {
        indMesKey = m;
        renderIndicadoresFiscal(m);
      },
      valueFn: (key) => fiscalMetricValue(key, 'receitaBruta'),
    });
    indMesKey = defaultKey;
    renderIndicadoresFiscal(defaultKey);
    const pat = data.indicadoresPatrimoniais;
    const bal = data.balancete;
    if (pat && pat.meses && pat.meses.length) {
      buildMesBar('ind-patrim-mes-bar', {
        meses: pat.meses,
        mesLabels: pat.meses.map((m, i) => (bal && bal.mesLabels && bal.mesLabels[i]) ? bal.mesLabels[i] : m),
        defaultKey: pat.mesRef || pat.meses[pat.meses.length - 1],
        showTotal: false,
        showTrim: false,
        onSelect: (m) => {
          patrimMesKey = m;
          renderIndicadoresPatrimoniais(m);
        },
      });
      patrimMesKey = pat.mesRef || pat.meses[pat.meses.length - 1];
      renderIndicadoresPatrimoniais(patrimMesKey);
    } else {
      const bar = document.getElementById('ind-patrim-mes-bar');
      if (bar) bar.innerHTML = '<span class="td-mute" style="font-size:12px;">Balancete indisponivel</span>';
    }

    const margMeses = data.margens && data.margens.meses ? data.margens.meses : [];
    const margLabels = data.margens && data.margens.mesLabels ? data.margens.mesLabels : margMeses;
    const margBruta = margMeses.map((m) => (data.margens.porMes[m] && data.margens.porMes[m].totais ? data.margens.porMes[m].totais.margemBrutaPct : null));
    const margLiq = margMeses.map((m) => (data.margens.porMes[m] && data.margens.porMes[m].totais ? data.margens.porMes[m].totais.margemLiquidaPct : null));
    const fp = getFiscal();
    const dedSeries = fp.meses.map((m) => (fp.porMes[m] ? fp.porMes[m].dedPct : null));

    safeChart('chartIndicadores', {
      type: 'line',
      data: {
        labels: margLabels.length ? margLabels : data.months,
        datasets: [
          { label: 'Deducoes % s/ RB (fiscal)', data: dedSeries.length ? dedSeries : data.dedPct, borderColor: PAL[4], borderWidth: 2, pointRadius: 4, tension: 0.3 },
          { label: 'Margem bruta % (gerencial)', data: margBruta, borderColor: PAL[0], borderWidth: 2, pointRadius: 4, tension: 0.3 },
          { label: 'Margem liquida % (gerencial)', data: margLiq, borderColor: PAL[1], borderWidth: 2, pointRadius: 4, tension: 0.3 },
        ],
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: leg() }, scales: { y: { ticks: { callback: (v) => v + '%' } } } },
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof DASHBOARD_DATA === 'undefined') {
      console.error('DASHBOARD_DATA nao carregado. Verifique data/schumacher-data.js');
      return;
    }
    applyBranding();
    initPeriodSelector();
    const vgAlert = document.getElementById('vg-fontes-alert');
    if (vgAlert) vgAlert.textContent = DASHBOARD_DATA.empresa.nome;
    window.showTab('visao-geral');
  });
  window.chartInst = chartInst;
  window.SchumacherDashboard = {
    getActiveFiscalPack: () => getFiscalPack(appMesFiscal),
    getActiveCompetenciaLabel: () => fiscalDisplayLabel(appMesFiscal),
    refreshActiveTab: () => rerenderActiveFiscalTab(),
  };
})();

</script>
<script>
/* Relatório Gerencial — motor PDF compartilhado (snapshot normalizado) */
(function (global) {
  'use strict';

  const MARGIN = 14;
  const HEADER_H = 14;
  const FOOTER_H = 10;
  const PAGE_W = 210;
  const CONTENT_W = PAGE_W - MARGIN * 2;

  const fmt = (v) => (v == null || isNaN(v) ? '—' : Number(v).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
  const fmtK = (v) => {
    if (v == null || isNaN(v)) return '—';
    const n = Number(v);
    if (Math.abs(n) >= 1e6) return 'R$ ' + (n / 1e6).toFixed(2).replace('.', ',') + ' mi';
    if (Math.abs(n) >= 1e3) return 'R$ ' + (n / 1e3).toFixed(0) + ' mil';
    return 'R$ ' + fmt(n);
  };
  const fmtPct = (v, digits = 1) => (v == null || isNaN(v) ? '—' : Number(v).toFixed(digits).replace('.', ',') + '%');
  const fmtVar = (v) => {
    if (v == null || isNaN(v)) return '—';
    const n = Number(v);
    const sign = n > 0 ? '+' : '';
    return sign + n.toFixed(0) + '%';
  };
  const fmtMoeda = (v) => (v == null || isNaN(v) ? '—' : 'R$ ' + fmt(v));

  function calcVariacao(atual, anterior) {
    const a = Number(atual) || 0;
    const p = Number(anterior) || 0;
    const abs = a - p;
    const pct = p !== 0 ? (abs / Math.abs(p)) * 100 : (a !== 0 ? 100 : 0);
    return { abs, pct };
  }

  function somaImpostos(impostosTabela) {
    return (impostosTabela || []).reduce((s, t) => s + (t.recolher || 0), 0);
  }

  function agruparComprasPorFinalidade(cfopEntradas, catalog) {
    const map = {};
    const cat = catalog || {};
    (cfopEntradas || []).forEach((c) => {
      const fromMap = cat[c.cfop];
      const fin = (fromMap && fromMap.finalidade) || c.finalidade || c.grupo || 'Outras';
      map[fin] = (map[fin] || 0) + (c.total || c.contabil || 0);
    });
    return Object.entries(map)
      .map(([finalidade, total]) => ({ finalidade, total }))
      .sort((a, b) => b.total - a.total);
  }

  function sortCfop(list) {
    return (list || []).slice().sort((a, b) => (b.total || b.contabil || 0) - (a.total || a.contabil || 0));
  }

  function cfopDesc(c, catalog) {
    const fromMap = (catalog || {})[c.cfop];
    return (fromMap && fromMap.descricao) || c.descricao || ('CFOP ' + c.cfop);
  }

  function createPdfContext(snapshot) {
    const { jsPDF } = global.jspdf;
    const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
    const pageH = pdf.internal.pageSize.getHeight();
    let y = MARGIN + HEADER_H;
    let pageNum = 1;
    const empresaNome = (snapshot.empresa?.nome || 'Empresa').split(' ')[0];
    const periodLabel = snapshot.periodLabel || '';
    const footerNote = snapshot.footerNote
      || ((snapshot.empresa?.nome || 'Empresa') + ' — Relatório gerencial — ' + periodLabel);

    function addHeader() {
      pdf.setFont('helvetica', 'normal');
      pdf.setFontSize(8);
      pdf.setTextColor(100, 116, 139);
      pdf.text(empresaNome + ' — pág. ' + pageNum, MARGIN, MARGIN + 4);
      pdf.setDrawColor(226, 232, 240);
      pdf.line(MARGIN, MARGIN + 7, PAGE_W - MARGIN, MARGIN + 7);
    }

    function addFooter() {
      pdf.setFontSize(7);
      pdf.setTextColor(148, 163, 184);
      pdf.text(footerNote, MARGIN, pageH - 5, { maxWidth: CONTENT_W });
    }

    function newPage() {
      addFooter();
      pdf.addPage();
      pageNum++;
      addHeader();
      y = MARGIN + HEADER_H + 4;
    }

    function ensureSpace(need) {
      if (y + need > pageH - FOOTER_H - MARGIN) newPage();
    }

    function writeTitle(text, size) {
      size = size || 14;
      ensureSpace(12);
      pdf.setFont('helvetica', 'bold');
      pdf.setFontSize(size);
      pdf.setTextColor(30, 41, 59);
      pdf.text(text, MARGIN, y);
      y += size * 0.45 + 4;
    }

    function writeSubtitle(text) {
      ensureSpace(8);
      pdf.setFont('helvetica', 'normal');
      pdf.setFontSize(10);
      pdf.setTextColor(71, 85, 105);
      const lines = pdf.splitTextToSize(String(text || ''), CONTENT_W);
      pdf.text(lines, MARGIN, y);
      y += lines.length * 5 + 2;
    }

    function writeParagraph(text, size) {
      size = size || 9;
      pdf.setFont('helvetica', 'normal');
      pdf.setFontSize(size);
      pdf.setTextColor(51, 65, 85);
      const lines = pdf.splitTextToSize(String(text || ''), CONTENT_W);
      ensureSpace(lines.length * 4 + 4);
      pdf.text(lines, MARGIN, y);
      y += lines.length * 4 + 4;
    }

    function writeSectionLabel(text) {
      ensureSpace(10);
      pdf.setFont('helvetica', 'bold');
      pdf.setFontSize(10);
      pdf.setTextColor(30, 41, 59);
      pdf.text(text, MARGIN, y);
      y += 6;
    }

    function writeBullets(items) {
      pdf.setFont('helvetica', 'normal');
      pdf.setFontSize(9);
      pdf.setTextColor(51, 65, 85);
      (items || []).forEach((item) => {
        const lines = pdf.splitTextToSize('• ' + item, CONTENT_W - 4);
        ensureSpace(lines.length * 4 + 2);
        pdf.text(lines, MARGIN + 2, y);
        y += lines.length * 4 + 2;
      });
      y += 2;
    }

    function addTable(head, body, opts) {
      opts = opts || {};
      ensureSpace(20);
      pdf.autoTable({
        startY: y,
        margin: { top: y, left: MARGIN, right: MARGIN, bottom: FOOTER_H + MARGIN },
        head: [head],
        body,
        theme: 'grid',
        styles: Object.assign({ fontSize: 8, cellPadding: 2, textColor: [51, 65, 85] }, opts.styles || {}),
        headStyles: { fillColor: [241, 245, 249], textColor: [71, 85, 105], fontStyle: 'bold' },
        columnStyles: opts.columnStyles || {},
      });
      y = pdf.lastAutoTable.finalY + 6;
    }

    addHeader();

    return {
      pdf,
      snapshot,
      getY: () => y,
      setY: (v) => { y = v; },
      newPage,
      ensureSpace,
      writeTitle,
      writeSubtitle,
      writeParagraph,
      writeSectionLabel,
      writeBullets,
      addTable,
      addFooter,
      getPageNum: () => pageNum,
    };
  }

  function renderCover(ctx) {
    const s = ctx.snapshot;
    ctx.writeTitle('Relatório Gerencial');
    ctx.writeSubtitle((s.empresa?.nome || 'Empresa') + ' — ' + (s.periodLabel || ''));
    if (s.empresa?.cnpj) ctx.writeParagraph('CNPJ: ' + s.empresa.cnpj, 9);
    if (s.narrativa) {
      ctx.writeSectionLabel('O período em uma frase');
      ctx.writeParagraph(s.narrativa);
    }
  }

  function renderComparativo(ctx) {
    const rc = ctx.snapshot.resultadoComparativo;
    if (!rc || !(rc.rows || []).length) return;
    ctx.newPage();
    ctx.writeTitle(rc.title || 'Resultado do período');
    if (rc.subtitle) ctx.writeParagraph(rc.subtitle);
    const body = rc.rows.map((r) => {
      const v = calcVariacao(r.curr, r.prev);
      return [
        r.linha,
        r.isPct ? fmtPct(r.prev) : fmtMoeda(r.prev),
        r.isPct ? fmtPct(r.curr) : fmtMoeda(r.curr),
        fmtVar(v.pct),
      ];
    });
    ctx.addTable(['Linha', rc.headPrev || 'Anterior', rc.headCurr || 'Atual', 'Var.'], body, {
      columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' }, 3: { halign: 'right' } },
    });
  }

  function renderFiscal(ctx) {
    const s = ctx.snapshot;
    if (!s.fiscal) return;
    ctx.newPage();
    ctx.writeTitle('Visão fiscal e compras — ' + (s.periodLabel || ''));
    const f = s.fiscal;
    const imp = somaImpostos(s.impostosTabela || f.impostosTabela);
    const rows = [
      ['(+) Receita bruta', fmtMoeda(f.receitaBruta)],
      ['(-) Deduções / impostos s/ vendas', fmtMoeda(-(f.deducoes || 0))],
      ['% Carga tributária', fmtPct(f.dedPct)],
      ['(-) Compras do período', fmtMoeda(-(f.totalCompras || 0))],
    ];
    if (f.cfopSaidasTotal != null) rows.push(['(=) Total saídas (CFOP)', fmtMoeda(f.cfopSaidasTotal)]);
    rows.push(['(=) Impostos a recolher (total)', fmtMoeda(imp)]);
    ctx.addTable(['Indicador', 'Valor'], rows, { columnStyles: { 1: { halign: 'right' } } });

    const impostos = s.impostosTabela || f.impostosTabela || [];
    if (impostos.length) {
      ctx.writeSectionLabel('Impostos a recolher por tributo');
      ctx.addTable(['Tributo', 'A recolher', '% RB'], impostos.map((t) => [
        t.tributo,
        fmtMoeda(t.recolher),
        t.pctRb != null ? fmtPct(t.pctRb) : '—',
      ]), { columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' } } });
    }

    const fins = s.comprasFinalidade || [];
    if (fins.length) {
      ctx.writeSectionLabel('Compras por finalidade (CFOP)');
      const top = fins.slice(0, 12);
      const base = f.totalCompras || top.reduce((a, c) => a + c.total, 0) || 1;
      ctx.addTable(['Finalidade', 'Valor', '%'], top.map((c) => [
        c.finalidade,
        fmtMoeda(c.total),
        fmtPct((c.total / base) * 100),
      ]), { columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' } } });
    }
  }

  function renderTops(ctx) {
    const s = ctx.snapshot;
    const hasClientes = (s.topClientes || []).length;
    const hasForn = (s.topFornecedores || []).length;
    const hasEnt = (s.topCfopEntradas || []).length;
    const hasSai = (s.topCfopSaidas || []).length;
    if (!hasClientes && !hasForn && !hasEnt && !hasSai) return;

    ctx.newPage();
    ctx.writeTitle('Rankings do período — ' + (s.periodLabel || ''));

    if (hasClientes) {
      ctx.writeSectionLabel('Top clientes');
      ctx.addTable(['Cliente', 'Total'], s.topClientes.slice(0, 10).map((c) => [
        String(c.nome || '—').substring(0, 48),
        fmtMoeda(c.total),
      ]), { columnStyles: { 1: { halign: 'right' } } });
    }
    if (hasForn) {
      ctx.writeSectionLabel('Top fornecedores');
      ctx.addTable(['Fornecedor', 'Total'], s.topFornecedores.slice(0, 10).map((c) => [
        String(c.nome || '—').substring(0, 48),
        fmtMoeda(c.total),
      ]), { columnStyles: { 1: { halign: 'right' } } });
    }
    if (hasEnt) {
      ctx.writeSectionLabel('Top CFOPs — entradas');
      ctx.addTable(['CFOP', 'Descrição', 'Valor'], s.topCfopEntradas.slice(0, 15).map((c) => [
        c.cfop,
        String(c.descricao || '').substring(0, 42),
        fmtMoeda(c.total),
      ]), {
        styles: { fontSize: 7 },
        columnStyles: { 0: { cellWidth: 16 }, 1: { cellWidth: 100 }, 2: { halign: 'right' } },
      });
    }
    if (hasSai) {
      ctx.writeSectionLabel('Top CFOPs — saídas');
      ctx.addTable(['CFOP', 'Descrição', 'Valor'], s.topCfopSaidas.slice(0, 15).map((c) => [
        c.cfop,
        String(c.descricao || '').substring(0, 42),
        fmtMoeda(c.total),
      ]), {
        styles: { fontSize: 7 },
        columnStyles: { 0: { cellWidth: 16 }, 1: { cellWidth: 100 }, 2: { halign: 'right' } },
      });
    }
  }

  function renderEvolucao(ctx) {
    const s = ctx.snapshot;
    if (!(s.evolucaoMensal || []).length) return;
    ctx.newPage();
    ctx.writeTitle(s.evolucaoTitle || 'Evolução mensal');
    if (s.evolucaoSubtitle) ctx.writeParagraph(s.evolucaoSubtitle);
    const body = s.evolucaoMensal.map((m) => [
      m.label,
      fmtMoeda(m.vendas),
      fmtMoeda(m.lucroLiquido != null ? m.lucroLiquido : m.receitaBruta),
      m.margemLiquidaPct != null ? fmtPct(m.margemLiquidaPct) : (m.dedPct != null ? fmtPct(m.dedPct) : '—'),
    ]);
    if (s.consolidado) {
      body.push([
        'Acum.',
        fmtMoeda(s.consolidado.vendas),
        fmtMoeda(s.consolidado.lucroLiquido),
        fmtPct(s.consolidado.margemLiquidaPct),
      ]);
    }
    ctx.addTable(
      ['Mês', s.evolucaoCol2 || 'Vendas', s.evolucaoCol3 || 'Lucro líq.', s.evolucaoCol4 || 'Margem %'],
      body,
      { columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' }, 3: { halign: 'right' } } }
    );
  }

  function renderLeitura(ctx) {
    const s = ctx.snapshot;
    if (!(s.leitura || []).length && !(s.acoes || []).length) return;
    ctx.newPage();
    ctx.writeTitle('Leitura integrada');
    (s.leitura || []).forEach((p) => ctx.writeParagraph(p));
    if ((s.acoes || []).length) {
      ctx.writeSectionLabel('Para onde olhar no próximo período');
      ctx.writeBullets(s.acoes);
    }
  }

  function renderResumoAcumulado(ctx) {
    const s = ctx.snapshot;
    if (!s.consolidado && !(s.alertasMargem && s.alertasMargem.total)) return;
    ctx.newPage();
    ctx.writeTitle('Resumo executivo acumulado');
    if (s.resumoAcumuladoSubtitle) ctx.writeSubtitle(s.resumoAcumuladoSubtitle);
    if (s.consolidado) {
      const c = s.consolidado;
      ctx.addTable(['Indicador', 'Valor', '%'], [
        ['Faturamento (vendas)', fmtMoeda(c.vendas), '100%'],
        ['Lucro bruto', fmtMoeda(c.lucroBruto), c.vendas ? fmtPct((c.lucroBruto / c.vendas) * 100) : '—'],
        ['Lucro líquido', fmtMoeda(c.lucroLiquido), fmtPct(c.margemLiquidaPct)],
        ['Margem bruta', fmtPct(c.margemBrutaPct), '—'],
        ['Margem líquida', fmtPct(c.margemLiquidaPct), '—'],
      ], { columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' } } });
    }
    if (s.alertasMargem && s.alertasMargem.total > 0) {
      ctx.writeSectionLabel(s.alertasMargem.label || 'Alertas de margem');
      ctx.addTable(['Produto', 'Vendas', 'Margem líq. %'], (s.alertasMargem.emAtencao || []).slice(0, 10).map((p) => [
        String(p.nome || p.descricao || '—').substring(0, 45),
        fmtMoeda(p.total),
        fmtPct(p.margemLiquidaPct),
      ]), { columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' } } });
    }
  }

  function renderMediaDetalhe(ctx) {
    const s = ctx.snapshot;
    if (!s.mediaMensal && !(s.evolucaoMensal || []).length) return;
    if (!s.mediaMensal && !s.showEvolucaoDetalhada) return;
    ctx.newPage();
    ctx.writeTitle('Média mensal e evolução detalhada');
    if (s.mediaMensal) {
      if (s.mediaMensalNote) ctx.writeParagraph(s.mediaMensalNote);
      ctx.addTable(['Indicador', 'Média mensal'], [
        ['Vendas', fmtMoeda(s.mediaMensal.vendas)],
        ['Lucro líquido', fmtMoeda(s.mediaMensal.lucroLiquido)],
        ['Margem líquida', fmtPct(s.mediaMensal.margemLiquidaPct)],
        ['Margem bruta', fmtPct(s.mediaMensal.margemBrutaPct)],
      ], { columnStyles: { 1: { halign: 'right' } } });
    }
    if (s.showEvolucaoDetalhada && (s.evolucaoMensal || []).length) {
      ctx.writeSectionLabel('Evolução mensal detalhada');
      const body = s.evolucaoMensal.map((m) => [
        m.label,
        fmtMoeda(m.vendas),
        fmtMoeda(m.custo),
        fmtMoeda(m.lucroBruto),
        fmtMoeda(m.lucroLiquido),
        fmtPct(m.margemBrutaPct),
        fmtPct(m.margemLiquidaPct),
      ]);
      if (s.consolidado) {
        const c = s.consolidado;
        body.push(['Acum.', fmtMoeda(c.vendas), fmtMoeda(c.custo), fmtMoeda(c.lucroBruto), fmtMoeda(c.lucroLiquido), fmtPct(c.margemBrutaPct), fmtPct(c.margemLiquidaPct)]);
      }
      ctx.addTable(['Mês', 'Vendas', 'Custo', 'Lucro bruto', 'Lucro líq.', 'Marg.br.%', 'Marg.líq.%'], body, {
        styles: { fontSize: 7 },
        columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' }, 3: { halign: 'right' }, 4: { halign: 'right' }, 5: { halign: 'right' }, 6: { halign: 'right' } },
      });
    }
  }

  function renderComposicao(ctx) {
    const s = ctx.snapshot;
    if (!(s.composicaoMargens || []).length) return;
    ctx.newPage();
    ctx.writeTitle('Onde vai cada real do faturamento');
    if (s.composicaoSubtitle) ctx.writeParagraph(s.composicaoSubtitle);
    ctx.addTable(['Item', 'R$ acumulado', '% do faturamento'], s.composicaoMargens.map((r) => [
      r.item,
      fmtMoeda(r.valor),
      fmtPct(Math.abs(r.pct)),
    ]), { columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' } } });
    if (s.composicaoNota) ctx.writeParagraph(s.composicaoNota);
    if (s.fiscalPeriodoNote) {
      ctx.writeSectionLabel('Competência fiscal do período selecionado');
      ctx.writeParagraph(s.fiscalPeriodoNote);
    }
  }

  function renderPatrimonial(ctx) {
    const s = ctx.snapshot;
    if (!s.patrimonial || !(s.patrimonial.meses || []).length) return;
    ctx.newPage();
    ctx.writeTitle('Indicadores patrimoniais');
    if (s.patrimonial.note) ctx.writeParagraph(s.patrimonial.note);
    ctx.addTable(['Mês', 'Liq. corrente', 'Liq. seca', 'Cap. giro', 'Endiv. %'], s.patrimonial.meses.map((p) => [
      p.label,
      Number(p.liquidezCorrente).toFixed(2).replace('.', ','),
      Number(p.liquidezSeca).toFixed(2).replace('.', ','),
      fmtMoeda(p.capitalGiro),
      fmtPct(p.grauEndividamento),
    ]), { columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' }, 3: { halign: 'right' }, 4: { halign: 'right' } } });
  }

  function renderPendencias(ctx) {
    const s = ctx.snapshot;
    const pend = (s.pendentes || []).filter(Boolean);
    const acoes = s.acoes || [];
    if (!pend.length && !acoes.length) return;
    ctx.newPage();
    ctx.writeTitle('Pendências e próximos passos');
    if (pend.length) {
      ctx.writeSectionLabel('Fontes pendentes de integração');
      ctx.writeBullets(pend);
    }
    if (acoes.length) {
      ctx.writeSectionLabel('Ações recomendadas');
      ctx.writeBullets(acoes);
    }
    ctx.writeParagraph(
      'Relatório gerencial — ' + (s.empresa?.nome || 'Empresa')
      + ' — competência ' + (s.periodLabel || '') + '.'
    );
  }

  function renderAll(ctx) {
    renderCover(ctx);
    renderComparativo(ctx);
    renderFiscal(ctx);
    renderTops(ctx);
    renderEvolucao(ctx);
    renderLeitura(ctx);
    renderResumoAcumulado(ctx);
    renderMediaDetalhe(ctx);
    renderComposicao(ctx);
    renderPatrimonial(ctx);
    renderPendencias(ctx);
    ctx.addFooter();
  }

  async function exportSnapshot(snapshot, opts) {
    opts = opts || {};
    if (!global.jspdf?.jsPDF) {
      alert('Biblioteca jsPDF não carregada.');
      return null;
    }
    const probe = new global.jspdf.jsPDF();
    if (typeof probe.autoTable !== 'function') {
      alert('Biblioteca jspdf-autotable não carregada.');
      return null;
    }
    if (!snapshot || !snapshot.empresa) {
      alert('Snapshot do relatório inválido.');
      return null;
    }

    const btn = opts.button || (typeof event !== 'undefined' ? event?.currentTarget : null);
    const origHtml = btn?.innerHTML;
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Gerando...';
    }

    try {
      const ctx = createPdfContext(snapshot);
      renderAll(ctx);
      const slug = snapshot.fileSlug || 'Relatorio_Gerencial';
      ctx.pdf.save(slug + '.pdf');
      return ctx.pdf;
    } catch (err) {
      console.error(err);
      alert('Erro ao gerar Relatório Gerencial. Tente novamente.');
      return null;
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = origHtml;
      }
    }
  }

  function buildFiscalSnapshot(opts) {
    opts = opts || {};
    const empresa = opts.empresa || {};
    const periodLabel = opts.periodLabel || '';
    const pack = opts.pack || {};
    const catalog = opts.catalog || {};
    const unitLabel = opts.unitLabel || '';
    const impostosTabela = pack.impostosTabela || [];
    const comprasFinalidade = agruparComprasPorFinalidade(pack.cfopEntradas, catalog);
    const topCfopEntradas = sortCfop(pack.cfopEntradas).slice(0, 15).map((c) => ({
      cfop: c.cfop,
      descricao: cfopDesc(c, catalog),
      total: c.total || c.contabil || 0,
    }));
    const topCfopSaidas = sortCfop(pack.cfopSaidas).slice(0, 15).map((c) => ({
      cfop: c.cfop,
      descricao: cfopDesc(c, catalog),
      total: c.total || c.contabil || 0,
    }));
    const clientesSrc = pack.sped?.clientes || pack.clientes || pack.clientesTop10 || [];
    const fornSrc = pack.sped?.fornecedores || pack.fornecedores || [];
    const topClientes = clientesSrc.slice(0, 10).map((c) => ({ nome: c.nome, total: c.total }));
    const topFornecedores = fornSrc.slice(0, 10).map((c) => ({ nome: c.nome, total: c.total }));

    const imp = somaImpostos(impostosTabela);
    let narrativa = 'Período ' + periodLabel;
    if (unitLabel) narrativa += ' (' + unitLabel + ')';
    narrativa += ': receita bruta ' + fmtK(pack.receitaBruta)
      + ', compras ' + fmtK(pack.totalCompras)
      + ', carga tributária ' + fmtPct(pack.dedPct)
      + ' (impostos a recolher ' + fmtK(imp) + ').';
    if (pack.cfopSaidasTotal != null) {
      narrativa += ' Total de saídas CFOP: ' + fmtK(pack.cfopSaidasTotal) + '.';
    }

    const leitura = [
      'Receita bruta ' + fmtK(pack.receitaBruta) + ' e compras ' + fmtK(pack.totalCompras) + ' em ' + periodLabel + '.',
      'Carga tributária de ' + fmtPct(pack.dedPct) + ' sobre a receita bruta.',
    ];
    if (topClientes.length) leitura.push('Principal cliente no ranking: ' + topClientes[0].nome + ' (' + fmtK(topClientes[0].total) + ').');
    if (comprasFinalidade.length) {
      leitura.push('Maior grupo de compras: ' + comprasFinalidade[0].finalidade + ' (' + fmtK(comprasFinalidade[0].total) + ').');
    }

    const acoes = [
      'Monitorar carga tributária de ' + fmtPct(pack.dedPct) + ' e créditos disponíveis.',
      'Revisar top CFOPs de entrada e finalidade de compras do período.',
    ];
    if (topFornecedores.length) acoes.push('Acompanhar concentração de compras nos principais fornecedores.');
    else acoes.push('Integrar ranking de fornecedores quando SPED de entradas estiver completo.');

    const pendentes = [];
    if (!topFornecedores.length) pendentes.push('Ranking de fornecedores (quando não disponível nos dados)');
    if (opts.pendentes) pendentes.push.apply(pendentes, opts.pendentes);

    let evolucaoMensal = opts.evolucaoMensal || null;
    if (!evolucaoMensal && opts.monthKeys && typeof opts.getMonthPack === 'function') {
      evolucaoMensal = opts.monthKeys.map((m) => {
        const p = opts.getMonthPack(m) || {};
        return {
          label: (opts.monthLabels && opts.monthLabels[m]) || m,
          vendas: p.cfopSaidasTotal || p.receitaBruta || 0,
          lucroLiquido: p.receitaBruta,
          receitaBruta: p.receitaBruta,
          dedPct: p.dedPct,
          custo: p.totalCompras,
          lucroBruto: null,
          margemBrutaPct: null,
          margemLiquidaPct: null,
        };
      });
    }

    const slug = opts.fileSlug || ('Relatorio_Gerencial_' + String(empresa.nome || 'Empresa').slice(0, 20).replace(/[^\w]+/g, '_'));

    return {
      empresa,
      periodLabel,
      fileSlug: slug,
      narrativa,
      resultadoComparativo: opts.resultadoComparativo || null,
      fiscal: {
        receitaBruta: pack.receitaBruta,
        deducoes: pack.deducoes,
        dedPct: pack.dedPct,
        totalCompras: pack.totalCompras,
        cfopSaidasTotal: pack.cfopSaidasTotal,
        impostosTabela,
      },
      impostosTabela,
      comprasFinalidade,
      topClientes,
      topFornecedores,
      topCfopEntradas,
      topCfopSaidas,
      evolucaoMensal,
      evolucaoTitle: 'Evolução mensal — fiscal',
      evolucaoSubtitle: 'Receita / saídas e carga tributária por mês disponível.',
      evolucaoCol2: 'Saídas/RB',
      evolucaoCol3: 'Receita bruta',
      evolucaoCol4: 'Carga %',
      consolidado: opts.consolidado || null,
      mediaMensal: null,
      showEvolucaoDetalhada: false,
      alertasMargem: null,
      composicaoMargens: null,
      patrimonial: opts.patrimonial || null,
      leitura,
      acoes,
      pendentes: [...new Set(pendentes.filter(Boolean))],
      footerNote: (empresa.nome || 'Empresa') + ' — Relatório gerencial fiscal — ' + periodLabel,
    };
  }

  global.RelatorioGerencialCore = {
    export: exportSnapshot,
    buildFiscalSnapshot,
    fmtMoeda,
    fmtPct,
    fmtK,
    fmtVar,
    calcVariacao,
    somaImpostos,
    agruparComprasPorFinalidade,
    sortCfop,
    cfopDesc,
  };
})(typeof window !== 'undefined' ? window : globalThis);

</script>
<script>
/* Relatório Gerencial — adapter Schumacher (margens + fiscal + patrimonial) */
(function () {
  'use strict';

  const MARGEM_LIMITE_ATENCAO = 20;
  const MARGEM_LIMITE_CRITICO = 15;

  function core() {
    return window.RelatorioGerencialCore;
  }

  function margemProdutoNivel(mLiq) {
    const m = mLiq != null ? mLiq : 0;
    if (m < 0) return 'negativo';
    if (m < MARGEM_LIMITE_CRITICO) return 'critico';
    if (m < MARGEM_LIMITE_ATENCAO) return 'atencao';
    return 'ok';
  }

  function coletarAlertasProdutos(pack) {
    const produtos = pack?.produtos || [];
    const neg = [];
    const crit = [];
    const warn = [];
    produtos.forEach((p) => {
      const n = margemProdutoNivel(p.margemLiquidaPct);
      if (n === 'negativo') neg.push(p);
      else if (n === 'critico') crit.push(p);
      else if (n === 'atencao') warn.push(p);
    });
    const emAtencao = neg.concat(crit, warn).sort((a, b) => {
      const d = (a.margemLiquidaPct || 0) - (b.margemLiquidaPct || 0);
      return d !== 0 ? d : (b.total || 0) - (a.total || 0);
    });
    return { neg, crit, warn, emAtencao, total: emAtencao.length };
  }

  function resolveActiveKeys(D) {
    const api = window.SchumacherDashboard;
    let fiscal = null;
    let periodLabel = D.competenciaLabel || '';
    let fiscalKey = D.competencia || null;

    if (api && typeof api.getActiveFiscalPack === 'function') {
      fiscal = api.getActiveFiscalPack();
      if (typeof api.getActiveCompetenciaLabel === 'function') {
        periodLabel = api.getActiveCompetenciaLabel() || periodLabel;
      }
      if (fiscal?.competencia) fiscalKey = fiscal.competencia;
    }
    if (!fiscal) {
      const fp = D.fiscalPorMes;
      const key = D.competencia || (fp?.meses && fp.meses[fp.meses.length - 1]);
      fiscal = fp?.porMes?.[key] || null;
      fiscalKey = key;
      if (!fiscal && key === D.competencia) {
        fiscal = {
          competencia: D.competencia,
          competenciaLabel: D.competenciaLabel,
          receitaBruta: D.receitaBruta,
          totalCompras: D.totalCompras,
          deducoes: Array.isArray(D.deducoes) ? D.deducoes[0] : D.deducoes,
          dedPct: Array.isArray(D.dedPct) ? D.dedPct[0] : D.dedPct,
          impostosTabela: D.impostosTabela,
          cfopEntradas: D.cfopEntradas,
          cfopSaidas: D.cfopSaidas,
          sped: D.sped,
        };
      }
    }
    return { fiscal, periodLabel, fiscalKey };
  }

  function resolveMargemPair(D, fiscalKey) {
    const marg = D.margens || {};
    const meses = marg.meses || [];
    let currKey = null;
    if (fiscalKey && meses.includes(fiscalKey)) currKey = fiscalKey;
    else if (fiscalKey && String(fiscalKey).includes('-')) {
      const mm = String(fiscalKey).slice(-2);
      currKey = meses.find((m) => m.endsWith('-' + mm) || m === mm) || null;
    }
    if (!currKey && meses.length) currKey = meses[meses.length - 1];
    const currIdx = meses.indexOf(currKey);
    const prevKey = currIdx > 0 ? meses[currIdx - 1] : null;
    const curr = currKey ? marg.porMes?.[currKey] : null;
    const prev = prevKey ? marg.porMes?.[prevKey] : null;
    const currLabel = currIdx >= 0 ? (marg.mesLabels?.[currIdx] || currKey) : currKey;
    const prevLabel = prevKey ? (marg.mesLabels?.[currIdx - 1] || prevKey) : '';
    return { currKey, prevKey, curr, prev, currLabel, prevLabel, meses };
  }

  function shortMesLabel(label) {
    if (!label) return '—';
    const s = String(label);
    if (s.includes('/')) return s.split('/')[0].trim().slice(0, 3) + '/' + (s.split('/')[1] || '').trim().slice(-2);
    return s.slice(0, 8);
  }

  function buildSnapshot(D) {
    const C = core();
    const { fiscal, periodLabel, fiscalKey } = resolveActiveKeys(D);
    const pair = resolveMargemPair(D, fiscalKey);
    const marg = D.margens || {};
    const consolidado = marg.consolidado?.totais || null;
    const catalog = D.cfopFinalidade || {};

    const evolucaoMensal = (pair.meses || []).map((k, i) => {
      const t = marg.porMes[k]?.totais || {};
      return {
        key: k,
        label: marg.mesLabels?.[i] || k,
        vendas: t.vendas || 0,
        custo: t.custo || 0,
        lucroBruto: t.lucroBruto || 0,
        lucroLiquido: t.lucroLiquido || 0,
        margemBrutaPct: t.margemBrutaPct || 0,
        margemLiquidaPct: t.margemLiquidaPct || 0,
      };
    });
    const nMeses = evolucaoMensal.length || 1;
    const mediaMensal = consolidado ? {
      vendas: consolidado.vendas / nMeses,
      lucroLiquido: consolidado.lucroLiquido / nMeses,
      margemLiquidaPct: consolidado.margemLiquidaPct,
      margemBrutaPct: consolidado.margemBrutaPct,
    } : null;

    const alertas = coletarAlertasProdutos(pair.curr || {});
    const comprasFinalidade = C.agruparComprasPorFinalidade(
      fiscal?.cfopEntradas || D.cfopEntradas,
      catalog
    );
    const impostosTabela = fiscal?.impostosTabela || D.impostosTabela || [];
    const clientes = (fiscal?.sped?.clientes || D.sped?.clientes || []).slice();
    const fornecedores = (fiscal?.sped?.fornecedores || fiscal?.fornecedores || D.sped?.fornecedores || []).slice();
    const topCfopEntradas = C.sortCfop(fiscal?.cfopEntradas || D.cfopEntradas).slice(0, 15).map((c) => ({
      cfop: c.cfop,
      descricao: C.cfopDesc(c, catalog),
      total: c.total || c.contabil || 0,
    }));
    const topCfopSaidas = C.sortCfop(fiscal?.cfopSaidas || D.cfopSaidas).slice(0, 15).map((c) => ({
      cfop: c.cfop,
      descricao: C.cfopDesc(c, catalog),
      total: c.total || c.contabil || 0,
    }));

    let resultadoComparativo = null;
    if (pair.prev && pair.curr) {
      resultadoComparativo = {
        title: 'Resultado do período — margens gerenciais',
        subtitle: 'Fonte: Demonstrativo de Margens de Venda. Não substitui o DRE contábil.',
        headPrev: shortMesLabel(pair.prevLabel),
        headCurr: shortMesLabel(pair.currLabel),
        rows: [
          { linha: '(+) Vendas', prev: pair.prev.totais.vendas, curr: pair.curr.totais.vendas },
          { linha: '(-) Custo', prev: -pair.prev.totais.custo, curr: -pair.curr.totais.custo },
          { linha: '(=) Lucro bruto', prev: pair.prev.totais.lucroBruto, curr: pair.curr.totais.lucroBruto },
          { linha: '(=) Lucro líquido', prev: pair.prev.totais.lucroLiquido, curr: pair.curr.totais.lucroLiquido },
          { linha: '% Margem líquida', prev: pair.prev.totais.margemLiquidaPct, curr: pair.curr.totais.margemLiquidaPct, isPct: true },
        ],
      };
    }

    let narrativa = '';
    if (pair.prev && pair.curr) {
      const vVar = C.calcVariacao(pair.curr.totais.vendas, pair.prev.totais.vendas);
      const lVar = C.calcVariacao(pair.curr.totais.lucroLiquido, pair.prev.totais.lucroLiquido);
      const mDelta = pair.curr.totais.margemLiquidaPct - pair.prev.totais.margemLiquidaPct;
      const vendasDir = vVar.pct >= 0 ? 'subiu' : 'caiu';
      const lucroDir = lVar.pct >= 0 ? 'melhorou' : 'piorou';
      const margemTxt = mDelta >= 0
        ? 'a margem líquida subiu ' + Math.abs(mDelta).toFixed(1).replace('.', ',') + ' p.p.'
        : 'a margem líquida caiu ' + Math.abs(mDelta).toFixed(1).replace('.', ',') + ' p.p.';
      narrativa = (pair.currLabel || 'O período') + ' fechou com vendas de ' + C.fmtK(pair.curr.totais.vendas)
        + ' no demonstrativo de margens, ' + vendasDir + ' cerca de ' + Math.abs(vVar.pct).toFixed(0)
        + '% frente a ' + (pair.prevLabel || 'o mês anterior') + ' (' + C.fmtK(pair.prev.totais.vendas)
        + '). O lucro líquido gerencial ' + lucroDir + ' ' + Math.abs(lVar.pct).toFixed(0) + '% ('
        + C.fmtK(pair.curr.totais.lucroLiquido) + ' vs ' + C.fmtK(pair.prev.totais.lucroLiquido)
        + ') e ' + margemTxt + ' (' + C.fmtPct(pair.curr.totais.margemLiquidaPct) + ' vs '
        + C.fmtPct(pair.prev.totais.margemLiquidaPct) + ').';
    } else if (pair.curr) {
      narrativa = (pair.currLabel || 'O período') + ' com vendas de ' + C.fmtK(pair.curr.totais.vendas)
        + ' e lucro líquido gerencial de ' + C.fmtK(pair.curr.totais.lucroLiquido)
        + ' (margem ' + C.fmtPct(pair.curr.totais.margemLiquidaPct) + ').';
    } else {
      narrativa = 'Relatório fiscal do período ' + periodLabel + '.';
    }
    if (fiscal) {
      narrativa += ' Na visão fiscal (' + periodLabel + '), a receita bruta foi ' + C.fmtK(fiscal.receitaBruta)
        + ', com compras de ' + C.fmtK(fiscal.totalCompras) + ' e carga tributária de '
        + C.fmtPct(fiscal.dedPct) + ' (impostos a recolher: ' + C.fmtK(C.somaImpostos(impostosTabela)) + ').';
    }
    if (!D.dre?.meses?.length) {
      narrativa += ' Este relatório usa margens gerenciais como proxy do resultado; o DRE contábil aguarda arquivo em CONTABIL/DRE/.';
    }

    const leitura = [];
    if (consolidado) {
      leitura.push('Faturamento acumulado: ' + C.fmtK(consolidado.vendas)
        + ' com margem líquida média de ' + C.fmtPct(consolidado.margemLiquidaPct) + '.');
    }
    if (fiscal) {
      leitura.push('Competência fiscal ' + periodLabel + ': receita bruta ' + C.fmtK(fiscal.receitaBruta)
        + ', compras ' + C.fmtK(fiscal.totalCompras) + '.');
    }
    if (alertas.total > 0) {
      leitura.push('Há ' + alertas.total + ' produto(s) com margem líquida abaixo de 20% em '
        + (pair.currLabel || 'no período') + ' — revisar precificação e custo.');
    } else if (pair.curr) {
      leitura.push('Nenhum produto com margem líquida abaixo de 20% em ' + (pair.currLabel || 'no período') + '.');
    }

    const pat = D.indicadoresPatrimoniais;
    const patrimonial = { meses: [], note: '', ultimo: null };
    if (pat?.meses) {
      pat.meses.forEach((k, i) => {
        const p = pat.porMes[k];
        if (!p) return;
        const row = {
          key: k,
          label: pat.mesLabels?.[i] || k,
          liquidezCorrente: p.liquidezCorrente,
          liquidezSeca: p.liquidezSeca,
          capitalGiro: p.capitalGiro,
          grauEndividamento: p.grauEndividamento,
        };
        patrimonial.meses.push(row);
        patrimonial.ultimo = row;
      });
      patrimonial.note = 'Indicadores a partir do balancete contábil disponível ('
        + (patrimonial.meses[0]?.label || '') + ' a ' + (patrimonial.ultimo?.label || '') + ').';
    }
    if (patrimonial.ultimo) {
      leitura.push('Liquidez corrente em ' + patrimonial.ultimo.label + ': '
        + patrimonial.ultimo.liquidezCorrente.toFixed(2).replace('.', ',')
        + '; grau de endividamento ' + C.fmtPct(patrimonial.ultimo.grauEndividamento) + '.');
    }

    const pendentesObj = D.pendentes || {};
    const pendentes = [];
    if (pendentesObj.dre || !D.dre?.meses?.length) pendentes.push('DRE contábil (CONTABIL/DRE/)');
    if (pendentesObj.recebimentos) pendentes.push('Extrato / contas a pagar e receber (DFC)');
    if (pendentesObj.balancete) pendentes.push('Balancete do mês da competência fiscal selecionada');
    if (pendentesObj.fornecedores || !fornecedores.length) pendentes.push('Ranking de fornecedores (SPED entradas C100)');
    if (pendentesObj.pessoal) pendentes.push('Folha analítica 2026');
    if (!D.dre?.meses?.length) {
      pendentes.push('Despesas operacionais por categoria — requer DRE ou razão contábil detalhado');
      pendentes.push('Ponto de equilíbrio econômico — requer DRE com despesas operacionais');
    }

    const acoes = [];
    if (!D.dre?.meses?.length) acoes.push('Integrar DRE contábil (CONTABIL/DRE/) para substituir proxy de margens por resultado oficial.');
    if (pendentesObj.recebimentos) acoes.push('Enviar extrato bancário ou contas a pagar/receber para habilitar fluxo de caixa (DFC).');
    if (alertas.neg.length) acoes.push('Revisar ' + alertas.neg.length + ' produto(s) com margem negativa em ' + (pair.currLabel || 'o período') + '.');
    if (alertas.crit.length) acoes.push('Acompanhar ' + alertas.crit.length + ' produto(s) com margem líquida abaixo de 15%.');
    if (fiscal) acoes.push('Monitorar carga tributária de ' + C.fmtPct(fiscal.dedPct) + ' e créditos de ICMS disponíveis.');
    if (pendentesObj.balancete) acoes.push('Validar balancete do mês selecionado quando disponível para atualizar indicadores patrimoniais.');

    const composicaoMargens = consolidado ? [
      { item: 'Custo dos produtos/serviços', valor: -consolidado.custo, pct: (consolidado.custo / consolidado.vendas) * 100 },
      { item: 'Lucro líquido gerencial', valor: consolidado.lucroLiquido, pct: (consolidado.lucroLiquido / consolidado.vendas) * 100 },
    ] : [];

    const impostosPeriodo = C.somaImpostos(impostosTabela);
    const fiscalPeriodoNote = fiscal
      ? ('No período fiscal ' + periodLabel + ': impostos a recolher ' + C.fmtMoeda(impostosPeriodo)
        + ' (' + C.fmtPct(fiscal.dedPct) + ' da receita bruta ' + C.fmtMoeda(fiscal.receitaBruta) + '). '
        + 'Este valor refere-se à competência fiscal selecionada e não deve ser misturado ao acumulado de margens.')
      : null;

    const rangeLabel = evolucaoMensal.length
      ? (evolucaoMensal[0].label + ' a ' + evolucaoMensal[evolucaoMensal.length - 1].label)
      : periodLabel;

    const slugComp = String(fiscalKey || D.competencia || 'periodo').replace(/[^a-zA-Z0-9]+/g, '_');

    return {
      empresa: D.empresa,
      periodLabel: periodLabel,
      fileSlug: 'Relatorio_Gerencial_SCHUMACHER_' + slugComp,
      narrativa,
      resultadoComparativo,
      fiscal: fiscal ? {
        receitaBruta: fiscal.receitaBruta,
        deducoes: fiscal.deducoes,
        dedPct: fiscal.dedPct,
        totalCompras: fiscal.totalCompras,
        cfopSaidasTotal: fiscal.cfopSaidasTotal,
        impostosTabela,
      } : null,
      impostosTabela,
      comprasFinalidade,
      topClientes: clientes.slice(0, 10).map((c) => ({ nome: c.nome, total: c.total })),
      topFornecedores: fornecedores.slice(0, 10).map((c) => ({ nome: c.nome, total: c.total })),
      topCfopEntradas,
      topCfopSaidas,
      evolucaoMensal,
      evolucaoTitle: 'Evolução mensal — margens gerenciais',
      evolucaoSubtitle: 'Demonstrativo de margens mês a mês (' + rangeLabel + '). Visão gerencial; não é fluxo de caixa.',
      consolidado,
      mediaMensal,
      mediaMensalNote: 'Média mensal (' + nMeses + ' mês(es)) com base no demonstrativo de margens.',
      showEvolucaoDetalhada: true,
      resumoAcumuladoSubtitle: rangeLabel + ' — Demonstrativo de margens',
      alertasMargem: alertas.total ? {
        total: alertas.total,
        emAtencao: alertas.emAtencao,
        label: 'Alertas de margem — ' + (pair.currLabel || periodLabel),
      } : null,
      composicaoMargens,
      composicaoSubtitle: 'Composição acumulada (' + rangeLabel + ') apenas com base no demonstrativo de margens.',
      composicaoNota: consolidado
        ? ('De cada R$ 1,00 faturado no acumulado, ' + C.fmtPct((consolidado.custo / consolidado.vendas) * 100)
          + ' saem em custo e ' + C.fmtPct(consolidado.margemLiquidaPct)
          + ' permanecem como lucro líquido gerencial (antes de despesas operacionais do DRE).')
        : null,
      fiscalPeriodoNote,
      patrimonial: patrimonial.meses.length ? patrimonial : null,
      leitura,
      acoes,
      pendentes: [...new Set(pendentes)],
      footerNote: (D.empresa?.nome || 'INDUSTRIA SCHUMACHER LTDA')
        + ' — Relatório gerencial — margens e fiscal — ' + periodLabel,
    };
  }

  function buildRelatorioModel(D) {
    return buildSnapshot(D);
  }

  async function exportRelatorioGerencial() {
    if (typeof DASHBOARD_DATA === 'undefined') {
      alert('Dados do dashboard não carregados.');
      return;
    }
    if (!core()) {
      alert('Motor do Relatório Gerencial não carregado.');
      return;
    }
    const snapshot = buildSnapshot(DASHBOARD_DATA);
    const btn = typeof event !== 'undefined' ? event?.currentTarget : null;
    await core().export(snapshot, { button: btn });
  }

  window.exportRelatorioGerencial = exportRelatorioGerencial;
  window.buildRelatorioModel = buildRelatorioModel;
})();

</script>
<script>

  const chartInst = window.chartInst || {};
  let sbCollapsed = false;
  function toggleSidebar() {
    const sb = document.getElementById('sidebar');
    const mw = document.getElementById('mainWrapper');
    if (window.innerWidth <= 768) {
      sb.classList.toggle('mob-open');
      document.getElementById('overlay').classList.toggle('hidden');
    } else {
      sbCollapsed = !sbCollapsed;
      sb.classList.toggle('collapsed', sbCollapsed);
      mw.classList.toggle('sb-collapsed', sbCollapsed);
    }
  }
  function closeMob() {
    document.getElementById('sidebar').classList.remove('mob-open');
    document.getElementById('overlay').classList.add('hidden');
  }
/* -----------------------------------------------
     EXPORTAÇÃO PDF / EXCEL / IMPRESSÃO FORNECEDOR / RELATÓRIO GERENCIAL (relatorio-gerencial.js)
     ----------------------------------------------- */
  function getCompanyName() {
    return document.querySelector('.logo-text .company')?.textContent?.trim() || 'Dashboard';
  }
  function getExportDate() {
    return new Date().toLocaleDateString('pt-BR').replace(/\//g, '-');
  }

  function getActiveCfopEntradas() {
    return window.SchumacherDashboard?.getActiveFiscalPack()?.cfopEntradas || [];
  }

  function getActiveCompetenciaLabel() {
    return window.SchumacherDashboard?.getActiveCompetenciaLabel?.() || '';
  }

  const PDF_CLONE_CSS = `
    .pdf-export-target {
      --bg:#f8fafc; --bg-card:#fff; --bg-card-hover:#f1f5f9;
      --text:#1e293b; --text-sec:#475569; --text-muted:#64748b;
      --border:rgba(0,0,0,.12);
      background:#f8fafc !important; color:#1e293b !important;
      padding:20px; opacity:1 !important; filter:none !important; animation:none !important;
    }
    .pdf-export-target * { opacity:1 !important; filter:none !important; }
    .pdf-export-target .sec-title,.pdf-export-target .kpi-val,.pdf-export-target .chart-ttl,
    .pdf-export-target .margin-val,.pdf-export-target .ind-val,.pdf-export-target .tax-cur,
    .pdf-export-target .table-head .ttl,.pdf-export-target tbody td,.pdf-export-target td,
    .pdf-export-target .kpi-lbl,.pdf-export-target .mem-row .lbl,.pdf-export-target .mem-row .val,
    .pdf-export-target .fw7,.pdf-export-target .fw8 { color:#1e293b !important; }
    .pdf-export-target .sec-sub,.pdf-export-target .kpi-sub,.pdf-export-target .chart-sub,
    .pdf-export-target .table-head .sub,.pdf-export-target .td-mute,.pdf-export-target .sec-title small,
    .pdf-export-target .margin-sub,.pdf-export-target .tax-prev,.pdf-export-target .ind-formula {
      color:#475569 !important;
    }
    .pdf-export-target .kpi-card,.pdf-export-target .chart-card,.pdf-export-target .table-card,
    .pdf-export-target .margin-card,.pdf-export-target .tax-card,.pdf-export-target .mem-card,
    .pdf-export-target .ind-card,.pdf-export-target .alert-box {
      background:#fff !important; border:1px solid #e2e8f0 !important;
      box-shadow:0 1px 3px rgba(0,0,0,.06) !important;
    }
    .pdf-export-target .t-success{color:#059669!important}
    .pdf-export-target .t-warning{color:#d97706!important}
    .pdf-export-target .t-danger{color:#dc2626!important}
    .pdf-export-target .t-accent{color:#16a34a!important}
    .pdf-export-target .t-muted{color:#64748b!important}
    .pdf-export-target .kpi-ico.c-blue{background:rgba(34,163,41,.22)!important;color:#16a34a!important}
    .pdf-export-target .kpi-ico.c-green{background:rgba(16,185,129,.22)!important;color:#059669!important}
    .pdf-export-target .kpi-ico.c-yellow{background:rgba(245,158,11,.22)!important;color:#d97706!important}
    .pdf-export-target .kpi-ico.c-purple{background:rgba(139,92,246,.22)!important;color:#7c3aed!important}
    .pdf-export-target thead th{background:#f1f5f9!important;color:#475569!important}
    .pdf-export-target .dre-tbl .dre-group td{background:#f1f5f9!important;color:#475569!important}
    .pdf-export-target .dre-tbl .dre-total td{background:#ecfdf5!important}
    .pdf-export-target .dre-tbl .dre-lucro td{background:#ecfdf5!important;color:#059669!important}
    .pdf-export-target .export-bar{display:none!important}
  `;

  function applyPdfLiveTheme(el) {
    el.style.setProperty('--text', '#1e293b');
    el.style.setProperty('--text-sec', '#475569');
    el.style.setProperty('--text-muted', '#64748b');
    el.style.setProperty('--bg-card', '#ffffff');
    el.style.setProperty('--border', 'rgba(0,0,0,0.12)');
    el.style.opacity = '1';
    el.style.animation = 'none';
  }

  function clearPdfLiveTheme(el) {
    ['--text', '--text-sec', '--text-muted', '--bg-card', '--border', 'opacity', 'animation'].forEach((p) => el.style.removeProperty(p));
  }

  function applyPdfCloneTheme(doc, el) {
    el.classList.add('pdf-export-target');
    applyPdfLiveTheme(el);
    const bar = el.querySelector('.export-bar');
    if (bar) bar.style.display = 'none';
    const style = doc.createElement('style');
    style.textContent = PDF_CLONE_CSS;
    el.insertBefore(style, el.firstChild);
  }

  function solidifyRgba(color) {
    if (typeof color !== 'string' || !color.startsWith('rgba')) return color;
    return color.replace(/,\s*[\d.]+\)\s*$/, ', 1)');
  }

  function prepareChartsForPdf(section) {
    const saved = [];
    Object.entries(chartInst).forEach(([id, chart]) => {
      if (!chart?.canvas || !section.contains(chart.canvas)) return;
      const snap = { id, ticks: [], grids: [], legend: null, datasets: [] };
      if (chart.options.scales) {
        Object.keys(chart.options.scales).forEach((key) => {
          const s = chart.options.scales[key];
          if (!s) return;
          if (s.ticks) { snap.ticks.push({ key, color: s.ticks.color }); s.ticks.color = '#475569'; }
          if (s.grid) { snap.grids.push({ key, color: s.grid.color }); s.grid.color = 'rgba(0,0,0,0.1)'; }
        });
      }
      if (chart.options.plugins?.legend?.labels) {
        snap.legend = chart.options.plugins.legend.labels.color;
        chart.options.plugins.legend.labels.color = '#475569';
      }
      chart.data.datasets.forEach((d) => {
        snap.datasets.push({ backgroundColor: d.backgroundColor, borderColor: d.borderColor, fill: d.fill });
        if (d.fill && typeof d.backgroundColor === 'string' && d.backgroundColor.startsWith('rgba')) {
          d.backgroundColor = d.backgroundColor.replace(/,\s*[\d.]+\)/, ', 0.18)');
        } else {
          d.backgroundColor = solidifyRgba(d.backgroundColor);
        }
        if (d.borderColor) d.borderColor = solidifyRgba(d.borderColor) || d.borderColor;
      });
      chart.update('none');
      saved.push(snap);
    });
    return saved;
  }

  function restoreChartsFromPdf(saved) {
    saved.forEach((snap) => {
      const chart = chartInst[snap.id];
      if (!chart) return;
      snap.ticks.forEach(({ key, color }) => { if (chart.options.scales?.[key]?.ticks) chart.options.scales[key].ticks.color = color; });
      snap.grids.forEach(({ key, color }) => { if (chart.options.scales?.[key]?.grid) chart.options.scales[key].grid.color = color; });
      if (snap.legend != null && chart.options.plugins?.legend?.labels) chart.options.plugins.legend.labels.color = snap.legend;
      snap.datasets.forEach((orig, i) => {
        const d = chart.data.datasets[i];
        if (!d) return;
        d.backgroundColor = orig.backgroundColor;
        d.borderColor = orig.borderColor;
        d.fill = orig.fill;
      });
      chart.update('none');
    });
  }

  async function exportPDF(sectionId, filename) {
    const section = document.getElementById(sectionId);
    if (!section) return;
    if (typeof html2canvas === 'undefined') {
      alert('Biblioteca html2canvas nao carregada.');
      return;
    }
    const btn = event?.currentTarget;
    const origHtml = btn?.innerHTML;
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Gerando...'; }

    window.SchumacherDashboard?.refreshActiveTab?.();
    await new Promise((r) => setTimeout(r, 150));

    const wasHidden = !section.classList.contains('active');
    if (wasHidden) section.classList.add('export-capture');
    section.classList.add('pdf-export-target');
    document.body.classList.add('pdf-capturing');
    section.scrollTop = 0;
    applyPdfLiveTheme(section);
    const chartSnap = prepareChartsForPdf(section);

    try {
      await new Promise((r) => setTimeout(r, 500));
      const canvas = await html2canvas(section, {
        scale: 2,
        useCORS: true,
        backgroundColor: '#f8fafc',
        logging: false,
        onclone: (doc, el) => applyPdfCloneTheme(doc, el),
      });
      const imgData = canvas.toDataURL('image/png');
      const { jsPDF } = window.jspdf;
      const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const pageW = pdf.internal.pageSize.getWidth();
      const pageH = pdf.internal.pageSize.getHeight();
      const margin = 10;
      const headerH = 12;
      const contentW = pageW - margin * 2;
      const pdfHeight = (canvas.height * contentW) / canvas.width;
      let heightLeft = pdfHeight;
      let position = margin + headerH;

      const addHeader = () => {
        pdf.setFontSize(10);
        pdf.setTextColor(26, 26, 46);
        pdf.text(getCompanyName() + ' — ' + new Date().toLocaleDateString('pt-BR'), margin, margin + 4);
        pdf.setDrawColor(200);
        pdf.line(margin, margin + 7, pageW - margin, margin + 7);
      };

      addHeader();
      pdf.addImage(imgData, 'PNG', margin, position, contentW, pdfHeight);
      heightLeft -= (pageH - margin - headerH);

      while (heightLeft > 0) {
        position = margin + headerH - (pdfHeight - heightLeft);
        pdf.addPage();
        addHeader();
        pdf.addImage(imgData, 'PNG', margin, position, contentW, pdfHeight);
        heightLeft -= (pageH - margin - headerH);
      }

      pdf.save(filename + '_' + getExportDate() + '.pdf');
    } catch (err) {
      console.error(err);
      alert('Erro ao gerar PDF. Tente novamente.');
    } finally {
      restoreChartsFromPdf(chartSnap);
      clearPdfLiveTheme(section);
      document.body.classList.remove('pdf-capturing');
      section.classList.remove('pdf-export-target', 'export-capture');
      if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
    }
  }

  function exportExcel(sectionId, filename) {
    const section = document.getElementById(sectionId);
    if (!section) return;
    const tables = section.querySelectorAll('table');
    const wb = XLSX.utils.book_new();

    if (tables.length > 0) {
      tables.forEach((tbl, i) => {
        const ws = XLSX.utils.table_to_sheet(tbl);
        const range = XLSX.utils.decode_range(ws['!ref'] || 'A1');
        const colWidths = [];
        for (let C = range.s.c; C <= range.e.c; C++) {
          let max = 10;
          for (let R = range.s.r; R <= range.e.r; R++) {
            const cell = ws[XLSX.utils.encode_cell({ r: R, c: C })];
            if (cell && cell.v != null) max = Math.max(max, String(cell.v).length + 2);
          }
          colWidths.push({ wch: Math.min(max, 50) });
        }
        ws['!cols'] = colWidths;
        XLSX.utils.book_append_sheet(wb, ws, 'Tabela_' + (i + 1));
      });
    } else {
      const cards = section.querySelectorAll('.ind-card');
      const rows = [['Indicador', 'Valor', 'Fórmula', 'Interpretação']];
      cards.forEach(card => {
        rows.push([
          card.querySelector('.ind-name')?.textContent?.trim() || '',
          card.querySelector('.ind-val')?.textContent?.trim() || '',
          card.querySelector('.ind-formula')?.textContent?.trim() || '',
          card.querySelector('.ind-interp')?.textContent?.trim() || ''
        ]);
      });
      const ws = XLSX.utils.aoa_to_sheet(rows);
      ws['!cols'] = [{ wch: 30 }, { wch: 15 }, { wch: 40 }, { wch: 60 }];
      XLSX.utils.book_append_sheet(wb, ws, 'Indicadores');
    }

    if (!wb.SheetNames.length) {
      alert('Nenhum dado encontrado para exportar.');
      return;
    }
    XLSX.writeFile(wb, filename + '_' + getExportDate() + '.xlsx');
  }

  function collectUniqueSuppliers() {
    const map = new Map();
    getActiveCfopEntradas().forEach((cfop) => {
      (cfop.fornecedores || []).forEach((f) => {
        const key = f.cnpj || f.nome;
        if (!map.has(key)) map.set(key, { nome: f.nome, cnpj: f.cnpj, uf: f.uf });
      });
    });
    return Array.from(map.values()).sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));
  }

  function buildSupplierReportData(selected) {
    const cfops = getActiveCfopEntradas();
    const competencia = getActiveCompetenciaLabel();
    const suppliers = [];

    selected.forEach((cb) => {
      const cnpj = cb.value;
      const nome = cb.dataset.nome;
      const rows = [];
      let subtotal = 0;
      let uf = '—';

      cfops.forEach((cfop) => {
        const f = (cfop.fornecedores || []).find((x) => x.cnpj === cnpj);
        if (f) {
          rows.push({
            cfop: cfop.cfop,
            desc: cfop.descricao || '—',
            fin: cfop.finalidade || '—',
            qtd: f.qtd,
            total: f.total,
          });
          subtotal += f.total;
          uf = f.uf;
        }
      });

      suppliers.push({ nome, cnpj, uf, rows, subtotal });
    });

    const totalGeral = suppliers.reduce((a, s) => a + s.subtotal, 0);
    return { suppliers, totalGeral, competencia };
  }

  function openSupplierModal() {
    const list = document.getElementById('supplierList');
    const btnPrint = document.querySelector('#supplierModal .btn-print-supplier');
    const btnPdf = document.querySelector('#supplierModal .btn-pdf-supplier');
    const suppliers = collectUniqueSuppliers();
    const btnExcel = document.querySelector('#supplierModal .btn-xlsx-supplier');
    if (!suppliers.length) {
      list.innerHTML = '<div class="td-mute" style="padding:24px;text-align:center;font-size:13px;line-height:1.6;">' +
        '<i class="fas fa-truck" style="font-size:24px;margin-bottom:12px;display:block;opacity:0.5;"></i>' +
        '<strong>Detalhe por fornecedor indisponível nesta competência.</strong><br><br>' +
        'O livro ENTRADA-SAIDA agrega apenas por CFOP (sem nome/CNPJ). ' +
        'Para listar fornecedores, envie SPED ICMS/IPI com notas de entrada (C100) ou relatório de compras por fornecedor.' +
        '</div>';
      if (btnPrint) { btnPrint.disabled = true; btnPrint.style.opacity = '0.45'; }
      if (btnPdf) { btnPdf.disabled = true; btnPdf.style.opacity = '0.45'; }
      if (btnExcel) { btnExcel.disabled = true; btnExcel.style.opacity = '0.45'; }
    } else {
      list.innerHTML = suppliers.map((s) => {
        const search = (s.nome + ' ' + s.cnpj).toLowerCase();
        const esc = (v) => String(v ?? '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
        return '<label class="supplier-item" data-search="' + esc(search) + '">' +
          '<input type="checkbox" value="' + esc(s.cnpj || s.nome) + '" data-nome="' + esc(s.nome) + '">' +
          '<span class="supplier-info"><strong>' + esc(s.nome) + '</strong>' +
          '<small>' + esc(s.cnpj || '—') + ' · ' + esc(s.uf || '—') + '</small></span></label>';
      }).join('');
      if (btnPrint) { btnPrint.disabled = false; btnPrint.style.opacity = '1'; }
      if (btnPdf) { btnPdf.disabled = false; btnPdf.style.opacity = '1'; }
      if (btnExcel) { btnExcel.disabled = false; btnExcel.style.opacity = '1'; }
    }
    document.getElementById('supplierSearch').value = '';
    document.getElementById('supplierModal').style.display = 'flex';
  }

  function closeSupplierModal() {
    document.getElementById('supplierModal').style.display = 'none';
    const search = document.getElementById('supplierSearch');
    if (search) search.value = '';
  }

  function filterSuppliers(query) {
    const q = query.toLowerCase();
    document.querySelectorAll('#supplierList .supplier-item').forEach(el => {
      el.style.display = el.dataset.search.includes(q) ? '' : 'none';
    });
  }

  function toggleAllSuppliers(state) {
    document.querySelectorAll('#supplierList .supplier-item').forEach(el => {
      if (el.style.display === 'none') return;
      const cb = el.querySelector('input');
      if (cb) cb.checked = state;
    });
  }

  function printBySupplier() {
    const selected = Array.from(document.querySelectorAll('#supplierList input:checked'));
    if (!selected.length) { alert('Selecione ao menos um fornecedor.'); return; }

    const { suppliers, totalGeral, competencia } = buildSupplierReportData(selected);
    closeSupplierModal();

    let html = '<div class="supplier-print-root" style="font-family:Inter,sans-serif;padding:0;margin:0;color:#1a1a2e;background:#fff;width:100%;max-width:100%;box-sizing:border-box;">';
    html += '<h1 style="font-size:18px;margin-bottom:4px;">Relatório por Fornecedor</h1>';
    html += '<p style="font-size:12px;color:#555;margin-bottom:24px;">' + getCompanyName() + ' — Competência ' + competencia + ' — ' + new Date().toLocaleDateString('pt-BR') + '</p>';

    suppliers.forEach((s) => {
      html += '<div class="supplier-print-block" style="margin-bottom:12px;page-break-inside:auto;width:100%;max-width:100%;box-sizing:border-box;">';
      html += '<h2 style="font-size:14px;border-bottom:2px solid #22a329;padding-bottom:6px;">' + s.nome + '</h2>';
      html += '<p style="font-size:11px;color:#555;">CNPJ: ' + s.cnpj + ' · UF: ' + s.uf + '</p>';
      html += '<table style="width:100%;max-width:100%;border-collapse:collapse;margin-top:8px;font-size:10px;table-layout:fixed;"><colgroup><col class="cfop"><col class="desc"><col class="fin"><col class="qtd"><col class="val"></colgroup>';
      html += '<thead><tr style="background:#f0f0f0;"><th style="padding:4px 5px;text-align:left;">CFOP</th>';
      html += '<th style="padding:4px 5px;text-align:left;">Descrição</th><th style="padding:4px 5px;text-align:left;">Finalidade</th>';
      html += '<th style="padding:4px 5px;text-align:right;">Qtd NFs</th><th style="padding:4px 5px;text-align:right;">Valor (R$)</th></tr></thead><tbody>';
      s.rows.forEach((r) => {
        html += '<tr><td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;">' + r.cfop + '</td>';
        html += '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;">' + r.desc + '</td>';
        html += '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;">' + r.fin + '</td>';
        html += '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;text-align:right;">' + r.qtd + '</td>';
        html += '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;text-align:right;font-weight:600;">' +
          r.total.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</td></tr>';
      });
      html += '</tbody><tfoot><tr><td colspan="4" style="padding:6px 5px;text-align:right;font-weight:700;">Subtotal:</td>';
      html += '<td style="padding:6px 5px;text-align:right;font-weight:700;">R$ ' +
        s.subtotal.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</td></tr></tfoot></table></div>';
    });

    html += '<div style="border-top:2px solid #1a1a2e;padding-top:12px;margin-top:16px;text-align:right;font-size:14px;font-weight:700;">';
    html += 'Total Geral: R$ ' + totalGeral.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</div></div>';

    const old = document.getElementById('print-supplier-report');
    if (old) old.remove();
    const div = document.createElement('div');
    div.id = 'print-supplier-report';
    div.innerHTML = html;
    document.body.appendChild(div);
    document.body.classList.add('supplier-printing');

    const cleanup = () => {
      document.body.classList.remove('supplier-printing');
      div.remove();
      window.removeEventListener('afterprint', cleanup);
    };
    window.addEventListener('afterprint', cleanup);
    window.print();
  }

  function exportSupplierPdf() {
    const selected = Array.from(document.querySelectorAll('#supplierList input:checked'));
    if (!selected.length) { alert('Selecione ao menos um fornecedor.'); return; }
    if (!window.jspdf?.jsPDF) {
      alert('Biblioteca jsPDF nao carregada.');
      return;
    }
    if (typeof window.jspdf.jsPDF.prototype.autoTable !== 'function') {
      alert('Biblioteca jspdf-autotable nao carregada.');
      return;
    }

    const { suppliers, totalGeral, competencia } = buildSupplierReportData(selected);
    closeSupplierModal();

    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
    const margin = 14;
    const pageW = pdf.internal.pageSize.getWidth();
    const pageH = pdf.internal.pageSize.getHeight();
    let y = margin;

    const ensureSpace = (need) => {
      if (y + need > pageH - margin) {
        pdf.addPage();
        y = margin;
      }
    };

    pdf.setFont('helvetica', 'bold');
    pdf.setFontSize(14);
    pdf.text('Relatorio por Fornecedor', margin, y);
    y += 7;
    pdf.setFont('helvetica', 'normal');
    pdf.setFontSize(9);
    pdf.setTextColor(80, 80, 80);
    pdf.text(getCompanyName() + ' — Competencia ' + competencia + ' — ' + new Date().toLocaleDateString('pt-BR'), margin, y);
    y += 10;
    pdf.setTextColor(0, 0, 0);

    const fmtBrl = (v) => 'R$ ' + Number(v).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    suppliers.forEach((s) => {
      ensureSpace(20);
      pdf.setFont('helvetica', 'bold');
      pdf.setFontSize(11);
      pdf.text(s.nome, margin, y);
      y += 5;
      pdf.setFont('helvetica', 'normal');
      pdf.setFontSize(8);
      pdf.setTextColor(100, 100, 100);
      pdf.text('CNPJ: ' + s.cnpj + ' · UF: ' + s.uf, margin, y);
      y += 4;
      pdf.setTextColor(0, 0, 0);

      pdf.autoTable({
        startY: y,
        margin: { left: margin, right: margin },
        tableWidth: 'auto',
        head: [['CFOP', 'Descricao', 'Finalidade', 'Qtd NFs', 'Valor (R$)']],
        body: s.rows.map((r) => [
          r.cfop,
          r.desc,
          r.fin,
          String(r.qtd),
          fmtBrl(r.total),
        ]),
        foot: [['', '', '', 'Subtotal:', fmtBrl(s.subtotal)]],
        styles: { fontSize: 7, cellPadding: 1.5, overflow: 'linebreak' },
        headStyles: { fillColor: [34, 163, 41], textColor: 255 },
        footStyles: { fillColor: [241, 245, 249], textColor: [30, 41, 59], fontStyle: 'bold' },
        columnStyles: {
          3: { halign: 'right' },
          4: { halign: 'right' },
        },
      });
      y = pdf.lastAutoTable.finalY + 8;
    });

    ensureSpace(12);
    pdf.setFont('helvetica', 'bold');
    pdf.setFontSize(11);
    pdf.text('Total Geral: ' + fmtBrl(totalGeral), pageW - margin, y, { align: 'right' });

    const compSlug = (competencia || 'competencia').replace(/\s+/g, '_').replace(/\//g, '-');
    pdf.save('Fornecedores_' + compSlug + '_' + getExportDate() + '.pdf');
  }

  function autoColWidths(aoa, maxWch) {
    const widths = [];
    aoa.forEach((row) => {
      row.forEach((cell, c) => {
        const len = String(cell == null ? '' : cell).length + 2;
        widths[c] = Math.min(Math.max(widths[c] || 10, len), maxWch || 50);
      });
    });
    return widths.map((wch) => ({ wch }));
  }

  function buildSupplierExcelWorkbook(data) {
    const wb = XLSX.utils.book_new();
    const emitido = new Date().toLocaleDateString('pt-BR');
    const col3 = data.col3Label || 'Finalidade';

    const resumo = [
      ['Relatório por Fornecedor'],
      ['Empresa', data.companyName || ''],
      ['Competência', data.competencia || ''],
      ['Emitido em', emitido],
      [],
      ['Fornecedor', 'CNPJ', 'UF', 'Subtotal (R$)'],
    ];
    data.suppliers.forEach((s) => {
      resumo.push([
        s.nome || '',
        s.cnpj || '—',
        s.uf || '—',
        Math.round(Number(s.subtotal || 0) * 100) / 100,
      ]);
    });
    resumo.push(['Total Geral', '', '', Math.round(Number(data.totalGeral || 0) * 100) / 100]);
    const wsResumo = XLSX.utils.aoa_to_sheet(resumo);
    wsResumo['!cols'] = autoColWidths(resumo, 45);
    XLSX.utils.book_append_sheet(wb, wsResumo, 'Resumo');

    const detalhado = [
      ['Fornecedor', 'CNPJ', 'UF', 'CFOP', 'Descrição', col3, 'Qtd NFs', 'Valor (R$)'],
    ];
    data.suppliers.forEach((s) => {
      (s.rows || []).forEach((r) => {
        detalhado.push([
          s.nome || '',
          s.cnpj || '—',
          s.uf || '—',
          r.cfop || '',
          r.desc || '—',
          r.fin || '—',
          Number(r.qtd || 0),
          Math.round(Number(r.total || 0) * 100) / 100,
        ]);
      });
    });
    const wsDet = XLSX.utils.aoa_to_sheet(detalhado);
    wsDet['!cols'] = autoColWidths(detalhado, 50);
    XLSX.utils.book_append_sheet(wb, wsDet, 'Detalhado');
    return wb;
  }

  function saveSupplierExcelWorkbook(data) {
    const wb = buildSupplierExcelWorkbook(data);
    const safeCompany = String(data.companyName || 'empresa').slice(0, 24).replace(/[\/:*?"<>|]/g, '');
    const safeComp = String(data.competencia || '')
      .replace(/[\/:*?"<>|]/g, '-')
      .replace(/\s+/g, '_')
      .slice(0, 32);
    const safeDate = new Date().toLocaleDateString('pt-BR').replace(/\//g, '-');
    const parts = ['relatorio-fornecedor', safeCompany, safeComp, safeDate].filter(Boolean);
    XLSX.writeFile(wb, parts.join('_') + '.xlsx');
  }


  function exportSupplierExcel() {
    const selected = Array.from(document.querySelectorAll('#supplierList input:checked'));
    if (!selected.length) { alert('Selecione ao menos um fornecedor.'); return; }
    if (!window.XLSX) {
      alert('Biblioteca XLSX nao carregada.');
      return;
    }
    const built = buildSupplierReportData(selected);
    if (built.totalGeral <= 0) {
      alert('Nenhum dado encontrado para os fornecedores selecionados neste período.');
      return;
    }
    closeSupplierModal();
    saveSupplierExcelWorkbook({
      suppliers: built.suppliers,
      totalGeral: built.totalGeral,
      companyName: getCompanyName(),
      competencia: built.competencia,
      col3Label: 'Finalidade',
    });
  }

  window.openSupplierModal = openSupplierModal;
  window.closeSupplierModal = closeSupplierModal;
  window.filterSuppliers = filterSuppliers;
  window.toggleAllSuppliers = toggleAllSuppliers;
  window.printBySupplier = printBySupplier;
  window.exportSupplierPdf = exportSupplierPdf;
  window.exportSupplierExcel = exportSupplierExcel;

  </script>
</body>
</html>
