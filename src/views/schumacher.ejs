      const fin = d.finalidade || 'Outras Entradas';
      finalGrupos[fin] = (finalGrupos[fin] || 0) + d.total;
    });
    const finLabels = Object.keys(finalGrupos).sort((a, b) => finalGrupos[b] - finalGrupos[a]);
    const finVals = finLabels.map((k) => finalGrupos[k]);
    const finCores = finLabels.map((k) => cores[k] || '#64748b');
    const top4 = finLabels.slice(0, 4);
    top4.forEach((lblFin, i) => {
      const valFin = finalGrupos[lblFin];
      const n = i + 1;
      setHTML('#fn-kpi-' + n, fmtK(valFin));
      setText('#fn-lbl-' + n, lblFin);
      setHTML('#fn-sub-' + n, pct(valFin, totalGeral) + '% do total de entradas');
      setText('#fn-badge-' + n, lblFin.substring(0, 18));
    });
    const distSub = document.getElementById('fn-chart-sub-dist');
    if (distSub) distSub.textContent = '% do valor total de entradas - ' + lbl + ' (R$ ' + fmt(totalGeral) + ')';
    const barSub = document.getElementById('fn-chart-sub-bar');
    if (barSub) barSub.textContent = 'Comparativo dos grupos fiscais de compras \u2014 ' + lbl;
    setText('#fn-sec-competencia', lbl);
    setFiscalDataStatus(
      'fn-data-status',
      val,
      'Conferido: ' + val.n + ' CFOPs totalizam R$ ' + fmt(val.total) + ' em ' + lbl,
      'Divergencia: soma CFOPs R$ ' + fmt(val.sum) + ' vs total R$ ' + fmt(val.total)
    );
    safeChart('chartFinalidadeDist', {
      type: 'doughnut',
      data: { labels: finLabels, datasets: [{ data: finVals, backgroundColor: finCores, borderWidth: 0, hoverOffset: 6 }] },
      options: { responsive: true, maintainAspectRatio: false, cutout: '58%', plugins: { legend: { ...leg(), position: 'right' } } },
    });
    safeChart('chartFinalidadeBar', {
      type: 'bar',
      data: { labels: finLabels, datasets: [{ label: 'R$ mil', data: finVals.map((v) => +(v / 1000).toFixed(1)), backgroundColor: finCores, borderRadius: 5 }] },
      options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { ticks: { callback: (v) => 'R$' + v + 'K' } } } },
    });
    const tbody = document.getElementById('cfop-tbody');
    if (tbody) {
      tbody.innerHTML = '';
      cfops.forEach((d) => {
        const p = pct(d.total, totalGeral);
        const cor = cores[d.finalidade] || '#64748b';
        const credChip = d.creditoPisCofins ? '<span class="chip gr"><i class="fas fa-check"></i> Sim</span>' : '<span class="chip rd"><i class="fas fa-times"></i> Nao</span>';
        const tr = document.createElement('tr');
        tr.style.cursor = 'pointer';
        tr.innerHTML = '<td><span class="chip" style="background:rgba(255,255,255,0.07);font-family:monospace;font-weight:700;">' + d.cfop + '</span></td><td style="font-size:12px;color:var(--text-sec)">' + d.descricao + '</td><td><span class="chip" style="background:' + cor + '22;color:' + cor + '">' + d.finalidade + '</span></td><td>' + credChip + '</td><td class="r">' + d.qtd + '</td><td class="r td-val">R$ ' + fmt(d.total) + '</td><td class="r"><div class="pb-wrap"><div class="pb-bar"><div class="pb-fill" style="width:' + p + '%;background:' + cor + '"></div></div><div class="pb-pct">' + p + '%</div></div></td><td class="c"><button onclick="openDrilldown(\'' + d.cfop + '\')" style="background:rgba(34,163,41,0.12);border:1px solid rgba(34,163,41,0.3);color:var(--accent);padding:4px 10px;border-radius:6px;cursor:pointer;font-size:11px;">Ver</button></td>';
        tbody.appendChild(tr);
