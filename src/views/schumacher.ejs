    }
    const prodTotais = {
      qtde: (pack.produtos || []).reduce((a, p) => a + (p.qtde || 0), 0),
      vendas: (pack.produtos || []).reduce((a, p) => a + (p.total || 0), 0),
      custo: (pack.produtos || []).reduce((a, p) => a + (p.custo || 0), 0),
      lucroLiquido: (pack.produtos || []).reduce((a, p) => a + (p.lucroLiquido || 0), 0),
    };
    if (prodTotais.vendas > 0) {
      prodTotais.margemBrutaPct = (pack.produtos || []).reduce((a, p) => a + (p.lucroBruto || 0), 0) / prodTotais.vendas * 100;
      prodTotais.margemLiquidaPct = prodTotais.lucroLiquido / prodTotais.vendas * 100;
    }
    renderMargensTableFoot('vd-margens-produtos-tfoot', prodTotais, 2);

    document.querySelectorAll('#vd-marg-mes-bar .vd-mes-chip').forEach((chip) => {
      chip.classList.toggle('active', chip.getAttribute('data-mes') === mesKey);
    });
  }

  function initMargensVendas() {
    const marg = D().margens;
    if (!marg || !marg.meses || !marg.meses.length) return;
    const defaultKey = (D().competencia && marg.porMes[D().competencia])
      ? D().competencia
      : marg.meses[marg.meses.length - 1];
    buildMesBar('vd-marg-mes-bar', {
      meses: marg.meses,
      mesLabels: marg.mesLabels || marg.meses,
      defaultKey: defaultKey,
      totalLabel: 'Total',
      onSelect: (m) => renderMargensVendas(m),
      valueFn: (key) => margensMetricValue(key),
    });
    renderMargensVendas(defaultKey);
  }

  let balMesKey = null;
  let balSearchTimer = null;
  let balExpanded = new Set();
  let balTreeMap = {};

  function isContaValida(c) {
    const cod = String(c.codigo || '').replace(/\.0$/, '');
    return /^\d+(\.\d+)*$/.test(cod);
  }

  function normalizeCodigo(codigo) {
    return String(codigo || '').replace(/\.0$/, '');
  }

  function isSectionConta(codigo) {
    const cod = normalizeCodigo(codigo);
    return cod === '1' || cod === '2' || cod === '3';
  }

  function effectiveBalNivel(c) {
    const cod = normalizeCodigo(c.codigo);
    if (cod === '1' || cod === '2' || cod === '3') return 1;
    if (cod.indexOf('.') >= 0) return cod.split('.').length;
    return 5;
  }

  function resolveBalGrupo(codigo, parentCodigo, treeMap, fallbackGrupo) {
    const cod = normalizeCodigo(codigo);
    if (cod === '1') return 'ativo';
    if (cod === '2') return 'passivo';
    if (cod === '3') return 'resultado';
    if (cod.indexOf('.') >= 0) {
      const root = cod.split('.')[0];
      if (root === '1') return 'ativo';
      if (root === '2') return 'passivo';
      if (root === '3') return 'resultado';
    }
    if (parentCodigo && treeMap[parentCodigo] && treeMap[parentCodigo].grupo) {
      return treeMap[parentCodigo].grupo;
    }
    return fallbackGrupo || 'outro';
  }

  function buildBalTree(contas) {
    const stack = [];
    const treeMap = {};
    const nodes = contas.map((c) => {
      const cod = normalizeCodigo(c.codigo);
      const nivel = effectiveBalNivel(c);
      while (stack.length && stack[stack.length - 1].nivel >= nivel) stack.pop();
      const parentCodigo = stack.length ? stack[stack.length - 1].codigo : null;
      const grupo = resolveBalGrupo(c.codigo, parentCodigo, treeMap, c.grupo);
      const node = Object.assign({}, c, {
        codigoNorm: cod,
        balNivel: nivel,
        parentCodigo: parentCodigo,
        hasChildren: false,
        grupo: grupo,
      });
      treeMap[cod] = node;
      if (parentCodigo && treeMap[parentCodigo]) treeMap[parentCodigo].hasChildren = true;
      stack.push({ codigo: cod, nivel: nivel, grupo: grupo });
      return node;
    });
    return { nodes: nodes, treeMap: treeMap };
  }

  function getBalAncestors(codigo, treeMap) {
    const ancestors = [];
    let cur = treeMap[codigo];
    while (cur && cur.parentCodigo) {
      ancestors.push(cur.parentCodigo);
      cur = treeMap[cur.parentCodigo];
    }
    return ancestors;
  }

  function isBalRowVisible(node, expandedSet, treeMap) {
    if (!node.parentCodigo) return true;
    let cur = node;
    while (cur && cur.parentCodigo) {
      if (!expandedSet.has(cur.parentCodigo)) return false;
      cur = treeMap[cur.parentCodigo];
    }
    return true;
  }

  function resetBalExpanded() {
    balExpanded = new Set();
  }

  function getBalSearchVisibleSet(nodes, treeMap, search) {
    if (!search) return null;
    const visible = new Set();
    nodes.forEach((node) => {
      const hay = (node.codigoNorm + ' ' + (node.descricao || '')).toLowerCase();
      if (hay.indexOf(search) === -1) return;
      visible.add(node.codigoNorm);
      getBalAncestors(node.codigoNorm, treeMap).forEach((a) => visible.add(a));
    });
    return visible;
  }

  function toggleBalExpand(codigo) {
    const cod = normalizeCodigo(codigo);
    if (balExpanded.has(cod)) balExpanded.delete(cod);
    else balExpanded.add(cod);
    renderBalanceteRows();
  }

  function balValClass(v) {
    if (v == null || v === 0) return 'bal-zero';
    if (v < 0) return 'bal-neg';
    return '';
  }

  function balNatChip(nat) {
    if (!nat) return '';
    const n = String(nat).trim().toUpperCase();
    if (n !== 'D' && n !== 'C') return '';
    return '<span class="bal-nat ' + n + '">' + n + '</span>';
  }

  function buildBalSaldosIndex(bal) {
    const index = {};
    if (!bal || !bal.meses) return index;
    bal.meses.forEach((mesKey) => {
      const pack = bal.porMes && bal.porMes[mesKey];
      if (!pack || !pack.contas) return;
      pack.contas.filter(isContaValida).forEach((c) => {
        const cod = normalizeCodigo(c.codigo);
        if (!index[cod]) index[cod] = {};
        index[cod][mesKey] = {
          saldoAtual: c.saldoAtual,
          naturezaAtual: c.naturezaAtual,
          debito: c.debito || 0,
          credito: c.credito || 0,
        };
      });
    });
    return index;
  }

  function balTotalPeriodLabel(bal) {
    if (!bal || !bal.meses || !bal.meses.length) return 'Total';
    const n = bal.meses.length - 1;
    const a = bal.mesLabels && bal.mesLabels[0] ? bal.mesLabels[0].split('/')[0] : bal.meses[0];
    const b = bal.mesLabels && bal.mesLabels[n] ? bal.mesLabels[n].split('/')[0] : bal.meses[n];
    return 'Total ' + a + '\u2013' + b;
  }

  function balTotalMovimentoFromEntry(entry, bal) {
    let deb = 0;
    let cred = 0;
    let any = false;
    bal.meses.forEach((mesKey) => {
      const cell = entry[mesKey];
      if (!cell) return;
      if (cell.debito) {
        deb += cell.debito;
        any = true;
      }
      if (cell.credito) {
        cred += cell.credito;
        any = true;
      }
    });
    if (!any) return null;
    const net = deb - cred;
    if (net === 0) return { saldoAtual: 0, naturezaAtual: '' };
    if (net > 0) return { saldoAtual: net, naturezaAtual: 'D' };
    return { saldoAtual: Math.abs(net), naturezaAtual: 'C' };
  }

  function balTotalSaldoCell(codigoNorm, saldosIndex, bal) {
    const entry = saldosIndex[codigoNorm] || {};
    const tot = balTotalMovimentoFromEntry(entry, bal);
    return balMesSaldoCell(
      tot ? tot.saldoAtual : null,
      tot ? tot.naturezaAtual : '',
      { isTotal: true }
    );
  }

  function renderBalanceteHeader(bal, focusMesKey) {
    const row = document.getElementById('bal-thead-row');
    if (!row || !bal || !bal.meses || !bal.meses.length) return;
    let html = '<th>Conta</th><th>Descricao</th>';
    bal.meses.forEach((mesKey, i) => {
      const lbl = bal.mesLabels && bal.mesLabels[i] ? bal.mesLabels[i] : mesKey;
      const cls = ['r', 'bal-col-mes'];
      if (mesKey === focusMesKey) cls.push('bal-col-focus');
      html += '<th class="' + cls.join(' ') + '">' + lbl + '</th>';
    });
    html += '<th class="r bal-col-mes bal-col-total td-val">' + balTotalPeriodLabel(bal) + '</th>';
    row.innerHTML = html;
  }

  function balMesSaldoCell(val, natureza, opts) {
    opts = opts || {};
    const missing = val == null;
    const cls = ['r', 'bal-col-mes'];
    if (opts.isFocus) cls.push('bal-col-focus');
    if (opts.isTotal) cls.push('bal-col-total', 'td-val');
    if (!missing) cls.push(balValClass(val));
    const content = missing
      ? '\u2014'
      : '<span class="bal-amt">' + fmt(val) + '</span>' + balNatChip(natureza);
    return '<td class="' + cls.filter(Boolean).join(' ') + '">' + content + '</td>';
  }

  function balMesSaldoCells(codigoNorm, saldosIndex, bal, focusMesKey) {
    const entry = saldosIndex[codigoNorm] || {};
    const mesCells = bal.meses.map((mesKey) => {
      const cell = entry[mesKey];
      return balMesSaldoCell(
        cell ? cell.saldoAtual : null,
        cell ? cell.naturezaAtual : '',
        { isFocus: mesKey === focusMesKey }
      );
    }).join('');
    return mesCells + balTotalSaldoCell(codigoNorm, saldosIndex, bal);
  }

  function balColCount(bal) {
    return 3 + (bal && bal.meses ? bal.meses.length : 0);
  }

  function isBalRootSummary(visibleRows) {
    if (visibleRows.length !== 3) return false;
    const codes = visibleRows.map((r) => r.codigoNorm).sort();
    return codes[0] === '1' && codes[1] === '2' && codes[2] === '3';
  }

  function balFooterMesCells(saldosIndex, codigos, bal, focusMesKey) {
    const mesCells = bal.meses.map((mesKey) => {
      let html = '';
      codigos.forEach((cod, idx) => {
        const cell = saldosIndex[cod] && saldosIndex[cod][mesKey];
        if (idx > 0) html += '<br>';
        html += cell
          ? '<span class="bal-amt">' + fmt(cell.saldoAtual) + '</span>' + balNatChip(cell.naturezaAtual)
          : '\u2014';
      });
      const cls = ['r', 'bal-col-mes'];
      if (mesKey === focusMesKey) cls.push('bal-col-focus');
      return '<td class="' + cls.join(' ') + '">' + html + '</td>';
    }).join('');
    let totHtml = '';
    codigos.forEach((cod, idx) => {
      const entry = saldosIndex[cod] || {};
      const tot = balTotalMovimentoFromEntry(entry, bal);
      if (idx > 0) totHtml += '<br>';
      totHtml += tot
        ? '<span class="bal-amt">' + fmt(tot.saldoAtual) + '</span>' + balNatChip(tot.naturezaAtual)
        : '\u2014';
    });
    return mesCells + '<td class="r bal-col-mes bal-col-total td-val">' + totHtml + '</td>';
  }

  function balRowClasses(c) {
    const nivel = Math.min(Math.max(c.balNivel != null ? c.balNivel : effectiveBalNivel(c), 1), 5);
    const classes = ['bal-n' + nivel, 'bal-grp-' + (c.grupo || 'outro')];
    if (isSectionConta(c.codigo)) classes.push('bal-section');
    else if (nivel <= 3) classes.push('bal-group-row');
    else classes.push('bal-analytic');
    if (c.hasChildren) classes.push('bal-has-children');
    if (c.hasChildren && balExpanded.has(c.codigoNorm)) classes.push('bal-expanded');
    return classes.join(' ');
  }

  function balDescCell(c, opts) {
    opts = opts || {};
    const nivel = Math.min(Math.max(c.balNivel != null ? c.balNivel : effectiveBalNivel(c), 1), 5);
    const cod = normalizeCodigo(c.codigo);
    const hasChildren = !!opts.hasChildren;
    const expanded = !!opts.expanded;
    const isFolder = hasChildren || isSectionConta(cod) || nivel <= 3;
    const icon = isFolder ? 'fa-folder' : 'fa-file-lines';
    const desc = c.descricao || '\u2014';
    let toggle = '';
    if (hasChildren) {
      const chev = expanded ? 'fa-chevron-down' : 'fa-chevron-right';
      toggle = '<i class="fas ' + chev + ' bal-toggle"></i>';
    } else {
      toggle = '<span class="bal-toggle-spacer"></span>';
    }
    return '<td class="bal-desc bal-n' + nivel + '">' + toggle + '<i class="fas ' + icon + ' bal-ico"></i><span>' + desc + '</span></td>';
  }

  function getBalFilters() {
    const searchEl = document.getElementById('bal-search');
    const grupoEl = document.getElementById('bal-grupo-filter');
    return {
      search: (searchEl && searchEl.value ? searchEl.value : '').trim().toLowerCase(),
      grupo: grupoEl ? grupoEl.value : '',
    };
  }

  function passesBalGrupoFilter(c, grupo) {
    return !grupo || c.grupo === grupo;
  }

  function updateBalKpis(contas) {
    const valid = contas.filter(isContaValida);
    const findRoot = (cod) => valid.find((c) => normalizeCodigo(c.codigo) === cod);
    const ativo = findRoot('1');
    const passivo = findRoot('2');
    const resultado = findRoot('3');
    const analiticas = valid.filter((c) => effectiveBalNivel(c) >= 4).length;

    function setKpiCard(id, val, nat, isNeg) {
      const card = document.getElementById(id);
      if (!card) return;
      const vEl = card.querySelector('.kpi-val');
      const sub = card.querySelector('.kpi-sub');
      if (vEl) {
        vEl.textContent = val != null ? 'R$ ' + fmt(val) : '\u2014';
        vEl.className = 'kpi-val' + (isNeg ? ' t-danger' : '');
      }
      if (sub && nat) {
        sub.innerHTML = 'Natureza <span class="bal-nat ' + String(nat).toUpperCase() + '">' + String(nat).toUpperCase() + '</span>';
      }
    }

    setKpiCard('bal-kpi-ativo', ativo ? ativo.saldoAtual : null, ativo ? ativo.naturezaAtual : null, false);
    setKpiCard('bal-kpi-passivo', passivo ? passivo.saldoAtual : null, passivo ? passivo.naturezaAtual : null, false);
    setKpiCard('bal-kpi-resultado', resultado ? resultado.saldoAtual : null, resultado ? resultado.naturezaAtual : null, (resultado ? resultado.saldoAtual : 0) < 0);
    setHTML('#bal-kpi-contas .kpi-val', String(analiticas));
  }

  function renderBalanceteRows() {
    const bal = D().balancete;
    if (!bal || !balMesKey || !bal.porMes || !bal.porMes[balMesKey]) return;
    const pack = bal.porMes[balMesKey];
    const tbody = document.getElementById('bal-tbody');
    const tfoot = document.getElementById('bal-tfoot');
    if (!tbody) return;

    renderBalanceteHeader(bal, balMesKey);
    const saldosIndex = buildBalSaldosIndex(bal);
    const colSpan = balColCount(bal);

    const valid = pack.contas.filter(isContaValida);
    updateBalKpis(valid);

    const filters = getBalFilters();
    const tree = buildBalTree(valid);
    balTreeMap = tree.treeMap;
    const grupoFiltered = tree.nodes.filter((node) => passesBalGrupoFilter(node, filters.grupo));

    if (filters.search) {
      grupoFiltered.forEach((node) => {
        const hay = (node.codigoNorm + ' ' + (node.descricao || '')).toLowerCase();
        if (hay.indexOf(filters.search) === -1) return;
        getBalAncestors(node.codigoNorm, tree.treeMap).forEach((a) => balExpanded.add(a));
      });
    }

    const searchVisible = getBalSearchVisibleSet(grupoFiltered, tree.treeMap, filters.search);
    const visibleRows = grupoFiltered.filter((node) => {
      if (!isBalRowVisible(node, balExpanded, tree.treeMap)) return false;
      if (searchVisible && !searchVisible.has(node.codigoNorm)) return false;
      return true;
    });

    tbody.innerHTML = '';
    let zebra = 0;

    visibleRows.forEach((c) => {
      const tr = document.createElement('tr');
      const cls = balRowClasses(c);
      if (cls.indexOf('bal-analytic') !== -1) {
        zebra += 1;
        tr.className = cls + (zebra % 2 === 0 ? ' bal-zebra' : '');
      } else {
        tr.className = cls;
      }
      if (c.hasChildren) {
        tr.dataset.balCod = c.codigoNorm;
        tr.dataset.balExpandable = '1';
      }
      tr.innerHTML =
        '<td><span class="bal-cod">' + c.codigoNorm + '</span></td>' +
        balDescCell(c, { hasChildren: c.hasChildren, expanded: balExpanded.has(c.codigoNorm) }) +
        balMesSaldoCells(c.codigoNorm, saldosIndex, bal, balMesKey);
      tbody.appendChild(tr);
    });

    if (tfoot) {
      if (visibleRows.length) {
        const emptyMesCells = bal.meses.map((mesKey) => {
          const cls = ['r', 'bal-col-mes'];
          if (mesKey === balMesKey) cls.push('bal-col-focus');
          return '<td class="' + cls.join(' ') + '">\u2014</td>';
        }).join('');
        let footHtml =
          '<tr><td colspan="2">Totais visiveis (' + visibleRows.length + ' contas)</td>' +
          emptyMesCells +
          '<td class="r bal-col-mes bal-col-total td-val">\u2014</td></tr>';
        if (isBalRootSummary(visibleRows)) {
          footHtml +=
            '<tr class="bal-foot-summary"><td colspan="2">Fechamento (contas 1, 2 e 3)</td>' +
            balFooterMesCells(saldosIndex, ['1', '2', '3'], bal, balMesKey) +
            '</tr>';
        }
        tfoot.innerHTML = footHtml;
      } else {
        tfoot.innerHTML =
          '<tr><td colspan="' + colSpan + '" class="td-mute" style="text-align:center;padding:20px;">' +
          'Nenhuma conta encontrada para os filtros aplicados</td></tr>';
      }
    }

    const countEl = document.getElementById('bal-row-count');
    if (countEl) {
      let label = visibleRows.length + ' de ' + grupoFiltered.length + ' contas visiveis';
      if (filters.grupo || filters.search) label += ' (filtrado)';
      countEl.textContent = label;
    }
  }

