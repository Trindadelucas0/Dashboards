    renderMargensTableFoot('vd-margens-cidades-tfoot', {
      qtde: (pack.cidades || []).reduce((a, c) => a + (c.qtde || 0), 0),
      vendas: t.vendas,
      custo: t.custo,
      lucroLiquido: t.lucroLiquido,
