  window.openDrilldown = function (cfop) {
    if (activeDrilldownCfop === cfop) { closeDrilldown(); return; }
    activeDrilldownCfop = cfop;
    const pack = getFiscalPack(appMesFiscal);
    const item = pack && pack.cfopEntradas ? pack.cfopEntradas.find((d) => d.cfop === cfop) : null;
