  });

  const cfSai = D.cfop_saidas.slice(0,8);
  safeChart(gid(pfx, 'chartCfopSai'), {
    type:'doughnut',
    data:{ labels: cfSai.length ? cfSai.map(c=>c.cfop) : ['—'], datasets:[{ data: cfSai.length ? cfSai.map(c=>c.total) : [1], backgroundColor:PAL, borderWidth:0 }] },
