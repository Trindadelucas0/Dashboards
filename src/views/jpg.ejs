    data:{ labels: cf.length ? cf.map(c=>c.cfop) : ['—'], datasets:[{ data: cf.length ? cf.map(c=>c.total/1000) : [0], backgroundColor:'rgba(59,130,246,0.7)', borderRadius:4 }] },
