      <div class="table-card"><div class="table-head"><div><div class="ttl">Ranking de Fornecedores</div></div></div><div class="tbl-scroll"><table><thead><tr><th>#</th><th>Fornecedor</th><th>UF</th><th class="r">Valor</th><th class="r">Base</th><th class="r">ICMS</th><th>Part.</th><th class="r">NF</th></tr></thead><tbody id="tblFornecedores"></tbody></table></div></div>
      <div class="table-card"><div class="table-head"><div><div class="ttl">Notas Fiscais de Entrada</div><div class="sub">Detalhe linha a linha</div></div></div><div class="tbl-scroll" style="max-height:360px"><table><thead><tr><th>NF</th><th>Data</th><th>CFOP</th><th>Fornecedor</th><th>UF</th><th class="r">Valor</th><th class="r">Base</th><th class="r">ICMS</th><th class="r">IPI</th></tr></thead><tbody id="tblNotasEntradas"></tbody></table></div></div>`,
    'finalidade': `
      <div class="kpi-grid kpi-grid-4" id="kpiFinalidade"></div>
      <div class="charts-row cr-2col">
        <div class="chart-card"><div class="chart-wrap h260"><canvas id="chartFinalidade"></canvas></div></div>
        <div class="chart-card"><div class="chart-wrap h260"><canvas id="chartCfopEnt"></canvas></div></div>
      </div>
      <div class="table-card"><div class="tbl-scroll"><table><thead><tr><th>CFOP</th><th>Descrição</th><th>Finalidade</th><th>Créd.</th><th class="r">Qtd</th><th class="r">Valor</th><th class="r">Base</th><th class="r">ICMS</th><th class="r">IPI</th><th>Part.</th><th class="c">Det.</th></tr></thead><tbody id="tblCfopEnt"></tbody></table></div></div>`,
    'vendas': `
      <div class="kpi-grid kpi-grid-4" id="kpiVendas"></div>
      <div class="charts-row cr-2col">
        <div class="chart-card"><div class="chart-wrap h300"><canvas id="chartClientes"></canvas></div></div>
        <div class="chart-card"><div class="chart-wrap h300"><canvas id="chartCfopVendas"></canvas></div></div>
      </div>
      <div class="table-card"><div class="tbl-scroll"><table><thead><tr><th>#</th><th>Cliente</th><th>UF</th><th class="r">Valor</th><th class="r">Base</th><th class="r">ICMS</th><th>Part.</th><th class="r">NF</th></tr></thead><tbody id="tblClientes"></tbody></table></div></div>
      <div class="table-card"><div class="table-head"><div><div class="ttl">CFOP — Saídas</div></div></div><div class="tbl-scroll"><table><thead><tr><th>CFOP</th><th>Descrição</th><th class="r">Qtd</th><th class="r">Valor</th><th class="r">Base</th><th class="r">ICMS</th><th class="r">IPI</th><th>Part.</th></tr></thead><tbody id="tblCfopSai"></tbody></table></div></div>
      <div class="table-card"><div class="table-head"><div><div class="ttl">Notas Fiscais de Saída</div><div class="sub">Detalhe linha a linha</div></div></div><div class="tbl-scroll" style="max-height:360px"><table><thead><tr><th>NF</th><th>Data</th><th>CFOP</th><th>Cliente</th><th>UF</th><th class="r">Valor</th><th class="r">Base</th><th class="r">ICMS</th><th class="r">IPI</th></tr></thead><tbody id="tblNotasSaidas"></tbody></table></div></div>`,
    'dre': `
      <div class="formula-box"><div class="fttl">Metodologia</div><div class="fline">Receita = Saídas ICMS · CMV = Entradas ICMS · Resultado = Lucro Bruto − Saldo ICMS</div></div>
      <div class="margin-grid" id="dreMargins"></div>
      <div class="table-card"><div class="tbl-scroll"><table class="dre-tbl"><tbody id="tblDre"></tbody></table></div></div>`,
  };
  return blocks[tabType] || '';
}

/* Dashboard JPG único — competência mensal (visão consolidada) */

const J = JPG_DATA;
let unidadeAtiva = 'TODAS';
let appMesFiscal = null;
let appTrimestre = null;
const tabsInit = {};

const FISCAL_MES_BAR_IDS = ['comp-mes-bar', 'vg-mes-bar', 'ent-mes-bar', 'fn-mes-bar', 'vnd-mes-bar', 'dre-mes-bar'];
const SEC_COMPETENCIA_IDS = ['comp-sec-competencia', 'vg-sec-competencia', 'ent-sec-competencia', 'fn-sec-competencia', 'vnd-sec-competencia', 'dre-sec-competencia'];
const SEC_SUB_IDS = ['compSub', 'vgSub', 'entSub', 'fin-sec-sub', 'vndSub', 'dreSub'];

const TAB_RENDER = {
  'visao-geral': renderVisaoGeral,
  'entradas': renderEntradas,
  'vendas': renderVendas,
  'dre': renderDRE,
};

const TAB_PANEL = {
  'visao-geral': 'panel-visao-geral',
  'entradas': 'panel-entradas',
  'vendas': 'panel-vendas',
  'dre': 'panel-dre',
};

const FINALIDADE_CORES = {
  'Transferência Matriz': '#3b82f6',
  'Remessa p/ Filial': '#8b5cf6',
  'Devol. Compra': '#f59e0b',
  'Devolução Venda': '#ef4444',
  'Retorno Ind.': '#06b6d4',
  'Outras Entradas': '#64748b',
  'Outros': '#94a3b8',
};

function getFiscal() {
  const fp = J.fiscalPorMes;
  if (fp && fp.meses && fp.meses.length) return fp;
  if (J.empresa && J.filiais) {
    const k = 'legacy';
    return {
      meses: [k],
      mesLabels: [J.meta.periodo || '—'],
      monthShort: [J.meta.periodo || '—'],
      porMes: {
        [k]: {
          competencia: k,
          competenciaLabel: J.meta.periodo || '—',
          periodo: J.meta.periodo || '—',
          ordem: J.ordem || ['MG', 'PR', 'SP', 'MATRIZ'],
          empresa: J.empresa,
          filiais: J.filiais,
        },
      },
    };
  }
  return { meses: [], mesLabels: [], porMes: {} };
}

function fiscalPeriodTotalLabel() {
  const fp = getFiscal();
  if (!fp.meses || !fp.meses.length) return 'Total';
  const a = fp.mesLabels && fp.mesLabels[0] ? fp.mesLabels[0].split('/')[0] : fp.meses[0];
  const b = fp.mesLabels && fp.mesLabels.length
    ? fp.mesLabels[fp.mesLabels.length - 1].split('/')[0]
    : fp.meses[fp.meses.length - 1];
  const yyyy = fp.mesLabels && fp.mesLabels.length
    ? fp.mesLabels[fp.mesLabels.length - 1].split('/')[1]
    : '';
  return yyyy ? a + ' – ' + b + ' / ' + yyyy : a + ' – ' + b;
}

function fiscalMesLabel(mesKey) {
  const fp = getFiscal();
  const i = fp.meses.indexOf(mesKey);
  if (i >= 0 && fp.mesLabels) return fp.mesLabels[i];
  return mesKey;
}

function fiscalDisplayLabel(mesKey) {
  if (mesKey === 'total') return fiscalPeriodTotalLabel();
  return fiscalMesLabel(mesKey);
}

function getFiscalPack(mesKey) {
  const fp = getFiscal();
  const key = mesKey || appMesFiscal || fp.meses[fp.meses.length - 1];
  if (key === 'total' && fp.porMes && fp.porMes.total) return fp.porMes.total;
  if (fp.porMes && fp.porMes[key]) return fp.porMes[key];
  const last = fp.meses[fp.meses.length - 1];
  return fp.porMes[last] || null;
}

function getTrimestrePack(qKey) {
  const tr = J.trimestres;
  if (!tr || !tr.porTrimestre || !qKey) return null;
  return tr.porTrimestre[qKey] || null;
}

function getActivePack() {
  if (appTrimestre) {
    const tp = getTrimestrePack(appTrimestre);
    if (tp) return tp;
  }
  return getFiscalPack(appMesFiscal);
}

function getPackOrdem(pack) {
  return pack.ordem || ['MG', 'PR', 'SP', 'MATRIZ'];
}

function getCompetenciaLabel() {
  const pack = getActivePack();
  return pack ? (pack.competenciaLabel || pack.periodo || '—') : '—';
}

window.getJpgCompetenciaLabel = getCompetenciaLabel;

function isTotalMode() {
  return appMesFiscal === 'total' && !appTrimestre;
}

function getScopeData() {
  const pack = getActivePack();
  if (!pack) return null;
  if (unidadeAtiva === 'TODAS') {
    return pack.empresa;
  }
  return pack.filiais[unidadeAtiva];
}

function setFiscalDataStatus(elId, ok, okMsg, warnMsg) {
  const el = document.getElementById(elId);
  if (!el) return;
  el.className = 'fiscal-data-status ' + (ok ? 'ok' : 'warn');
  el.innerHTML = '<i class="fas fa-' + (ok ? 'check-circle' : 'exclamation-triangle') + '"></i> ' + (ok ? okMsg : warnMsg);
}

function resetPanelCache() {
  Object.values(TAB_PANEL).forEach((id) => {
    const p = document.getElementById(id);
    if (p) {
      delete p.dataset.built;
      p.innerHTML = '';
    }
  });
}

function updateTabSubtitle() {
  updatePeriodLabels();
}

function trimestreButtonLabel(qkey) {
  const qnum = parseInt(String(qkey).split('Q')[1], 10);
  return (isNaN(qnum) ? qkey : qnum) + 'º Trim';
}

function trimestreForMonthKey(mesKey) {
  if (!mesKey || mesKey === 'total') return '';
  const tr = J.trimestres;
  if (tr && tr.trimestres) {
    const fp = getFiscal();
    for (let i = 0; i < tr.trimestres.length; i++) {
      const qkey = tr.trimestres[i];
      const yyyy = qkey.split('-')[0];
      const qnum = parseInt(qkey.split('Q')[1], 10);
      const inQ = fp.meses.some((m) => {
        const [y, mm] = m.split('-');
        return y === yyyy && Math.ceil(parseInt(mm, 10) / 3) === qnum;
      });
      if (inQ && fp.meses.includes(mesKey)) {
        const [y, mm] = mesKey.split('-');
        if (y === yyyy && Math.ceil(parseInt(mm, 10) / 3) === qnum) {
          return trimestreButtonLabel(qkey);
        }
      }
    }
  }
  const mm = parseInt(mesKey.split('-')[1], 10);
  if (isNaN(mm)) return '';
  return Math.ceil(mm / 3) + 'º Trim';
}

function getPeriodScopeLabel() {
  if (unidadeAtiva === 'TODAS') return 'Consolidado';
  const pack = getActivePack();
  if (pack && pack.filiais[unidadeAtiva]) return pack.filiais[unidadeAtiva].meta.filial_label;
  return 'JPG';
}

function getPeriodFull() {
  if (appTrimestre) {
    const tr = J.trimestres || {};
    const i = (tr.trimestres || []).indexOf(appTrimestre);
    const label = i >= 0 ? tr.trimestreLabels[i] : appTrimestre;
    return String(label).replace('/', ' / ');
  }
  if (appMesFiscal === 'total') return fiscalPeriodTotalLabel();
  const lbl = fiscalMesLabel(appMesFiscal);
  if (lbl.includes('/')) {
    const parts = lbl.split('/');
    return parts[0] + ' / ' + parts[1];
  }
  return lbl;
}

function getPeriodContext() {
  if (appTrimestre) return ' — ' + trimestreButtonLabel(appTrimestre);
  if (appMesFiscal && appMesFiscal !== 'total') {
    const t = trimestreForMonthKey(appMesFiscal);
    return t ? ' — ' + t : '';
  }
  return '';
}

function getPeriodSubText() {
  return getPeriodScopeLabel() + ' — ' + getPeriodFull() + getPeriodContext();
}

function getActivePeriodKey() {
  if (appTrimestre) return appTrimestre;
  if (appMesFiscal) return appMesFiscal;
  const fp = getFiscal();
  return fp.meses.length ? fp.meses[fp.meses.length - 1] : '';
}

function isPeriodActive(key) {
  if (appTrimestre) return appTrimestre === key;
  if (key === 'total') return appMesFiscal === 'total';
  return !appTrimestre && appMesFiscal === key;
}

function setMesBarActive(containerId, mesKey) {
  const bar = document.getElementById(containerId);
  if (!bar) return;
  const activeKey = mesKey !== undefined && mesKey !== '' ? mesKey : getActivePeriodKey();
  bar.querySelectorAll('.vd-mes-chip').forEach((chip) => {
    chip.classList.toggle('active', chip.getAttribute('data-mes') === activeKey);
  });
}

function syncFiscalMesBars(mesKey) {
  const key = mesKey !== undefined && mesKey !== '' ? mesKey : getActivePeriodKey();
  FISCAL_MES_BAR_IDS.forEach((id) => setMesBarActive(id, key));
}

function getDisplayYear() {
  const fp = getFiscal();
  if (fp.meses && fp.meses.length) return fp.meses[0].split('-')[0];
  const m = J.meta.competenciaDefault || '';
  return m.includes('-') ? m.split('-')[0] : '2026';
}

const MONTH_SHORT = {
  '01': 'Jan', '02': 'Fev', '03': 'Mar', '04': 'Abr', '05': 'Mai', '06': 'Jun',
  '07': 'Jul', '08': 'Ago', '09': 'Set', '10': 'Out', '11': 'Nov', '12': 'Dez',
};

function getTrimestreSlots() {
  const yyyy = getDisplayYear();
  const tr = J.trimestres || {};
  const por = tr.porTrimestre || {};
  return [1, 2].map((q) => {
    const key = `${yyyy}-Q${q}`;
    return { key, label: `${q}º Trim`, available: !!por[key] };
  });
}

function getAllMonthSlotsForYear() {
  const yyyy = getDisplayYear();
  const fp = getFiscal();
  const available = new Set(fp.meses || []);
  const maxMm = fp.meses && fp.meses.length
    ? Math.max(...fp.meses.map((m) => parseInt(m.split('-')[1], 10)))
    : 5;
  const slots = [];
  for (let mm = 1; mm <= maxMm; mm++) {
    const key = `${yyyy}-${String(mm).padStart(2, '0')}`;
    slots.push({
      key,
      label: MONTH_SHORT[String(mm).padStart(2, '0')],
      available: available.has(key),
    });
  }
  return slots;
}

function renderPeriodBar(containerId) {
  const bar = document.getElementById(containerId);
  if (!bar) return;
  const fp = getFiscal();
  const tr = J.trimestres || {};
  bar.innerHTML = '';

  const addChip = (key, label, extraClass, disabled) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'vd-mes-chip' + (extraClass ? ' ' + extraClass : '') + (disabled ? ' disabled' : '');
    btn.setAttribute('data-mes', key);
    btn.textContent = label;
    if (disabled) btn.disabled = true;
    else if (isPeriodActive(key)) btn.classList.add('active');
    bar.appendChild(btn);
  };

  addChip('total', 'Total', 'tot', !fp.meses || fp.meses.length < 2);

  getTrimestreSlots().forEach((t) => {
    addChip(t.key, t.label, 'trim', !t.available);
  });

  const sep = document.createElement('span');
  sep.className = 'vd-mes-sep';
  sep.textContent = '|';
  bar.appendChild(sep);

  getAllMonthSlotsForYear().forEach((slot) => {
    addChip(slot.key, slot.label, '', !slot.available);
  });

  bar.querySelectorAll('.vd-mes-chip:not(:disabled)').forEach((chip) => {
    chip.onclick = () => {
      const key = chip.getAttribute('data-mes');
      if (key === 'total') {
        setAppMesFiscal('total');
      } else if (tr.trimestres && tr.trimestres.includes(key)) {
        setAppTrimestre(key);
      } else {
        setAppMesFiscal(key);
      }
    };
  });
}

function buildFiscalMesBars() {
  FISCAL_MES_BAR_IDS.forEach((id) => renderPeriodBar(id));
  syncFiscalMesBars();
}

function setAppTrimestre(qKey) {
  appTrimestre = qKey;
  appMesFiscal = null;
  const sel = document.getElementById('mesSelect');
  if (sel) sel.value = '';
  buildFiscalMesBars();
  updatePeriodLabels();
  rerenderAllTabs();
}

function getViewData() {
  const pack = getActivePack();
  if (!pack) return { isTodas: true, kpis: {}, dre: {}, label: '—', scopeLabel: '—' };
  const competencia = getCompetenciaLabel();
  if (unidadeAtiva === 'TODAS') {
    const emp = pack.empresa;
    return {
      isTodas: true,
      kpis: emp.kpis,
      dre: emp.dre,
      ranking_fornecedores: emp.ranking_fornecedores,
      ranking_clientes: emp.ranking_clientes,
      label: J.meta.empresa + ' · ' + competencia,
      scopeLabel: 'Empresa (todas as unidades)',
      competenciaLabel: competencia,
    };
  }
  const f = pack.filiais[unidadeAtiva];
  return {
    isTodas: false,
    data: f,
    kpis: f.kpis,
    dre: f.dre,
    ranking_fornecedores: f.ranking_fornecedores,
    ranking_clientes: f.ranking_clientes,
    label: f.meta.filial_label + ' · CNPJ ' + f.meta.cnpj,
    scopeLabel: f.meta.filial_label,
    meta: f.meta,
    serie_diaria: f.serie_diaria,
    competenciaLabel: competencia,
  };
}

function initPeriodSelector() {
  const fp = getFiscal();
  const sel = document.getElementById('mesSelect');
  if (!sel || !fp.meses.length) return;
  sel.innerHTML = '';
  fp.meses.forEach((m, i) => {
    const opt = document.createElement('option');
    opt.value = m;
    opt.textContent = fp.mesLabels[i] || m;
    sel.appendChild(opt);
  });
  if (fp.meses.length > 1) {
    const optTot = document.createElement('option');
    optTot.value = 'total';
    optTot.textContent = fiscalPeriodTotalLabel();
    sel.appendChild(optTot);
  }
  const def = J.meta.competenciaDefault || fp.meses[fp.meses.length - 1];
  appMesFiscal = def;
  sel.value = def;
  sel.onchange = () => {
    appTrimestre = null;
    setAppMesFiscal(sel.value);
  };
}

function updatePeriodLabels() {
  const lbl = getCompetenciaLabel();
  const compSmall = 'Competência ' + lbl;
  const subText = getPeriodSubText();
  const range = J.meta.periodoRange || lbl;
  document.getElementById('logoSubtitle').textContent = range;
  document.getElementById('sidebarPeriodo').textContent = lbl;
  SEC_COMPETENCIA_IDS.forEach((id) => {
    const el = document.getElementById(id);
    if (el) el.textContent = compSmall;
  });
  SEC_SUB_IDS.forEach((id) => {
    const el = document.getElementById(id);
    if (el) el.textContent = subText;
  });
}

function updateHeaderSubtitle(tabName) {
  const titles = {
    comparativo: 'Comparativo Filiais',
    'visao-geral': 'Visão Geral',
    entradas: 'Entradas',
    finalidade: 'Finalidade de Compras',
    vendas: 'Vendas',
    dre: 'DRE',
  };
  document.getElementById('headerTitle').innerHTML = (titles[tabName] || 'Dashboard') + ' <span>' + getPeriodSubText() + '</span>';
}

function setAppMesFiscal(mesKey, opts) {
  appMesFiscal = mesKey;
  appTrimestre = null;
  const sel = document.getElementById('mesSelect');
  if (sel && mesKey !== 'total' && sel.value !== mesKey) sel.value = mesKey;
  buildFiscalMesBars();
  updatePeriodLabels();
  if (!opts || !opts.skipRerender) rerenderAllTabs();
}

function rerenderAllTabs() {
  Object.keys(tabsInit).forEach((k) => { tabsInit[k] = false; });
  resetPanelCache();
  const active = document.querySelector('.tab-section.active');
  if (active) {
    const name = active.id.replace('tab-', '');
    showTab(name);
  }
}

function initMeta() {
  document.title = 'Dashboard JPG — ICMS';
  document.getElementById('logoCompany').textContent = 'JPG';
  updatePeriodLabels();
}

function updateNavComparativo() {
  const nav = document.getElementById('nav-comparativo');
  if (!nav) return;
  if (unidadeAtiva === 'TODAS') {
    nav.classList.remove('nav-hidden');
  } else {
    nav.classList.add('nav-hidden');
    const active = document.querySelector('.tab-section.active');
    if (active && active.id === 'tab-comparativo') showTab('visao-geral');
  }
}

function updateSupplierHeaderBtn() {
  const btn = document.getElementById('btnSupplierHeader');
  if (!btn) return;
  const D = getScopeData();
  if (D && (D.cfop_entradas || []).length) {
    btn.style.display = '';
    registerJpgCtx('ACTIVE', D, D.meta?.filial_label || 'JPG');
  } else {
    btn.style.display = 'none';
  }
}

function openSupplierModalActive() {
  const D = getScopeData();
  if (!D) return;
  openSupplierModal(jpgCtxRegistry.ACTIVE || makeJpgContext(D, D.meta?.filial_label));
}

function initFinalidade() {
  const D = getScopeData();
  if (!D) return;
  const competencia = getCompetenciaLabel();
  const scopeLabel = D.meta?.filial_label || (unidadeAtiva === 'TODAS' ? 'Empresa (consolidado)' : unidadeAtiva);
  registerJpgCtx('ACTIVE', D, scopeLabel);

  const entradas = D.kpis?.entradas || 0;
  const cfops = D.cfop_entradas || [];
  const sumCfop = cfops.reduce((a, c) => a + (c.total || 0), 0);
  const ok = Math.abs(sumCfop - entradas) < 0.02;
  setFiscalDataStatus(
    'fn-data-status',
    ok,
    'Conferência OK — CFOPs = total entradas (' + cfops.length + ' CFOPs · ' + brl(entradas) + ')',
    'Divergência: CFOPs ' + brl(sumCfop) + ' vs total entradas ' + brl(entradas)
  );

  const fin = D.finalidade || [];
  const colors = ['green', 'cyan', 'orange', 'purple'];
  const finGrid = document.getElementById('fin-kpi-grid');
  if (finGrid) {
    finGrid.innerHTML = fin.slice(0, 4).map((f, i) =>
      kpiCard(colors[i] || 'blue', 'fas fa-tag', competencia, brl(f.total), f.finalidade, f.pct + '% do total · ' + f.qtd + ' NF')
    ).join('') || kpiCard('blue', 'fas fa-minus', '—', 'R$ 0,00', 'Sem entradas', '—');
  }

  const finDistSub = document.getElementById('fn-chart-dist-sub');
  const finBarSub = document.getElementById('fn-chart-bar-sub');
  if (finDistSub) finDistSub.textContent = '% do valor total de entradas — ' + competencia + ' (' + brl(entradas) + ')';
  if (finBarSub) finBarSub.textContent = 'Comparativo dos grupos fiscais — ' + competencia;

  const grupos = {};
  cfops.forEach((c) => {
    const fn = c.finalidade || 'Outros';
    grupos[fn] = (grupos[fn] || 0) + c.total;
  });
  const labels = Object.keys(grupos).sort((a, b) => grupos[b] - grupos[a]);
  const vals = labels.map((k) => grupos[k]);
  const cores = labels.map((k) => FINALIDADE_CORES[k] || '#64748b');

  safeChart('chartFinalidadeDist', {
    type: 'doughnut',
    data: { labels, datasets: [{ data: vals, backgroundColor: cores, borderWidth: 0 }] },
    options: {
      responsive: true, maintainAspectRatio: false, cutout: '55%',
      plugins: { legend: { ...leg(), position: 'right' }, tooltip: { ...tip(), callbacks: { label: (c) => c.label + ': ' + brl(c.parsed) } } },
    },
  });

  safeChart('chartFinalidadeBar', {
    type: 'bar',
    data: { labels, datasets: [{ data: vals.map((v) => v / 1000), backgroundColor: cores, borderRadius: 4 }] },
    options: {
      indexAxis: 'y', responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { ...tip(), callbacks: { label: (c) => brl(c.parsed.x * 1000) } } },
      scales: { x: { ticks: { callback: (v) => 'R$' + v + 'K' } } },
    },
  });

  const tbody = document.getElementById('cfop-tbody');
  if (tbody) {
    const totalCf = entradas || 1;
    const sorted = cfops.slice().sort((a, b) => (b.total || 0) - (a.total || 0));
    tbody.innerHTML = sorted.map((c) => {
      const cor = FINALIDADE_CORES[c.finalidade] || '#64748b';
      const p = totalCf ? (100 * c.total / totalCf).toFixed(1) : '0.0';
      const cfEsc = String(c.cfop).replace(/'/g, "\\'");
      return '<tr><td><span class="chip bl">' + escHtml(c.cfop) + '</span></td>' +
        '<td style="font-size:12px">' + escHtml(c.descricao) + '</td>' +
        '<td><span class="chip" style="background:' + cor + '22;color:' + cor + '">' + escHtml(c.finalidade) + '</span></td>' +
        '<td class="c">' + credIcmsChip(c) + '</td><td class="r">' + c.qtd + '</td>' +
        '<td class="r td-val">' + brl(c.total) + '</td><td class="r">' + pbRow(parseFloat(p)) + '</td>' +
        '<td class="c"><button type="button" onclick="openDrilldown(\'' + cfEsc + '\', jpgCtxRegistry[\'ACTIVE\'])" style="background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.3);color:var(--accent);padding:4px 10px;border-radius:6px;cursor:pointer;font-size:11px;">Detalhes</button></td></tr>';
    }).join('') || '<tr><td colspan="8" class="td-mute">Sem entradas no período</td></tr>';
  }

  updateSupplierHeaderBtn();
  closeDrilldown();
}

function onUnidadeChange(val) {
  unidadeAtiva = val;
  updateNavComparativo();
  resetPanelCache();
  updatePeriodLabels();
  const activeTab = document.querySelector('.tab-section.active');
  if (activeTab) {
    const name = activeTab.id.replace('tab-', '');
    if (name !== 'comparativo') {
      tabsInit[name] = false;
      if (name === 'finalidade') initFinalidade();
      else renderTabContent(name);
      tabsInit[name] = true;
    }
  }
  closeDrilldown();
  updateHeaderSubtitle(document.querySelector('.tab-section.active')?.id?.replace('tab-', '') || 'visao-geral');
}

function renderTabContent(tabName) {
  if (tabName === 'finalidade') {
    initFinalidade();
    return;
  }
  const panel = document.getElementById(TAB_PANEL[tabName]);
  if (!panel) return;
  const D = getScopeData();
  if (!D) return;
  const renderFn = TAB_RENDER[tabName];
  if (!renderFn) return;

  if (!panel.dataset.built) {
    panel.innerHTML = singleFilialBlockHTML(tabName);
    panel.dataset.built = '1';
  }

  const scopeLabel = D.meta?.filial_label || J.meta.empresa;
  registerJpgCtx('ACTIVE', D, scopeLabel);
  renderFn(D, '');
  updatePeriodLabels();
}

function initComparativo() {
  const pack = getActivePack();
  if (!pack) return;
  const emp = pack.empresa;
  const ordem = getPackOrdem(pack);
  const competencia = getCompetenciaLabel();
  const evo = J.evolucaoMensal;
  const showEvo = isTotalMode() && evo && evo.meses && evo.meses.length > 1;

  document.getElementById('kpiComparativo').innerHTML =
    kpiCard('green', 'fas fa-cart-shopping', competencia, brl(emp.kpis.entradas), 'Total Entradas', emp.kpis.n_nf_ent + ' NF-e · Base ' + brl(emp.kpis.base_icms_ent || 0)) +
    kpiCard('blue', 'fas fa-store', competencia, brl(emp.kpis.saidas), 'Total Vendas', emp.kpis.n_nf_sai + ' NF-e · Base ' + brl(emp.kpis.base_icms_sai || 0)) +
    kpiCard('yellow', 'fas fa-file-invoice-dollar', 'ICMS', brl(emp.kpis.saldo_icms), 'Saldo ICMS', 'Débito ' + brl(emp.kpis.icms_debito) + ' − Crédito ' + brl(emp.kpis.icms_credito)) +
    kpiCard('purple', 'fas fa-receipt', 'IPI', brl((emp.kpis.ipi_ent || 0) + (emp.kpis.ipi_sai || 0)), 'IPI Total', 'Ent. ' + brl(emp.kpis.ipi_ent || 0) + ' · Saí. ' + brl(emp.kpis.ipi_sai || 0));

  const cardsExtra = ordem.map((key) => {
    const d = pack.filiais[key];
    const dr = d.dre;
    return kpiCard(
      key === 'MATRIZ' ? 'purple' : key === 'SP' ? 'blue' : key === 'PR' ? 'green' : 'yellow',
      'fas fa-building',
      d.meta.filial_label.replace('Filial ', '').replace('Matriz DF', 'Matriz'),
      brl(dr.resultado),
      'Resultado após ICMS',
      'Vendas ' + brl(d.kpis.saidas)
    );
  });
  const elExtra = document.getElementById('kpiComparativoExtra');
  if (elExtra) elExtra.innerHTML = cardsExtra.join('');

  const labels = ordem.map((k) => pack.filiais[k].meta.filial_label.replace('Filial ', '').replace('Matriz DF', 'Matriz'));
  const entradas = ordem.map((k) => pack.filiais[k].kpis.entradas);
  const saidas = ordem.map((k) => pack.filiais[k].kpis.saidas);
  const icms = ordem.map((k) => pack.filiais[k].kpis.saldo_icms);
  const totalVendas = saidas.reduce((a, b) => a + b, 0);

  if (showEvo) {
    safeChart('chartCompFilial', {
      type: 'bar',
      data: {
        labels: evo.mesLabels,
        datasets: [
          { label: 'Entradas', data: evo.entradas, backgroundColor: 'rgba(16,185,129,0.75)', borderRadius: 4 },
          { label: 'Vendas', data: evo.vendas, backgroundColor: 'rgba(59,130,246,0.75)', borderRadius: 4 },
        ],
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: leg(), tooltip: { ...tip(), callbacks: { label: (c) => c.dataset.label + ': ' + brl(c.parsed.y) } } },
        scales: { y: { ticks: { callback: (v) => brlK(v) } } },
      },
    });
  } else {
    safeChart('chartCompFilial', {
      type: 'bar',
      data: {
        labels,
        datasets: [
          { label: 'Entradas', data: entradas, backgroundColor: 'rgba(16,185,129,0.75)', borderRadius: 4 },
          { label: 'Vendas', data: saidas, backgroundColor: 'rgba(59,130,246,0.75)', borderRadius: 4 },
        ],
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: leg(), tooltip: { ...tip(), callbacks: { label: (c) => c.dataset.label + ': ' + brl(c.parsed.y) } } },
        scales: { y: { ticks: { callback: (v) => brlK(v) } } },
      },
    });
  }

  safeChart('chartIcmsFilial', {
    type: 'bar',
    data: {
      labels: showEvo ? evo.mesLabels : labels,
      datasets: [{
        label: showEvo ? 'Saldo ICMS' : 'Saldo ICMS',
        data: showEvo ? evo.saldo_icms : icms,
        backgroundColor: (showEvo ? evo.saldo_icms : icms).map((v) => (v >= 0 ? 'rgba(245,158,11,0.75)' : 'rgba(16,185,129,0.75)')),
        borderRadius: 4,
      }],
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { ...tip(), callbacks: { label: (c) => brl(c.parsed.y) } } },
      scales: { y: { ticks: { callback: (v) => brl(v) } } },
    },
  });

  safeChart('chartParticipacao', {
    type: 'doughnut',
    data: { labels, datasets: [{ data: saidas, backgroundColor: PAL_MIX.slice(0, labels.length), borderWidth: 0 }] },
    options: {
      responsive: true, maintainAspectRatio: false, cutout: '55%',
      plugins: {
        legend: { position: 'right', labels: { boxWidth: 10, padding: 12 } },
        tooltip: {
          ...tip(),
          callbacks: {
            label: (c) => {
              const pctVal = totalVendas ? (100 * c.parsed / totalVendas).toFixed(1) : 0;
              return c.label + ': ' + brl(c.parsed) + ' (' + pctVal + '%)';
            },
          },
        },
      },
    },
  });

  const sumEnt = emp.kpis.entradas;
  const sumVnd = emp.kpis.saidas;
  const sumRes = emp.dre.resultado;
  let rows = ordem.map((key) => {
    const d = pack.filiais[key];
    const k = d.kpis;
    const dr = d.dre;
    return '<tr>' +
      '<td><span class="chip bl">' + d.meta.filial_label + '</span></td>' +
      '<td class="td-mute">' + d.meta.codigo + '</td>' +
      '<td class="td-mute" style="font-size:11px">' + d.meta.cnpj + '</td>' +
      '<td class="r td-val">' + brl(k.entradas) + '</td>' +
      '<td class="r td-val">' + brl(k.saidas) + '</td>' +
      '<td class="r">' + brl(k.saldo_icms) + '</td>' +
      '<td class="r">' + k.n_nf_ent + '</td>' +
      '<td class="r">' + k.n_nf_sai + '</td>' +
      '<td class="r">' + brl(dr.lucro_bruto) + '</td>' +
      '<td class="r">' + pct(dr.margem_bruta_pct) + '</td>' +
      '<td class="r td-val ' + (dr.resultado >= 0 ? 't-success' : 't-danger') + '">' + brl(dr.resultado) + '</td>' +
      '</tr>';
  }).join('');
  rows += '<tr class="row-active"><td><strong>TOTAL EMPRESA</strong></td><td>—</td><td class="td-mute">4 unidades</td>' +
    '<td class="r td-val"><strong>' + brl(sumEnt) + '</strong></td>' +
    '<td class="r td-val"><strong>' + brl(sumVnd) + '</strong></td>' +
    '<td class="r"><strong>' + brl(emp.kpis.saldo_icms) + '</strong></td>' +
    '<td class="r"><strong>' + emp.kpis.n_nf_ent + '</strong></td>' +
    '<td class="r"><strong>' + emp.kpis.n_nf_sai + '</strong></td>' +
    '<td class="r"><strong>' + brl(emp.dre.lucro_bruto) + '</strong></td>' +
    '<td class="r"><strong>' + pct(emp.dre.margem_bruta_pct) + '</strong></td>' +
    '<td class="r td-val"><strong>' + brl(sumRes) + '</strong></td></tr>';
  document.getElementById('tblComparativo').innerHTML = rows;
}

const PAL_MIX = ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6'];

function refreshActiveTab() {
  const active = document.querySelector('.tab-section.active');
  if (!active) return;
  const name = active.id.replace('tab-', '');
  if (name === 'comparativo') {
    tabsInit.comparativo = false;
    initComparativo();
    tabsInit.comparativo = true;
    return;
  }
  if (TAB_PANEL[name] || name === 'finalidade') {
    tabsInit[name] = false;
    if (name === 'finalidade') initFinalidade();
    else renderTabContent(name);
    tabsInit[name] = true;
  }
}

function showTab(name) {
  if (name === 'comparativo' && unidadeAtiva !== 'TODAS') {
    showTab('visao-geral');
    return;
  }
  document.querySelectorAll('.tab-section').forEach((s) => s.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach((n) => n.classList.remove('active'));
  const sec = document.getElementById('tab-' + name);
  const nav = document.getElementById('nav-' + name);
  if (sec) sec.classList.add('active');
  if (nav) nav.classList.add('active');

  updateHeaderSubtitle(name);

  if (!tabsInit[name]) {
    tabsInit[name] = true;
    setTimeout(() => {
      if (name === 'comparativo') initComparativo();
      else if (name === 'finalidade') initFinalidade();
      else renderTabContent(name);
    }, 50);
  }
  if (window.innerWidth <= 768) closeMob();
}

let sbCollapsed = false;
function toggleSidebar() {
  const sb = document.getElementById('sidebar');
  const mw = document.getElementById('mainWrapper');
  if (window.innerWidth <= 768) {
    sb.classList.toggle('mob-open');
    document.getElementById('overlay').classList.toggle('hidden');
  } else {
    sbCollapsed = !sbCollapsed;
    sb.classList.toggle('collapsed', sbCollapsed);
    mw.classList.toggle('sb-collapsed', sbCollapsed);
  }
}
function closeMob() {
  document.getElementById('sidebar').classList.remove('mob-open');
  document.getElementById('overlay').classList.add('hidden');
}

async function exportPDF(sectionId, filename) {
  if (window.JpgDashboard && window.JpgDashboard.refreshActiveTab) {
    window.JpgDashboard.refreshActiveTab();
    await new Promise((r) => setTimeout(r, 120));
  }
  const section = document.getElementById(sectionId);
  if (!section || !window.html2canvas || !window.jspdf) return;
  const btn = event?.currentTarget;
  const orig = btn?.innerHTML;
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>'; }
  try {
    section.classList.add('pdf-export-target');
    const canvas = await html2canvas(section, { scale: 2, backgroundColor: '#f8fafc', useCORS: true });
    section.classList.remove('pdf-export-target');
    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF('p', 'mm', 'a4');
    const w = pdf.internal.pageSize.getWidth();
    const h = (canvas.height * w) / canvas.width;
    pdf.addImage(canvas.toDataURL('image/png'), 'PNG', 0, 0, w, Math.min(h, 290));
    const suffix = unidadeAtiva === 'TODAS' ? 'Empresa' : unidadeAtiva;
    const mes = getCompetenciaLabel().replace(/\s+/g, '_').replace(/\//g, '-');
    pdf.save(filename + '_JPG_' + suffix + '_' + mes + '.pdf');
  } catch (e) { console.error(e); }
  finally { if (btn) { btn.disabled = false; btn.innerHTML = orig; } }
}

window.JpgDashboard = {
  getActiveData: getScopeData,
  getActiveUnidade: () => unidadeAtiva,
  getActivePack,
  getFiscalPack,
  refreshActiveTab,
  getViewData,
  isTotalMode,
  getScopeData,
};

document.addEventListener('DOMContentLoaded', () => {
  initPeriodSelector();
  buildFiscalMesBars();
  initMeta();
  updateNavComparativo();
  updateSupplierHeaderBtn();
  showTab('visao-geral');
});

</script>
</body>
