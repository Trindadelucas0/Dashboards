    data:{ labels:['Entradas','Vendas'], datasets:[{ label:'Valor Contábil', data:[k.entradas, k.saidas], backgroundColor:['rgba(16,185,129,0.7)','rgba(59,130,246,0.7)'], borderRadius:6 }] },
