<script>
/* Core JPG Dashboard — funções de render parametrizadas (data + prefix) */

const PAL = ['#3b82f6','#10b981','#f59e0b','#8b5cf6','#ef4444','#06b6d4','#f97316','#ec4899'];
const chartInst = {};

Chart.defaults.color = '#94a3b8';
Chart.defaults.borderColor = 'rgba(255,255,255,0.07)';
Chart.defaults.font.family = "'Inter', sans-serif";
Chart.defaults.font.size = 12;

function brl(v) {
  return 'R$ ' + Number(v || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function brlK(v) { return 'R$ ' + (Number(v || 0) / 1000).toFixed(1).replace('.', ',') + 'K'; }
function pct(v) { return (v == null ? 'N/D' : Number(v).toFixed(1) + '%'); }
function tip() {
  return { backgroundColor:'#1e2535', borderColor:'rgba(255,255,255,0.1)', borderWidth:1, padding:12, titleColor:'#e2e8f0', bodyColor:'#94a3b8', cornerRadius:8 };
}
function leg() { return { labels:{ usePointStyle:true, padding:16, boxWidth:8, boxHeight:8 } }; }
function safeChart(id, cfg) {
  if (chartInst[id]) chartInst[id].destroy();
  const ctx = document.getElementById(id);
  if (!ctx) return;
  chartInst[id] = new Chart(ctx, cfg);
}
function rankClass(i) { return i === 0 ? 'g1' : i === 1 ? 'g2' : i === 2 ? 'g3' : 'gn'; }
function pbRow(pctVal, color) {
  const w = Math.min(100, Math.max(4, pctVal));
  return '<div class="pb-wrap"><div class="pb-bar"><div class="pb-fill" style="width:'+w+'%;background:'+(color||'var(--accent)')+'"></div></div><div class="pb-pct">'+pctVal.toFixed(1)+'%</div></div>';
}
function kpiCard(color, icon, badge, val, lbl, sub) {
  return '<div class="kpi-card c-'+color+'"><div class="kpi-head"><div class="kpi-ico c-'+color+'"><i class="'+icon+'"></i></div><div class="kpi-badge neutral">'+badge+'</div></div><div class="kpi-val">'+val+'</div><div class="kpi-lbl">'+lbl+'</div><div class="kpi-sub">'+sub+'</div></div>';
}
function gid(pfx, id) { return pfx ? pfx + id : id; }
function $(pfx, id) { return document.getElementById(gid(pfx, id)); }

function truncNome(s, max) {
  if (!s) return '—';
  return s.length > max ? s.slice(0, max - 1) + '…' : s;
}

function getCompetenciaBadge(D) {
  if (typeof window.getJpgCompetenciaLabel === 'function') return window.getJpgCompetenciaLabel();
  return (D && D.meta && D.meta.periodo) ? D.meta.periodo : '—';
}

let jpgSupplierCtx = null;
let activeDrilldownCfop = null;
const jpgCtxRegistry = {};

function makeJpgContext(data, label) {
  return { data, label: label || (data.meta && data.meta.filial_label) || 'JPG' };
}

function registerJpgCtx(key, data, label) {
  jpgCtxRegistry[key] = makeJpgContext(data, label || (data.meta && data.meta.filial_label));
  return key;
}

function collectSuppliersFromCfops(cfopEntradas) {
  const merged = {};
  (cfopEntradas || []).forEach((cf) => {
    (cf.parties || []).forEach((p) => {
      const key = (p.cnpj || '').trim() || p.nome;
      if (!merged[key]) {
        merged[key] = { nome: p.nome, cnpj: p.cnpj || key, uf: p.uf || '—', total: 0, qtd: 0 };
      }
      merged[key].total += p.total || 0;
      merged[key].qtd += p.qtd || 0;
      if (p.uf) merged[key].uf = p.uf;
    });
  });
  return Object.values(merged).sort((a, b) => b.total - a.total);
}

function credIcmsChip(c) {
  const has = c.credito_icms === true || (c.icms || 0) > 0;
  if (has) {
    return '<span class="chip" style="background:rgba(16,185,129,0.15);color:#10b981;font-size:11px;">Sim</span>';
  }
  return '<span class="chip" style="background:rgba(148,163,184,0.12);color:#94a3b8;font-size:11px;">Não</span>';
}

function escHtml(v) {
  return String(v || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
}

function openDrilldown(cfop, ctx) {
  if (!ctx || !ctx.data) return;
  if (activeDrilldownCfop === cfop) { closeDrilldown(); return; }
  activeDrilldownCfop = cfop;
  const item = (ctx.data.cfop_entradas || []).find((d) => d.cfop === cfop);
  if (!item) return;
  const panel = document.getElementById('drilldown-panel');
  const title = document.getElementById('dd-title');
  const sub = document.getElementById('dd-sub');
  const tbody = document.getElementById('dd-tbody');
  if (!panel || !tbody) return;
  if (title) title.textContent = 'CFOP ' + cfop + ' — ' + item.descricao;
  if (sub) sub.textContent = (ctx.label ? ctx.label + ' · ' : '') + 'Finalidade: ' + item.finalidade + ' | Total: ' + brl(item.total);
  const forn = item.parties || [];
  if (!forn.length) {
    tbody.innerHTML = '<tr><td colspan="10" class="td-mute" style="text-align:center;padding:20px;">Sem fornecedores neste CFOP.</td></tr>';
  } else {
    tbody.innerHTML = forn.map((f, i) => {
      const p = item.total ? (100 * f.total / item.total).toFixed(1) : '0.0';
      return '<tr><td>' + (i + 1) + '</td><td><div class="fw7">' + escHtml(f.nome) + '</div></td>' +
        '<td><span class="td-mute">' + escHtml(f.cnpj) + '</span></td><td><span class="chip bl">' + escHtml(f.uf) + '</span></td>' +
        '<td class="r">' + f.qtd + '</td><td class="r td-val">' + brl(f.total) + '</td>' +
        '<td class="r">' + brl(f.base || 0) + '</td><td class="r">' + brl(f.icms || 0) + '</td><td class="r">' + brl(f.ipi || 0) + '</td>' +
        '<td class="r">' + p + '%</td></tr>';
    }).join('');
  }
  panel.style.display = 'block';
  panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function closeDrilldown() {
  const panel = document.getElementById('drilldown-panel');
  if (panel) panel.style.display = 'none';
  activeDrilldownCfop = null;
}

function openSupplierModal(ctx) {
  if (!ctx || !ctx.data) {
    alert('Selecione uma unidade ou use o botão Por Fornecedor de uma filial.');
    return;
  }
  jpgSupplierCtx = ctx;
  const list = document.getElementById('supplierList');
  const btnPrint = document.querySelector('#supplierModal .btn-confirm:not(.btn-pdf-supplier)');
  const btnPdf = document.querySelector('#supplierModal .btn-pdf-supplier');
  const suppliers = collectSuppliersFromCfops(ctx.data.cfop_entradas);
  if (!list) return;
  if (!suppliers.length) {
    list.innerHTML = '<div class="td-mute" style="padding:24px;text-align:center;font-size:13px;">Sem fornecedores no período.</div>';
    if (btnPrint) { btnPrint.disabled = true; btnPrint.style.opacity = '0.45'; }
    if (btnPdf) { btnPdf.disabled = true; btnPdf.style.opacity = '0.45'; }
  } else {
    list.innerHTML = suppliers.map((s) => {
      const search = (s.nome + ' ' + s.cnpj).toLowerCase();
      return '<label class="supplier-item" data-search="' + escHtml(search) + '">' +
        '<input type="checkbox" value="' + escHtml(s.cnpj) + '" data-nome="' + escHtml(s.nome) + '">' +
        '<span class="supplier-info"><strong>' + escHtml(s.nome) + '</strong>' +
        '<small>' + escHtml(s.cnpj) + ' · ' + escHtml(s.uf) + ' · ' + brl(s.total) + '</small></span></label>';
    }).join('');
    if (btnPrint) { btnPrint.disabled = false; btnPrint.style.opacity = '1'; }
    if (btnPdf) { btnPdf.disabled = false; btnPdf.style.opacity = '1'; }
  }
  const search = document.getElementById('supplierSearch');
  if (search) search.value = '';
  const modalTitle = document.querySelector('#supplierModal .modal-header h3');
  if (modalTitle) modalTitle.innerHTML = '<i class="fas fa-truck"></i> Por Fornecedor — ' + escHtml(ctx.label);
  document.getElementById('supplierModal').style.display = 'flex';
}

function closeSupplierModal() {
  const modal = document.getElementById('supplierModal');
  if (modal) modal.style.display = 'none';
  const search = document.getElementById('supplierSearch');
  if (search) search.value = '';
}

function filterSuppliers(query) {
  const q = (query || '').toLowerCase();
  document.querySelectorAll('#supplierList .supplier-item').forEach((el) => {
    el.style.display = el.dataset.search.includes(q) ? '' : 'none';
  });
}

function toggleAllSuppliers(state) {
  document.querySelectorAll('#supplierList .supplier-item').forEach((el) => {
    if (el.style.display === 'none') return;
    const cb = el.querySelector('input');
    if (cb) cb.checked = state;
  });
}

function buildSupplierReportData(selected) {
  const ctx = jpgSupplierCtx;
  const cfops = ctx && ctx.data ? ctx.data.cfop_entradas || [] : [];
  const periodo = (typeof window.getJpgCompetenciaLabel === 'function')
    ? window.getJpgCompetenciaLabel()
    : ((typeof JPG_DATA !== 'undefined' && JPG_DATA.meta) ? (JPG_DATA.meta.periodoRange || JPG_DATA.meta.periodo) : '—');
  const empresa = (typeof JPG_DATA !== 'undefined' && JPG_DATA.meta) ? JPG_DATA.meta.empresa : 'JPG';
  let totalGeral = 0;
  const suppliers = [];
  selected.forEach((cb) => {
    const cnpj = cb.value;
    const nome = cb.dataset.nome;
    const rows = [];
    let subtotal = 0;
    let uf = '—';
    cfops.forEach((cfop) => {
      const f = (cfop.parties || []).find((x) => (x.cnpj || '').trim() === cnpj || x.nome === nome);
      if (f) {
        rows.push({ cfop: cfop.cfop, desc: cfop.descricao, fin: cfop.finalidade, qtd: f.qtd, total: f.total });
        subtotal += f.total;
        uf = f.uf || uf;
      }
    });
    totalGeral += subtotal;
    suppliers.push({ nome, cnpj, uf, rows, subtotal });
  });
  return { suppliers, totalGeral, periodo, empresa, label: ctx ? ctx.label : '' };
}

function printBySupplier() {
  const selected = Array.from(document.querySelectorAll('#supplierList input:checked'));
  if (!selected.length) { alert('Selecione ao menos um fornecedor.'); return; }
  const { suppliers, totalGeral, periodo, empresa, label } = buildSupplierReportData(selected);
  closeSupplierModal();
  let html = '<div class="supplier-print-root" style="font-family:Inter,sans-serif;padding:0;margin:0;color:#1a1a2e;background:#fff;width:100%;max-width:100%;box-sizing:border-box;">';
  html += '<h1 style="font-size:18px;margin-bottom:4px;">Relatório por Fornecedor</h1>';
  html += '<p style="font-size:12px;color:#555;margin-bottom:24px;">' + empresa + (label ? ' — ' + label : '') + ' — ' + periodo + ' — ' + new Date().toLocaleDateString('pt-BR') + '</p>';
  suppliers.forEach((s) => {
    html += '<div class="supplier-print-block" style="margin-bottom:12px;page-break-inside:auto;width:100%;max-width:100%;box-sizing:border-box;">';
    html += '<h2 style="font-size:14px;border-bottom:2px solid #3b82f6;padding-bottom:6px;">' + s.nome + '</h2>';
    html += '<p style="font-size:11px;color:#555;">CNPJ: ' + s.cnpj + ' · UF: ' + s.uf + '</p>';
    html += '<table style="width:100%;max-width:100%;border-collapse:collapse;margin-top:8px;font-size:10px;table-layout:fixed;"><colgroup><col class="cfop"><col class="desc"><col class="fin"><col class="qtd"><col class="val"></colgroup>';
    html += '<thead><tr style="background:#f0f0f0;"><th style="padding:4px 5px;text-align:left;">CFOP</th>';
    html += '<th style="padding:4px 5px;text-align:left;">Descrição</th><th style="padding:4px 5px;text-align:left;">Finalidade</th>';
    html += '<th style="padding:4px 5px;text-align:right;">Qtd NFs</th><th style="padding:4px 5px;text-align:right;">Valor (R$)</th></tr></thead><tbody>';
    s.rows.forEach((r) => {
      html += '<tr><td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;">' + r.cfop + '</td>';
      html += '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;">' + r.desc + '</td>';
      html += '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;">' + r.fin + '</td>';
      html += '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;text-align:right;">' + r.qtd + '</td>';
      html += '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;text-align:right;font-weight:600;">' +
        r.total.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</td></tr>';
    });
    html += '</tbody><tfoot><tr><td colspan="4" style="padding:6px 5px;text-align:right;font-weight:700;">Subtotal:</td>';
    html += '<td style="padding:6px 5px;text-align:right;font-weight:700;">R$ ' +
      s.subtotal.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</td></tr></tfoot></table></div>';
  });
  html += '<div style="border-top:2px solid #1a1a2e;padding-top:12px;margin-top:16px;text-align:right;font-size:14px;font-weight:700;">';
  html += 'Total Geral: R$ ' + totalGeral.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</div></div>';
  const old = document.getElementById('print-supplier-report');
  if (old) old.remove();
  const div = document.createElement('div');
  div.id = 'print-supplier-report';
  div.innerHTML = html;
  document.body.appendChild(div);
  const cleanup = () => { div.remove(); window.removeEventListener('afterprint', cleanup); };
  window.addEventListener('afterprint', cleanup);
  window.print();
}

function exportSupplierPdf() {
  const selected = Array.from(document.querySelectorAll('#supplierList input:checked'));
  if (!selected.length) { alert('Selecione ao menos um fornecedor.'); return; }
  if (!window.jspdf?.jsPDF) { alert('Biblioteca jsPDF não carregada.'); return; }
  if (typeof window.jspdf.jsPDF.prototype.autoTable !== 'function') {
    alert('Biblioteca jspdf-autotable não carregada.');
    return;
  }
  const { suppliers, totalGeral, periodo, empresa, label } = buildSupplierReportData(selected);
  closeSupplierModal();
  const { jsPDF } = window.jspdf;
  const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
  const margin = 14;
  const pageH = pdf.internal.pageSize.getHeight();
  let y = margin;
  const ensureSpace = (need) => {
    if (y + need > pageH - margin) { pdf.addPage(); y = margin; }
  };
  const fmtBrl = (v) => 'R$ ' + Number(v).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  pdf.setFont('helvetica', 'bold');
  pdf.setFontSize(14);
  pdf.text('Relatório por Fornecedor', margin, y);
  y += 7;
  pdf.setFont('helvetica', 'normal');
  pdf.setFontSize(9);
  pdf.setTextColor(80, 80, 80);
  pdf.text(empresa + (label ? ' — ' + label : '') + ' — ' + periodo, margin, y);
  y += 10;
  pdf.setTextColor(0, 0, 0);
  suppliers.forEach((s) => {
    ensureSpace(20);
    pdf.setFont('helvetica', 'bold');
    pdf.setFontSize(11);
    pdf.text(s.nome.substring(0, 60), margin, y);
    y += 5;
    pdf.setFont('helvetica', 'normal');
    pdf.setFontSize(8);
    pdf.setTextColor(100, 100, 100);
    pdf.text('CNPJ: ' + s.cnpj + ' · UF: ' + s.uf, margin, y);
    y += 4;
    pdf.setTextColor(0, 0, 0);
    pdf.autoTable({
        startY: y,
        margin: { left: margin, right: margin },
        tableWidth: 'auto',
      head: [['CFOP', 'Descrição', 'Finalidade', 'Qtd NFs', 'Valor (R$)']],
      body: s.rows.map((r) => [r.cfop, r.desc, r.fin, String(r.qtd), fmtBrl(r.total)]),
      foot: [['', '', '', 'Subtotal:', fmtBrl(s.subtotal)]],
      styles: { fontSize: 7, cellPadding: 1.5, overflow: 'linebreak' },
      headStyles: { fillColor: [59, 130, 246], textColor: 255 },
      footStyles: { fillColor: [241, 245, 249], textColor: [30, 41, 59], fontStyle: 'bold' },
      columnStyles: { 3: { halign: 'right' }, 4: { halign: 'right' } },
    });
    y = pdf.lastAutoTable.finalY + 10;
  });
  ensureSpace(12);
  pdf.setFont('helvetica', 'bold');
  pdf.setFontSize(11);
  pdf.text('Total Geral: ' + fmtBrl(totalGeral), margin, y);
  const slug = (label || 'JPG').replace(/\s+/g, '_');
  pdf.save('Fornecedores_' + slug + '.pdf');
}

function renderNotasTable(notas, pfx, id, emptyMsg) {
  const tbl = $(pfx, id);
  if (!tbl) return;
  if (!notas || !notas.length) {
    tbl.innerHTML = '<tr><td colspan="9" class="td-mute">' + (emptyMsg || 'Sem notas no período') + '</td></tr>';
    return;
  }
  const isTotal = typeof window.JpgDashboard !== 'undefined' && window.JpgDashboard.isTotalMode && window.JpgDashboard.isTotalMode();
  const maxRows = isTotal ? 50 : notas.length;
  const slice = notas.slice(0, maxRows);
  const panel = tbl.closest('.table-card') || tbl.closest('.filial-block');
  let hint = panel ? panel.querySelector('.notas-limit-hint') : null;
  if (isTotal && notas.length > maxRows) {
    if (!hint && panel) {
      hint = document.createElement('div');
      hint.className = 'notas-limit-hint';
      tbl.closest('.tbl-scroll').parentNode.insertBefore(hint, tbl.closest('.tbl-scroll'));
    }
    if (hint) hint.textContent = 'Exibindo ' + maxRows + ' de ' + notas.length + ' notas no consolidado. Selecione um mês para ver todas.';
  } else if (hint) {
    hint.textContent = '';
    hint.style.display = 'none';
  }
  tbl.innerHTML = slice.map((n) =>
    '<tr><td class="td-mute">' + escHtml(n.nota) + '</td><td>' + escHtml(n.data) + '</td>' +
    '<td><span class="chip bl">' + escHtml(n.cfop) + '</span></td>' +
    '<td><div class="fw7">' + escHtml(n.party) + '</div><div class="td-mute">' + escHtml(n.cnpj) + '</div></td>' +
    '<td><span class="chip bl">' + escHtml(n.uf) + '</span></td>' +
    '<td class="r td-val">' + brl(n.valor_contabil) + '</td><td class="r">' + brl(n.base) + '</td>' +
    '<td class="r">' + brl(n.icms) + '</td><td class="r">' + brl(n.ipi) + '</td></tr>'
  ).join('');
}

function renderVisaoFiscal(D, pfx) {
  const k = D.kpis;
  const el = $(pfx, 'kpiVisaoFiscal');
  if (!el || k.base_icms_ent === undefined) return;
  el.innerHTML =
    kpiCard('green', 'fas fa-calculator', 'Entradas', brl(k.base_icms_ent), 'Base ICMS Entradas', 'IPI ' + brl(k.ipi_ent || 0)) +
    kpiCard('blue', 'fas fa-calculator', 'Saídas', brl(k.base_icms_sai), 'Base ICMS Saídas', 'IPI ' + brl(k.ipi_sai || 0)) +
    kpiCard('yellow', 'fas fa-receipt', 'IPI', brl((k.ipi_ent || 0) + (k.ipi_sai || 0)), 'IPI Total', 'Ent. ' + brl(k.ipi_ent || 0) + ' · Saí. ' + brl(k.ipi_sai || 0)) +
    kpiCard('purple', 'fas fa-file-lines', 'NF', String(k.n_nf_ent + k.n_nf_sai), 'Notas no período', k.n_nf_ent + ' ent. · ' + k.n_nf_sai + ' saí.');
}

function renderVisaoExtra(D, pfx) {
  const k = D.kpis;
  const el = $(pfx, 'kpiVisaoExtra');
  if (!el) return;
  const rc = D.ranking_clientes[0];
  const rf = D.ranking_fornecedores[0];
  const ticketVenda = k.n_nf_sai > 0 ? brl(k.saidas / k.n_nf_sai) : 'N/D';
  const ticketCompra = k.n_nf_ent > 0 ? brl(k.entradas / k.n_nf_ent) : 'N/D';
  const icmsVendas = k.saidas > 0 ? pct(100 * k.saldo_icms / k.saidas) : 'N/D';
  const sd = D.serie_diaria || { labels: [], saidas: [] };
  const diasVendas = sd.labels.filter((_, i) => (sd.saidas[i] || 0) > 0).length;
  const mediaDiaria = diasVendas > 0 ? brl(k.saidas / diasVendas) : 'N/D';
  const topCliVal = rc ? truncNome(rc.nome, 28) : '—';
  const topCliSub = rc ? rc.pct + '% das vendas · ' + brl(rc.total) : 'Sem clientes no período';
  const topFornVal = rf ? truncNome(rf.nome, 28) : '—';
  const topFornSub = rf ? rf.pct + '% das compras · ' + brl(rf.total) : 'Sem fornecedores no período';
  el.innerHTML =
    kpiCard('blue', 'fas fa-receipt', getCompetenciaBadge(D), ticketVenda, 'Ticket Médio Venda', k.n_nf_sai + ' NF de saída') +
    kpiCard('green', 'fas fa-basket-shopping', getCompetenciaBadge(D), ticketCompra, 'Ticket Médio Compra', k.n_nf_ent + ' NF de entrada') +
    kpiCard('yellow', 'fas fa-percent', 'ICMS', icmsVendas, 'ICMS / Vendas', 'Saldo ICMS sobre faturamento') +
    kpiCard('purple', 'fas fa-user-tie', 'Cliente', topCliVal, 'Top Cliente', topCliSub) +
    kpiCard('purple', 'fas fa-truck', 'Fornec.', topFornVal, 'Top Fornecedor', topFornSub) +
    kpiCard('blue', 'fas fa-calendar-day', getCompetenciaBadge(D), mediaDiaria, 'Média Diária Vendas', diasVendas + ' dias com movimento');
}

function renderVisaoGeral(D, pfx) {
  const k = D.kpis;
  const elKpi = $(pfx, 'kpiVisao');
  if (!elKpi) return;
  elKpi.innerHTML =
    kpiCard('green','fas fa-cart-shopping', getCompetenciaBadge(D), brl(k.entradas), 'Total Entradas', k.n_nf_ent + ' NF-e · ' + k.n_fornecedores + ' fornec.') +
