  });

  const tbl = $(pfx, 'tblCfopEnt');
  const ctxKey = registerJpgCtx(pfx || (D.meta.filial_key || 'SINGLE'), D, D.meta.filial_label);
  if (tbl) tbl.innerHTML = D.cfop_entradas.map(c =>
    '<tr><td><span class="chip bl">'+c.cfop+'</span></td><td style="font-size:12px">'+c.descricao+'</td><td><span class="chip pu">'+c.finalidade+'</span></td>' +
