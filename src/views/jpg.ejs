  ).join('') || '<tr><td colspan="8" class="td-mute">Sem vendas a clientes no período</td></tr>';

  const tblCfop = $(pfx, 'tblCfopSai');
  if (tblCfop) tblCfop.innerHTML = (D.cfop_saidas || []).map(c =>
    '<tr><td><span class="chip bl">'+c.cfop+'</span></td><td style="font-size:12px">'+c.descricao+'</td><td class="r">'+c.qtd+'</td>' +
