    trTot.innerHTML = '<td class="fw7">TOTAL</td><td></td><td class="r fw7">' + (pack.nfsSaidas || '—') + '*</td><td class="r fw7 td-val">R$ ' + total.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</td><td class="r fw7">100%</td>';
