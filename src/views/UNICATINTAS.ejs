    }
    .fin-supplier-hint { font-size:12px; color:var(--text-sec); line-height:1.4; }

    /* === SUPPLIER MODAL === */
    .modal-overlay {
      position:fixed; inset:0; background:rgba(0,0,0,.65); backdrop-filter:blur(4px);
      z-index:1000; display:none; align-items:center; justify-content:center; padding:20px;
    }
    .modal-box {
      background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius);
      width:100%; max-width:520px; max-height:85vh; display:flex; flex-direction:column;
      box-shadow:var(--shadow);
    }
    .modal-header {
      display:flex; align-items:center; justify-content:space-between;
      padding:16px 20px; border-bottom:1px solid var(--border);
    }
    .modal-header h3 { font-size:15px; font-weight:700; display:flex; align-items:center; gap:8px; }
    .modal-header h3 i { color:var(--warning); }
    .modal-close {
      background:none; border:none; color:var(--text-muted); font-size:22px;
      cursor:pointer; line-height:1; padding:0 4px;
    }
    .modal-close:hover { color:var(--text); }
    .modal-body { padding:16px 20px; overflow-y:auto; flex:1; }
    .search-box input {
      width:100%; padding:9px 12px; border-radius:var(--radius-sm);
      border:1px solid var(--border); background:var(--bg); color:var(--text);
      font-family:inherit; font-size:13px; outline:none;
    }
    .search-box input:focus { border-color:var(--border-accent); }
    .supplier-actions { display:flex; gap:8px; margin:12px 0; }
    .supplier-actions button {
      padding:6px 12px; border-radius:6px; font-size:11px; font-weight:600;
      border:1px solid var(--border); background:rgba(255,255,255,.05);
      color:var(--text-sec); cursor:pointer; font-family:inherit;
    }
    .supplier-actions button:hover { background:rgba(34,163,41,.15); color:var(--accent); }
    .supplier-list { display:flex; flex-direction:column; gap:4px; max-height:320px; overflow-y:auto; }
    .supplier-item {
      display:flex; align-items:flex-start; gap:10px; padding:10px 12px;
      border-radius:var(--radius-sm); cursor:pointer; transition:background .15s;
    }
    .supplier-item:hover { background:rgba(255,255,255,.04); }
    .supplier-item input { margin-top:3px; accent-color:var(--accent); }
    .supplier-info { display:flex; flex-direction:column; gap:2px; }
    .supplier-info strong { font-size:13px; font-weight:600; }
    .supplier-info small { font-size:11px; color:var(--text-muted); }
    .modal-footer {
      display:flex; justify-content:flex-end; gap:10px;
      padding:14px 20px; border-top:1px solid var(--border);
    }
    .btn-cancel {
      padding:8px 16px; border-radius:var(--radius-sm); font-size:12px; font-weight:600;
      border:1px solid var(--border); background:transparent; color:var(--text-sec);
      cursor:pointer; font-family:inherit;
    }
    .btn-cancel:hover { background:rgba(255,255,255,.05); }
    .btn-confirm {
      padding:8px 16px; border-radius:var(--radius-sm); font-size:12px; font-weight:600;
      border:1px solid rgba(34,163,41,.4); background:rgba(34,163,41,.2);
      color:var(--accent); cursor:pointer; font-family:inherit;
      display:inline-flex; align-items:center; gap:6px;
    }
    .btn-confirm:hover { background:rgba(34,163,41,.35); }

    /* === PDF EXPORT THEME (scoped capture) === */
    .pdf-export-target {
      --bg: #f8fafc; --bg-card: #ffffff; --bg-card-hover: #f1f5f9;
      --text: #1e293b; --text-sec: #475569; --text-muted: #64748b;
      --border: rgba(0,0,0,0.12);
      background: #f8fafc !important; color: #1e293b !important;
      padding: 20px; opacity: 1 !important; filter: none !important; animation: none !important;
    }
    .pdf-export-target * { opacity: 1 !important; filter: none !important; }
    .pdf-export-target .sec-title, .pdf-export-target .kpi-val, .pdf-export-target .chart-ttl,
    .pdf-export-target .margin-val, .pdf-export-target .ind-val, .pdf-export-target .tax-cur,
    .pdf-export-target .table-head .ttl, .pdf-export-target tbody td, .pdf-export-target td,
