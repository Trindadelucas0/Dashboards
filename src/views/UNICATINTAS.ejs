<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard Tributário | ÚNICA Comércio Atacadista de Tintas</title>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg:#0f1117; --bg-sidebar:#161b27; --bg-card:#1e2535; --bg-card-hover:#252d42;
      --accent:#22a329; --accent-hover:#1a8a20; --success:#10b981; --danger:#ef4444;
      --warning:#f59e0b; --purple:#8b5cf6; --cyan:#06b6d4; --orange:#f97316;
      --text:#e2e8f0; --text-sec:#94a3b8; --text-muted:#64748b;
      --border:rgba(255,255,255,0.07); --border-accent:rgba(34,163,41,0.35);
      --sidebar-w:260px; --header-h:68px; --radius:12px; --radius-sm:8px;
      --shadow:0 4px 24px rgba(0,0,0,0.35); --t:0.22s ease;
    }
    html { font-size:14px; scroll-behavior:smooth; }
    body { font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif; background:var(--bg); color:var(--text); min-height:100vh; overflow-x:hidden; }
    #app { display:flex; min-height:100vh; }

    /* SIDEBAR */
    .sidebar { width:var(--sidebar-w); background:var(--bg-sidebar); border-right:1px solid var(--border); display:flex; flex-direction:column; position:fixed; top:0;left:0;bottom:0; z-index:100; transition:width var(--t),transform var(--t); overflow:hidden; }
    .sidebar.collapsed { width:72px; }
    .sidebar.collapsed .logo-text,.sidebar.collapsed .nav-label,.sidebar.collapsed .sec-label,.sidebar.collapsed .sidebar-foot-info { display:none; }
    .sidebar-logo { padding:0 16px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:12px; min-height:var(--header-h); flex-shrink:0; }
    .logo-icon { width:38px;height:38px; background:linear-gradient(135deg,#22a329,#4ade80); border-radius:10px; display:flex;align-items:center;justify-content:center; font-size:16px;color:#fff; flex-shrink:0; }
    .logo-text .company { font-size:13px;font-weight:700;color:var(--text);white-space:nowrap; }
    .logo-text .subtitle { font-size:10px;color:var(--text-muted);margin-top:2px;white-space:nowrap; }
    .sidebar-nav { flex:1; padding:12px 8px; overflow-y:auto; overflow-x:hidden; }
    .sidebar-nav::-webkit-scrollbar { width:4px; }
    .sidebar-nav::-webkit-scrollbar-thumb { background:var(--border); border-radius:2px; }
    .sec-label { font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--text-muted);padding:10px 12px 4px; }
    .nav-item { display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:var(--radius-sm);cursor:pointer;transition:background var(--t),color var(--t);margin-bottom:2px;white-space:nowrap;user-select:none; }
    .nav-item:hover { background:rgba(255,255,255,0.05); }
    .nav-item.active { background:rgba(34,163,41,0.15);color:var(--accent); }
    .nav-item.active .nav-ico { color:var(--accent); }
    .nav-ico { width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:14px;color:var(--text-muted);flex-shrink:0;transition:color var(--t); }
    .nav-item:hover .nav-ico { color:var(--text); }
    .nav-label { font-size:13px;font-weight:500; }
    .sidebar-foot { padding:14px 16px;border-top:1px solid var(--border);flex-shrink:0; }
    .sidebar-foot-info .lbl { font-size:10px;color:var(--text-muted); }
    .sidebar-foot-info .val { font-size:12px;font-weight:600;color:var(--accent);margin-top:2px; }

    /* MAIN */
    .main-wrapper { margin-left:var(--sidebar-w);flex:1;display:flex;flex-direction:column;min-height:100vh;transition:margin-left var(--t); }
    .main-wrapper.sb-collapsed { margin-left:72px; }
    .top-header { height:var(--header-h);background:var(--bg-sidebar);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 24px;gap:14px;position:sticky;top:0;z-index:50; }
    .btn-toggle { width:36px;height:36px;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text-sec);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;transition:background var(--t),color var(--t); }
    .btn-toggle:hover { background:var(--bg-card-hover);color:var(--text); }
    .header-title { font-size:15px;font-weight:600;flex:1; }
    .header-title span { font-size:12px;font-weight:400;color:var(--text-muted);margin-left:8px; }
    .header-actions { display:flex;align-items:center;gap:10px;flex-shrink:0; }
    .period-sel { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);padding:7px 12px;font-size:12px;font-family:inherit;cursor:pointer;outline:none; }
    .period-sel:focus { border-color:var(--border-accent); }
    .regime-badge { background:rgba(16,185,129,0.12);color:var(--success);border:1px solid rgba(16,185,129,0.3);padding:5px 12px;border-radius:20px;font-size:11px;font-weight:600; }

    /* CONTENT */
    .content { flex:1;padding:24px;overflow-x:hidden; }
    .tab-section { display:none;animation:fadeUp .28s ease; }
    .tab-section.active { display:block; }
    @keyframes fadeUp { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }
    .sec-header { display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:20px;gap:12px;flex-wrap:wrap; }
    .sec-title { font-size:18px;font-weight:700; }
    .sec-title small { font-size:12px;font-weight:400;color:var(--text-muted);margin-left:8px; }
    .sec-sub { font-size:12px;color:var(--text-sec);margin-top:4px; }

    /* KPI CARDS */
    .kpi-grid { display:grid;gap:16px;margin-bottom:24px; }
    .kpi-grid-4 { grid-template-columns:repeat(4,1fr); }
    .kpi-grid-3 { grid-template-columns:repeat(3,1fr); }
    .kpi-grid-2 { grid-template-columns:repeat(2,1fr); }
    .kpi-card { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;position:relative;overflow:hidden;transition:transform var(--t),box-shadow var(--t); }
    .kpi-card:hover { transform:translateY(-2px);box-shadow:var(--shadow); }
    .kpi-card::before { content:'';position:absolute;top:0;left:0;right:0;height:3px; }
    .kpi-card.c-blue::before   { background:linear-gradient(90deg,var(--accent),transparent); }
    .kpi-card.c-green::before  { background:linear-gradient(90deg,var(--success),transparent); }
    .kpi-card.c-red::before    { background:linear-gradient(90deg,var(--danger),transparent); }
    .kpi-card.c-yellow::before { background:linear-gradient(90deg,var(--warning),transparent); }
    .kpi-card.c-purple::before { background:linear-gradient(90deg,var(--purple),transparent); }
    .kpi-card.c-cyan::before   { background:linear-gradient(90deg,var(--cyan),transparent); }
    .kpi-card.c-orange::before { background:linear-gradient(90deg,var(--orange),transparent); }
    .kpi-head { display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:12px; }
    .kpi-ico { width:40px;height:40px;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:16px; }
    .kpi-ico.c-blue   { background:rgba(34,163,41,.15);color:var(--accent); }
    .kpi-ico.c-green  { background:rgba(16,185,129,.15);color:var(--success); }
    .kpi-ico.c-red    { background:rgba(239,68,68,.15); color:var(--danger); }
    .kpi-ico.c-yellow { background:rgba(245,158,11,.15);color:var(--warning); }
    .kpi-ico.c-purple { background:rgba(139,92,246,.15);color:var(--purple); }
    .kpi-ico.c-cyan   { background:rgba(6,182,212,.15); color:var(--cyan); }
    .kpi-ico.c-orange { background:rgba(249,115,22,.15);color:var(--orange); }
    .kpi-badge { font-size:11px;font-weight:600;padding:3px 8px;border-radius:20px;display:flex;align-items:center;gap:4px; }
    .kpi-badge.up      { background:rgba(16,185,129,.15);color:var(--success); }
    .kpi-badge.down    { background:rgba(239,68,68,.15); color:var(--danger); }
    .kpi-badge.neutral { background:rgba(100,116,139,.15);color:var(--text-muted); }
    .kpi-val { font-size:22px;font-weight:800;line-height:1.1;margin-bottom:4px; }
    .kpi-lbl { font-size:12px;color:var(--text-sec);font-weight:500; }
    .kpi-sub { font-size:11px;color:var(--text-muted);margin-top:10px;padding-top:10px;border-top:1px solid var(--border); }

    /* CHARTS */
    .charts-row { display:grid;gap:16px;margin-bottom:24px; }
    .cr-2col { grid-template-columns:1fr 1fr; }
    .cr-1-2  { grid-template-columns:1fr 2fr; }
    .cr-2-1  { grid-template-columns:2fr 1fr; }
    .cr-1col { grid-template-columns:1fr; }
    .chart-card { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:20px; }
    .chart-ttl { font-size:14px;font-weight:600;margin-bottom:2px; }
    .chart-sub { font-size:11px;color:var(--text-muted);margin-bottom:14px; }
    .chart-wrap { position:relative; }
    .chart-wrap.h220 { height:220px; }
    .chart-wrap.h260 { height:260px; }
    .chart-wrap.h300 { height:300px; }

    /* TABLES */
    .table-card { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;margin-bottom:24px; }
    .table-head { padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between; }
    .table-head .ttl { font-size:14px;font-weight:600; }
    .table-head .sub { font-size:11px;color:var(--text-muted);margin-top:2px; }
    .tbl-scroll { overflow-x:auto; }
    table { width:100%;border-collapse:collapse; }
    thead th { padding:9px 16px;text-align:left;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--text-muted);background:rgba(255,255,255,0.025);border-bottom:1px solid var(--border);white-space:nowrap; }
    thead th.r { text-align:right; }
    tbody td { padding:11px 16px;font-size:13px;border-bottom:1px solid var(--border);vertical-align:middle; }
    tbody tr:last-child td { border-bottom:none; }
    tbody tr:hover td { background:rgba(255,255,255,0.02); }
    td.r { text-align:right; }
    .td-val { font-weight:600; }
    .td-mute { color:var(--text-muted);font-size:12px; }

    /* PROGRESS */
    .pb-wrap { display:flex;align-items:center;gap:10px; }
    .pb-bar  { flex:1;height:6px;background:rgba(255,255,255,0.08);border-radius:3px;overflow:hidden; }
    .pb-fill { height:100%;border-radius:3px;transition:width .8s ease;background:var(--accent); }
    .pb-fill.gr { background:var(--success); }
    .pb-fill.ye { background:var(--warning); }
    .pb-fill.pu { background:var(--purple); }
    .pb-fill.cy { background:var(--cyan); }
    .pb-fill.or { background:var(--orange); }
    .pb-fill.rd { background:var(--danger); }
    .pb-pct { font-size:12px;font-weight:600;min-width:44px;text-align:right; }

    /* RANK */
    .rank { width:24px;height:24px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0; }
    .rank.g1 { background:rgba(245,158,11,.2);color:var(--warning); }
    .rank.g2 { background:rgba(148,163,184,.2);color:#94a3b8; }
    .rank.g3 { background:rgba(180,120,80,.2);color:#c97c4a; }
    .rank.gn { background:rgba(100,116,139,.15);color:var(--text-muted); }

    /* VARIATION */
    .var-up   { display:inline-flex;align-items:center;gap:3px;font-size:12px;font-weight:600;padding:3px 8px;border-radius:6px;background:rgba(16,185,129,.15);color:var(--success); }
    .var-down { display:inline-flex;align-items:center;gap:3px;font-size:12px;font-weight:600;padding:3px 8px;border-radius:6px;background:rgba(239,68,68,.15); color:var(--danger); }
    .var-neu  { display:inline-flex;align-items:center;gap:3px;font-size:12px;font-weight:600;padding:3px 8px;border-radius:6px;background:rgba(100,116,139,.15);color:var(--text-muted); }

    /* TAX CARDS */
    .tax-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px; }
    .tax-card { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;transition:transform var(--t); }
    .tax-card:hover { transform:translateY(-2px); }
    .tax-card-head { display:flex;align-items:center;justify-content:space-between;margin-bottom:14px; }
    .tax-name { font-size:13px;font-weight:700;letter-spacing:.04em; }
    .tax-cur  { font-size:24px;font-weight:800;margin-bottom:4px; }
    .tax-prev { font-size:11px;color:var(--text-muted);margin-bottom:12px; }
    .tax-foot { display:flex;align-items:center;justify-content:space-between;padding-top:10px;border-top:1px solid var(--border);font-size:11px;color:var(--text-muted); }

    /* MEMORY */
    .formula-box { background:rgba(34,163,41,0.07);border:1px solid rgba(34,163,41,0.2);border-radius:var(--radius-sm);padding:14px 18px;margin-bottom:20px; }
    .formula-box .fttl { font-weight:700;color:var(--accent);margin-bottom:8px;font-size:13px; }
    .formula-box .fline { color:var(--text-sec);line-height:1.8;font-size:12px;font-family:'Courier New',monospace; }
    .mem-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px; }
    .mem-card { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden; }
    .mem-card-head { padding:12px 16px;font-size:13px;font-weight:700;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between; }
    .mem-row { display:flex;justify-content:space-between;padding:8px 16px;border-bottom:1px solid var(--border);font-size:12px; }
    .mem-row:last-child { border-bottom:none; }
    .mem-row.hl  { background:rgba(34,163,41,0.06); }
    .mem-row.tot { background:rgba(16,185,129,0.08);font-weight:700; }
    .mem-row.neg { background:rgba(239,68,68,0.05); }
    .mem-row .lbl { color:var(--text-sec); }
    .mem-row .val { font-weight:600; }
    .mem-row.tot .val { color:var(--success); }
    .mem-row.neg .val { color:var(--danger); }
    .alert-box { background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.25);border-radius:var(--radius-sm);padding:10px 14px;margin-bottom:16px;font-size:12px;color:var(--warning); }

    /* DRE */
    .margin-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px; }
    .margin-card { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;text-align:center; }
    .margin-val { font-size:28px;font-weight:800;margin-bottom:4px; }
    .margin-lbl { font-size:12px;color:var(--text-sec); }
    .margin-sub { font-size:11px;color:var(--text-muted);margin-top:4px; }
    .dre-tbl td:first-child { padding-left:16px;font-weight:500; }
    .dre-tbl .dre-group td  { font-weight:700;background:rgba(255,255,255,0.03);color:var(--text-sec);font-size:11px;text-transform:uppercase;letter-spacing:.05em; }
    .dre-tbl .dre-indent td:first-child { padding-left:32px;color:var(--text-sec); }
    .dre-tbl .dre-total td  { font-weight:800;background:rgba(34,163,41,0.07);border-top:1px solid var(--border-accent); }
    .dre-tbl .dre-lucro td  { font-weight:800;background:rgba(16,185,129,0.08);color:var(--success);font-size:14px; }
    .dre-tbl .dre-neg td.r  { color:var(--danger); }
    .dre-tbl .dre-subv td   { background:rgba(245,158,11,0.06); }
    .dre-tbl .dre-nd td     { color:var(--text-muted);font-style:italic; }

    /* INDICATORS */
    .ind-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px; }
    .ind-card { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;transition:transform var(--t); }
    .ind-card:hover { transform:translateY(-2px); }
    .ind-head { display:flex;align-items:center;justify-content:space-between;margin-bottom:10px; }
    .ind-name { font-size:11px;font-weight:600;color:var(--text-sec);text-transform:uppercase;letter-spacing:.04em; }
    .ind-val  { font-size:26px;font-weight:800;margin-bottom:6px; }
    .ind-formula { font-size:11px;color:var(--text-muted);font-family:'Courier New',monospace;background:rgba(255,255,255,0.04);padding:6px 10px;border-radius:6px;margin-bottom:10px; }
    .ind-interp { font-size:11px;color:var(--text-sec);line-height:1.55;padding-top:10px;border-top:1px solid var(--border); }
    .dot { width:8px;height:8px;border-radius:50%;flex-shrink:0;display:inline-block; }
    .dot.gr { background:var(--success); }
    .dot.ye { background:var(--warning); }
    .dot.rd { background:var(--danger); }
    .dot.gy { background:var(--text-muted); }

    /* CHIPS */
    .chip { display:inline-flex;align-items:center;gap:4px;font-size:11px;padding:3px 8px;border-radius:20px;font-weight:500; }
    .chip.bl { background:rgba(34,163,41,.15);color:var(--accent); }
    .chip.gr { background:rgba(16,185,129,.15);color:var(--success); }
    .chip.ye { background:rgba(245,158,11,.15);color:var(--warning); }
    .chip.pu { background:rgba(139,92,246,.15);color:var(--purple); }
    .chip.cy { background:rgba(6,182,212,.15); color:var(--cyan); }
    .chip.or { background:rgba(249,115,22,.15);color:var(--orange); }
    .chip.rd { background:rgba(239,68,68,.15); color:var(--danger); }
    .chip.gy { background:rgba(100,116,139,.15);color:var(--text-muted); }

    /* UTIL */
    .divider { height:1px;background:var(--border);margin:20px 0; }
    .mb-24 { margin-bottom:24px; }
    .t-success { color:var(--success); }
    .t-danger  { color:var(--danger); }
    .t-warning { color:var(--warning); }
    .t-accent  { color:var(--accent); }
    .t-muted   { color:var(--text-muted); }
    .fw7 { font-weight:700; }
    .fw8 { font-weight:800; }

    /* OVERLAY */
    .overlay { display:none;position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:99; }
    ::-webkit-scrollbar { width:6px;height:6px; }
    ::-webkit-scrollbar-track { background:transparent; }
    ::-webkit-scrollbar-thumb { background:var(--border);border-radius:3px; }
    ::-webkit-scrollbar-thumb:hover { background:var(--text-muted); }

    /* RESPONSIVE */
    @media (max-width:1300px) {
      .tax-grid { grid-template-columns:repeat(2,1fr); }
      .mem-grid { grid-template-columns:repeat(2,1fr); }
      .ind-grid { grid-template-columns:repeat(2,1fr); }
      .margin-grid { grid-template-columns:repeat(2,1fr); }
    }
    @media (max-width:960px) {
      .kpi-grid-4 { grid-template-columns:repeat(2,1fr); }
      .kpi-grid-3 { grid-template-columns:repeat(2,1fr); }
      .cr-2col,.cr-1-2,.cr-2-1 { grid-template-columns:1fr; }
    }
    @media (max-width:768px) {
      .sidebar { transform:translateX(-100%); }
      .sidebar.mob-open { transform:translateX(0); }
      .main-wrapper { margin-left:0 !important; }
      .content { padding:14px; }
      .tax-grid,.mem-grid,.ind-grid { grid-template-columns:1fr; }
      .margin-grid { grid-template-columns:repeat(2,1fr); }
      .overlay { display:block; }
      .overlay.hidden { display:none; }
    }
  </style>
</head>
<body>

<div id="overlay" class="overlay hidden" onclick="closeMob()"></div>

<div id="app">
  <!-- ===== SIDEBAR ===== -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="logo-icon"><i class="fas fa-paint-roller"></i></div>
      <div class="logo-text">
        <div class="company">ÚNICA Tintas</div>
        <div class="subtitle">Grupo DAUTO &bull; Mai/2026</div>
      </div>
    </div>
    <nav class="sidebar-nav">
      <div class="sec-label">Principal</div>
      <div class="nav-item active" id="nav-visao-geral" onclick="showTab('visao-geral')">
        <div class="nav-ico"><i class="fas fa-gauge-high"></i></div><span class="nav-label">Visão Geral</span>
      </div>
      <div class="sec-label">Movimentação</div>
      <div class="nav-item" id="nav-compras" onclick="showTab('compras')">
        <div class="nav-ico"><i class="fas fa-cart-shopping"></i></div><span class="nav-label">Compras</span>
      </div>
      <div class="nav-item" id="nav-finalidade" onclick="showTab('finalidade')">
        <div class="nav-ico"><i class="fas fa-tags"></i></div><span class="nav-label">Finalidade de Compras</span>
