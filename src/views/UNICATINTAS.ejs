  function renderComprasRanking(pack) {
    const tbody = document.getElementById('compras-ranking-tbody');
    if (!tbody || !pack.totalCompras) { if (tbody) tbody.innerHTML = '<tr><td colspan="6" class="td-mute">Sem planilha de entradas para este período.</td></tr>'; return; }
    const total = pack.totalCompras;
    const top = (pack.fornecedores || []).slice(0, 8);
    const demais = total - top.reduce((a, b) => a + b.total, 0);
    tbody.innerHTML = '';
    top.forEach((f, i) => {
      const pct = ((f.total / total) * 100).toFixed(1);
      const barW = top[0] ? ((f.total / top[0].total) * 100).toFixed(0) : 0;
      const tr = document.createElement('tr');
      tr.innerHTML = '<td><div class="rank ' + rankClass(i) + '">' + (i + 1) + '</div></td><td><div class="fw7">' + f.nome + '</div><div class="td-mute">' + f.qtd + ' NFs</div></td><td>' + chipUf(f.uf) + '</td><td class="r td-val">' + fmtBRL(f.total) + '</td><td><div class="pb-wrap"><div class="pb-bar"><div class="pb-fill" style="width:' + barW + '%"></div></div><div class="pb-pct">' + pct + '%</div></div></td><td class="r td-mute">2-102</td>';
      tbody.appendChild(tr);
    });
    if (demais > 0) {
      const trD = document.createElement('tr');
      trD.innerHTML = '<td><div class="rank gn">' + (top.length + 1) + '+</div></td><td><div class="fw7">Demais Fornecedores</div></td><td><span class="chip gy">—</span></td><td class="r td-val">' + fmtBRL(demais) + '</td><td class="r td-mute">—</td><td class="r td-mute">vários</td>';
      tbody.appendChild(trD);
    }
  }

  function renderVendasRanking(pack) {
    const tbody = document.getElementById('vendas-ranking-tbody');
    if (!tbody || !pack.cfopSaidasTotal) { if (tbody) tbody.innerHTML = '<tr><td colspan="5" class="td-mute">Sem planilha de saídas para este período.</td></tr>'; return; }
    const total = pack.cfopSaidasTotal;
    const top = pack.clientesTop10 || pack.clientes.slice(0, 10);
    const demais = pack.demaisClientes || 0;
    const maxVal = top[0]?.total || 1;
    tbody.innerHTML = '';
    top.forEach((c, i) => {
      const pct = ((c.total / total) * 100).toFixed(1);
      const barW = ((c.total / maxVal) * 100).toFixed(0);
      const grupo = /DT TINTAS|DAUTO/i.test(c.nome) ? 'Grupo DAUTO' : 'Parceiro';
      const tr = document.createElement('tr');
      tr.innerHTML = '<td><div class="rank ' + rankClass(i) + '">' + (i + 1) + '</div></td><td><div class="fw7">' + c.nome + '</div><div class="td-mute">' + grupo + ' · ' + c.qtd + ' NFs</div></td><td>' + chipUf(c.uf) + '</td><td class="r td-val">' + fmtBRL(c.total) + '</td><td><div class="pb-wrap"><div class="pb-bar"><div class="pb-fill" style="width:' + barW + '%"></div></div><div class="pb-pct">' + pct + '%</div></div></td>';
      tbody.appendChild(tr);
    });
    if (demais > 0) {
      const trD = document.createElement('tr');
      trD.innerHTML = '<td><div class="rank gn">' + (top.length + 1) + '+</div></td><td><div class="fw7">Demais Clientes</div></td><td><span class="chip gy">—</span></td><td class="r td-val">' + fmtBRL(demais) + '</td><td class="r td-mute">—</td>';
      tbody.appendChild(trD);
    }
  }

