          'visao-geral': initVisaoGeral, compras: initCompras, finalidade: initFinalidade, vendas: initVendas,
          impostos: initImpostos, memoria: initMemoria, recebimentos: initRecebimentos, balancete: initBalancete,
          dre: initDRE, indicadores: initIndicadores,
        };
        if (inits[name]) inits[name]();
      }, 50);
