  window.closeDrilldown = function () {
    document.getElementById('drilldown-panel').style.display = 'none';
    activeDrilldownCfop = null;
  };

  window.openDrilldown = function (cfop) {
    if (activeDrilldownCfop === cfop) { closeDrilldown(); return; }
    activeDrilldownCfop = cfop;
    const pack = getPack();
    const item = (pack.cfopDados || []).find(d => d.cfop === cfop);
    const info = CFOP_FINALIDADE[cfop] || {};
    if (!item) return;
    document.getElementById('dd-title').textContent = 'CFOP ' + cfop + ' — ' + (info.descricao || '');
    document.getElementById('dd-sub').textContent = 'Finalidade: ' + (info.finalidade || '—') + ' | Total: R$ ' + item.total.toLocaleString('pt-BR') + ' | ' + item.qtd + ' NFs';
    const tbody = document.getElementById('dd-tbody');
    tbody.innerHTML = '';
    item.fornecedores.forEach((f, i) => {
      const pct = item.total > 0 ? ((f.total / item.total) * 100).toFixed(1) : '0.0';
      const tr = document.createElement('tr');
      tr.innerHTML = '<td>' + (i + 1) + '</td><td><div class="fw7">' + f.nome + '</div></td><td><span class="td-mute">' + f.cnpj + '</span></td><td>' + chipUf(f.uf) + '</td><td class="r">' + f.qtd + '</td><td class="r td-val">R$ ' + f.total.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</td><td class="r"><div class="pb-pct">' + pct + '%</div></td>';
      tbody.appendChild(tr);
    });
    document.getElementById('drilldown-panel').style.display = 'block';
  };

  function initFinalidade() {
    const pack = enrichMovementPack(getPack());
    renderTabNotice('tab-finalidade', activeTabNotice || movementAvailabilityNote(pack));
    const CFOP_DADOS = pack.cfopDados || [];
    const totalGeral = CFOP_DADOS.reduce((a, b) => a + b.total, 0);
    const macro = aggregateMacroFinalidade(CFOP_DADOS);
    const finLabels = macro.map((m) => m.label);
    const finVals = macro.map((m) => m.total);
    const finCores = macro.map((m) => m.color);

    const fnGrid = document.getElementById('fn-kpi-grid');
    if (fnGrid) {
      if (!totalGeral) {
        fnGrid.innerHTML = '<div class="alert-box">Sem planilha de entradas para ' + periodFull() + '.</div>';
      } else {
        fnGrid.innerHTML = macro.map((m) =>
          kpiCard(m.cardColor, m.icon, m.badge, fmtBRL(m.total, true), m.label, m.sub + ' — ' + m.pct.toFixed(1) + '% do total')
        ).join('');
      }
    }

    const distSub = document.getElementById('fn-chart-dist-sub');
    const barSub = document.getElementById('fn-chart-bar-sub');
    if (distSub) {
      distSub.textContent = totalGeral
        ? '% do valor total de entradas — ' + periodFull() + ' (R$ ' + totalGeral.toLocaleString('pt-BR', { maximumFractionDigits: 0 }) + ' bruto)'
        : 'Sem entradas no período — ' + periodFull();
    }
    if (barSub) {
      barSub.textContent = 'Comparativo dos grupos fiscais de compras — ' + periodFull();
    }

    const chartLabels = totalGeral ? finLabels : ['Sem dados'];
    const chartVals = totalGeral ? finVals : [0];
    const chartCores = totalGeral ? finCores : ['#64748b'];

    safeChart('chartFinalidadeDist', {
      type: 'doughnut',
      data: { labels: chartLabels, datasets: [{ data: chartVals, backgroundColor: chartCores, borderWidth: 0, hoverOffset: 6 }] },
      options: {
        responsive: true, maintainAspectRatio: false, cutout: '58%',
        plugins: {
          legend: { ...leg(), position: 'right' },
          tooltip: {
            ...tip(),
            callbacks: {
              label: (c) => {
                if (!totalGeral) return c.label;
                const pct = ((c.parsed / totalGeral) * 100).toFixed(1);
                return c.label + ': R$ ' + c.parsed.toLocaleString('pt-BR', { maximumFractionDigits: 0 }) + ' (' + pct + '%)';
              },
            },
          },
        },
      },
    });
    safeChart('chartFinalidadeBar', {
      type: 'bar',
      data: { labels: chartLabels, datasets: [{ label: 'R$ mil', data: chartVals.map((v) => +(v / 1000).toFixed(1)), backgroundColor: chartCores, borderRadius: 5 }] },
      options: {
        indexAxis: 'y', responsive: true, maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: { ...tip(), callbacks: { label: (c) => 'R$ ' + (c.parsed.x * 1000).toLocaleString('pt-BR', { maximumFractionDigits: 0 }) } },
        },
        scales: { x: { ticks: { callback: (v) => 'R$' + v + 'K' } } },
      },
    });

    const tbody = document.getElementById('cfop-tbody');
    if (!tbody) return;
    tbody.innerHTML = '';
    if (!CFOP_DADOS.length) { tbody.innerHTML = '<tr><td colspan="8" class="td-mute">Sem dados CFOP para este período.</td></tr>'; return; }
    CFOP_DADOS.forEach(d => {
      const info = CFOP_FINALIDADE[d.cfop] || {};
      const pct = totalGeral > 0 ? ((d.total / totalGeral) * 100).toFixed(1) : '0.0';
      const cor = FINALIDADE_CORES[info.finalidade] || '#64748b';
      const credChip = info.creditoPisCofins ? '<span class="chip gr">Sim</span>' : '<span class="chip rd">Não</span>';
      const tr = document.createElement('tr');
      tr.style.cursor = 'pointer';
      tr.innerHTML = '<td><span class="chip" style="font-family:monospace;font-weight:700;">' + d.cfop + '</span></td><td style="font-size:12px;color:var(--text-sec)">' + (info.descricao || '—') + '</td><td><span class="chip" style="background:' + cor + '22;color:' + cor + '">' + (info.finalidade || '—') + '</span></td><td>' + credChip + '</td><td class="r">' + d.qtd + '</td><td class="r td-val">R$ ' + d.total.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</td><td class="r">' + pct + '%</td><td class="c"><button onclick="openDrilldown(\'' + d.cfop + '\')" style="background:rgba(34,163,41,0.12);border:1px solid rgba(34,163,41,0.3);color:var(--accent);padding:4px 10px;border-radius:6px;cursor:pointer;font-size:11px;">Ver</button></td>';
      tbody.appendChild(tr);
    });
  }

  function initMemoria() { /* conteúdo estático — labels atualizados via updateCompetenciaLabels */ }

  function initRecebimentos() {
    const pack = getPack();
    renderTabNotice('tab-recebimentos', activeTabNotice || movementAvailabilityNote(pack));

    const recPeriod = document.getElementById('rec-sec-competencia');
    if (recPeriod) recPeriod.textContent = 'Competência ' + periodFull();
    const recSub = document.getElementById('rec-sec-sub');
    if (recSub) {
      recSub.textContent = pack.hasMovimentacao
        ? 'Estimativa ICMS — ' + periodFull()
        : 'Sem movimentação fiscal neste período — ' + periodFull();
    }

    const receb = pack.cfopSaidasTotal;
    const pag = pack.totalCompras;
    const hasRec = receb != null;
    const hasPag = pag != null;
    const saldo = hasRec && hasPag ? receb - pag : null;

    const grid = document.getElementById('rec-kpi-grid');
    if (grid) {
      if (!pack.hasMovimentacao) {
        grid.innerHTML = '<div class="alert-box" style="grid-column:1/-1;">Sem planilha de entradas/saídas para ' + periodFull() + '. Selecione Mai ou Jun/2026, ou Total.</div>';
      } else {
        grid.innerHTML =
          kpiCard('green', 'arrow-down', periodLbl(), fmtBRL(receb, true), 'Recebimentos estimados', 'Faturamento (saídas ICMS)') +
          kpiCard('red', 'arrow-up', periodLbl(), fmtBRL(pag, true), 'Pagamentos estimados', 'Compras (entradas ICMS)') +
          kpiCard(saldo != null && saldo >= 0 ? 'blue' : 'orange', 'scale-balanced', periodLbl(), fmtBRL(saldo, true), 'Saldo estimado', 'Recebimentos − pagamentos');
      }
    }

    const labels = D.meta.monthShort;
    const recData = MES_KEYS.map((m) => {
      const v = D.fiscalPorMes[m]?.cfopSaidasTotal;
      return v != null ? +(v / 1000).toFixed(1) : null;
    });
    const pagData = MES_KEYS.map((m) => {
      const v = D.fiscalPorMes[m]?.totalCompras;
      return v != null ? +(v / 1000).toFixed(1) : null;
    });

    const chartSub = document.getElementById('rec-chart-sub');
    if (chartSub) {
      const mov = monthsWithMovement();
      chartSub.textContent = mov.length
        ? 'Comparativo mensal — Jan–Jun/2026 (valores em milhares; meses sem planilha ficam vazios)'
        : 'Sem movimentação fiscal importada';
    }

    safeChart('chartRecebPag', {
      type: 'bar',
      data: {
        labels,
        datasets: [
          { label: 'Recebimentos (mil)', data: recData, backgroundColor: PAL[1], borderRadius: 4 },
          { label: 'Pagamentos (mil)', data: pagData, backgroundColor: PAL[4], borderRadius: 4 },
        ],
      },
      options: { responsive: true, maintainAspectRatio: false, spanGaps: false, plugins: { legend: leg() } },
    });
