<script>
/* ÚNICA Dashboard — período dinâmico + abas (DASHBOARD_DATA) */
(function () {
  'use strict';

  if (typeof DASHBOARD_DATA === 'undefined') {
    console.error('unica-data.js não carregado');
    return;
  }

  const D = DASHBOARD_DATA;
  const CFOP_FINALIDADE = D.cfopFinalidade || {};
  const FINALIDADE_CORES = D.finalidadeCores || {};
  const MES_KEYS = D.meta.meses;
  const MONTH_LABELS = D.meta.monthLabels;
  const MES_BAR_IDS = ['vg-mes-bar', 'cp-mes-bar', 'fn-mes-bar', 'vd-mes-bar', 'tax-mes-bar', 'mem-mes-bar', 'rec-mes-bar', 'dre-mes-bar', 'ind-mes-bar'];
  const MOVEMENT_TABS = new Set(['compras', 'finalidade', 'vendas', 'recebimentos']);
  const DRE_TABS = new Set(['visao-geral', 'dre', 'indicadores', 'impostos']);

  let state = { fiscalMode: 'month', month: D.meta.defaultMonth || MES_KEYS[MES_KEYS.length - 1] };
  let currentTab = 'visao-geral';
  let activeTabNotice = null;
  let activeDrilldownCfop = null;
  const chartInst = {};
  const tabsInit = {};

  Chart.defaults.color = '#94a3b8';
  Chart.defaults.borderColor = 'rgba(255,255,255,0.07)';
  Chart.defaults.font.family = "'Inter', sans-serif";
  Chart.defaults.font.size = 12;
  const PAL = ['#22a329', '#10b981', '#f59e0b', '#8b5cf6', '#ef4444', '#06b6d4', '#f97316', '#ec4899'];

  function tip() {
    return { backgroundColor: '#1e2535', borderColor: 'rgba(255,255,255,0.1)', borderWidth: 1, padding: 12, titleColor: '#e2e8f0', bodyColor: '#94a3b8', cornerRadius: 8 };
  }
  function leg() { return { labels: { usePointStyle: true, padding: 16, boxWidth: 8, boxHeight: 8 } }; }

  function safeChart(id, cfg) {
    if (chartInst[id]) chartInst[id].destroy();
    const ctx = document.getElementById(id);
    if (!ctx) return;
    chartInst[id] = new Chart(ctx, cfg);
  }

  function fmtBRL(v, short) {
    if (v == null || isNaN(v)) return '—';
    if (short && Math.abs(v) >= 1e6) return 'R$ ' + (v / 1e6).toFixed(2).replace('.', ',') + 'M';
    if (short && Math.abs(v) >= 1e3) return 'R$ ' + (v / 1e3).toFixed(1).replace('.', ',') + 'K';
    return 'R$ ' + Number(v).toLocaleString('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function periodLbl() {
    if (state.fiscalMode === 'total') return 'Total';
    return (MONTH_LABELS[state.month] || state.month) + '/26';
  }

  function periodFull() {
    if (state.fiscalMode === 'total') return D.meta.periodoTotal.label;
    return (MONTH_LABELS[state.month] || state.month) + ' / 2026';
  }

  function getActiveKey() {
    return state.fiscalMode === 'total' ? 'total' : state.month;
  }

  function isActiveKey(key) {
    return getActiveKey() === key;
  }

  function applyPeriodSelection(val) {
    if (val === 'total') state.fiscalMode = 'total';
    else { state.fiscalMode = 'month'; state.month = val; }
    syncMonthSel();
    syncAllMesBars();
    updateCompetenciaLabels();
    resetAllTabs();
    showTab(currentTab, true);
  }

  window.onMonthSelChange = applyPeriodSelection;

  function syncMonthSel() {
    const ms = document.getElementById('monthSel');
    if (!ms) return;
    const key = getActiveKey();
    if (ms.value !== key) ms.value = key;
  }

  function hydrateMonthSel() {
    const ms = document.getElementById('monthSel');
    if (!ms) return;
    let html = '';
    if (MES_KEYS.length > 1) html += '<option value="total">' + D.meta.periodoTotal.label + '</option>';
    MES_KEYS.forEach(m => { html += '<option value="' + m + '">' + MONTH_LABELS[m] + ' / 2026</option>'; });
    ms.innerHTML = html;
    syncMonthSel();
  }

  function renderPeriodBar(containerId, onSelect) {
    const bar = document.getElementById(containerId);
    if (!bar) return;
    bar.innerHTML = '';
    const add = (key, label, extra) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'vd-mes-chip' + (extra ? ' ' + extra : '') + (isActiveKey(key) ? ' active' : '');
      btn.setAttribute('data-mes', key);
      btn.textContent = label;
      btn.onclick = () => { applyPeriodSelection(key); if (onSelect) onSelect(); };
      bar.appendChild(btn);
    };
    if (MES_KEYS.length > 1) add('total', 'Total', 'tot');
    if (MES_KEYS.length > 1) {
      const sep = document.createElement('span');
      sep.className = 'vd-mes-sep';
      sep.textContent = '|';
      bar.appendChild(sep);
    }
    MES_KEYS.forEach(m => add(m, MONTH_LABELS[m], ''));
  }

  function syncAllMesBars() {
    const key = getActiveKey();
    MES_BAR_IDS.forEach(id => {
      const bar = document.getElementById(id);
      if (!bar) return;
      bar.querySelectorAll('.vd-mes-chip').forEach(chip => {
        chip.classList.toggle('active', chip.getAttribute('data-mes') === key);
      });
    });
  }

  function buildAllMesBars() {
    MES_BAR_IDS.forEach(id => renderPeriodBar(id));
  }

  function updateCompetenciaLabels() {
    const lbl = 'Competência ' + periodFull();
    ['vg-sec-competencia', 'cp-sec-competencia', 'fn-sec-competencia', 'vd-sec-competencia',
      'tax-sec-competencia', 'mem-sec-competencia', 'rec-sec-competencia', 'dre-sec-competencia', 'ind-sec-competencia'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.textContent = lbl;
    });
    const sp = document.getElementById('sidebarPeriod');
    if (sp) sp.textContent = D.meta.periodoTotal.label.replace('Total ', '');
    const ht = document.getElementById('headerTitle');
    if (ht && currentTab === 'visao-geral') {
      ht.innerHTML = 'Visão Geral <span>Resumo Executivo – ' + periodFull() + '</span>';
    }
  }

  function resetAllTabs() {
    Object.keys(tabsInit).forEach(k => { tabsInit[k] = false; });
  }

  function mergeCfopDados(packs) {
    const m = {};
    packs.forEach(p => (p.cfopDados || []).forEach(c => {
      if (!m[c.cfop]) m[c.cfop] = { cfop: c.cfop, qtd: 0, total: 0, fornecedores: {} };
      const e = m[c.cfop];
      e.qtd += c.qtd || 0;
      e.total += c.total || 0;
      (c.fornecedores || []).forEach(f => {
        if (!e.fornecedores[f.nome]) e.fornecedores[f.nome] = { ...f, qtd: 0, total: 0 };
        e.fornecedores[f.nome].qtd += f.qtd || 0;
        e.fornecedores[f.nome].total += f.total || 0;
      });
    }));
    return Object.values(m).map(c => ({
      ...c,
      total: Math.round(c.total * 100) / 100,
      fornecedores: Object.values(c.fornecedores).sort((a, b) => b.total - a.total),
    })).sort((a, b) => b.total - a.total);
  }

  function mergeCfopSaidas(packs) {
    const m = {};
    packs.forEach(p => (p.cfopSaidas || []).forEach(c => {
      if (!m[c.cfop]) m[c.cfop] = { cfop: c.cfop, qtd: 0, total: 0 };
      m[c.cfop].qtd += c.qtd || 0;
      m[c.cfop].total += c.total || 0;
    }));
    return Object.values(m).map(c => ({ ...c, total: Math.round(c.total * 100) / 100 })).sort((a, b) => b.total - a.total);
  }

  function mergeParties(listKey, packs) {
    const m = {};
    packs.forEach(p => (p[listKey] || []).forEach(x => {
      const k = x.nome;
      if (!m[k]) m[k] = { ...x, qtd: 0, total: 0 };
      m[k].qtd += x.qtd || 0;
      m[k].total += x.total || 0;
    }));
    return Object.values(m).map(x => ({ ...x, total: Math.round(x.total * 100) / 100 })).sort((a, b) => b.total - a.total);
  }

  function mergeUf(packs, key) {
    const m = {};
    packs.forEach(p => (p[key] || []).forEach(u => { m[u.uf] = (m[u.uf] || 0) + u.total; }));
    const total = Object.values(m).reduce((a, b) => a + b, 0) || 1;
    return Object.entries(m).map(([uf, t]) => ({ uf, total: Math.round(t * 100) / 100, pct: Math.round(t / total * 10000) / 100 })).sort((a, b) => b.total - a.total);
  }

  function sumField(packs, fn) {
    let s = 0, has = false;
    packs.forEach(p => { const v = fn(p); if (v != null && !isNaN(v)) { s += v; has = true; } });
    return has ? s : null;
  }

  function aggregatePack(monthKeys) {
    const packs = monthKeys.map(m => D.fiscalPorMes[m]).filter(Boolean);
    const fornecedores = mergeParties('fornecedores', packs);
    const clientes = mergeParties('clientes', packs);
    const top10 = clientes.slice(0, 10);
    const saiTotal = sumField(packs, p => p.cfopSaidasTotal);
    const demais = saiTotal != null ? Math.round((saiTotal - top10.reduce((a, c) => a + c.total, 0)) * 100) / 100 : 0;
    const composicaoMap = {};
    packs.forEach(p => (p.composicao || []).forEach(c => {
      composicaoMap[c.label] = (composicaoMap[c.label] || 0) + (c.valor || 0);
    }));
    const composicao = Object.entries(composicaoMap).map(([label, valor]) => ({ label, valor })).filter(c => c.valor);
    return {
      monthKeys,
      monthLabel: monthKeys.length > 1 ? D.meta.periodoTotal.label : (MONTH_LABELS[monthKeys[0]] + ' / 2026'),
      receitaBruta: sumField(packs, p => p.receitaBruta),
      deducoes: sumField(packs, p => p.deducoes),
      dedPct: (() => {
        const rb = sumField(packs, p => p.receitaBruta);
        const ded = sumField(packs, p => p.deducoes);
        return rb > 0 ? Math.round(ded / rb * 10000) / 100 : null;
      })(),
      totalCompras: sumField(packs, p => p.totalCompras),
      cfopSaidasTotal: saiTotal,
      nfsEntradas: sumField(packs, p => p.nfsEntradas),
      nfsSaidas: sumField(packs, p => p.nfsSaidas),
      cfopDados: mergeCfopDados(packs),
      cfopSaidas: mergeCfopSaidas(packs),
      fornecedores,
      clientes,
      clientesTop10: top10,
      demaisClientes: demais,
      dtTintasTotal: Math.round(clientes.filter(c => c.nome.toUpperCase().includes('DT TINTAS')).reduce((a, c) => a + c.total, 0) * 100) / 100,
      ufEntradas: mergeUf(packs, 'ufEntradas'),
      ufSaidas: mergeUf(packs, 'ufSaidas'),
      composicao,
      apuracao: packs.length === 1 ? packs[0].apuracao : null,
      hasDre: packs.some(p => p.hasDre),
      hasMovimentacao: packs.some(p => p.hasMovimentacao),
      icmsDed: sumField(packs, p => p.icmsDed),
      icmsStDed: sumField(packs, p => p.icmsStDed),
      cofinsDed: sumField(packs, p => p.cofinsDed),
      pisDed: sumField(packs, p => p.pisDed),
      devDed: sumField(packs, p => p.devDed),
      cmv: sumField(packs, p => p.cmv),
      lucBruto: sumField(packs, p => p.lucBruto),
      lucLiq: sumField(packs, p => p.lucLiq),
      margMb: null,
      margMl: null,
      subvencao: sumField(packs, p => p.subvencao),
    };
  }

  function getPack() {
    if (state.fiscalMode === 'total') return aggregatePack(MES_KEYS);
    return { ...D.fiscalPorMes[state.month], monthKeys: [state.month] };
  }

  function monthsWithMovement() {
    return MES_KEYS.filter((m) => D.fiscalPorMes[m]?.hasMovimentacao);
  }

  function getLastMovementMonth() {
    const mov = monthsWithMovement();
    return mov.length ? mov[mov.length - 1] : (D.meta.defaultMonth || MES_KEYS[MES_KEYS.length - 1]);
  }

  function getLastDreMonth() {
    for (let i = MES_KEYS.length - 1; i >= 0; i--) {
      if (D.fiscalPorMes[MES_KEYS[i]]?.hasDre) return MES_KEYS[i];
    }
    return MES_KEYS[0];
  }

  function ensurePeriodForTab(tabName) {
    if (state.fiscalMode === 'total') return null;
    const pack = D.fiscalPorMes[state.month];
    if (MOVEMENT_TABS.has(tabName) && !pack?.hasMovimentacao) {
      const fallback = getLastMovementMonth();
      if (fallback && fallback !== state.month) {
        const prev = periodFull();
        state.month = fallback;
        syncMonthSel();
        syncAllMesBars();
        updateCompetenciaLabels();
        return 'Sem planilha de entradas/saídas em ' + prev + '. Exibindo ' + MONTH_LABELS[fallback] + ' / 2026.';
      }
    }
    if (DRE_TABS.has(tabName) && tabName !== 'impostos' && !pack?.hasDre && !pack?.hasMovimentacao) {
      const fallback = getLastDreMonth();
      if (fallback && fallback !== state.month) {
        const prev = periodFull();
        state.month = fallback;
        syncMonthSel();
        syncAllMesBars();
        updateCompetenciaLabels();
        return 'DRE não disponível em ' + prev + '. Exibindo ' + MONTH_LABELS[fallback] + ' / 2026.';
      }
    }
    return null;
  }

  function enrichMovementPack(pack) {
    if (!pack) return pack;
    const out = { ...pack };
    if ((!out.fornecedores || !out.fornecedores.length) && out.cfopDados?.length) {
      const merged = {};
      out.cfopDados.forEach((c) => (c.fornecedores || []).forEach((f) => {
        if (!merged[f.nome]) merged[f.nome] = { ...f, qtd: 0, total: 0 };
        merged[f.nome].qtd += f.qtd || 0;
        merged[f.nome].total += f.total || 0;
      }));
      out.fornecedores = Object.values(merged).sort((a, b) => b.total - a.total);
    }
    if ((!out.ufEntradas || !out.ufEntradas.length) && out.fornecedores?.length) {
      const ufs = {};
      out.fornecedores.forEach((f) => { ufs[f.uf] = (ufs[f.uf] || 0) + f.total; });
      const total = Object.values(ufs).reduce((a, b) => a + b, 0) || 1;
      out.ufEntradas = Object.entries(ufs)
        .map(([uf, t]) => ({ uf, total: Math.round(t * 100) / 100, pct: Math.round(t / total * 10000) / 100 }))
        .sort((a, b) => b.total - a.total);
    }
    return out;
  }

  function renderTabNotice(containerId, message) {
    const host = document.getElementById(containerId);
    if (!host) return;
    let box = host.querySelector('.tab-period-notice');
    if (!message) {
      if (box) box.remove();
      return;
    }
    if (!box) {
      box = document.createElement('div');
      box.className = 'tab-period-notice alert-box';
      host.insertBefore(box, host.firstChild);
    }
    box.textContent = message;
  }

  function movementAvailabilityNote(pack) {
    const mov = monthsWithMovement();
    if (!mov.length) return 'Nenhuma planilha de entradas/saídas importada ainda.';
    if (state.fiscalMode === 'total' && pack.hasMovimentacao) {
      return 'Movimento fiscal disponível para ' + mov.map((m) => MONTH_LABELS[m] + '/2026').join(' e ') + '.';
    }
    if (state.fiscalMode === 'month' && !pack.hasMovimentacao) {
      return 'Sem planilha de entradas/saídas em ' + periodFull() + '. Selecione ' + mov.map((m) => MONTH_LABELS[m]).join(' ou ') + '/2026.';
    }
    return null;
  }

  function getSeries(monthKeys, field) {
    return monthKeys.map(m => {
      const v = D.fiscalPorMes[m]?.[field];
      return v == null ? null : v;
    });
  }

  function kpiCard(color, icon, badge, val, lbl, sub) {
    return '<div class="kpi-card c-' + color + '"><div class="kpi-head"><div class="kpi-ico c-' + color + '"><i class="fas fa-' + icon + '"></i></div>' +
      (badge ? '<div class="kpi-badge neutral">' + badge + '</div>' : '') + '</div><div class="kpi-val">' + val + '</div><div class="kpi-lbl">' + lbl + '</div>' +
      (sub ? '<div class="kpi-sub">' + sub + '</div>' : '') + '</div>';
  }

  function chipUf(uf) {
    const m = { DF: 'cy', SP: 'bl', GO: 'or', PR: 'pu', MG: 'gr', CE: 'ye', RS: 'pu', SC: 'cy', RJ: 'bl', BA: 'or' };
    return '<span class="chip ' + (m[uf] || 'gy') + '">' + uf + '</span>';
  }

  function rankClass(i) {
    if (i === 0) return 'g1';
    if (i === 1) return 'g2';
    if (i === 2) return 'g3';
    return 'gn';
  }

  const MACRO_FINALIDADE = [
    { key: 'revenda', label: 'Revenda', badge: '1.102 / 2.102 / 1.403', color: '#22a329', cardColor: 'blue', icon: 'rotate-left', sub: 'Compra p/ comercialização' },
    { key: 'ativo', label: 'Ativo Imobilizado', badge: '1.551', color: '#f97316', cardColor: 'orange', icon: 'building', sub: 'Bens para o ativo imobilizado' },
    { key: 'devol', label: 'Devoluções / Retornos', badge: '1.202 / 1.411 / 2.202 / 2.411', color: '#8b5cf6', cardColor: 'purple', icon: 'arrows-rotate', sub: 'Devoluções de venda (incl. ST)' },
    { key: 'outros', label: 'Outros', badge: 'Demais CFOPs', color: '#06b6d4', cardColor: 'cyan', icon: 'box-open', sub: 'Serviços, bonificação, comodato e demais entradas' },
  ];

  function getMacroGrupo(cfop) {
    const fin = (CFOP_FINALIDADE[cfop] || {}).finalidade || '';
    if (fin === 'Revenda' || fin === 'Revenda c/ ST' || fin === 'Industrializacao' || fin === 'Industrializacao c/ ST') return 'revenda';
    if (fin === 'Ativo Imobilizado') return 'ativo';
    if (fin === 'Devolução Venda' || fin === 'Devol. Compra') return 'devol';
    return 'outros';
  }

  function aggregateMacroFinalidade(cfopDados) {
    const buckets = {};
    MACRO_FINALIDADE.forEach((m) => { buckets[m.key] = { total: 0, qtd: 0 }; });
    (cfopDados || []).forEach((d) => {
      const key = getMacroGrupo(d.cfop);
      buckets[key].total += d.total || 0;
      buckets[key].qtd += d.qtd || 0;
    });
    const totalGeral = (cfopDados || []).reduce((a, d) => a + (d.total || 0), 0);
    return MACRO_FINALIDADE.map((m) => ({
      ...m,
      total: buckets[m.key].total,
      qtd: buckets[m.key].qtd,
      pct: totalGeral > 0 ? (100 * buckets[m.key].total / totalGeral) : 0,
    }));
  }

  /* ---- INITS ---- */

  function initVisaoGeral() {
    const pack = getPack();
    renderTabNotice('tab-visao-geral', activeTabNotice);
    const grid = document.getElementById('vg-kpi-grid');
    if (grid) {
      const ap = pack.apuracao;
      const icmsRec = ap ? fmtBRL(ap.icms.aRecolher, true) : '—';
      const subv = ap ? fmtBRL(ap.subvencao, true) : (pack.subvencao ? fmtBRL(pack.subvencao, true) : '—');
      grid.innerHTML =
        kpiCard('blue', 'store', periodLbl(), fmtBRL(pack.receitaBruta, true), 'Receita Bruta de Vendas', pack.receitaBruta == null ? 'DRE não lançado neste período' : (pack.receitaFonte === 'faturamento_nf' ? 'Fonte: faturamento NF-e' : 'Fonte: DRE contábil')) +
        kpiCard('green', 'cart-shopping', periodLbl(), fmtBRL(pack.totalCompras, true), 'Total de Compras', pack.totalCompras == null ? 'Planilha de entradas pendente' : (pack.nfsEntradas || '—') + ' NFs') +
