  /* ---- EXPORT (simplificado) ---- */
  window.getCompanyName = function () { return document.querySelector('.logo-text .company')?.textContent?.trim() || 'ÚNICA Tintas'; };
  window.exportPDF = async function (sectionId, filename) {
    const section = document.getElementById(sectionId);
    if (!section || !window.html2canvas) return;
    const canvas = await html2canvas(section, { scale: 2, backgroundColor: '#0f1117' });
    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
    const pageW = pdf.internal.pageSize.getWidth();
    const img = canvas.toDataURL('image/png');
    const h = (canvas.height * (pageW - 20)) / canvas.width;
    pdf.addImage(img, 'PNG', 10, 10, pageW - 20, h);
    pdf.save(filename + '_' + new Date().toLocaleDateString('pt-BR').replace(/\//g, '-') + '.pdf');
  };
  window.exportExcel = function (sectionId, filename) {
    const section = document.getElementById(sectionId);
    if (!section || !window.XLSX) return;
    const wb = XLSX.utils.book_new();
    section.querySelectorAll('table').forEach((tbl, i) => {
      XLSX.utils.book_append_sheet(wb, XLSX.utils.table_to_sheet(tbl), 'Sheet' + (i + 1));
    });
    XLSX.writeFile(wb, filename + '.xlsx');
  };

  function escHtml(v) {
    return String(v ?? '')
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function supplierKey(f) {
    return (f.cnpj && String(f.cnpj).trim()) || f.nome;
  }

  function getSupplierReportPeriodKey() {
    const sel = document.getElementById('supplierReportPeriod');
    return sel?.value || resolveDefaultSupplierReportPeriod();
  }

  function getPackForSupplierReport(periodKey) {
    if (periodKey === 'total') return aggregatePack(MES_KEYS);
    const pack = D.fiscalPorMes[periodKey];
    return pack ? { ...pack, monthKeys: [periodKey] } : null;
  }

  function periodLabelForReport(periodKey) {
    if (periodKey === 'total') return D.meta.periodoTotal.label;
    return (MONTH_LABELS[periodKey] || periodKey) + ' / 2026';
  }

  function resolveDefaultSupplierReportPeriod() {
    if (state.fiscalMode === 'month' && D.fiscalPorMes[state.month]?.hasMovimentacao) {
      return state.month;
    }
    return getLastMovementMonth();
  }

  function hydrateSupplierReportPeriodSelect() {
    const sel = document.getElementById('supplierReportPeriod');
    if (!sel) return;
    const mov = monthsWithMovement();
    let html = '';
    mov.forEach((m) => {
      html += '<option value="' + m + '">' + MONTH_LABELS[m] + ' / 2026</option>';
    });
    if (mov.length > 1) {
      html += '<option value="total">' + D.meta.periodoTotal.label + '</option>';
    }
    sel.innerHTML = html;
    sel.value = resolveDefaultSupplierReportPeriod();
  }

  function getCfopDadosForPrint() {
    const pack = getPackForSupplierReport(getSupplierReportPeriodKey());
    if (!pack) return [];
    return enrichMovementPack(pack).cfopDados || [];
  }

  function collectUniqueSuppliers() {
    const map = new Map();
    getCfopDadosForPrint().forEach((cfop) => {
      (cfop.fornecedores || []).forEach((f) => {
        const key = supplierKey(f);
        if (!key || map.has(key)) return;
        map.set(key, { nome: f.nome, cnpj: f.cnpj || '—', uf: f.uf || '—', key });
      });
    });
    return Array.from(map.values()).sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));
  }

  function findFornecedorInCfop(cfop, key, nome) {
    return (cfop.fornecedores || []).find((f) => supplierKey(f) === key || (nome && f.nome === nome));
  }

  function rowsForSupplier(cfopDados, key, nome) {
    const rows = [];
    cfopDados.forEach((cfop) => {
      const f = findFornecedorInCfop(cfop, key, nome);
      if (!f) return;
      const info = CFOP_FINALIDADE[cfop.cfop] || {};
      rows.push({
        cfop: cfop.cfop,
        desc: info.descricao || '—',
        fin: info.finalidade || '—',
        qtd: f.qtd || 0,
        total: f.total || 0,
      });
    });
    return rows;
  }

  function aggregateDemaisByCfop(cfopDados, selectedKeys) {
    const map = {};
    cfopDados.forEach((cfop) => {
      (cfop.fornecedores || []).forEach((f) => {
        const key = supplierKey(f);
        if (!key || selectedKeys.has(key)) return;
        if (!map[cfop.cfop]) map[cfop.cfop] = { cfop: cfop.cfop, qtd: 0, total: 0 };
        map[cfop.cfop].qtd += f.qtd || 0;
        map[cfop.cfop].total += f.total || 0;
      });
    });
    return Object.values(map)
      .filter((r) => r.total > 0)
      .map((r) => {
        const info = CFOP_FINALIDADE[r.cfop] || {};
        return {
          cfop: r.cfop,
          desc: info.descricao || '—',
          fin: info.finalidade || '—',
          qtd: r.qtd,
          total: Math.round(r.total * 100) / 100,
        };
      })
      .sort((a, b) => b.total - a.total);
  }

  function renderSupplierTableRows(rows) {
    return rows.map((r) =>
      '<tr><td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;">' + escHtml(r.cfop) + '</td>' +
      '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;">' + escHtml(r.desc) + '</td>' +
      '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;">' + escHtml(r.fin) + '</td>' +
      '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;text-align:right;">' + r.qtd + '</td>' +
      '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;text-align:right;font-weight:600;">' +
      r.total.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</td></tr>'
    ).join('');
  }

  function renderSupplierSection(nome, cnpj, uf, rows) {
    const subtotal = rows.reduce((s, r) => s + r.total, 0);
    if (!rows.length) return { html: '', subtotal: 0 };

    let html = '<div class="supplier-print-block" style="margin-bottom:12px;page-break-inside:auto;width:100%;max-width:100%;box-sizing:border-box;">';
    html += '<h2 style="font-size:14px;border-bottom:2px solid #22a329;padding-bottom:6px;">' + escHtml(nome) + '</h2>';
    html += '<p style="font-size:11px;color:#555;">CNPJ: ' + escHtml(cnpj) + ' · UF: ' + escHtml(uf) + '</p>';
    html += '<table style="width:100%;max-width:100%;border-collapse:collapse;margin-top:8px;font-size:10px;table-layout:fixed;"><colgroup><col class="cfop"><col class="desc"><col class="fin"><col class="qtd"><col class="val"></colgroup>';
    html += '<thead><tr style="background:#f0f0f0;"><th style="padding:4px 5px;text-align:left;">CFOP</th>';
    html += '<th style="padding:4px 5px;text-align:left;">Descrição</th><th style="padding:4px 5px;text-align:left;">Finalidade</th>';
    html += '<th style="padding:4px 5px;text-align:right;">Qtd NFs</th><th style="padding:4px 5px;text-align:right;">Valor (R$)</th></tr></thead><tbody>';
    html += renderSupplierTableRows(rows);
    html += '</tbody><tfoot><tr><td colspan="4" style="padding:6px 5px;text-align:right;font-weight:700;">Subtotal:</td>';
    html += '<td style="padding:6px 5px;text-align:right;font-weight:700;">R$ ' +
      subtotal.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</td></tr></tfoot></table></div>';
    return { html, subtotal };
  }

  function renderSupplierList() {
    const list = document.getElementById('supplierList');
    if (!list) return;
    const suppliers = collectUniqueSuppliers();
    list.innerHTML = suppliers.map((s) => {
      const search = (s.nome + ' ' + s.cnpj + ' ' + s.uf).toLowerCase();
      return '<label class="supplier-item" data-search="' + escHtml(search) + '">' +
        '<input type="checkbox" value="' + escHtml(s.cnpj) + '" data-key="' + escHtml(s.key) + '" data-nome="' + escHtml(s.nome) + '" data-uf="' + escHtml(s.uf) + '">' +
        '<span class="supplier-info"><strong>' + escHtml(s.nome) + '</strong>' +
        '<small>' + escHtml(s.cnpj) + ' · ' + escHtml(s.uf) + '</small></span></label>';
    }).join('');
  }

  window.openSupplierModal = function () {
    const list = document.getElementById('supplierList');
    if (!list) return;
    hydrateSupplierReportPeriodSelect();
    renderSupplierList();
    const search = document.getElementById('supplierSearch');
