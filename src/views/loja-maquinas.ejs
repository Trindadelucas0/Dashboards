    "efdJun": true
  };
  let selectedMonthIdx = 5;
  let periodMode = 'month'; // 'month' | 'total' | 'trim1' | 'trim2'

  function round2(v) { return Math.round(v * 100) / 100; }

  function mergeCfopEntradas(listOfLists) {
    const map = {};
    listOfLists.flat().forEach(c => {
      if (!map[c.cfop]) map[c.cfop] = { cfop: c.cfop, qtd: 0, total: 0, fornecedores: {} };
      map[c.cfop].qtd += c.qtd;
      map[c.cfop].total += c.total;
      (c.fornecedores || []).forEach(f => {
        const k = f.cnpj || f.nome;
        if (!map[c.cfop].fornecedores[k]) map[c.cfop].fornecedores[k] = { nome: f.nome, cnpj: f.cnpj, uf: f.uf, qtd: 0, total: 0 };
        map[c.cfop].fornecedores[k].qtd += f.qtd;
        map[c.cfop].fornecedores[k].total += f.total;
      });
    });
    return Object.values(map).map(c => ({
      cfop: c.cfop, qtd: c.qtd, total: round2(c.total),
      fornecedores: Object.values(c.fornecedores).map(f => ({ ...f, total: round2(f.total) })).sort((a, b) => b.total - a.total)
    })).sort((a, b) => b.total - a.total);
  }

  function mergeCfopSaidas(listOfLists) {
    const map = {};
    listOfLists.flat().forEach(c => {
      if (!map[c.cfop]) map[c.cfop] = { cfop: c.cfop, qtd: 0, total: 0 };
      map[c.cfop].qtd += c.qtd;
      map[c.cfop].total += c.total;
    });
    return Object.values(map).map(c => ({ ...c, total: round2(c.total) })).sort((a, b) => b.total - a.total);
  }

  function mergeTop(items, topN) {
    const map = {};
    items.flat().forEach(item => {
      const k = item.cnpj || item.nome;
      if (!map[k]) map[k] = { nome: item.nome, cnpj: item.cnpj, uf: item.uf, qtd: 0, total: 0, cfops: {} };
      map[k].qtd += item.qtd;
      map[k].total += item.total;
      if (item.cfops) Object.entries(item.cfops).forEach(([cf, v]) => { map[k].cfops[cf] = (map[k].cfops[cf] || 0) + v; });
    });
    return Object.values(map).map(x => ({ ...x, total: round2(x.total) })).sort((a, b) => b.total - a.total).slice(0, topN);
  }

  function mergeUF(listOfObjs) {
    const map = {};
    listOfObjs.forEach(obj => Object.entries(obj || {}).forEach(([uf, v]) => { map[uf] = (map[uf] || 0) + v; }));
    return map;
  }

  function aggregatePacks(packs, competenciaLabel, monthShort) {
    const sum = (key) => packs.reduce((a, p) => a + (p[key] || 0), 0);
    const receitaBruta = round2(sum('receitaBruta'));
    const totalCompras = round2(sum('totalCompras'));
    const deducoes = round2(sum('deducoes'));
    const pisRecolher = round2(sum('pisRecolher'));
    const cofinsRecolher = round2(sum('cofinsRecolher'));
    const icmsDebito = round2(sum('icmsDebito'));
    const icmsCredito = round2(sum('icmsCredito'));
    const icmsRecolher = round2(sum('icmsRecolher'));
    const cfopEntradas = mergeCfopEntradas(packs.map(p => p.cfopEntradas || []));
    const cfopSaidas = mergeCfopSaidas(packs.map(p => p.cfopSaidas || []));
    const cfopSaidasTotal = round2(cfopSaidas.reduce((a, c) => a + c.total, 0));
    return {
      competencia: 'consolidado',
      competenciaLabel,
      monthShort,
      receitaBruta,
      totalCompras,
      deducoes,
      dedPct: receitaBruta > 0 ? round2(deducoes / receitaBruta * 100) : 0,
      pisRecolher,
      cofinsRecolher,
      icmsDebito,
      icmsCredito,
      icmsRecolher,
      composicao: [
        { label: 'PIS', valor: pisRecolher },
        { label: 'COFINS', valor: cofinsRecolher },
        { label: 'ICMS', valor: icmsRecolher },
      ],
      cfopEntradas,
      cfopSaidas,
      cfopSaidasTotal,
      clientesTop: mergeTop(packs.map(p => p.clientesTop || []), 15),
      fornecedoresTop: mergeTop(packs.map(p => p.fornecedoresTop || []), 15),
      comprasUF: mergeUF(packs.map(p => p.comprasUF)),
      vendasUF: mergeUF(packs.map(p => p.vendasUF)),
      nfSaidas: packs.reduce((a, p) => a + (p.nfSaidas || 0), 0),
    };
  }

  function buildFiscalTotalPack() {
    const packs = MONTH_KEYS.map(k => FISCAL_POR_MES[k]);
    return aggregatePacks(packs, 'Jan – Jun / 2026', 'Total');
  }

  function buildFiscalTrimPack(trim) {
    const idx = trim === 1 ? [0, 1, 2] : [3, 4, 5];
    const packs = idx.map(i => FISCAL_POR_MES[MONTH_KEYS[i]]);
    return aggregatePacks(packs, trim === 1 ? '1º Trim / 2026' : '2º Trim / 2026', trim === 1 ? '1º Trim' : '2º Trim');
  }

  function getPack() {
    if (periodMode === 'total') return buildFiscalTotalPack();
    if (periodMode === 'trim1') return buildFiscalTrimPack(1);
    if (periodMode === 'trim2') return buildFiscalTrimPack(2);
    return FISCAL_POR_MES[MONTH_KEYS[selectedMonthIdx]] || FISCAL_POR_MES[MONTH_KEYS[MONTH_KEYS.length - 1]];
  }

  function getPeriodHeaderLabel() {
    const p = getPack();
    if (periodMode === 'total') return 'Consolidado · ' + p.competenciaLabel;
    if (periodMode === 'trim1' || periodMode === 'trim2') return 'Consolidado · ' + p.competenciaLabel;
    return p.competenciaLabel;
  }

  function getHeaderSelectValue() {
    if (periodMode === 'total') return 'total';
    if (periodMode === 'trim1') return 'trim1';
    if (periodMode === 'trim2') return 'trim2';
    return String(selectedMonthIdx);
  }

  function setPeriod(mode, idx) {
    periodMode = mode;
    if (mode === 'month' && idx !== undefined) selectedMonthIdx = idx;
    applyPeriodChange();
  }

  function onHeaderPeriodChange(val) {
    if (val === 'total') setPeriod('total');
    else if (val === 'trim1') setPeriod('trim1');
    else if (val === 'trim2') setPeriod('trim2');
    else setPeriod('month', parseInt(val, 10));
  }

  function updateMesBarActive() {
    let trimCtx = null;
    if (periodMode === 'trim1') trimCtx = 'q1';
    else if (periodMode === 'trim2') trimCtx = 'q2';
    else if (periodMode === 'month') {
      trimCtx = selectedMonthIdx <= 2 ? 'q1' : 'q2';
    }
    document.querySelectorAll('#mes-bar .mes-btn').forEach(btn => {
      btn.classList.remove('active', 'dim', 'in-trim');
      const m = btn.dataset.mode;
      const i = btn.dataset.idx;
      const btnTrim = btn.dataset.trim;
      if (periodMode === 'month' && i !== undefined && parseInt(i, 10) === selectedMonthIdx) btn.classList.add('active');
      else if (periodMode === m) btn.classList.add('active');
      if (btnTrim && trimCtx) {
        if (btnTrim === trimCtx) btn.classList.add('in-trim');
        else btn.classList.add('dim');
      }
    });
    const sel = document.getElementById('periodSel');
    if (sel) sel.value = getHeaderSelectValue();
  }

  function applyPeriodChange() {
    CFOP_DADOS = getCfopDados();
    CFOP_SAIDAS_DADOS = getCfopSaidasDados();
