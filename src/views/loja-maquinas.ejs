      Object.keys(chartInst).forEach(k => { if (chartInst[k]) { chartInst[k].destroy(); delete chartInst[k]; } });
    }
    const active = document.querySelector('.tab-section.active');
    if (active) showTab(active.id.replace('tab-', ''));
  }

