     ----------------------------------------------- */
  function initCompras() {
    const p = getPack();
    const top = (p.fornecedoresTop || []).slice(0, 8);
    const forn = {
      nomes: top.map(f => f.nome.length > 22 ? f.nome.slice(0, 22) + '…' : f.nome),
      vals: top.map(f => f.total),
    };
    safeChart('chartFornecedores', {
      type:'bar',
      data:{ labels:forn.nomes, datasets:[{ label:'Valor (R$ mil)', data:forn.vals.map(v=>+(v/1000).toFixed(1)), backgroundColor:PAL, borderRadius:5 }] },
      options:{ indexAxis:'y', responsive:true, maintainAspectRatio:false,
        plugins:{ legend:{display:false}, tooltip:{ ...tip(), callbacks:{ label:c=>'R$ '+c.parsed.x.toFixed(0)+'K' } } },
        scales:{ x:{ ticks:{ callback:v=>'R$'+v+'K' }, grid:{ color:'rgba(255,255,255,0.05)' } }, y:{ grid:{display:false} } }
      }
    });

    const ufData = p.comprasUF || {};
    const ufLabels = Object.keys(ufData).sort((a,b)=>ufData[b]-ufData[a]);
    const ufTotal = ufLabels.reduce((a,k)=>a+ufData[k],0) || 1;
    const ufPct = ufLabels.map(k => +((ufData[k]/ufTotal)*100).toFixed(2));
    safeChart('chartComprasUF', {
      type:'doughnut',
      data:{ labels:ufLabels, datasets:[{ data:ufPct, backgroundColor:PAL, borderWidth:0, hoverOffset:6 }] },
      options:{ responsive:true, maintainAspectRatio:false, cutout:'58%',
        plugins:{ legend:{ ...leg(), position:'right' }, tooltip:{ ...tip(), callbacks:{ label:c=>c.label+': '+c.parsed.toFixed(2)+'%' } } }
      }
    });
  }

