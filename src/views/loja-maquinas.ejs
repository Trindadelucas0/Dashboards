  /* -----------------------------------------------
     INIT: FINALIDADE DE COMPRAS (CFOP)
     ----------------------------------------------- */
  let activeDrilldownCfop = null;

  function closeDrilldown() {
    document.getElementById('drilldown-panel').style.display = 'none';
    activeDrilldownCfop = null;
  }

  function openDrilldown(cfop) {
    if (activeDrilldownCfop === cfop) { closeDrilldown(); return; }
    activeDrilldownCfop = cfop;
    const item = CFOP_DADOS.find(d => d.cfop === cfop);
    const info = CFOP_FINALIDADE[cfop] || {};
    if (!item) return;
    const totalCfop = item.total;
    document.getElementById('dd-title').textContent = 'CFOP ' + cfop + ' — ' + (info.descricao || '');
    document.getElementById('dd-sub').textContent =
      'Finalidade: ' + (info.finalidade || '—') +
      ' | Total: R$ ' + totalCfop.toLocaleString('pt-BR',{minimumFractionDigits:2}) +
      ' | ' + item.qtd + ' NFs';
    const tbody = document.getElementById('dd-tbody');
    tbody.innerHTML = '';
    item.fornecedores.forEach((f, i) => {
      const pct = totalCfop > 0 ? ((f.total/totalCfop)*100).toFixed(1) : '0.0';
      const tr = document.createElement('tr');
      tr.innerHTML =
        '<td>' + (i+1) + '</td>' +
        '<td><div class="fw7">' + f.nome + '</div></td>' +
        '<td><span class="td-mute">' + f.cnpj + '</span></td>' +
        '<td><span class="chip ' + (f.uf==='DF'?'cy':f.uf==='SP'?'bl':f.uf==='GO'?'or':f.uf==='PR'?'pu':f.uf==='MG'?'gr':'gy') + '">' + f.uf + '</span></td>' +
        '<td class="r">' + f.qtd + '</td>' +
        '<td class="r td-val">R$ ' + f.total.toLocaleString('pt-BR',{minimumFractionDigits:2}) + '</td>' +
        '<td class="r"><div class="pb-wrap"><div class="pb-bar"><div class="pb-fill" style="width:' + pct + '%;background:' + (FINALIDADE_CORES[info.finalidade]||'#22a329') + '"></div></div><div class="pb-pct">' + pct + '%</div></div></td>';
      tbody.appendChild(tr);
    });
    const panel = document.getElementById('drilldown-panel');
    panel.style.display = 'block';
    panel.scrollIntoView({ behavior:'smooth', block:'nearest' });
  }


  function updateFinalidadeKpis() {
    const totalGeral = CFOP_DADOS.reduce((a,b)=>a+b.total,0);
    const totalCompras = getPack().totalCompras || totalGeral;
    const grupos = { revenda: 0, ativo: 0, devol: 0, outros: 0 };
    CFOP_DADOS.forEach(d => {
      const fin = (CFOP_FINALIDADE[d.cfop] || {}).finalidade || 'Outros';
      if (fin === 'Revenda' || fin === 'Revenda c/ ST' || fin === 'Industrializacao') grupos.revenda += d.total;
      else if (fin === 'Ativo Imobilizado') grupos.ativo += d.total;
      else if (fin.includes('Devol') || fin === 'Devolução Venda' || fin === 'Retorno Conserto') grupos.devol += d.total;
      else grupos.outros += d.total;
    });
    const pct = (v) => totalCompras > 0 ? ((v/totalCompras)*100).toFixed(1) + '% do total' : '—';
    const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = fmtK(v); };
    set('fin-kpi-total', totalCompras);
    set('fin-kpi-revenda', grupos.revenda);
    set('fin-kpi-ativo', grupos.ativo);
    set('fin-kpi-devol', grupos.devol);
    set('fin-kpi-outros', grupos.outros);
    const ss = (id, t) => { const el = document.getElementById(id); if (el) el.textContent = t; };
    ss('fin-sub-total', CFOP_DADOS.length + ' CFOPs · valor total do período');
    ss('fin-sub-revenda', 'Compra p/ comercialização — ' + pct(grupos.revenda));
    ss('fin-sub-ativo', 'Bens para o ativo — ' + pct(grupos.ativo));
    ss('fin-sub-devol', 'Devoluções e retornos — ' + pct(grupos.devol));
    ss('fin-sub-outros', 'Transporte, ISSQN e demais — ' + pct(grupos.outros));
  }

  function initFinalidade() {
    updateFinalidadeKpis();
    const totalGeral = CFOP_DADOS.reduce((a,b)=>a+b.total,0);
    const totalCompras = getPack().totalCompras || totalGeral;
    const totalBase = totalCompras > 0 ? totalCompras : totalGeral;

    const finDistSub = document.getElementById('fn-chart-dist-sub');
    const finBarSub = document.getElementById('fn-chart-bar-sub');
    if (finDistSub) {
      finDistSub.textContent = '% do valor total de entradas — ' + getPeriodHeaderLabel() +
        ' (R$ ' + totalCompras.toLocaleString('pt-BR', { maximumFractionDigits: 0 }) + ' bruto)';
    }
    if (finBarSub) finBarSub.textContent = 'Comparativo dos grupos fiscais de compras — ' + getPeriodHeaderLabel();

    // Agregar por finalidade para gráficos
    const finalGrupos = {};
    CFOP_DADOS.forEach(d => {
      const fin = (CFOP_FINALIDADE[d.cfop] || {}).finalidade || 'Outros';
      if (!finalGrupos[fin]) finalGrupos[fin] = 0;
      finalGrupos[fin] += d.total;
    });
    const finLabels = Object.keys(finalGrupos).sort((a,b)=>finalGrupos[b]-finalGrupos[a]);
    const finVals   = finLabels.map(k=>finalGrupos[k]);
    const finCores  = finLabels.map(k=>FINALIDADE_CORES[k]||'#64748b');

    safeChart('chartFinalidadeDist', {
      type:'doughnut',
      data:{ labels:finLabels, datasets:[{ data:finVals, backgroundColor:finCores, borderWidth:0, hoverOffset:6 }] },
      options:{
        responsive:true, maintainAspectRatio:false, cutout:'58%',
        plugins:{
          legend:{ ...leg(), position:'right' },
          tooltip:{ ...tip(), callbacks:{ label:c=>{
            const pct = totalBase > 0 ? ((c.parsed/totalBase)*100).toFixed(1) : '0.0';
            return c.label+': R$ '+c.parsed.toLocaleString('pt-BR',{minimumFractionDigits:0})+' ('+pct+'%)';
          }}}
        }
      }
    });

    safeChart('chartFinalidadeBar', {
      type:'bar',
      data:{ labels:finLabels, datasets:[{ label:'Valor (R$ mil)', data:finVals.map(v=>+(v/1000).toFixed(1)), backgroundColor:finCores, borderRadius:5 }] },
      options:{
        indexAxis:'y', responsive:true, maintainAspectRatio:false,
        plugins:{ legend:{display:false}, tooltip:{ ...tip(), callbacks:{ label:c=>'R$ '+c.parsed.x.toFixed(0)+'K' } } },
        scales:{ x:{ ticks:{ callback:v=>'R$'+v+'K' }, grid:{ color:'rgba(255,255,255,0.05)' } }, y:{ grid:{display:false} } }
      }
    });

    // Montar tabela CFOP
    const tbody = document.getElementById('cfop-tbody');
    if (!tbody) return;
    tbody.innerHTML = '';
    CFOP_DADOS.forEach(d => {
      const info = CFOP_FINALIDADE[d.cfop] || {};
      const pct  = totalBase > 0 ? ((d.total/totalBase)*100).toFixed(1) : '0.0';
      const cor  = FINALIDADE_CORES[info.finalidade] || '#64748b';
      const credChip = info.creditoPisCofins
        ? '<span class="chip gr"><i class="fas fa-check"></i> Sim</span>'
        : '<span class="chip rd"><i class="fas fa-times"></i> Não</span>';
      const tr = document.createElement('tr');
      tr.style.cursor = 'pointer';
      tr.title = 'Clique para ver fornecedores';
      tr.innerHTML =
        '<td><span class="chip" style="background:rgba(255,255,255,0.07);color:var(--text);font-family:monospace;font-weight:700;">' + d.cfop + '</span></td>' +
        '<td style="font-size:12px;color:var(--text-sec)">' + (info.descricao || '—') + '</td>' +
        '<td><span class="chip" style="background:'+cor+'22;color:'+cor+'">' + (info.finalidade||'—') + '</span></td>' +
        '<td>' + credChip + '</td>' +
        '<td class="r">' + d.qtd + '</td>' +
        '<td class="r td-val">R$ ' + d.total.toLocaleString('pt-BR',{minimumFractionDigits:2}) + '</td>' +
        '<td class="r"><div class="pb-wrap"><div class="pb-bar"><div class="pb-fill" style="width:'+(totalBase > 0 ? ((d.total/totalBase)*100).toFixed(0) : '0')+'%;background:'+cor+'"></div></div><div class="pb-pct">'+pct+'%</div></div></td>' +
        '<td class="c"><button onclick="openDrilldown(\''+d.cfop+'\')" style="background:rgba(34,163,41,0.12);border:1px solid rgba(34,163,41,0.3);color:var(--accent);padding:4px 10px;border-radius:6px;cursor:pointer;font-size:11px;">Ver <i class="fas fa-chevron-down"></i></button></td>';
      tbody.appendChild(tr);
    });
    if (CFOP_DADOS.length) {
      const totalNfs = CFOP_DADOS.reduce((a, d) => a + (d.qtd || 0), 0);
      const trTot = document.createElement('tr');
      trTot.style.background = 'rgba(34,163,41,0.05)';
      trTot.innerHTML =
        '<td class="fw7" colspan="4">TOTAL DE CFOP</td>' +
        '<td class="r fw7">' + totalNfs + '</td>' +
        '<td class="r fw7 td-val">R$ ' + totalCompras.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</td>' +
        '<td class="r fw7">100%</td>' +
