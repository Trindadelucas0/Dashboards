        "resumoEntradas": 388293.61,
        "saidasSum": 645029.42,
        "resumoSaidas": 645029.42
      },
      "pendentesEfd": false
    }
  };
  const PENDENTES = {
    "dre": true,
    "balancete": true,
    "margens": true,
    "sped": true,
    "recebimentos": true,
    "irpj": true,
