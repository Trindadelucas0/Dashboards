  /* -----------------------------------------------
     INIT: FINALIDADE DE COMPRAS (CFOP)
     ----------------------------------------------- */
  let activeDrilldownCfop = null;

  function closeDrilldown() {
    document.getElementById('drilldown-panel').style.display = 'none';
    activeDrilldownCfop = null;
  }

  function openDrilldown(cfop) {
    if (activeDrilldownCfop === cfop) { closeDrilldown(); return; }
    activeDrilldownCfop = cfop;
    const item = CFOP_DADOS.find(d => d.cfop === cfop);
    const info = CFOP_FINALIDADE[cfop] || {};
    if (!item) return;
    const totalCfop = item.total;
    document.getElementById('dd-title').textContent = 'CFOP ' + cfop + ' — ' + (info.descricao || '');
    document.getElementById('dd-sub').textContent =
      'Finalidade: ' + (info.finalidade || '—') +
      ' | Total: R$ ' + totalCfop.toLocaleString('pt-BR',{minimumFractionDigits:2}) +
      ' | ' + item.qtd + ' NFs';
    const tbody = document.getElementById('dd-tbody');
    tbody.innerHTML = '';
    item.fornecedores.forEach((f, i) => {
      const pct = totalCfop > 0 ? ((f.total/totalCfop)*100).toFixed(1) : '0.0';
      const tr = document.createElement('tr');
      tr.innerHTML =
        '<td>' + (i+1) + '</td>' +
        '<td><div class="fw7">' + f.nome + '</div></td>' +
        '<td><span class="td-mute">' + f.cnpj + '</span></td>' +
        '<td><span class="chip ' + (f.uf==='DF'?'cy':f.uf==='SP'?'bl':f.uf==='GO'?'or':f.uf==='PR'?'pu':f.uf==='MG'?'gr':'gy') + '">' + f.uf + '</span></td>' +
        '<td class="r">' + f.qtd + '</td>' +
        '<td class="r td-val">R$ ' + f.total.toLocaleString('pt-BR',{minimumFractionDigits:2}) + '</td>' +
        '<td class="r"><div class="pb-wrap"><div class="pb-bar"><div class="pb-fill" style="width:' + pct + '%;background:' + (FINALIDADE_CORES[info.finalidade]||'#22a329') + '"></div></div><div class="pb-pct">' + pct + '%</div></div></td>';
      tbody.appendChild(tr);
    });
    const panel = document.getElementById('drilldown-panel');
    panel.style.display = 'block';
    panel.scrollIntoView({ behavior:'smooth', block:'nearest' });
  }

  function initFinalidade() {
    const totalGeral = CFOP_DADOS.reduce((a,b)=>a+b.total,0);

    // Agregar por finalidade para gráficos
    const finalGrupos = {};
    CFOP_DADOS.forEach(d => {
      const fin = (CFOP_FINALIDADE[d.cfop] || {}).finalidade || 'Outros';
      if (!finalGrupos[fin]) finalGrupos[fin] = 0;
      finalGrupos[fin] += d.total;
    });
    const finLabels = Object.keys(finalGrupos).sort((a,b)=>finalGrupos[b]-finalGrupos[a]);
    const finVals   = finLabels.map(k=>finalGrupos[k]);
    const finCores  = finLabels.map(k=>FINALIDADE_CORES[k]||'#64748b');

    safeChart('chartFinalidadeDist', {
      type:'doughnut',
      data:{ labels:finLabels, datasets:[{ data:finVals, backgroundColor:finCores, borderWidth:0, hoverOffset:6 }] },
      options:{
        responsive:true, maintainAspectRatio:false, cutout:'58%',
        plugins:{
          legend:{ ...leg(), position:'right' },
          tooltip:{ ...tip(), callbacks:{ label:c=>{
            const pct = ((c.parsed/totalGeral)*100).toFixed(1);
            return c.label+': R$ '+c.parsed.toLocaleString('pt-BR',{minimumFractionDigits:0})+' ('+pct+'%)';
          }}}
        }
      }
    });

    safeChart('chartFinalidadeBar', {
      type:'bar',
      data:{ labels:finLabels, datasets:[{ label:'Valor (R$ mil)', data:finVals.map(v=>+(v/1000).toFixed(1)), backgroundColor:finCores, borderRadius:5 }] },
      options:{
        indexAxis:'y', responsive:true, maintainAspectRatio:false,
        plugins:{ legend:{display:false}, tooltip:{ ...tip(), callbacks:{ label:c=>'R$ '+c.parsed.x.toFixed(0)+'K' } } },
        scales:{ x:{ ticks:{ callback:v=>'R$'+v+'K' }, grid:{ color:'rgba(255,255,255,0.05)' } }, y:{ grid:{display:false} } }
      }
    });

    // Montar tabela CFOP
    const tbody = document.getElementById('cfop-tbody');
    if (!tbody) return;
    tbody.innerHTML = '';
    CFOP_DADOS.forEach(d => {
      const info = CFOP_FINALIDADE[d.cfop] || {};
      const pct  = totalGeral > 0 ? ((d.total/totalGeral)*100).toFixed(1) : '0.0';
      const cor  = FINALIDADE_CORES[info.finalidade] || '#64748b';
      const credChip = info.creditoPisCofins
        ? '<span class="chip gr"><i class="fas fa-check"></i> Sim</span>'
        : '<span class="chip rd"><i class="fas fa-times"></i> Não</span>';
      const tr = document.createElement('tr');
      tr.style.cursor = 'pointer';
      tr.title = 'Clique para ver fornecedores';
      tr.innerHTML =
        '<td><span class="chip" style="background:rgba(255,255,255,0.07);color:var(--text);font-family:monospace;font-weight:700;">' + d.cfop + '</span></td>' +
        '<td style="font-size:12px;color:var(--text-sec)">' + (info.descricao || '—') + '</td>' +
        '<td><span class="chip" style="background:'+cor+'22;color:'+cor+'">' + (info.finalidade||'—') + '</span></td>' +
        '<td>' + credChip + '</td>' +
        '<td class="r">' + d.qtd + '</td>' +
        '<td class="r td-val">R$ ' + d.total.toLocaleString('pt-BR',{minimumFractionDigits:2}) + '</td>' +
        '<td class="r"><div class="pb-wrap"><div class="pb-bar"><div class="pb-fill" style="width:'+((d.total/1900158)*100).toFixed(0)+'%;background:'+cor+'"></div></div><div class="pb-pct">'+pct+'%</div></div></td>' +
        '<td class="c"><button onclick="openDrilldown(\''+d.cfop+'\')" style="background:rgba(34,163,41,0.12);border:1px solid rgba(34,163,41,0.3);color:var(--accent);padding:4px 10px;border-radius:6px;cursor:pointer;font-size:11px;">Ver <i class="fas fa-chevron-down"></i></button></td>';
      tbody.appendChild(tr);
    });
  }

  /* -----------------------------------------------
     EXPORTAÇÃO PDF / EXCEL / IMPRESSÃO FORNECEDOR
     ----------------------------------------------- */
  function getCompanyName() {
    return document.querySelector('.logo-text .company')?.textContent?.trim() || 'Dashboard';
  }
  function getExportDate() {
    return new Date().toLocaleDateString('pt-BR').replace(/\//g, '-');
  }

  async function exportPDF(sectionId, filename) {
    const section = document.getElementById(sectionId);
    if (!section) return;
    const btn = event?.currentTarget;
    const origHtml = btn?.innerHTML;
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Gerando...'; }

    const wasHidden = !section.classList.contains('active');
    if (wasHidden) section.classList.add('export-capture');
    document.body.classList.add('print-mode');

    try {
      await new Promise(r => setTimeout(r, 350));
      const canvas = await html2canvas(section, { scale: 2, useCORS: true, backgroundColor: '#ffffff', logging: false });
      const imgData = canvas.toDataURL('image/png');
      const { jsPDF } = window.jspdf;
      const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const pageW = pdf.internal.pageSize.getWidth();
      const pageH = pdf.internal.pageSize.getHeight();
      const margin = 10;
      const headerH = 12;
      const contentW = pageW - margin * 2;
      const pdfHeight = (canvas.height * contentW) / canvas.width;
      let heightLeft = pdfHeight;
      let position = margin + headerH;

      const addHeader = () => {
        pdf.setFontSize(10);
        pdf.setTextColor(26, 26, 46);
        pdf.text(getCompanyName() + ' — ' + new Date().toLocaleDateString('pt-BR'), margin, margin + 4);
        pdf.setDrawColor(200);
        pdf.line(margin, margin + 7, pageW - margin, margin + 7);
      };

      addHeader();
      pdf.addImage(imgData, 'PNG', margin, position, contentW, pdfHeight);
      heightLeft -= (pageH - margin - headerH);

      while (heightLeft > 0) {
        position = margin + headerH - (pdfHeight - heightLeft);
        pdf.addPage();
        addHeader();
        pdf.addImage(imgData, 'PNG', margin, position, contentW, pdfHeight);
        heightLeft -= (pageH - margin - headerH);
      }

      pdf.save(filename + '_' + getExportDate() + '.pdf');
    } catch (err) {
      console.error(err);
      alert('Erro ao gerar PDF. Tente novamente.');
    } finally {
      document.body.classList.remove('print-mode');
      if (wasHidden) section.classList.remove('export-capture');
      if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
    }
  }

  function exportExcel(sectionId, filename) {
    const section = document.getElementById(sectionId);
    if (!section) return;
    const tables = section.querySelectorAll('table');
    const wb = XLSX.utils.book_new();

    if (tables.length > 0) {
      tables.forEach((tbl, i) => {
        const ws = XLSX.utils.table_to_sheet(tbl);
        const range = XLSX.utils.decode_range(ws['!ref'] || 'A1');
        const colWidths = [];
        for (let C = range.s.c; C <= range.e.c; C++) {
          let max = 10;
          for (let R = range.s.r; R <= range.e.r; R++) {
            const cell = ws[XLSX.utils.encode_cell({ r: R, c: C })];
            if (cell && cell.v != null) max = Math.max(max, String(cell.v).length + 2);
          }
          colWidths.push({ wch: Math.min(max, 50) });
        }
        ws['!cols'] = colWidths;
        XLSX.utils.book_append_sheet(wb, ws, 'Tabela_' + (i + 1));
      });
    } else {
      const cards = section.querySelectorAll('.ind-card');
      const rows = [['Indicador', 'Valor', 'Fórmula', 'Interpretação']];
      cards.forEach(card => {
        rows.push([
          card.querySelector('.ind-name')?.textContent?.trim() || '',
          card.querySelector('.ind-val')?.textContent?.trim() || '',
          card.querySelector('.ind-formula')?.textContent?.trim() || '',
          card.querySelector('.ind-interp')?.textContent?.trim() || ''
        ]);
      });
      const ws = XLSX.utils.aoa_to_sheet(rows);
      ws['!cols'] = [{ wch: 30 }, { wch: 15 }, { wch: 40 }, { wch: 60 }];
      XLSX.utils.book_append_sheet(wb, ws, 'Indicadores');
    }

    if (!wb.SheetNames.length) {
      alert('Nenhum dado encontrado para exportar.');
      return;
    }
    XLSX.writeFile(wb, filename + '_' + getExportDate() + '.xlsx');
  }

  function collectUniqueSuppliers() {
    const map = new Map();
    (CFOP_DADOS || []).forEach(cfop => {
      (cfop.fornecedores || []).forEach(f => {
        const key = f.cnpj || f.nome;
        if (!map.has(key)) map.set(key, { nome: f.nome, cnpj: f.cnpj, uf: f.uf });
      });
    });
    return Array.from(map.values()).sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));
  }

  function openSupplierModal() {
    const list = document.getElementById('supplierList');
    const suppliers = collectUniqueSuppliers();
    list.innerHTML = suppliers.map(s => {
      const search = (s.nome + ' ' + s.cnpj).toLowerCase();
      const esc = v => v.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
      return '<label class="supplier-item" data-search="' + esc(search) + '">' +
        '<input type="checkbox" value="' + esc(s.cnpj) + '" data-nome="' + esc(s.nome) + '">' +
        '<span class="supplier-info"><strong>' + esc(s.nome) + '</strong>' +
        '<small>' + esc(s.cnpj) + ' · ' + esc(s.uf) + '</small></span></label>';
    }).join('');
    document.getElementById('supplierSearch').value = '';
    document.getElementById('supplierModal').style.display = 'flex';
  }

  function closeSupplierModal() {
    document.getElementById('supplierModal').style.display = 'none';
    const search = document.getElementById('supplierSearch');
    if (search) search.value = '';
  }

  function filterSuppliers(query) {
    const q = query.toLowerCase();
    document.querySelectorAll('#supplierList .supplier-item').forEach(el => {
      el.style.display = el.dataset.search.includes(q) ? '' : 'none';
    });
  }

  function toggleAllSuppliers(state) {
    document.querySelectorAll('#supplierList .supplier-item').forEach(el => {
      if (el.style.display === 'none') return;
      const cb = el.querySelector('input');
      if (cb) cb.checked = state;
    });
  }

  function printBySupplier() {
    const selected = Array.from(document.querySelectorAll('#supplierList input:checked'));
    if (!selected.length) { alert('Selecione ao menos um fornecedor.'); return; }

    closeSupplierModal();
    let totalGeral = 0;
    let html = '<div style="font-family:Inter,sans-serif;padding:24px;color:#1a1a2e;background:#fff;">';
    html += '<h1 style="font-size:18px;margin-bottom:4px;">Relatório por Fornecedor</h1>';
    html += '<p style="font-size:12px;color:#555;margin-bottom:24px;">' + getCompanyName() + ' — ' + new Date().toLocaleDateString('pt-BR') + '</p>';

    selected.forEach(cb => {
      const cnpj = cb.value;
      const nome = cb.dataset.nome;
      const rows = [];
      let subtotal = 0;
      let uf = '—';

      (CFOP_DADOS || []).forEach(cfop => {
        const f = (cfop.fornecedores || []).find(x => x.cnpj === cnpj);
        if (f) {
          const info = (CFOP_FINALIDADE[cfop.cfop] || {});
          rows.push({ cfop: cfop.cfop, desc: info.descricao || '—', fin: info.finalidade || '—', qtd: f.qtd, total: f.total });
          subtotal += f.total;
          uf = f.uf;
        }
      });

      totalGeral += subtotal;
      html += '<div style="margin-bottom:28px;page-break-inside:avoid;">';
      html += '<h2 style="font-size:14px;border-bottom:2px solid #22a329;padding-bottom:6px;">' + nome + '</h2>';
      html += '<p style="font-size:11px;color:#555;">CNPJ: ' + cnpj + ' · UF: ' + uf + '</p>';
      html += '<table style="width:100%;border-collapse:collapse;margin-top:10px;font-size:12px;">';
      html += '<thead><tr style="background:#f0f0f0;"><th style="padding:8px;text-align:left;">CFOP</th>';
      html += '<th style="padding:8px;text-align:left;">Descrição</th><th style="padding:8px;text-align:left;">Finalidade</th>';
      html += '<th style="padding:8px;text-align:right;">Qtd NFs</th><th style="padding:8px;text-align:right;">Valor (R$)</th></tr></thead><tbody>';
      rows.forEach(r => {
        html += '<tr><td style="padding:8px;border-bottom:1px solid #ddd;">' + r.cfop + '</td>';
        html += '<td style="padding:8px;border-bottom:1px solid #ddd;">' + r.desc + '</td>';
        html += '<td style="padding:8px;border-bottom:1px solid #ddd;">' + r.fin + '</td>';
        html += '<td style="padding:8px;border-bottom:1px solid #ddd;text-align:right;">' + r.qtd + '</td>';
        html += '<td style="padding:8px;border-bottom:1px solid #ddd;text-align:right;font-weight:600;">' +
          r.total.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</td></tr>';
      });
      html += '</tbody><tfoot><tr><td colspan="4" style="padding:10px;text-align:right;font-weight:700;">Subtotal:</td>';
      html += '<td style="padding:10px;text-align:right;font-weight:700;">R$ ' +
        subtotal.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</td></tr></tfoot></table></div>';
    });

    html += '<div style="border-top:2px solid #1a1a2e;padding-top:12px;margin-top:16px;text-align:right;font-size:14px;font-weight:700;">';
    html += 'Total Geral: R$ ' + totalGeral.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</div></div>';

    const old = document.getElementById('print-supplier-report');
    if (old) old.remove();
    const div = document.createElement('div');
    div.id = 'print-supplier-report';
    div.innerHTML = html;
    document.body.appendChild(div);
    document.body.classList.add('supplier-printing');

    const cleanup = () => {
      document.body.classList.remove('supplier-printing');
      div.remove();
      window.removeEventListener('afterprint', cleanup);
    };
    window.addEventListener('afterprint', cleanup);
    window.print();
  }

  /* -----------------------------------------------
     INICIALIZAÇÃO
     ----------------------------------------------- */
  document.addEventListener('DOMContentLoaded', () => { showTab('visao-geral'); });
</script>
