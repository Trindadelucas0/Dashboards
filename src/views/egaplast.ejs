  function initImpostos() {
    const pack = getPack();
    renderMesBar('tax-mes-bar', () => { tabsInit.impostos = false; initImpostos(); });
    const v = validateApuracaoPack(pack);
    setFiscalDataStatus('tax-data-status', v, 'Apuração conferida', 'Divergência apuração: recolher ' + fmt(v.sumRec) + ' vs deduções ' + fmt(v.deducoes));

