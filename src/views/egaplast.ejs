  function initIndicadores() {
    const fp = getUnitFiscal();
    const indSub = document.getElementById('ind-sec-sub');
    const indTitleSmall = document.getElementById('ind-sec-title-small');
    const indMargensNote = document.getElementById('ind-margens-note');
    const trimLabel = TRIMESTRES.q1 && TRIMESTRES.q2
      ? TRIMESTRES.q1.label + ' + ' + TRIMESTRES.q2.label
      : PERIODO_TOTAL.label;
    if (indSub) indSub.textContent = UNIT_LABELS[state.unit] + ' — carga tributária — ' + trimLabel;
    if (indTitleSmall) indTitleSmall.textContent = trimLabel;
    if (indMargensNote) indMargensNote.textContent = 'Margens de Rentabilidade — ' + trimLabel + ' (requer DRE)';
    const indChartMargens = document.getElementById('ind-chart-margens-sub');
    if (indChartMargens) indChartMargens.textContent = trimLabel + ' — margens requerem DRE';

    const cargaS = fp.meses.map((m) => {
      const p = fp.porMes[m];
      return p.receitaBruta > 0 ? Math.round(p.deducoes / p.receitaBruta * 10000) / 100 : 0;
    });
    const firstCarga = cargaS[0] || 0;
    const lastCarga = cargaS[cargaS.length - 1] || 0;
    const cargaDelta = deltaPct(lastCarga, firstCarga);
    const cargaDeltaStr = cargaDelta !== null ? (parseFloat(cargaDelta) >= 0 ? '+' : '') + cargaDelta + ' p.p. Jan→Mai' : '—';

    const vendasTri = fp.meses.reduce((a, m) => a + fp.porMes[m].cfopSaidasTotal, 0);
    const dedTri = fp.meses.reduce((a, m) => a + fp.porMes[m].deducoes, 0);
    const cargaTri = vendasTri > 0 ? Math.round(dedTri / vendasTri * 10000) / 100 : 0;

    const margensGrid = document.getElementById('ind-margens-grid');
    if (margensGrid) {
      margensGrid.innerHTML =
        '<div class="ind-card"><div class="ind-head"><div class="ind-name">Carga Tributária Acum.</div></div><div class="ind-val t-warning">' + cargaTri + '%</div><div class="ind-formula">(PIS+COFINS+ICMS) / Vendas ' + PERIODO_TOTAL.label + '</div><div class="ind-interp">Calculado a partir das planilhas EGAPLAST extraídas.</div></div>' +
        '<div class="ind-card" style="opacity:.7"><div class="ind-head"><div class="ind-name">Margem Bruta</div></div><div class="ind-val t-muted">N/D</div><div class="ind-formula">Requer DRE / margens</div></div>' +
        '<div class="ind-card" style="opacity:.7"><div class="ind-head"><div class="ind-name">Margem Líquida</div></div><div class="ind-val t-muted">N/D</div><div class="ind-formula">Requer DRE / margens</div></div>' +
        '<div class="ind-card"><div class="ind-head"><div class="ind-name">Vendas Acum.</div></div><div class="ind-val t-success">' + fmtBRL(vendasTri, true) + '</div><div class="ind-formula">' + PERIODO_TOTAL.label + ' — saídas contábeis</div></div>' +
        '<div class="ind-card"><div class="ind-head"><div class="ind-name">Variação Carga Jan→Mai</div></div><div class="ind-val t-warning">' + cargaDeltaStr + '</div><div class="ind-formula">' + firstCarga + '% → ' + lastCarga + '% sobre RB</div></div>';
    }

    const cargaGrid = document.getElementById('ind-carga-grid');
    if (cargaGrid) {
      const mm = state.fiscalMode === 'total' ? '05' : state.month;
      const p = fp.porMes[mm];
      const cargaMes = p.receitaBruta > 0 ? Math.round(p.deducoes / p.receitaBruta * 10000) / 100 : 0;
      cargaGrid.innerHTML =
        '<div class="ind-card"><div class="ind-head"><div class="ind-name">Carga ' + MONTH_LABELS[mm] + '/2026</div></div><div class="ind-val t-warning">' + cargaMes + '%</div><div class="ind-formula">Ded ' + fmtBRL(p.deducoes) + ' / RB ' + fmtBRL(p.receitaBruta) + '</div></div>' +
        '<div class="ind-card"><div class="ind-head"><div class="ind-name">Liquidez Corrente</div></div><div class="ind-val t-muted">N/D</div><div class="ind-formula">Requer balancete</div></div>';
    }

    safeChart('chartIndicadores', {
      type: 'bar',
      data: { labels: fp.monthShort, datasets: [{ label: 'Carga %', data: cargaS, backgroundColor: PAL[4], borderRadius: 4 }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { ticks: { callback: (v) => v + '%' } } } },
    });
  }

  function renderCustomMesBar(containerId, meses, labels, activeKey, onSelect) {
    const el = document.getElementById(containerId);
    if (!el || !meses || !meses.length) return;
    let html = '';
    meses.forEach((m, i) => {
      const lbl = labels[i] || m;
      html += '<button type="button" data-m="' + m + '"' + (m === activeKey ? ' class="active"' : '') + '>' + lbl + '</button>';
    });
    el.innerHTML = html;
    el.querySelectorAll('button').forEach((b) => {
      b.onclick = () => { onSelect(b.dataset.m); };
    });
  }

  function initRecebimentos() {
    const pack = getPack();
    renderMesBar('rec-mes-bar', () => { tabsInit.recebimentos = false; initRecebimentos(); });

    const recPeriod = document.getElementById('rec-sec-period');
    if (recPeriod) recPeriod.textContent = periodFull();
    const recSub = document.getElementById('rec-sec-sub');
    if (recSub) recSub.textContent = UNIT_LABELS[state.unit] + ' — estimativa ICMS' + periodContext();

    const receb = pack.cfopSaidasTotal || 0;
    const pag = pack.totalCompras || 0;
    const saldo = receb - pag;

    const grid = document.getElementById('rec-kpi-grid');
    if (grid) {
      grid.innerHTML =
        kpiCard('green', 'arrow-down', periodLbl(), fmtBRL(receb, true), 'Recebimentos estimados', 'Faturamento (saídas ICMS)') +
        kpiCard('red', 'arrow-up', periodLbl(), fmtBRL(pag, true), 'Pagamentos estimados', 'Compras (entradas ICMS)') +
        kpiCard(saldo >= 0 ? 'blue' : 'orange', 'scale-balanced', periodLbl(), fmtBRL(saldo, true), 'Saldo estimado', 'Recebimentos − pagamentos');
    }

    const fp = getUnitFiscal();
    const labels = fp.monthShort || fp.meses.map((m) => MONTH_LABELS[m]);
    const recData = fp.meses.map((m) => (fp.porMes[m].cfopSaidasTotal || 0) / 1000);
    const pagData = fp.meses.map((m) => (fp.porMes[m].totalCompras || 0) / 1000);

    const chartSub = document.getElementById('rec-chart-sub');
    if (chartSub) chartSub.textContent = 'Comparativo mensal — ' + UNIT_LABELS[state.unit] + ' · Jan–Mai/2026';

    safeChart('chartRecebPag', {
      type: 'bar',
      data: {
        labels,
        datasets: [
          { label: 'Recebimentos (mil)', data: recData, backgroundColor: PAL[1], borderRadius: 4 },
          { label: 'Pagamentos (mil)', data: pagData, backgroundColor: PAL[4], borderRadius: 4 },
        ],
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: leg() } },
    });
  }

  let balMesKey = null;

  function setBalKpi(cardId, val, isMoney) {
    const card = document.getElementById(cardId);
    if (!card) return;
    const vEl = card.querySelector('.kpi-val');
    if (!vEl) return;
    if (val == null || val === '') {
      vEl.textContent = '—';
      return;
    }
    vEl.textContent = isMoney !== false ? fmtBRL(val) : String(val);
  }

  function updateBalKpisEmpty() {
    ['bal-kpi-ativo', 'bal-kpi-passivo', 'bal-kpi-resultado'].forEach((id) => setBalKpi(id, null));
    setBalKpi('bal-kpi-contas', null, false);
  }

  function updateBalKpis(contas) {
    const norm = (cod) => String(cod).replace(/\.0$/, '');
    const find = (cod) => contas.find((c) => norm(c.codigo) === cod);
    const ativo = find('1');
    const passivo = find('2');
    const resultado = find('3');
    const analiticas = contas.filter((c) => (c.nivel || 0) >= 4).length;
    setBalKpi('bal-kpi-ativo', ativo ? ativo.saldoAtual : null);
    setBalKpi('bal-kpi-passivo', passivo ? passivo.saldoAtual : null);
    setBalKpi('bal-kpi-resultado', resultado ? resultado.saldoAtual : null);
    setBalKpi('bal-kpi-contas', analiticas, false);
  }

  function renderBalanceteMes(mesKey) {
    const bal = D.balancete;
    const pack = bal && bal.porMes ? bal.porMes[mesKey] : null;
    if (!pack) return;
    balMesKey = mesKey;

    const periodEl = document.getElementById('bal-header-period');
    const idx = bal.meses.indexOf(mesKey);
    if (periodEl && idx >= 0) periodEl.textContent = bal.mesLabels[idx];
    const fonteSub = document.getElementById('bal-fonte-sub');
    if (fonteSub) fonteSub.textContent = pack.arquivo || '—';

    const contas = pack.contas || [];
    updateBalKpis(contas);

    const search = (document.getElementById('bal-search')?.value || '').toLowerCase();
    const grupo = document.getElementById('bal-grupo-filter')?.value || '';

    const filtered = contas.filter((c) => {
      const cod = String(c.codigo || '').trim();
      if (!cod || !/^\d/.test(cod)) return false;
      if (grupo && c.grupo !== grupo) return false;
      if (search) {
        const hay = (cod + ' ' + (c.descricao || '')).toLowerCase();
        if (hay.indexOf(search) < 0) return false;
      }
      return true;
    });

    const tbody = document.getElementById('bal-tbody');
    if (tbody) {
      tbody.innerHTML = filtered.map((c) => {
        const nivel = c.nivel || 1;
        const pad = nivel > 1 ? 'padding-left:' + ((nivel - 1) * 12) + 'px' : '';
        return '<tr><td><span style="font-family:monospace;font-weight:600">' + escHtml(String(c.codigo)) + '</span></td>' +
          '<td style="' + pad + '">' + escHtml(c.descricao || '') + '</td>' +
          '<td class="r">' + fmtBRL(c.saldoAnterior) + '</td>' +
          '<td class="r">' + fmtBRL(c.debito) + '</td>' +
          '<td class="r">' + fmtBRL(c.credito) + '</td>' +
          '<td class="r td-val">' + fmtBRL(c.saldoAtual) + '</td></tr>';
      }).join('') || '<tr><td colspan="6" class="td-mute" style="text-align:center;padding:32px;">Nenhuma conta encontrada</td></tr>';
    }
    const countEl = document.getElementById('bal-row-count');
    if (countEl) countEl.textContent = filtered.length + ' contas exibidas';
  }

  function initBalancete() {
    const bal = D.balancete;
    const alertEl = document.getElementById('bal-alert');
    const hasData = bal && bal.meses && bal.meses.length > 0;

    if (!hasData) {
      if (alertEl) {
        alertEl.innerHTML = '<i class="fas fa-clock" style="margin-right:8px;"></i> Balancete pendente — coloque planilhas em <strong>CONTABIL/BALANCETE/{mm-yyyy}/*BALANCETE.xls</strong> nas pastas GRUPO EGAPLAST.';
      }
      const tbody = document.getElementById('bal-tbody');
      if (tbody) tbody.innerHTML = '<tr><td colspan="6" class="td-mute" style="text-align:center;padding:32px;">Aguardando planilhas de balancete contábil.</td></tr>';
      const bar = document.getElementById('bal-mes-bar');
      if (bar) bar.innerHTML = '';
      updateBalKpisEmpty();
      return;
    }

    if (alertEl) {
      alertEl.innerHTML = '<i class="fas fa-info-circle" style="margin-right:8px;"></i> Dados contábeis disponíveis para <strong>' + bal.meses.length + '</strong> competência(s).';
    }

    const defaultKey = bal.meses[bal.meses.length - 1];
    renderCustomMesBar('bal-mes-bar', bal.meses, bal.mesLabels, balMesKey || defaultKey, (m) => {
      renderBalanceteMes(m);
    });
    renderBalanceteMes(balMesKey || defaultKey);

    const search = document.getElementById('bal-search');
    if (search) search.oninput = () => renderBalanceteMes(balMesKey);
    const grupo = document.getElementById('bal-grupo-filter');
    if (grupo) grupo.onchange = () => renderBalanceteMes(balMesKey);
  }

