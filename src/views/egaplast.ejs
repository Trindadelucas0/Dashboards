      const efdAviso = efdJunPendente
        ? '<br><span style="color:#f59e0b;"><i class="fas fa-exclamation-triangle" style="margin-right:6px;"></i><strong>Jun/2026:</strong> PIS/COFINS e Apuração 5005 pendentes — ICMS estimado pelas NFs de movimento.</span>'
        : '';
      impAlert.innerHTML = '<i class="fas fa-info-circle" style="margin-right:8px;"></i><strong>Apuração ICMS (5005) + EFD PIS/COFINS</strong> — ' +
        periodFull() + ': ICMS a recolher <strong>' + fmtBRL(icms) + '</strong>, PIS <strong>' + fmtBRL(pack.apuracao.pis.aRecolher) +
        '</strong>, COFINS <strong>' + fmtBRL(pack.apuracao.cofins.aRecolher) + '</strong>. Fonte: planilhas EGAPLAST.' + efdAviso;
