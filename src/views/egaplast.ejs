        safeChart(id, {
          type: 'bar',
          data: { labels: ['Sem planilha de margens'], datasets: [{ data: [0], backgroundColor: '#64748b' }] },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, plugins: { title: { display: true, text: 'Margens — módulo pendente' } } },
