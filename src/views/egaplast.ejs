    'visao-geral': 'Visão Geral', compras: 'Compras', finalidade: 'Finalidade de Compras', vendas: 'Vendas',
    impostos: 'Impostos', memoria: 'Memória de Cálculo', recebimentos: 'Recebimentos/Pagamentos',
