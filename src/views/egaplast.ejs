          </div>
        </div>

        <div class="charts-row cr-2col">
          <div class="chart-card">
            <div class="chart-ttl">Top 5 CFOPs de Saída</div>
            <div class="chart-sub" id="vg-chart-cfop-sub">Maiores CFOPs do período selecionado</div>
            <div class="chart-wrap h260"><canvas id="chartVgTopCfop"></canvas></div>
          </div>
          <div class="chart-card">
            <div class="chart-ttl">Composição dos Tributos</div>
            <div class="chart-sub" id="vg-chart-comp-sub2">Participação na dedução do período</div>
            <div class="chart-wrap h260"><canvas id="chartComposicao"></canvas></div>
          </div>
        </div>

