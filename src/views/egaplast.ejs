      </div>
      <div class="nav-item" id="nav-finalidade" onclick="showTab('finalidade')">
        <div class="nav-ico"><i class="fas fa-tags"></i></div><span class="nav-label">Finalidade de Compras</span>
      </div>
      <div class="nav-item" id="nav-vendas" onclick="showTab('vendas')">
        <div class="nav-ico"><i class="fas fa-store"></i></div><span class="nav-label">Vendas</span>
      </div>
      <div class="sec-label">Tributário</div>
      <div class="nav-item" id="nav-impostos" onclick="showTab('impostos')">
        <div class="nav-ico"><i class="fas fa-file-invoice-dollar"></i></div><span class="nav-label">Impostos</span>
      </div>
      <div class="nav-item" id="nav-memoria" onclick="showTab('memoria')">
        <div class="nav-ico"><i class="fas fa-calculator"></i></div><span class="nav-label">Memória de Cálculo</span>
      </div>
      <div class="sec-label">Financeiro</div>
      <div class="nav-item" id="nav-recebimentos" onclick="showTab('recebimentos')">
        <div class="nav-ico"><i class="fas fa-money-bill-transfer"></i></div><span class="nav-label">Recebimentos/Pagamentos</span>
      </div>
      <div class="nav-item" id="nav-balancete" onclick="showTab('balancete')">
        <div class="nav-ico"><i class="fas fa-scale-balanced"></i></div><span class="nav-label">Balancete</span>
      </div>

      <div class="nav-item" id="nav-dre" onclick="showTab('dre')">
        <div class="nav-ico"><i class="fas fa-chart-line"></i></div><span class="nav-label">DRE</span>
      </div>
      <div class="nav-item" id="nav-indicadores" onclick="showTab('indicadores')">
        <div class="nav-ico"><i class="fas fa-circle-nodes"></i></div><span class="nav-label">Indicadores</span>
      </div>
    </nav>
    <div class="sidebar-foot">
      <div class="sidebar-foot-info">
        <div class="lbl">Competência</div>
        <div class="val" id="sidebarPeriod">1º Trim + 2º Trim / 2026</div>
      </div>
    </div>
  </aside>

  <!-- ===== MAIN ===== -->
  <div class="main-wrapper" id="mainWrapper">
    <header class="top-header">
      <button class="btn-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
      <div class="header-title" id="headerTitle">Visão Geral <span id="headerSub"></span></div>
      <div class="header-actions"><a href="/auth/dashboard-selector" class="btn-export btn-back-hub"><i class="fas fa-arrow-left"></i> Voltar</a>
        <select class="period-sel" id="unitSel" onchange="onFilterChange()">
          <option value="matriz">Matriz (37)</option>
          <option value="filial">Filial (61)</option>
          <option value="consolidado">Consolidado</option>
        </select>
        <select class="period-sel" id="monthSel" onchange="onFilterChange()">
          <option value="03">Março / 2026</option>
          <option value="02">Fevereiro / 2026</option>
          <option value="01">Janeiro / 2026</option>
          <option value="tri">1º Trimestre 2026</option>
        </select>
        <button class="btn-export pdf" onclick="exportRelatorioGerencial()" title="Relatório Gerencial"><i class="fas fa-file-pdf"></i> Relatório</button>
        <div class="regime-badge"><i class="fas fa-circle" style="font-size:7px;margin-right:5px;"></i>Lucro Real</div>
      </div>
    </header>

    <main class="content">

      <!-- ===============================================
           ABA 1 – VISÃO GERAL
           =============================================== -->
      <section id="tab-visao-geral" class="tab-section active">
        <div class="sec-header">
          <div>
            <div class="sec-title">Visão Geral <small>Competência Mar/2026</small></div>
            <div class="sec-sub"><span id="vg-sec-sub"></span></div>
          </div>
          <div class="export-bar">
            <button class="btn-export pdf" onclick="exportPDF('tab-visao-geral','Visao_Geral')" title="Exportar PDF"><i class="fas fa-file-pdf"></i> PDF</button>
            <button class="btn-export xlsx" onclick="exportExcel('tab-visao-geral','Visao_Geral')" title="Exportar Excel"><i class="fas fa-file-excel"></i> Excel</button>
          </div>
        </div>

        <div class="mes-bar" id="vg-mes-bar"></div>
        
        
        <div id="tax-notice" class="alert-box" style="display:none;margin-bottom:16px"></div>
        <div class="kpi-grid kpi-grid-8" id="vg-kpi-grid"></div>

        <div class="charts-row cr-2col">
          <div class="chart-card">
            <div class="chart-ttl">Vendas × Compras × Saldo</div>
            <div class="chart-sub" id="vg-chart-comp-sub">Fluxo operacional mensal (R$ mil)</div>
            <div class="chart-wrap h260"><canvas id="chartCompBar"></canvas></div>
          </div>
          <div class="chart-card">
            <div class="chart-ttl">Tributos sobre Receita Bruta (%)</div>
