            <div class="chart-wrap h260"><canvas id="chartDedPct"></canvas></div>
          </div>
        </div>

        <div class="charts-row cr-2col">
          <div class="chart-card">
            <div class="chart-ttl">Fluxo Vendas vs Compras</div>
