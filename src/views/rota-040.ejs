    if (impKpi) {
      impKpi.innerHTML =
        kpiCard('yellow', 'hand-holding-dollar', '', fmtBRL(totalRec, true), 'Total a recolher', fed ? 'PIS+COFINS+ICMS + IRPJ/CSLL' : 'PIS+COFINS+ICMS positivos') +
        (icmsVal < 0
          ? kpiCard('green', 'rotate-left', '', fmtBRL(Math.abs(icmsVal), true), 'Crédito ICMS', 'Saldo credor no período')
          : kpiCard('purple', 'landmark', '', fmtBRL(icmsVal, true), 'ICMS a recolher', '')) +
        (fed
          ? kpiCard('cyan', 'file-invoice-dollar', '', fmtBRL(fedRec, true), 'IRPJ + CSLL', irpjCsllTrimLabel(fed) + ' (trimestral)')
          : kpiCard('orange', 'percent', '', pack.dedPct + '%', 'Carga % sobre RB', fmtBRL(pack.deducoes) + ' em tributos'));
    }

    const cards = document.getElementById('imp-tax-grid');
    if (cards) {
      let html = ['icms', 'icmsSt', 'pis', 'cofins', 'ipi'].map((k, i) => {
        const labels = ['ICMS', 'ICMS ST', 'PIS', 'COFINS', 'IPI'];
        const t = pack.apuracao[k];
        return '<div class="tax-card"><div class="tax-card-head"><div class="tax-name">' + labels[i] + '</div></div><div class="tax-cur">' + fmtBRL(t.aRecolher) +
          '</div><div class="tax-prev">Apurado: ' + fmtBRL(t.debitoSaidas) + '</div></div>';
      }).join('');
      if (fed) {
        html +=
          '<div class="tax-card"><div class="tax-card-head"><div class="tax-name" style="color:var(--cyan)">IRPJ</div><span class="chip cy">Trimestral</span></div>' +
          '<div class="tax-cur">' + fmtBRL(fed.irpj.aRecolher) + '</div>' +
          '<div class="tax-prev">' + irpjCsllTrimLabel(fed) + ' · Adicional ' + fmtBRL(fed.irpj.adicional?.valor || 0) + '</div></div>' +
          '<div class="tax-card"><div class="tax-card-head"><div class="tax-name" style="color:var(--orange)">CSLL</div><span class="chip or">Trimestral</span></div>' +
          '<div class="tax-cur">' + fmtBRL(fed.csll.aRecolher) + '</div>' +
          '<div class="tax-prev">' + irpjCsllTrimLabel(fed) + ' · BC ' + fmtBRL(fed.csll.baseCalculo) + '</div></div>';
      }
      cards.innerHTML = html;
    }

    const fp = getUnitFiscal();
    safeChart('chartImpostosEv', {
      type: 'line',
      data: {
        labels: fp.monthShort,
        datasets: [
          { label: 'ICMS', data: fp.meses.map((m) => fp.porMes[m].apuracao.icms.aRecolher), borderColor: PAL[0], tension: 0.3 },
          { label: 'PIS', data: fp.meses.map((m) => fp.porMes[m].apuracao.pis.aRecolher), borderColor: PAL[1], tension: 0.3 },
          { label: 'COFINS', data: fp.meses.map((m) => fp.porMes[m].apuracao.cofins.aRecolher), borderColor: PAL[2], tension: 0.3 },
        ],
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: leg() } },
    });

    const comp = composicaoChartData(pack);
    if (fed) {
      comp.push({ label: 'IRPJ', valor: Math.max(fed.irpj.aRecolher || 0, 0) });
      comp.push({ label: 'CSLL', valor: Math.max(fed.csll.aRecolher || 0, 0) });
    }
    safeChart('chartImpostosPart', {
      type: 'doughnut',
      data: { labels: comp.map((c) => c.label), datasets: [{ data: comp.map((c) => c.valor), backgroundColor: PAL }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right' } } },
    });
  }

  function trimestreKeyForMonth(m) {
    if (TRIMESTRES.q1 && TRIMESTRES.q1.meses.includes(m)) return 'q1';
    if (TRIMESTRES.q2 && TRIMESTRES.q2.meses.includes(m)) return 'q2';
    return null;
  }

  function aggregateIrpjCsllPacks(packs) {
    if (!packs.length) return null;
    if (packs.length === 1) return packs[0];
    const sumTax = (key) => {
      const first = packs[0][key];
      const out = {
        receitaBruta: 0,
        devolucoes: 0,
        saidas: 0,
        pctPresuncao: first.pctPresuncao,
        aliquota: first.aliquota,
        baseCalculoSimples: 0,
        baseCalculo: 0,
        majoracao: null,
        debitos: 0,
        aRecolher: 0,
        fonte: packs.map((p) => p[key].fonte).filter(Boolean).join(' + '),
      };
      if (key === 'irpj') {
        out.adicional = {
          baseCalculo: 0,
          limiteIsento: first.adicional?.limiteIsento || 60000,
          parcelaExcedente: 0,
          aliquota: first.adicional?.aliquota || 10,
          valor: 0,
        };
      }
      packs.forEach((p) => {
        const t = p[key];
        out.receitaBruta += t.receitaBruta || 0;
        out.devolucoes += t.devolucoes || 0;
        out.saidas += t.saidas || 0;
        out.baseCalculoSimples += t.baseCalculoSimples || 0;
        out.baseCalculo += t.baseCalculo || 0;
        out.debitos += t.debitos || 0;
        out.aRecolher += t.aRecolher || 0;
        if (key === 'irpj' && t.adicional) {
          out.adicional.baseCalculo += t.adicional.baseCalculo || 0;
          out.adicional.parcelaExcedente += t.adicional.parcelaExcedente || 0;
          out.adicional.valor += t.adicional.valor || 0;
          out.adicional.limiteIsento += t.adicional.limiteIsento || 0;
        }
      });
      ['receitaBruta', 'devolucoes', 'saidas', 'baseCalculoSimples', 'baseCalculo', 'debitos', 'aRecolher'].forEach((f) => {
        out[f] = Math.round(out[f] * 100) / 100;
      });
      if (out.adicional) {
        ['baseCalculo', 'parcelaExcedente', 'valor', 'limiteIsento'].forEach((f) => {
          out.adicional[f] = Math.round(out.adicional[f] * 100) / 100;
        });
      }
      return out;
    };
    return {
      id: 'total',
      competencia: null,
      receitaBruta: Math.round(packs.reduce((a, p) => a + (p.receitaBruta || 0), 0) * 100) / 100,
      devolucoes: Math.round(packs.reduce((a, p) => a + (p.devolucoes || 0), 0) * 100) / 100,
      saidas: Math.round(packs.reduce((a, p) => a + (p.saidas || 0), 0) * 100) / 100,
      irpj: sumTax('irpj'),
      csll: sumTax('csll'),
      fonte: packs.map((p) => p.fonte).filter(Boolean).join(' + '),
      _agregado: true,
    };
  }

  function getIrpjCsllPack() {
    const root = D.irpjCsll;
    if (!root || !root.porTrimestre) return null;
    const por = root.porTrimestre;
    if (state.fiscalMode === 'q1' || state.fiscalMode === 'q2') return por[state.fiscalMode] || null;
    if (state.fiscalMode === 'total') {
      return aggregateIrpjCsllPacks([por.q1, por.q2].filter(Boolean));
    }
    const qid = trimestreKeyForMonth(state.month);
    return qid ? (por[qid] || null) : null;
  }

  function irpjCsllTrimLabel(pack) {
    if (!pack) return '';
    if (pack.id === 'total' || pack._agregado) return 'Jan – Jun / 2026';
    if (pack.id === 'q1' && TRIMESTRES.q1) return TRIMESTRES.q1.label;
    if (pack.id === 'q2' && TRIMESTRES.q2) return TRIMESTRES.q2.label;
    return pack.id || '';
  }

  function memRow(lbl, val, cls) {
    return '<div class="mem-row' + (cls ? ' ' + cls : '') + '"><span class="lbl">' + lbl + '</span><span class="val">' + val + '</span></div>';
  }

  function renderIrpjCsllMemCards(pack) {
    if (!pack) {
      return '<div class="mem-card" style="grid-column:1/-1;opacity:.7"><div class="mem-card-head"><span class="fw7 t-muted">IRPJ / CSLL</span><span class="chip gy">Pendente</span></div>' +
        memRow('Status', 'Demonstrativo trimestral não carregado') + '</div>';
    }
    const trimLbl = irpjCsllTrimLabel(pack);
    const irpj = pack.irpj || {};
    const csll = pack.csll || {};
    const majI = irpj.majoracao;
    const majC = csll.majoracao;
    const adic = irpj.adicional || {};

    let irpjHtml = '<div class="mem-card">' +
      '<div class="mem-card-head"><span style="color:var(--cyan)" class="fw7">IRPJ — Lucro Presumido</span><span class="chip cy">Trimestral</span></div>' +
      memRow('Apuração', trimLbl, 'hl') +
      memRow('Receita bruta (líquida)', fmtBRL(irpj.receitaBruta)) +
      memRow('Presunção base', (irpj.pctPresuncao != null ? irpj.pctPresuncao.toFixed(2).replace('.', ',') : '8,00') + '%');
    if (majI) {
      irpjHtml += memRow('RB até limite (' + majI.pctLimite.toFixed(2).replace('.', ',') + '%)', fmtBRL(majI.receitaLimite)) +
        memRow('RB excedente (' + majI.pctExcedente.toFixed(2).replace('.', ',') + '%)', fmtBRL(majI.receitaExcedente));
    }
    irpjHtml += memRow('Base de cálculo IRPJ', fmtBRL(irpj.baseCalculo), 'hl') +
      memRow('Alíquota básica', (irpj.aliquota != null ? irpj.aliquota.toFixed(2).replace('.', ',') : '15,00') + '%') +
      memRow('Débitos (IRPJ básico)', fmtBRL(irpj.debitos)) +
      memRow('Adicional 10% s/ > R$60k/tri', fmtBRL(adic.valor)) +
      memRow('IRPJ a recolher', fmtBRL(irpj.aRecolher), 'tot') +
      '</div>';

    let csllHtml = '<div class="mem-card">' +
      '<div class="mem-card-head"><span style="color:var(--orange)" class="fw7">CSLL — Lucro Presumido</span><span class="chip or">Trimestral</span></div>' +
      memRow('Apuração', trimLbl, 'hl') +
      memRow('Receita bruta (líquida)', fmtBRL(csll.receitaBruta)) +
      memRow('Presunção base', (csll.pctPresuncao != null ? csll.pctPresuncao.toFixed(2).replace('.', ',') : '12,00') + '%');
    if (majC) {
      csllHtml += memRow('RB até limite (' + majC.pctLimite.toFixed(2).replace('.', ',') + '%)', fmtBRL(majC.receitaLimite)) +
        memRow('RB excedente (' + majC.pctExcedente.toFixed(2).replace('.', ',') + '%)', fmtBRL(majC.receitaExcedente));
    }
    csllHtml += memRow('Base de cálculo CSLL', fmtBRL(csll.baseCalculo), 'hl') +
      memRow('Alíquota CSLL', (csll.aliquota != null ? csll.aliquota.toFixed(2).replace('.', ',') : '9,00') + '%') +
      memRow('Débitos', fmtBRL(csll.debitos)) +
      memRow('CSLL a recolher', fmtBRL(csll.aRecolher), 'tot') +
      '</div>';

    return irpjHtml + csllHtml;
  }

  function initMemoria() {
    const pack = getPack();
    const fed = getIrpjCsllPack();
    renderMesBar('mem-mes-bar', () => { tabsInit.memoria = false; initMemoria(); });
    const memSub = document.getElementById('mem-sec-sub');
    if (memSub) {
