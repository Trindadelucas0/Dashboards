    }
    const impAlert = document.getElementById('imp-alert');
    if (impAlert) {
      const icms = pack.apuracao.icms.aRecolher;
      let alertHtml = '<i class="fas fa-info-circle" style="margin-right:8px;"></i><strong>Apuração ICMS (5005) + EFD PIS/COFINS</strong> — ' +
        periodFull() + ': ICMS a recolher <strong>' + fmtBRL(icms) + '</strong>, PIS <strong>' + fmtBRL(pack.apuracao.pis.aRecolher) +
        '</strong>, COFINS <strong>' + fmtBRL(pack.apuracao.cofins.aRecolher) + '</strong>.';
      if (fed) {
