  function initRecebimentos() { /* placeholder static */ }
  function initBalancete() {
    const meses = D.balancete?.meses || [];
    let balSel = window._balSel || state.month || meses[meses.length - 1];
    renderMesBar('bal-mes-bar', () => { window._balSel = balSel; tabsInit.balancete = false; initBalancete(); });
    const bar = document.getElementById('bal-mes-bar');
    if (bar) {
      bar.querySelectorAll('.mes-btn').forEach((btn) => {
        btn.onclick = () => { window._balSel = btn.dataset.m; balSel = btn.dataset.m; initBalancete(); };
        if (btn.dataset.m === balSel) btn.classList.add('active');
      });
    }
    const data = D.balancete?.porMes?.[balSel];
    const alertEl = document.getElementById('bal-alert');
    if (alertEl) {
      if (data && data._proxyBalancete) {
        alertEl.style.display = 'block';
        alertEl.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Balancete ' + (data.dataRef || '') + ': aguardando Apuração 5005 — exibindo saldos do último mês disponível.';
      } else if (data && data._copiaJan) {
        alertEl.style.display = 'block';
        alertEl.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Balancete Fev–Mai: mesmos saldos de Jan/2026 na planilha (cópia no xlsx).';
      } else {
        alertEl.style.display = 'none';
      }
    }
    if (!data) return;
    const contas = data.contas || [];
    const ativo = contas.filter((c) => c.grupo === 'ativo' && c.nivel <= 2).pop();
    const passivo = contas.filter((c) => c.grupo === 'passivo' && c.nivel <= 2).pop();
    const resultado = contas.filter((c) => c.grupo === 'resultado' && String(c.codigo).startsWith('3')).pop();
    const kpiEl = document.getElementById('bal-kpi-grid');
    if (kpiEl) {
      kpiEl.innerHTML =
        kpiCard('green', 'scale-balanced', '', fmtBRL(ativo?.saldoAtual, true), 'Ativo Total', data.dataRef || '') +
        kpiCard('red', 'landmark', '', fmtBRL(Math.abs(passivo?.saldoAtual || 0), true), 'Passivo Total', '') +
        kpiCard('blue', 'chart-pie', '', fmtBRL(Math.abs((ativo?.saldoAtual || 0) + (passivo?.saldoAtual || 0)), true), 'Patrimônio Líquido', '') +
        kpiCard('yellow', 'coins', '', fmtBRL(resultado?.saldoAtual, true), 'Resultado', '');
    }
    const tbody = document.getElementById('bal-tbody');
    if (tbody) {
      tbody.innerHTML = contas.map((c) =>
        '<tr><td style="padding-left:' + (c.nivel * 12) + 'px">' + c.codigo + '</td><td>' + c.descricao +
        '</td><td class="r">' + fmtBRL(c.saldoAnterior) + '</td><td class="r">' + fmtBRL(c.debito) +
        '</td><td class="r">' + fmtBRL(c.credito) + '</td><td class="r td-val">' + fmtBRL(c.saldoAtual) + '</td></tr>'
      ).join('');
    }
  }

