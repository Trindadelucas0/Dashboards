          { label: 'Margem Líquida %', data: MONTH_KEYS.map((m) => (dre[m] ? dre[m].margemLiquidaPct : 0)), borderColor: PAL[4], tension: 0.3 },
        ],
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: leg() }, scales: { y: { ticks: { callback: (v) => v + '%' } } } },
