        kpiCard('green', 'arrow-down', '', fmtBRL(totalCred, true), 'Total créditos', 'Entradas + outros créditos') +
        kpiCard('yellow', 'equals', '', fmtBRL(totalLiq, true), 'A recolher líquido', fed ? 'Inclui IRPJ + CSLL trimestral' : 'Soma apuração final');
