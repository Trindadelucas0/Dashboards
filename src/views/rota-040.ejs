        '</td><td class="r">' + fmtBRL(t.outrosDebitos) + '</td><td class="r">' + fmtBRL(t.outrosCreditos) + '</td><td class="r">' + fmtBRL(t.saldoDevedor) +
        '</td><td class="r">' + fmtBRL(t.saldoCredor) + '</td><td class="r td-val">' + fmtBRL(t.aRecolher) + '</td><td class="r">' + fmtBRL(t.saldoCredorTransportar) + '</td></tr>';
    });
    if (fed) {
      const pctFed = (v) => (rb > 0 ? ((v / rb) * 100).toFixed(2).replace('.', ',') + '%' : '—');
      rows.push(
        '<tr><td class="fw7" style="color:var(--cyan)">IRPJ <span class="chip cy">Trimestral</span></td><td class="r">' + fmtBRL(fed.irpj.debitos) +
        '</td><td class="r">—</td><td class="r">' + fmtBRL(fed.irpj.adicional?.valor || 0) + '</td><td class="r">—</td><td class="r">' +
        fmtBRL(fed.irpj.aRecolher) + '</td><td class="r">—</td><td class="r td-val">' + fmtBRL(fed.irpj.aRecolher) +
        '</td><td class="r">' + pctFed(fed.irpj.aRecolher) + '</td></tr>',
        '<tr><td class="fw7" style="color:var(--orange)">CSLL <span class="chip or">Trimestral</span></td><td class="r">' + fmtBRL(fed.csll.debitos) +
        '</td><td class="r">—</td><td class="r">—</td><td class="r">—</td><td class="r">' + fmtBRL(fed.csll.aRecolher) +
        '</td><td class="r">—</td><td class="r td-val">' + fmtBRL(fed.csll.aRecolher) +
        '</td><td class="r">' + pctFed(fed.csll.aRecolher) + '</td></tr>'
      );
    }
    tbody.innerHTML = rows.join('');
  }

  function initDRE() {
