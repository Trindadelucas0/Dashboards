<script>
/* Rota 040 Dashboard — empresa única (consolidado) */
(function () {
  'use strict';

  if (typeof DASHBOARD_DATA === 'undefined') {
    console.error('DASHBOARD_DATA não carregado');
    return;
  }

  const D = DASHBOARD_DATA;
  const MONTH_KEYS = D.meta.meses;
  const MONTH_LABELS = D.meta.monthLabels;
  const TRIMESTRES = D.meta.trimestres || {};
  const PERIODO_TOTAL = D.meta.periodoTotal || { label: 'Total Jan – Jun / 2026', meses: MONTH_KEYS };
  const Q1_MESES = (TRIMESTRES.q1 && TRIMESTRES.q1.meses) || ['01', '02', '03'];
  const Q2_MESES = (TRIMESTRES.q2 && TRIMESTRES.q2.meses) || ['04', '05', '06'];
  const UNIT_LABELS = { consolidado: D.empresa.nome || 'ROTA 040' };

  let state = { unit: 'consolidado', month: D.competencia.split('-')[1] || '05', fiscalMode: 'month' };
  let activeDrilldownCfop = null;
  const chartInst = {};
  const tabsInit = {};
  const CFOP_FINALIDADE = D.cfopFinalidade || {};
  const FINALIDADE_CORES = D.finalidadeCores || {};

  Chart.defaults.color = '#94a3b8';
  Chart.defaults.borderColor = 'rgba(255,255,255,0.07)';
  Chart.defaults.font.family = "'Inter', sans-serif";
  Chart.defaults.font.size = 12;
  const PAL = ['#22a329', '#10b981', '#f59e0b', '#8b5cf6', '#ef4444', '#06b6d4', '#f97316', '#ec4899'];

  const fmt = (v) => (v == null || isNaN(v) ? '—' : Number(v).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
  const fmtBRL = (v, short) => {
    if (v == null || isNaN(v)) return '—';
    if (short && Math.abs(v) >= 1e6) return 'R$ ' + (v / 1e6).toFixed(2).replace('.', ',') + 'M';
    if (short && Math.abs(v) >= 1e3) return 'R$ ' + (v / 1e3).toFixed(0) + 'K';
    return 'R$ ' + fmt(v);
  };
  const pct = (a, b) => (b > 0 ? ((a / b) * 100).toFixed(1) : '0.0');
  const pct1 = pct;

  function tip() {
    return { backgroundColor: '#1e2535', borderColor: 'rgba(255,255,255,0.1)', borderWidth: 1, padding: 12, titleColor: '#e2e8f0', bodyColor: '#94a3b8', cornerRadius: 8 };
  }
  function leg() { return { labels: { usePointStyle: true, padding: 16, boxWidth: 8, boxHeight: 8 } }; }

  function safeChart(id, cfg) {
    if (chartInst[id]) chartInst[id].destroy();
    const ctx = document.getElementById(id);
    if (!ctx) return;
    chartInst[id] = new Chart(ctx, cfg);
  }

  function getUnitFiscal() { return D.unidades[state.unit].fiscalPorMes; }
  function getPack() {
    if (state.fiscalMode === 'total') return buildFiscalTotalPack();
    if (state.fiscalMode === 'q1' || state.fiscalMode === 'q2') return buildFiscalTrimPack(state.fiscalMode);
    return getUnitFiscal().porMes[state.month];
  }
  function getCfopDados() {
    const pack = getPack();
    return (pack && pack.cfopEntradas) || [];
  }
  function escHtml(v) {
    return String(v || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  }
  function trimestreForMonth(m) {
    if (TRIMESTRES.q1 && TRIMESTRES.q1.meses.includes(m)) return '1º Trim';
    if (TRIMESTRES.q2 && TRIMESTRES.q2.meses.includes(m)) return '2º Trim';
    return '';
  }
  function periodLbl() {
    if (state.fiscalMode === 'total') return 'Total';
    if (state.fiscalMode === 'q1') return '1º Trim';
    if (state.fiscalMode === 'q2') return '2º Trim';
    return MONTH_LABELS[state.month] + '/26';
  }
  function periodFull() {
    if (state.fiscalMode === 'total') return PERIODO_TOTAL.label;
    if (state.fiscalMode === 'q1' && TRIMESTRES.q1) return TRIMESTRES.q1.label + ' (' + TRIMESTRES.q1.mesesLabel + ')';
    if (state.fiscalMode === 'q2' && TRIMESTRES.q2) return TRIMESTRES.q2.label + ' (' + TRIMESTRES.q2.mesesLabel + ')';
    return MONTH_LABELS[state.month] + ' / 2026';
  }
  function periodContext() {
    if (state.fiscalMode === 'month') {
      const t = trimestreForMonth(state.month);
      return t ? ' — ' + t : '';
    }
    if (state.fiscalMode === 'q1' && TRIMESTRES.q1) return ' — ' + TRIMESTRES.q1.pasta;
    if (state.fiscalMode === 'q2' && TRIMESTRES.q2) return ' — ' + TRIMESTRES.q2.pasta;
    return '';
  }
  function syncMonthSel() {
    const ms = document.getElementById('monthSel');
    if (!ms) return;
    ms.value = ['total', 'q1', 'q2'].includes(state.fiscalMode) ? state.fiscalMode : state.month;
  }
  function applyPeriodSelection(val) {
    if (val === 'total') state.fiscalMode = 'total';
    else if (val === 'q1' || val === 'q2') state.fiscalMode = val;
    else { state.fiscalMode = 'month'; state.month = val; }
    syncMonthSel();
  }

  function aggregateFiscalPack(monthKeys, competenciaLabel) {
    const fp = getUnitFiscal();
    const packs = monthKeys.map((m) => fp.porMes[m]);
    const sum = (fn) => packs.reduce((a, p) => a + fn(p), 0);
    const mergeCfop = (field) => {
      const m = {};
      packs.forEach((p) => p[field].forEach((c) => {
        if (!m[c.cfop]) {
          m[c.cfop] = {
            cfop: c.cfop, qtd: 0, total: 0, contabil: 0, descricao: c.descricao,
            finalidade: c.finalidade, creditoPisCofins: c.creditoPisCofins, debitaIcms: c.debitaIcms,
            fornecedores: {},
          };
        }
        const entry = m[c.cfop];
        entry.qtd += c.qtd || 0;
        entry.total += c.total || c.contabil || 0;
        entry.contabil += c.contabil || c.total || 0;
        if (field === 'cfopEntradas') {
          (c.fornecedores || []).forEach((f) => {
            if (!entry.fornecedores[f.nome]) {
              entry.fornecedores[f.nome] = { nome: f.nome, qtd: 0, total: 0, cnpj: f.cnpj || '', uf: f.uf || '—' };
            }
            entry.fornecedores[f.nome].qtd += f.qtd || 0;
            entry.fornecedores[f.nome].total += f.total || 0;
          });
        }
      }));
      return Object.values(m).map((c) => {
        const row = {
          cfop: c.cfop, qtd: c.qtd, total: c.total, contabil: c.contabil || c.total,
          descricao: c.descricao, finalidade: c.finalidade,
          creditoPisCofins: c.creditoPisCofins, debitaIcms: c.debitaIcms,
        };
        if (field === 'cfopEntradas') {
          row.fornecedores = Object.values(c.fornecedores || {}).sort((a, b) => b.total - a.total);
        }
        return row;
      }).sort((a, b) => b.total - a.total);
    };
    const apKeys = ['icms', 'icmsSt', 'pis', 'cofins', 'ipi'];
    const apuracao = {};
    apKeys.forEach((k) => {
      apuracao[k] = { debitoSaidas: 0, creditoEntradas: 0, outrosDebitos: 0, outrosCreditos: 0, saldoDevedor: 0, saldoCredor: 0, aRecolher: 0, saldoCredorTransportar: 0 };
      packs.forEach((p) => {
        const t = p.apuracao[k];
        Object.keys(apuracao[k]).forEach((f) => { apuracao[k][f] += t[f] || 0; });
      });
      Object.keys(apuracao[k]).forEach((f) => { apuracao[k][f] = Math.round(apuracao[k][f] * 100) / 100; });
    });
    const rb = sum((p) => p.receitaBruta);
    const ded = sum((p) => p.deducoes);
    const clientes = mergePartiesFromPacks(packs, 'clientes', 20);
    const fornecedores = mergePartiesFromPacks(packs, 'fornecedores', 20);
    const porUf = mergePorUfFromPacks(packs);
    return {
      competencia: competenciaLabel === PERIODO_TOTAL.label ? 'total' : monthKeys[0],
      competenciaLabel,
      receitaBruta: rb, totalCompras: sum((p) => p.totalCompras), deducoes: ded,
      dedPct: rb > 0 ? Math.round(ded / rb * 10000) / 100 : 0,
      composicao: apKeys.map((k, i) => ({ label: ['ICMS', 'ICMS ST', 'PIS', 'COFINS', 'IPI'][i], valor: apuracao[k].aRecolher })),
      impostosTabela: packs[0].impostosTabela.map((_, i) => ({
        tributo: packs[0].impostosTabela[i].tributo,
        apurado: packs.reduce((a, p) => a + p.impostosTabela[i].apurado, 0),
        recolher: packs.reduce((a, p) => a + p.impostosTabela[i].recolher, 0),
        pctRb: rb > 0 ? Math.round(packs.reduce((a, p) => a + p.impostosTabela[i].recolher, 0) / rb * 10000) / 100 : 0,
      })),
      apuracao, cfopEntradas: mergeCfop('cfopEntradas'), cfopSaidas: mergeCfop('cfopSaidas'),
      cfopSaidasTotal: sum((p) => p.cfopSaidasTotal),
      sped: {
        nfSaidas: sum((p) => p.sped.nfSaidas),
        totalClientes: clientes.length,
        c100Total: sum((p) => p.sped.c100Total),
        clientes,
        cfopSaidas: mergeCfop('cfopSaidas').slice(0, 20).map((c) => ({ cfop: c.cfop, total: c.contabil, qtd: c.qtd })),
      },
      porUf, fornecedores,
    };
  }

  function buildFiscalTotalPack() {
    return aggregateFiscalPack(MONTH_KEYS, PERIODO_TOTAL.label);
  }
  function buildFiscalTrimPack(trimId) {
    const t = TRIMESTRES[trimId];
    if (!t) return buildFiscalTotalPack();
    return aggregateFiscalPack(t.meses, t.label + ' (' + t.mesesLabel + ')');
  }

  function validateComprasPack(pack) {
    const sum = (pack.cfopEntradas || []).reduce((a, c) => a + (c.total || 0), 0);
    const total = pack.totalCompras || 0;
    return { ok: Math.abs(sum - total) < 0.02, sum, total, n: (pack.cfopEntradas || []).length };
  }

  function validateApuracaoPack(pack) {
    const keys = ['icms', 'icmsSt', 'pis', 'cofins', 'ipi'];
    let taxOk = true;
    keys.forEach((k) => {
      const t = pack.apuracao?.[k];
      if (!t) return;
      const cred = (t.creditoEntradas || 0) + (t.outrosCreditos || 0);
      const deb = (t.debitoSaidas || 0) + (t.outrosDebitos || 0);
      if (deb > 0 && Math.abs(deb - cred - (t.aRecolher || 0)) > 2) taxOk = false;
    });
    const sumRec = keys.reduce((a, k) => a + (pack.apuracao?.[k]?.aRecolher || 0), 0);
    const dedOk = Math.abs(sumRec - (pack.deducoes || 0)) < 0.02;
    return { ok: taxOk && dedOk, sumRec, deducoes: pack.deducoes || 0 };
  }

  function setFiscalDataStatus(elId, result, okMsg, failMsg) {
    const el = document.getElementById(elId);
    if (!el) return;
    el.className = 'fiscal-data-status ' + (result.ok ? 'ok' : 'warn');
    el.innerHTML = '<i class="fas fa-' + (result.ok ? 'circle-check' : 'triangle-exclamation') + '"></i> ' + (result.ok ? okMsg : failMsg);
  }

  function getCfopInfo(cfop) {
    const raw = CFOP_FINALIDADE[cfop] || {};
    return { descricao: raw.descricao || ('CFOP ' + cfop), finalidade: raw.finalidade || 'Outras Entradas', creditoPisCofins: raw.creditoPisCofins, debitaIcms: raw.debitaIcms };
  }

  function cfopFinalidadeFromItem(c) {
    const fromMap = CFOP_FINALIDADE[c.cfop];
    if (fromMap && fromMap.finalidade) return fromMap.finalidade;
    return c.finalidade || getCfopInfo(c.cfop).finalidade;
  }

  function cfopDescricaoFromItem(c) {
    const fromMap = CFOP_FINALIDADE[c.cfop];
    if (fromMap && fromMap.descricao) return fromMap.descricao;
    return c.descricao || getCfopInfo(c.cfop).descricao;
  }

  function cfopCreditoFromItem(c) {
    if (typeof c.creditoPisCofins === 'boolean') return c.creditoPisCofins;
    return getCfopInfo(c.cfop).creditoPisCofins;
  }

  function activeTrimContext() {
    if (state.fiscalMode === 'q1') return 'q1';
    if (state.fiscalMode === 'q2') return 'q2';
    if (state.fiscalMode === 'month') {
      if (Q1_MESES.includes(state.month)) return 'q1';
      if (Q2_MESES.includes(state.month)) return 'q2';
    }
    return null;
  }

  function renderMesBar(containerId, onSelect) {
    const el = document.getElementById(containerId);
    if (!el) return;
    const isActive = (m) => {
      if (m === 'total') return state.fiscalMode === 'total';
      if (m === 'q1') return state.fiscalMode === 'q1';
      if (m === 'q2') return state.fiscalMode === 'q2';
      return state.fiscalMode === 'month' && state.month === m;
    };
    const trimCtx = activeTrimContext();
    const monthClass = (m) => {
      const classes = [];
      if (isActive(m)) classes.push('active');
      if (trimCtx === 'q1' && Q1_MESES.includes(m)) classes.push('in-trim');
      if (trimCtx === 'q2' && Q2_MESES.includes(m)) classes.push('in-trim');
      if (trimCtx === 'q1' && Q2_MESES.includes(m)) classes.push('dim');
      if (trimCtx === 'q2' && Q1_MESES.includes(m)) classes.push('dim');
      return classes.length ? ' class="' + classes.join(' ') + '"' : '';
    };
    const btn = (m, lbl, isMonth) =>
      '<button type="button" data-m="' + m + '"' + (isMonth ? monthClass(m) : (isActive(m) ? ' class="active"' : '')) + '>' + lbl + '</button>';
    let html = btn('total', 'Total', false);
    html += '<span class="mes-bar-sep">|</span>';
    html += btn('q1', '1º Trim', false);
    Q1_MESES.forEach((m) => { html += btn(m, MONTH_LABELS[m], true); });
    html += '<span class="mes-bar-sep">|</span>';
    html += btn('q2', '2º Trim', false);
    Q2_MESES.forEach((m) => { html += btn(m, MONTH_LABELS[m], true); });
    el.innerHTML = html;
    el.querySelectorAll('button').forEach((b) => {
      b.onclick = () => { applyPeriodSelection(b.dataset.m); onSelect(); };
    });
  }

  function kpiCard(color, icon, badge, val, lbl, sub) {
    return '<div class="kpi-card c-' + color + '"><div class="kpi-head"><div class="kpi-ico c-' + color + '"><i class="fas fa-' + icon + '"></i></div>' +
      (badge ? '<div class="kpi-badge neutral">' + badge + '</div>' : '') + '</div><div class="kpi-val">' + val + '</div><div class="kpi-lbl">' + lbl + '</div>' +
      (sub ? '<div class="kpi-sub">' + sub + '</div>' : '') + '</div>';
  }

  function pbBar(pctVal) {
    const n = typeof pctVal === 'number' ? pctVal : parseFloat(pctVal);
    const safe = isNaN(n) ? 0 : n;
    return '<div class="pb-wrap"><div class="pb-bar"><div class="pb-fill" style="width:' + safe + '%"></div></div><span class="pb-pct">' + safe.toFixed(1) + '%</span></div>';
  }

  function deltaPct(curr, prev) {
    if (!prev || prev === 0) return null;
    return ((curr - prev) / Math.abs(prev) * 100).toFixed(1);
  }
  function monthDeltaStr(fieldFn, currVal) {
    if (state.fiscalMode !== 'month') return '';
    const idx = MONTH_KEYS.indexOf(state.month);
    if (idx <= 0) return '';
    const prev = getUnitFiscal().porMes[MONTH_KEYS[idx - 1]];
    const d = deltaPct(currVal, fieldFn(prev));
    if (d === null) return '';
    const sign = parseFloat(d) >= 0 ? '+' : '';
    const arrow = parseFloat(d) >= 0 ? '▲' : '▼';
    return arrow + ' ' + sign + d + '% vs ' + MONTH_LABELS[MONTH_KEYS[idx - 1]];
  }
  function saldoOperacional(pack) { return (pack.cfopSaidasTotal || 0) - (pack.totalCompras || 0); }
  function tributosRecolher(pack) {
    return ['icms', 'pis', 'cofins'].reduce((a, k) => a + Math.max(pack.apuracao[k].aRecolher || 0, 0), 0);
  }
  function topFinalidades(cfopEntradas, n) {
    const grupos = {};
    (cfopEntradas || []).forEach((c) => {
      const fin = cfopFinalidadeFromItem(c);
      grupos[fin] = (grupos[fin] || 0) + c.total;
    });
    return Object.entries(grupos).sort((a, b) => b[1] - a[1]).slice(0, n);
  }
  function kpiCardDelta(color, icon, badge, val, lbl, sub) {
    return kpiCard(color, icon, badge, val, lbl, sub);
  }
  function formatIcmsKpi(pack) {
    const v = pack.apuracao.icms.aRecolher;
    if (v < 0) return { val: fmtBRL(Math.abs(v), true), lbl: 'Crédito ICMS', color: 'green', sub: 'Saldo credor no período' };
    return { val: fmtBRL(v, true), lbl: 'ICMS a Recolher', color: 'purple', sub: '' };
  }
  function mergePartiesFromPacks(packs, field, limit) {
    const m = {};
    packs.forEach((p) => {
      const list = field === 'fornecedores' ? (p.fornecedores || []) : (p.sped?.clientes || []);
      list.forEach((x) => { m[x.nome] = (m[x.nome] || 0) + x.total; });
    });
    return Object.entries(m).map(([nome, total]) => ({ nome, total })).sort((a, b) => b.total - a.total).slice(0, limit || 20);
  }
  function mergePorUfFromPacks(packs) {
    const u = {};
    packs.forEach((p) => Object.entries(p.porUf || {}).forEach(([k, v]) => { u[k] = (u[k] || 0) + v; }));
    return u;
  }
  function composicaoChartData(pack) {
    const items = [];
    (pack.composicao || []).forEach((c) => {
      if (c.label === 'ICMS' && c.valor < 0) items.push({ label: 'ICMS (crédito)', valor: Math.abs(c.valor) });
      else if (c.valor !== 0) items.push({ label: c.label, valor: Math.max(c.valor, 0) });
    });
    return items;
  }
  function tributoPctRb(pack, key) {
    const rb = pack.receitaBruta || 0;
    if (!rb) return 0;
    return Math.round((pack.apuracao[key].aRecolher / rb) * 10000) / 100;
  }
  function topUf(porUf) {
    const entries = Object.entries(porUf || {});
    if (!entries.length) return null;
    return entries.sort((a, b) => b[1] - a[1])[0];
  }

  function buildFontesHtml() {
    const t1 = TRIMESTRES.q1;
    const t2 = TRIMESTRES.q2;
    const mesesStr = (meses) => meses.map((m) => MONTH_LABELS[m]).join(', ');
    let html = '<i class="fas fa-database" style="margin-right:8px;color:var(--accent)"></i><strong>Fontes Avícola</strong> — CNPJ ' + D.empresa.cnpj;
    if (t1) {
      html += '<br><strong>' + t1.label + ':</strong> ' + t1.pasta + ' — ' + mesesStr(t1.meses);
    }
    if (t2) {
      html += '<br><strong>' + t2.label + ':</strong> ' + t2.pasta + ' — ' + mesesStr(t2.meses);
    }
    html += '<br><strong>' + PERIODO_TOTAL.label + ':</strong> ' + MONTH_KEYS.map((m) => MONTH_LABELS[m]).join(', ');
    const fontesRest = Object.entries(D.fontes || {}).filter(([k]) => !k.startsWith('trimestre'));
    if (fontesRest.length) html += '<br>' + fontesRest.map(([, v]) => v).join(' · ');
    return html;
  }

  function hydrateStatic() {
    document.querySelector('.logo-text .company').textContent = D.empresa.nome.split(' ').slice(0, 2).join(' ') || 'AVÍCOLA';
    document.getElementById('sidebarSubtitle').textContent = D.empresa.sede + ' · ' + D.competenciaLabel;
    const t1 = TRIMESTRES.q1;
    const t2 = TRIMESTRES.q2;
    const sidebarPeriod = t1 && t2
      ? '1º Trim (' + t1.mesesLabel.replace(' / 2026', '') + ') + 2º Trim (' + t2.mesesLabel.replace(' / 2026', '') + ') / 2026'
      : PERIODO_TOTAL.label;
    document.getElementById('sidebarPeriod').textContent = sidebarPeriod;
    const ms = document.getElementById('monthSel');
    if (ms) {
      const q1Label = TRIMESTRES.q1 ? TRIMESTRES.q1.label : '1º Trimestre 2026';
      const q2Label = TRIMESTRES.q2 ? TRIMESTRES.q2.label : '2º Trimestre 2026';
      const totalLabel = PERIODO_TOTAL.label || 'Total Jan – Jun / 2026';
      ms.innerHTML =
        '<optgroup label="Período">' +
          '<option value="total">' + totalLabel + '</option>' +
          '<option value="q1">' + q1Label + '</option>' +
          '<option value="q2">' + q2Label + '</option>' +
        '</optgroup>' +
        '<optgroup label="1º Trimestre — meses">' +
          Q1_MESES.map((m) => '<option value="' + m + '">' + MONTH_LABELS[m] + ' / 2026</option>').join('') +
        '</optgroup>' +
        '<optgroup label="2º Trimestre — meses">' +
          Q2_MESES.map((m) => '<option value="' + m + '">' + MONTH_LABELS[m] + ' / 2026</option>').join('') +
        '</optgroup>';
      syncMonthSel();
    }
    document.querySelectorAll('[id^="dyn-cnpj"]').forEach((el) => {
      el.textContent = D.empresa.cnpj || '';
    });
  }

  function initVisaoGeral() {
    const pack = getPack();
    renderMesBar('vg-mes-bar', () => { tabsInit['visao-geral'] = false; initVisaoGeral(); });

    const vgSub = document.getElementById('vg-sec-sub');
    if (vgSub) vgSub.textContent = UNIT_LABELS[state.unit] + ' — ' + periodFull() + periodContext();

    const notice = document.getElementById('tax-notice');
    if (notice) {
      if (pack._proxyFiscal) {
        notice.style.display = 'block';
        notice.innerHTML = '<i class="fas fa-triangle-exclamation" style="margin-right:8px"></i> ' +
          (pack.competenciaLabel || 'Competência') + ': dados de movimento (Entradas/Saídas). ICMS, PIS/COFINS e balancete aguardam Apuração 5005, EFD e Resumo.';
      } else if (state.unit === 'filial' && state.fiscalMode === 'month' && state.month === '05' && !pack.cfopSaidasTotal) {
        notice.style.display = 'block';
        const q2p = TRIMESTRES.q2 ? TRIMESTRES.q2.pasta : 'ROTA 040';
        notice.innerHTML = '<i class="fas fa-triangle-exclamation" style="margin-right:8px"></i> Filial Mai/2026 sem planilha de saídas (61-Saidas 05-2026.xls ausente em ' + q2p + ').';
      } else notice.style.display = 'none';
    }

    const saldo = saldoOperacional(pack);
    const icmsKpi = formatIcmsKpi(pack);
    const pisCofins = (pack.apuracao.pis.aRecolher || 0) + (pack.apuracao.cofins.aRecolher || 0);
    const saldoColor = saldo >= 0 ? 'green' : 'red';

    document.getElementById('vg-kpi-grid').innerHTML =
      kpiCardDelta('blue', 'store', periodLbl(), fmtBRL(pack.receitaBruta, true), 'Receita Bruta', monthDeltaStr((p) => p.receitaBruta, pack.receitaBruta)) +
      kpiCardDelta('cyan', 'file-invoice', periodLbl(), fmtBRL(pack.cfopSaidasTotal, true), 'Total Vendas (saídas)', monthDeltaStr((p) => p.cfopSaidasTotal, pack.cfopSaidasTotal)) +
      kpiCardDelta('green', 'cart-shopping', periodLbl(), fmtBRL(pack.totalCompras, true), 'Total de Compras', monthDeltaStr((p) => p.totalCompras, pack.totalCompras)) +
      kpiCardDelta(saldoColor, 'scale-balanced', periodLbl(), fmtBRL(saldo, true), 'Saldo Operacional', 'Vendas − compras') +
      kpiCardDelta(icmsKpi.color, 'landmark', periodLbl(), icmsKpi.val, icmsKpi.lbl, icmsKpi.sub) +
      kpiCardDelta('yellow', 'coins', periodLbl(), fmtBRL(pisCofins, true), 'PIS + COFINS', 'A recolher no período') +
      kpiCardDelta('orange', 'percent', periodLbl(), pack.dedPct + '%', 'Carga Tributária', 'Sobre receita bruta') +
      kpiCardDelta('cyan', 'receipt', periodLbl(), pack.sped.nfSaidas, 'NFs / Linhas', 'Notas de saída');

    const fp = getUnitFiscal();
    const vendasMil = fp.meses.map((m) => fp.porMes[m].cfopSaidasTotal / 1000);
    const comprasMil = fp.meses.map((m) => fp.porMes[m].totalCompras / 1000);
    const saldoMil = fp.meses.map((m) => saldoOperacional(fp.porMes[m]) / 1000);

    safeChart('chartCompBar', {
      type: 'bar',
      data: {
        labels: fp.monthShort,
        datasets: [
          { label: 'Vendas', data: vendasMil, backgroundColor: 'rgba(34,163,41,0.65)', borderRadius: 4 },
          { label: 'Compras', data: comprasMil, backgroundColor: 'rgba(6,182,212,0.55)', borderRadius: 4 },
          { label: 'Saldo', data: saldoMil, type: 'line', borderColor: PAL[2], backgroundColor: 'transparent', tension: 0.3, yAxisID: 'y' },
        ],
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: leg() }, scales: { y: { ticks: { callback: (v) => 'R$' + v + 'K' } } } },
    });

    safeChart('chartDedPct', {
      type: 'line',
      data: {
        labels: fp.monthShort,
        datasets: [
          { label: '% ICMS/RB', data: fp.meses.map((m) => tributoPctRb(fp.porMes[m], 'icms')), borderColor: PAL[0], tension: 0.3, fill: false },
          { label: '% PIS/RB', data: fp.meses.map((m) => tributoPctRb(fp.porMes[m], 'pis')), borderColor: PAL[1], tension: 0.3, fill: false },
          { label: '% COFINS/RB', data: fp.meses.map((m) => tributoPctRb(fp.porMes[m], 'cofins')), borderColor: PAL[2], tension: 0.3, fill: false },
        ],
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: leg() }, scales: { y: { ticks: { callback: (v) => v + '%' } } } },
    });

    const compData = composicaoChartData(pack);
    safeChart('chartComposicao', {
      type: 'doughnut',
      data: { labels: compData.map((c) => c.label), datasets: [{ data: compData.map((c) => c.valor), backgroundColor: PAL }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right' } } },
    });

    safeChart('chartVgFluxo', {
      type: 'bar',
      data: {
        labels: fp.monthShort,
        datasets: [
          { label: 'Vendas', data: vendasMil, backgroundColor: 'rgba(34,163,41,0.7)', borderRadius: 4 },
          { label: 'Compras', data: comprasMil, backgroundColor: 'rgba(6,182,212,0.6)', borderRadius: 4 },
        ],
      },
