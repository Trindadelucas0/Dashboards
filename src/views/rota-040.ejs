    grid.innerHTML = MONTH_KEYS.map((m) => {
      const d = dre[m] || {};
      return '<div class="margin-card"><div class="margin-val">' + fmtBRL(d.resultadoLiquido, true) + '</div><div class="margin-lbl">Resultado ' + MONTH_LABELS[m] + '</div></div>';
    }).join('');

    if (tbody && dre[MONTH_KEYS[0]]) {
