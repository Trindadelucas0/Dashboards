      safeChart('chartMargensUF', {
        type: 'bar',
        data: { labels: margensUf.map((u) => u.uf), datasets: [{ label: '% RB (proxy UF)', data: margensUf.map((u) => u.margem), backgroundColor: PAL[0], borderRadius: 4 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, title: { display: true, text: 'Participação vendas por UF (proxy)' } } },
      });
      ['chartMargensCidade', 'chartMargensProduto'].forEach((id) => {
        safeChart(id, {
          type: 'bar',
          data: { labels: ['Sem planilha'], datasets: [{ data: [0], backgroundColor: '#64748b' }] },
          options: { responsive: true, maintainAspectRatio: false, plugins: { title: { display: true, text: 'Cidade/Produto — pendente' } } },
        });
      });
    } else if (D.pendentes.margens) {
      ['chartMargensUF', 'chartMargensCidade', 'chartMargensProduto'].forEach((id) => {
        const el = document.getElementById(id);
        if (!el) return;
        safeChart(id, {
          type: 'bar',
          data: { labels: ['Sem planilha de margens'], datasets: [{ data: [0], backgroundColor: '#64748b' }] },
          options: { responsive: true, maintainAspectRatio: false, plugins: { title: { display: true, text: 'Margens — módulo pendente' } } },
        });
      });
    }
