    setFiscalDataStatus('cp-data-status', v, 'Conferência OK — CFOPs = total compras', 'Divergência: CFOPs ' + fmt(v.sum) + ' vs total ' + fmt(v.total));

    const top = pack.cfopEntradas[0];
    const forn = pack.fornecedores || [];
