        '<tr><td class="fw7">' + c.cfop + '</td><td class="r">' + c.qtd + '</td><td class="r td-val">' + fmtBRL(c.contabil || c.total) +
        '</td><td class="r">' + pct1(c.contabil || c.total, totalV) + '%</td></tr>'
      ).join('');
