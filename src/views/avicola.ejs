  function initMemoria() {
    const pack = getPack();
    renderMesBar('mem-mes-bar', () => { tabsInit.memoria = false; initMemoria(); });
    const memSub = document.getElementById('mem-sec-sub');
    if (memSub) memSub.textContent = UNIT_LABELS[state.unit] + ' — ' + periodFull() + periodContext() + ' — ';

    const taxKeys = ['icms', 'icmsSt', 'pis', 'cofins', 'ipi'];
    const totalDeb = taxKeys.reduce((a, k) => a + (pack.apuracao[k].debitoSaidas || 0), 0);
    const totalCred = taxKeys.reduce((a, k) => a + (pack.apuracao[k].creditoEntradas || 0) + (pack.apuracao[k].outrosCreditos || 0), 0);
    const totalLiq = taxKeys.reduce((a, k) => a + (pack.apuracao[k].aRecolher || 0), 0);
