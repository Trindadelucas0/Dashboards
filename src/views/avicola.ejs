    if (memKpi) {
      memKpi.innerHTML =
        kpiCard('red', 'arrow-up', '', fmtBRL(totalDeb, true), 'Total débitos', 'Saídas dos 5 tributos') +
        kpiCard('green', 'arrow-down', '', fmtBRL(totalCred, true), 'Total créditos', 'Entradas + outros créditos') +
        kpiCard('yellow', 'equals', '', fmtBRL(totalLiq, true), 'A recolher líquido', 'Soma apuração final');
    }

    const tbody = document.getElementById('mem-resumo-tbody');
    if (!tbody) return;
