    const periodTxt = periodFull();

    const compEl = document.getElementById('dre-sec-competencia');
    const subEl = document.getElementById('dre-sec-sub');
    if (compEl) compEl.textContent = periodTxt;
    if (subEl) subEl.textContent = UNIT_LABELS[state.unit] + periodContext() + ' — ' + (D.pendentes?.dreProxy ? 'Abr–Jun DRE oficial · Jan–Mar proxy' : 'DRE contábil');

    const ttl = document.getElementById('dre-table-ttl');
    const tsub = document.getElementById('dre-table-sub');
    if (ttl) ttl.textContent = 'Demonstrativo do Resultado – ' + periodTxt;
    if (tsub) tsub.textContent = 'Valores em R$ — Fonte: DRE contábil BAIFER (Abr–Jun oficiais; Jan–Mar proxy fiscal)';

    const chartTtl = document.getElementById('dre-chart-ttl');
    const chartSub = document.getElementById('dre-chart-sub');
    const margTtl = document.getElementById('dre-margens-ttl');
    const margSub = document.getElementById('dre-margens-sub');
    if (chartTtl) chartTtl.textContent = 'Receita Bruta e Resultado – ' + periodTxt;
    if (chartSub) chartSub.textContent = 'Receita bruta × Lucro bruto × Resultado líquido (R$ mil)';
    if (margTtl) margTtl.textContent = 'Margens de Rentabilidade (%) – ' + periodTxt;
    if (margSub) margSub.textContent = 'Margem bruta e margem líquida';

    if (D.pendentes?.dre && !D.dre?._proxy) {
      setText('dre-mb-val', '—');
      setText('dre-mo-val', '—');
      setText('dre-ml-val', '—');
      setText('dre-carga-val', '—');
