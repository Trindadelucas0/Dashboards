    const mbEl = document.getElementById('dre-mb-val');
    const moEl = document.getElementById('dre-mo-val');
    const mlEl = document.getElementById('dre-ml-val');
    const cargaEl = document.getElementById('dre-carga-val');
    if (mbEl) {
      mbEl.textContent = avgMb != null ? avgMb.toFixed(2) + '%' : '—';
      mbEl.style.color = avgMb != null && avgMb < 0 ? 'var(--danger)' : 'var(--success)';
    }
    if (mlEl) {
      mlEl.textContent = avgMl != null ? avgMl.toFixed(2) + '%' : '—';
      mlEl.className = 'margin-val' + (avgMl != null && avgMl < 0 ? ' t-warning' : ' t-accent');
    }
    if (moEl) {
      if (avgMo != null) {
        moEl.textContent = avgMo.toFixed(2) + '%';
        moEl.className = 'margin-val' + (avgMo < 0 ? ' t-warning' : '');
        moEl.style.fontSize = '';
      } else {
        moEl.textContent = '—';
        moEl.className = 'margin-val t-muted';
        moEl.style.fontSize = '20px';
      }
    }
    if (cargaEl) cargaEl.textContent = carga != null ? carga.toFixed(2) + '%' : '—';

    setText('dre-mb-sub', state.fiscalMode === 'month' ? 'Mês selecionado' : 'Média do período · ' + keys.map((m) => MONTH_LABELS[m]).join(', '));
    setText('dre-ml-sub', state.fiscalMode === 'month' ? 'Mês selecionado' : 'Média do período');
    setText('dre-mo-sub', avgMo != null ? 'Resultado operacional / RB' : 'Sem linha operacional no período');
    setText('dre-carga-sub', 'Deduções fiscais s/ RB · ' + periodLbl());

    const thead = document.getElementById('dre-thead');
    if (thead) {
      thead.innerHTML = '<tr><th style="min-width:240px">Descrição</th>' + keys.map((m) => {
        const proxy = dreAll[m]?._proxy;
        const chip = proxy ? ' <span class="chip ye" style="font-size:9px;display:block;margin-top:3px">proxy</span>' : '';
        return '<th class="r">' + MONTH_LABELS[m] + '/2026' + chip + '</th>';
      }).join('') + '</tr>';
    }

    const tbody = document.getElementById('dre-tbody');
    if (tbody) {
      const seen = new Set();
      const linhasUnion = [];
      keys.forEach((m) => {
        (dreAll[m]?.linhas || []).forEach((ln) => {
          if (!seen.has(ln.id)) {
            seen.add(ln.id);
            linhasUnion.push(ln);
          }
        });
      });

      let html = '';
      let lastGroup = null;
      linhasUnion.forEach((ln) => {
        const group = dreLineGroup(ln);
        if (group && group !== lastGroup) {
          lastGroup = group;
          html += '<tr class="dre-group"><td colspan="' + colSpan + '">' + group + '</td></tr>';
        }
        const rowCls = dreRowClass(ln);
        const cells = keys.map((m) => {
          const row = (dreAll[m]?.linhas || []).find((x) => x.id === ln.id);
          if (!row) return '<td class="r td-mute">—</td>';
          return '<td class="r">' + fmtBRL(row.valor) + '</td>';
        }).join('');
        html += '<tr' + (rowCls ? ' class="' + rowCls + '"' : '') + '><td>' + escHtml(ln.label) + '</td>' + cells + '</tr>';
      });
      tbody.innerHTML = html || '<tr><td colspan="' + colSpan + '" class="td-mute">Sem linhas DRE no período</td></tr>';
    }

    const ht = document.getElementById('headerTitle');
    if (ht) ht.innerHTML = 'DRE <span>— ' + UNIT_LABELS[state.unit] + ' · ' + periodTxt + periodContext() + '</span>';

    const labels = keys.map((m) => MONTH_LABELS[m]);
    safeChart('chartDRE', {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [
          { label: 'Receita Bruta', data: keys.map((m) => { const v = dreAll[m]?.receitaBruta; return v != null ? +(v / 1000).toFixed(0) : null; }), backgroundColor: 'rgba(34,163,41,0.6)', borderRadius: 4 },
          { label: 'Lucro Bruto', data: keys.map((m) => { const v = dreAll[m]?.lucroBruto; return v != null ? +(v / 1000).toFixed(0) : null; }), backgroundColor: 'rgba(16,185,129,0.6)', borderRadius: 4 },
          { label: 'Resultado Líquido', data: keys.map((m) => { const v = dreAll[m]?.resultadoLiquido; return v != null ? +(v / 1000).toFixed(0) : null; }), backgroundColor: 'rgba(6,182,212,0.6)', borderRadius: 4 },
        ],
      },
      options: { responsive: true, maintainAspectRatio: false, spanGaps: false, plugins: { legend: leg() } },
    });
    safeChart('chartMargens', {
      type: 'line',
      data: {
        labels: labels,
        datasets: [
          { label: 'Margem Bruta (%)', data: keys.map((m) => dreAll[m]?.margemBruta ?? null), borderColor: PAL[1], borderWidth: 2.5, pointRadius: 5, fill: true, tension: 0.3 },
          { label: 'Margem Líquida (%)', data: keys.map((m) => dreAll[m]?.margemLiquida ?? null), borderColor: PAL[0], borderWidth: 2.5, pointRadius: 5, fill: true, tension: 0.3 },
        ],
      },
      options: { responsive: true, maintainAspectRatio: false, spanGaps: false, plugins: { legend: leg() } },
    });
  }

  function setText(id, text) {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  }

  function dreMonthKeys() {
    if (state.fiscalMode === 'total') return MONTH_KEYS.slice();
    if (state.fiscalMode === 'q1') return Q1_MESES.slice();
    if (state.fiscalMode === 'q2') return Q2_MESES.slice();
    return [state.month];
  }

  function avgDreField(keys, field) {
    const vals = keys.map((m) => D.dre?.porMes?.[m]?.[field]).filter((v) => v != null && !isNaN(v));
    if (!vals.length) return null;
    return vals.reduce((a, b) => a + b, 0) / vals.length;
  }

  function avgOperacionalPct(keys) {
    const pcts = [];
    keys.forEach((m) => {
      const d = D.dre?.porMes?.[m];
      if (!d) return;
      const rb = d.receitaBruta || 0;
      if (!rb) return;
      const op = (d.linhas || []).find((ln) => {
        const u = String(ln.label || '').toUpperCase();
        return u.includes('LUCRO OU PREJU') && u.includes('OPERACIONAL');
      });
      if (op) pcts.push((op.valor / rb) * 100);
    });
    if (!pcts.length) return null;
    return pcts.reduce((a, b) => a + b, 0) / pcts.length;
  }

  function cargaTribPeriod(keys) {
    const fp = getUnitFiscal();
    let rb = 0;
    let ded = 0;
    keys.forEach((m) => {
      const p = fp.porMes[m];
      if (!p) return;
      rb += p.receitaBruta || 0;
      ded += p.deducoes || 0;
    });
    if (rb <= 0) return null;
    return Math.round(ded / rb * 10000) / 100;
  }

  function dreLineGroup(ln) {
    const id = ln.id || '';
    const u = String(ln.label || '').toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    if (id === 'rb' || u === 'RECEITA BRUTA' || u.includes('VENDA DE MERCADORIAS')) return 'Receitas';
    if (id === 'ded_rb' || u.includes('DEDUC') || u.includes('DEVOLUC') || u.includes('(-) ICMS') || u.includes('(-) COFINS') || u.includes('(-) PIS') || u.includes('SUBSTITUICAO')) return 'Deducoes da Receita Bruta';
    if (id === 'rl' || u.includes('RECEITA LIQUIDA')) return null;
    if (id === 'cmv' || id === 'cmv_det' || u.includes('CMV') || u.includes('CUSTOS DAS MERCADORIAS')) return 'Custos';
    if (id === 'lb' || u.includes('LUCRO BRUTO')) return null;
    if (u.includes('DESPESA') || u.includes('RECEITAS FINANCEIRAS') || u.includes('DESPESAS BANC')) return 'Despesas';
    if (u.includes('OUTRAS RECEITAS') || u.includes('BONIFIC') || u.includes('SUBVENC')) return 'Outras Receitas';
    return null;
  }

  function dreRowClass(ln) {
    const id = ln.id || '';
    const u = String(ln.label || '').toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    if (id === 'll' || id === 'll_resumo' || ((u.includes('LUCRO') || u.includes('PREJUIZO')) && u.includes('EXERCICIO') && !u.includes('ANTES') && !u.includes('OPERACIONAL'))) {
      return 'dre-lucro';
    }
    if (id === 'rl' || id === 'lb' || u.startsWith('= ')) return 'dre-total';
    if (u.includes('SUBVENC') || u.includes('BONIFICACAO RECEBIDA')) return 'dre-indent dre-subv';
    if (ln.nivel === 1 || u.startsWith('(-)') || u.startsWith('(+')) {
      return u.startsWith('(-)') || (typeof ln.valor === 'number' && ln.valor < 0) ? 'dre-indent dre-neg' : 'dre-indent';
    }
    if (u.startsWith('(-)') || (typeof ln.valor === 'number' && ln.valor < 0 && !u.startsWith('RECEITA'))) return 'dre-neg';
    return '';
  }

  function initIndicadores() {
    const fp = getUnitFiscal();
    const indSub = document.getElementById('ind-sec-sub');
    const indTitleSmall = document.getElementById('ind-sec-title-small');
    const indMargensNote = document.getElementById('ind-margens-note');
    const trimLabel = TRIMESTRES.q1 && TRIMESTRES.q2
      ? TRIMESTRES.q1.label + ' + ' + TRIMESTRES.q2.label
      : PERIODO_TOTAL.label;
    if (indSub) indSub.textContent = UNIT_LABELS[state.unit] + ' — carga tributária — ' + trimLabel;
    if (indTitleSmall) indTitleSmall.textContent = trimLabel;
    if (indMargensNote) indMargensNote.textContent = 'Margens de Rentabilidade — ' + trimLabel + ' (requer DRE)';
    const indChartMargens = document.getElementById('ind-chart-margens-sub');
    if (indChartMargens) indChartMargens.textContent = trimLabel + ' — margens requerem DRE';

    const cargaS = fp.meses.map((m) => {
      const p = fp.porMes[m];
      return p.receitaBruta > 0 ? Math.round(p.deducoes / p.receitaBruta * 10000) / 100 : 0;
    });
    const firstCarga = cargaS[0] || 0;
    const lastCarga = cargaS[cargaS.length - 1] || 0;
    const cargaDelta = deltaPct(lastCarga, firstCarga);
    const cargaDeltaStr = cargaDelta !== null ? (parseFloat(cargaDelta) >= 0 ? '+' : '') + cargaDelta + ' p.p. Jan→Mai' : '—';

    const vendasTri = fp.meses.reduce((a, m) => a + fp.porMes[m].cfopSaidasTotal, 0);
    const dedTri = fp.meses.reduce((a, m) => a + fp.porMes[m].deducoes, 0);
    const cargaTri = vendasTri > 0 ? Math.round(dedTri / vendasTri * 10000) / 100 : 0;

    const drePorMes = D.dre?.porMes || {};
    const dreOficiais = MONTH_KEYS.filter((m) => drePorMes[m] && !drePorMes[m]._proxy);
    let mbHtml = '<div class="ind-card" style="opacity:.7"><div class="ind-head"><div class="ind-name">Margem Bruta</div></div><div class="ind-val t-muted">N/D</div><div class="ind-formula">Requer DRE / margens</div></div>';
    let mlHtml = '<div class="ind-card" style="opacity:.7"><div class="ind-head"><div class="ind-name">Margem Líquida</div></div><div class="ind-val t-muted">N/D</div><div class="ind-formula">Requer DRE / margens</div></div>';
    if (dreOficiais.length) {
      const lastM = dreOficiais[dreOficiais.length - 1];
      const dLast = drePorMes[lastM];
      const avgMb = dreOficiais.reduce((a, m) => a + (drePorMes[m].margemBruta || 0), 0) / dreOficiais.length;
      const avgMl = dreOficiais.reduce((a, m) => a + (drePorMes[m].margemLiquida || 0), 0) / dreOficiais.length;
      mbHtml = '<div class="ind-card"><div class="ind-head"><div class="ind-name">Margem Bruta</div></div><div class="ind-val">' + avgMb.toFixed(2) + '%</div><div class="ind-formula">Média DRE oficial Abr–Jun · último ' + MONTH_LABELS[lastM] + ': ' + (dLast.margemBruta != null ? dLast.margemBruta + '%' : '—') + '</div></div>';
      mlHtml = '<div class="ind-card"><div class="ind-head"><div class="ind-name">Margem Líquida</div></div><div class="ind-val">' + avgMl.toFixed(2) + '%</div><div class="ind-formula">Média DRE oficial Abr–Jun · último ' + MONTH_LABELS[lastM] + ': ' + (dLast.margemLiquida != null ? dLast.margemLiquida + '%' : '—') + '</div></div>';
      if (indMargensNote) indMargensNote.textContent = 'Margens de Rentabilidade — DRE oficial Abr–Jun / 2026';
      if (indChartMargens) indChartMargens.textContent = trimLabel + ' — margens via DRE oficial (Abr–Jun)';
    }

    const margensGrid = document.getElementById('ind-margens-grid');
    if (margensGrid) {
      margensGrid.innerHTML =
        '<div class="ind-card"><div class="ind-head"><div class="ind-name">Carga Tributária Acum.</div></div><div class="ind-val t-warning">' + cargaTri + '%</div><div class="ind-formula">(PIS+COFINS+ICMS) / Vendas ' + PERIODO_TOTAL.label + '</div><div class="ind-interp">Calculado a partir das planilhas BAIFER extraídas.</div></div>' +
        mbHtml +
        mlHtml +
        '<div class="ind-card"><div class="ind-head"><div class="ind-name">Vendas Acum.</div></div><div class="ind-val t-success">' + fmtBRL(vendasTri, true) + '</div><div class="ind-formula">' + PERIODO_TOTAL.label + ' — saídas contábeis</div></div>' +
        '<div class="ind-card"><div class="ind-head"><div class="ind-name">Variação Carga Jan→Mai</div></div><div class="ind-val t-warning">' + cargaDeltaStr + '</div><div class="ind-formula">' + firstCarga + '% → ' + lastCarga + '% sobre RB</div></div>';
    }

    const cargaGrid = document.getElementById('ind-carga-grid');
    if (cargaGrid) {
      const mm = state.fiscalMode === 'total' ? '05' : state.month;
      const p = fp.porMes[mm];
      const cargaMes = p.receitaBruta > 0 ? Math.round(p.deducoes / p.receitaBruta * 10000) / 100 : 0;
      cargaGrid.innerHTML =
        '<div class="ind-card"><div class="ind-head"><div class="ind-name">Carga ' + MONTH_LABELS[mm] + '/2026</div></div><div class="ind-val t-warning">' + cargaMes + '%</div><div class="ind-formula">Ded ' + fmtBRL(p.deducoes) + ' / RB ' + fmtBRL(p.receitaBruta) + '</div></div>' +
        '<div class="ind-card"><div class="ind-head"><div class="ind-name">Liquidez Corrente</div></div><div class="ind-val t-muted">N/D</div><div class="ind-formula">Requer balancete</div></div>';
    }

    safeChart('chartIndicadores', {
      type: 'bar',
      data: { labels: fp.monthShort, datasets: [{ label: 'Carga %', data: cargaS, backgroundColor: PAL[4], borderRadius: 4 }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { ticks: { callback: (v) => v + '%' } } } },
    });
  }

  function initRecebimentos() { /* placeholder static */ }
  function initBalancete() {
    const meses = D.balancete?.meses || [];
    let balSel = window._balSel || state.month || meses[meses.length - 1];
    renderMesBar('bal-mes-bar', () => { window._balSel = balSel; tabsInit.balancete = false; initBalancete(); });
    const bar = document.getElementById('bal-mes-bar');
    if (bar) {
      bar.querySelectorAll('.mes-btn').forEach((btn) => {
        btn.onclick = () => { window._balSel = btn.dataset.m; balSel = btn.dataset.m; initBalancete(); };
        if (btn.dataset.m === balSel) btn.classList.add('active');
      });
    }
    const data = D.balancete?.porMes?.[balSel];
    const alertEl = document.getElementById('bal-alert');
    if (alertEl) {
      if (data && data._proxyBalancete) {
        alertEl.style.display = 'block';
        alertEl.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Balancete ' + (data.dataRef || '') + ': aguardando Apuração 5005 — exibindo saldos do último mês disponível.';
      } else if (data && data._copiaJan) {
        alertEl.style.display = 'block';
        alertEl.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Balancete Fev–Mai: mesmos saldos de Jan/2026 na planilha (cópia no xlsx).';
      } else {
        alertEl.style.display = 'none';
      }
    }
    if (!data) return;
    const contas = data.contas || [];
    const ativo = contas.filter((c) => c.grupo === 'ativo' && c.nivel <= 2).pop();
    const passivo = contas.filter((c) => c.grupo === 'passivo' && c.nivel <= 2).pop();
    const resultado = contas.filter((c) => c.grupo === 'resultado' && String(c.codigo).startsWith('3')).pop();
    const kpiEl = document.getElementById('bal-kpi-grid');
    if (kpiEl) {
      kpiEl.innerHTML =
        kpiCard('green', 'scale-balanced', '', fmtBRL(ativo?.saldoAtual, true), 'Ativo Total', data.dataRef || '') +
        kpiCard('red', 'landmark', '', fmtBRL(Math.abs(passivo?.saldoAtual || 0), true), 'Passivo Total', '') +
        kpiCard('blue', 'chart-pie', '', fmtBRL(Math.abs((ativo?.saldoAtual || 0) + (passivo?.saldoAtual || 0)), true), 'Patrimônio Líquido', '') +
        kpiCard('yellow', 'coins', '', fmtBRL(resultado?.saldoAtual, true), 'Resultado', '');
    }
    const tbody = document.getElementById('bal-tbody');
    if (tbody) {
      tbody.innerHTML = contas.map((c) =>
        '<tr><td style="padding-left:' + (c.nivel * 12) + 'px">' + c.codigo + '</td><td>' + c.descricao +
        '</td><td class="r">' + fmtBRL(c.saldoAnterior) + '</td><td class="r">' + fmtBRL(c.debito) +
        '</td><td class="r">' + fmtBRL(c.credito) + '</td><td class="r td-val">' + fmtBRL(c.saldoAtual) + '</td></tr>'
      ).join('');
    }
  }

