  function exportExcel(sectionId, filename) {
    const section = document.getElementById(sectionId);
    if (!section || typeof XLSX === 'undefined') return;
    const tables = section.querySelectorAll('table');
    const wb = XLSX.utils.book_new();
    tables.forEach((tbl, i) => {
      XLSX.utils.book_append_sheet(wb, XLSX.utils.table_to_sheet(tbl), 'Sheet' + (i + 1));
    });
    XLSX.writeFile(wb, filename + '.xlsx');
  }

  function exportPDF() { if (typeof exportRelatorioGerencial === 'function') exportRelatorioGerencial(); }

  let activeDrilldownCfop = null;
  let activeFornecedorNome = null;
  let fornecedorSelected = new Set();
  let fornecedorCatalogCache = [];
  let fornecedorSelectionPeriodKey = '';

  function escHtml(v) {
    return String(v || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  }

  function getCfopDados() {
    return getPack().cfopEntradas || [];
  }

  function topCfopForFornecedor(nome) {
    let best = null;
    getCfopDados().forEach((c) => {
      const f = (c.fornecedores || []).find((x) => x.nome === nome);
      if (f && (!best || f.total > best.total)) best = { cfop: c.cfop, total: f.total };
    });
    return best ? best.cfop : '—';
  }

  function dominantUf(ufMap) {
    const entries = Object.entries(ufMap || {}).filter(([k]) => k && k !== '—');
    if (!entries.length) return '—';
    entries.sort((a, b) => b[1] - a[1]);
    return entries[0][0];
  }

  function fornecedorPeriodKey() {
    return state.fiscalMode + '|' + state.month;
  }

  function buildFornecedorCatalog() {
    const map = new Map();
    getCfopDados().forEach((c) => {
      const cfopUf = raw_cfop_uf(c.cfop);
      (c.fornecedores || []).forEach((f) => {
        if (!f.nome) return;
        if (!map.has(f.nome)) {
          map.set(f.nome, { nome: f.nome, total: 0, qtd: 0, cfops: new Set(), ufs: {}, cnpj: f.cnpj || '', uf: f.uf && f.uf !== '—' ? f.uf : '' });
        }
        const entry = map.get(f.nome);
        entry.total += f.total || 0;
        entry.qtd += f.qtd || 0;
        entry.cfops.add(c.cfop);
        entry.ufs[cfopUf] = (entry.ufs[cfopUf] || 0) + (f.total || 0);
        if (f.cnpj && !entry.cnpj) entry.cnpj = f.cnpj;
        if (f.uf && f.uf !== '—') entry.uf = f.uf;
      });
    });
    const packList = getPack().fornecedores || [];
    packList.forEach((f) => {
      if (!f.nome) return;
      if (!map.has(f.nome)) map.set(f.nome, { nome: f.nome, total: f.total || 0, qtd: 0, cfops: new Set(), ufs: {}, cnpj: '', uf: '' });
      else if ((map.get(f.nome).total || 0) < (f.total || 0)) map.get(f.nome).total = f.total;
    });
    return Array.from(map.values()).map((e) => ({
      nome: e.nome,
      total: Math.round(e.total * 100) / 100,
      qtd: e.qtd,
      cfopCount: e.cfops.size,
      topCfop: topCfopForFornecedor(e.nome),
      uf: e.uf || dominantUf(e.ufs),
      cnpj: e.cnpj || '',
    })).sort((a, b) => b.total - a.total);
  }

  function ensureFornecedorSelection(catalog) {
    const key = fornecedorPeriodKey();
    if (key !== fornecedorSelectionPeriodKey) {
      fornecedorSelectionPeriodKey = key;
      fornecedorSelected = new Set(catalog.slice(0, 20).map((f) => f.nome));
    }
    if (!fornecedorSelected.size && catalog.length) {
      fornecedorSelected = new Set(catalog.slice(0, 20).map((f) => f.nome));
    }
    Array.from(fornecedorSelected).forEach((nome) => {
      if (!catalog.find((x) => x.nome === nome)) fornecedorSelected.delete(nome);
    });
  }

  function buildFornecedorRanking() {
    fornecedorCatalogCache = buildFornecedorCatalog();
    ensureFornecedorSelection(fornecedorCatalogCache);
    return fornecedorCatalogCache.filter((f) => fornecedorSelected.has(f.nome));
  }

  function updateFornecedorPickerCount() {
    const el = document.getElementById('forn-picker-count');
    const total = fornecedorCatalogCache.length;
    if (el) el.textContent = fornecedorSelected.size + ' de ' + total + ' selecionados';
  }

  function renderFornecedorPicker() {
    const list = document.getElementById('forn-picker-list');
    if (!list) return;
    fornecedorCatalogCache = buildFornecedorCatalog();
    ensureFornecedorSelection(fornecedorCatalogCache);
    const packTotal = getPack().totalCompras || 1;
    list.innerHTML = fornecedorCatalogCache.map((f) => {
      const checked = fornecedorSelected.has(f.nome) ? ' checked' : '';
      const search = (f.nome + ' ' + (f.cnpj || '') + ' ' + f.uf).toLowerCase();
      const meta = fmtBRL(f.total) + ' · ' + (f.qtd || 0) + ' NFs · ' + f.cfopCount + ' CFOP(s) · UF ' + f.uf;
      return '<label class="supplier-item forn-picker-item" data-search="' + escHtml(search) + '">' +
        '<input type="checkbox" data-nome="' + escHtml(f.nome) + '"' + checked + ' onchange="onFornecedorPickerChange(this)">' +
        '<span class="supplier-info"><strong>' + escHtml(f.nome) + '</strong><small>' + escHtml(meta) +
        (packTotal > 0 ? ' · ' + pct1(f.total, packTotal) + '% das compras' : '') + '</small></span></label>';
    }).join('') || '<p class="td-mute">Nenhum fornecedor no período selecionado.</p>';
    updateFornecedorPickerCount();
    const note = document.getElementById('forn-data-note');
    if (note) {
      note.textContent = 'Fonte: notas de entrada por CFOP (SPED/apuração). Valores somam o contábil do período; até 15 fornecedores por CFOP no ETL. CNPJ/UF aparecem quando disponíveis na planilha.';
    }
  }

  function renderFornecedorStats(ranking) {
    const el = document.getElementById('forn-panel-stats');
    if (!el) return;
    const pack = getPack();
    const totalCompras = pack.totalCompras || 0;
    const selTotal = ranking.reduce((s, f) => s + (f.total || 0), 0);
    const selNfs = ranking.reduce((s, f) => s + (f.qtd || 0), 0);
    const catalogTotal = fornecedorCatalogCache.reduce((s, f) => s + (f.total || 0), 0);
    el.innerHTML =
      '<div class="forn-stat"><div class="lbl">Exibindo</div><div class="val">' + ranking.length + ' fornecedor(es)</div></div>' +
      '<div class="forn-stat"><div class="lbl">Valor selecionado</div><div class="val">' + fmtBRL(selTotal) + '</div></div>' +
      '<div class="forn-stat"><div class="lbl">NFs (selecionados)</div><div class="val">' + selNfs + '</div></div>' +
      '<div class="forn-stat"><div class="lbl">Cobertura vs compras</div><div class="val">' + pct1(selTotal, totalCompras) + '%</div></div>' +
      '<div class="forn-stat"><div class="lbl">Total catalogado</div><div class="val">' + fornecedorCatalogCache.length + ' · ' + fmtBRL(catalogTotal) + '</div></div>';
  }

  function onFornecedorPickerChange(cb) {
    const nome = cb.dataset.nome;
    if (cb.checked) fornecedorSelected.add(nome);
    else {
      fornecedorSelected.delete(nome);
      if (activeFornecedorNome === nome) {
        activeFornecedorNome = null;
        const detail = document.getElementById('fornecedor-detail');
        if (detail) detail.style.display = 'none';
      }
    }
    updateFornecedorPickerCount();
    renderFornecedorRankingTable();
  }

  function toggleAllFornecedorPicker(state) {
    document.querySelectorAll('#forn-picker-list .forn-picker-item').forEach((el) => {
      if (el.style.display === 'none') return;
      const cb = el.querySelector('input');
      if (!cb) return;
      cb.checked = state;
      if (state) fornecedorSelected.add(cb.dataset.nome);
      else fornecedorSelected.delete(cb.dataset.nome);
    });
    if (!state) {
      activeFornecedorNome = null;
      const detail = document.getElementById('fornecedor-detail');
      if (detail) detail.style.display = 'none';
    }
    updateFornecedorPickerCount();
    renderFornecedorRankingTable();
  }

  function selectTopFornecedores(n) {
    fornecedorSelected = new Set(fornecedorCatalogCache.slice(0, n).map((f) => f.nome));
    renderFornecedorPicker();
    renderFornecedorRankingTable();
  }

  function filterFornecedorPicker(query) {
    const q = (query || '').toLowerCase();
    document.querySelectorAll('#forn-picker-list .forn-picker-item').forEach((el) => {
      el.style.display = el.dataset.search.includes(q) ? '' : 'none';
    });
  }

  function toggleFornecedorPicker() {
    const body = document.getElementById('forn-picker-body');
    if (!body) return;
    const open = body.style.display === 'none';
    body.style.display = open ? 'block' : 'none';
    const btn = document.getElementById('forn-picker-toggle');
    if (btn) btn.innerHTML = '<i class="fas fa-list-check"></i> ' + (open ? 'Ocultar lista' : 'Escolher fornecedores');
  }

  function renderFornecedorRankingTable() {
    const pack = getPack();
    const total = pack.totalCompras || 1;
    const ranking = fornecedorCatalogCache.filter((f) => fornecedorSelected.has(f.nome));
    renderFornecedorStats(ranking);
    const tbody = document.getElementById('fornecedor-ranking-tbody');
    if (!tbody) return;
    if (!ranking.length) {
      tbody.innerHTML = '<tr><td colspan="8" class="td-mute">Marque fornecedores na lista acima para exibir o ranking.</td></tr>';
      return;
    }
    tbody.innerHTML = ranking.map((f, i) => {
      const search = (f.nome + ' ' + f.uf + ' ' + f.topCfop).toLowerCase();
      const rowStyle = activeFornecedorNome === f.nome ? ' style="background:rgba(34,163,41,0.08)"' : '';
      return '<tr class="forn-rank-row" data-search="' + escHtml(search) + '" data-nome="' + escHtml(f.nome) + '"' + rowStyle + '>' +
        '<td><span class="rank ' + (i < 3 ? 'g' + (i + 1) : 'gn') + '">' + (i + 1) + '</span></td>' +
        '<td class="fw7">' + escHtml(f.nome) + '</td>' +
        '<td>' + escHtml(f.uf || '—') + '</td>' +
        '<td class="r">' + (f.qtd || 0) + '</td>' +
        '<td class="r">' + f.cfopCount + '</td>' +
        '<td class="r td-val">' + fmtBRL(f.total) + '</td>' +
        '<td>' + pbBar(total > 0 ? f.total / total * 100 : 0) + '</td>' +
        '<td class="r">' + escHtml(f.topCfop || '—') + '</td></tr>';
    }).join('');
    tbody.querySelectorAll('.forn-rank-row').forEach((row) => {
      row.onclick = () => showFornecedorDetail(row.dataset.nome);
    });
    const q = (document.getElementById('forn-search') || {}).value;
    if (q) filterFornecedorPanel(q);
  }

  function isFornecedorPanelOpen() {
    const panel = document.getElementById('fornecedor-panel');
    return panel && panel.style.display !== 'none';
  }

  function setFornecedorPanelBtnActive(active) {
    const btn = document.getElementById('btn-fornecedor-panel');
    if (btn) btn.classList.toggle('fornecedor-panel-active', active);
  }

  function renderFornecedorPanel() {
    fornecedorCatalogCache = buildFornecedorCatalog();
    ensureFornecedorSelection(fornecedorCatalogCache);
    const pack = getPack();
    const total = pack.totalCompras || 1;
    const sub = document.getElementById('forn-panel-sub');
    if (sub) {
      sub.textContent = UNIT_LABEL + ' — ' + periodFull() + periodContext() +
        ' — Total compras ' + fmtBRL(total) + ' — ' + fornecedorCatalogCache.length + ' fornecedores catalogados';
    }
    renderFornecedorPicker();
    renderFornecedorRankingTable();
    if (activeFornecedorNome && fornecedorSelected.has(activeFornecedorNome)) showFornecedorDetail(activeFornecedorNome, true);
    else {
      activeFornecedorNome = null;
      const detail = document.getElementById('fornecedor-detail');
      if (detail) detail.style.display = 'none';
    }
  }

  function showFornecedorDetail(nome, skipScroll) {
    activeFornecedorNome = nome;
    const pack = getPack();
    const totalCompras = pack.totalCompras || 1;
    const catalog = fornecedorCatalogCache.find((f) => f.nome === nome) || {};
    const rows = [];
    let subtotal = 0;
    let totalNfs = 0;
    const finalidades = {};
    getCfopDados().forEach((c) => {
      const f = (c.fornecedores || []).find((x) => x.nome === nome);
      if (f) {
        subtotal += f.total || 0;
        totalNfs += f.qtd || 0;
        const fin = getCfopInfo(c.cfop).finalidade;
        finalidades[fin] = (finalidades[fin] || 0) + (f.total || 0);
        rows.push({
          cfop: c.cfop,
          descricao: getCfopInfo(c.cfop).descricao,
          finalidade: fin,
          qtd: f.qtd || 0,
          total: f.total || 0,
        });
      }
    });
    rows.sort((a, b) => b.total - a.total);
    const title = document.getElementById('forn-detail-title');
    const sub = document.getElementById('forn-detail-sub');
    const meta = document.getElementById('forn-detail-meta');
    if (title) title.textContent = nome;
    if (sub) {
      sub.textContent = 'Subtotal: ' + fmtBRL(subtotal) + ' · ' + totalNfs + ' NFs · ' + rows.length + ' CFOP(s) · ' +
        pct1(subtotal, totalCompras) + '% das compras do período';
    }
    if (meta) {
      const finTxt = Object.entries(finalidades).sort((a, b) => b[1] - a[1]).map(([k, v]) => k + ' ' + fmtBRL(v)).join(' · ');
      meta.textContent = 'UF: ' + (catalog.uf || '—') +
        (catalog.cnpj ? ' · CNPJ: ' + catalog.cnpj : '') +
        (finTxt ? ' · Finalidades: ' + finTxt : '');
    }
    const dtbody = document.getElementById('fornecedor-detail-tbody');
    if (dtbody) {
      dtbody.innerHTML = rows.length ? rows.map((r) =>
        '<tr><td class="fw7">' + escHtml(r.cfop) + '</td><td>' + escHtml(r.descricao) + '</td><td>' + escHtml(r.finalidade) + '</td><td class="r">' + r.qtd +
        '</td><td class="r td-val">' + fmtBRL(r.total) + '</td><td class="r">' + pbBar(subtotal > 0 ? r.total / subtotal * 100 : 0) +
        '</td><td class="r">' + pct1(r.total, totalCompras) + '%</td></tr>'
      ).join('') : '<tr><td colspan="7" class="td-mute">Sem CFOPs para este fornecedor</td></tr>';
    }
    const detail = document.getElementById('fornecedor-detail');
    if (detail) {
      detail.style.display = 'block';
      if (!skipScroll) detail.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
    document.querySelectorAll('#fornecedor-ranking-tbody .forn-rank-row').forEach((row) => {
      row.style.background = row.dataset.nome === nome ? 'rgba(34,163,41,0.08)' : '';
    });
  }

  function toggleFornecedorPanel() {
    const panel = document.getElementById('fornecedor-panel');
    if (!panel) return;
    if (panel.style.display === 'none' || !panel.style.display) {
      panel.style.display = 'block';
      setFornecedorPanelBtnActive(true);
      const search = document.getElementById('forn-search');
      if (search) search.value = '';
      const pickerSearch = document.getElementById('forn-picker-search');
      if (pickerSearch) pickerSearch.value = '';
      renderFornecedorPanel();
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else {
      closeFornecedorPanel();
    }
  }

  function closeFornecedorPanel() {
    const panel = document.getElementById('fornecedor-panel');
    if (panel) panel.style.display = 'none';
    activeFornecedorNome = null;
    const detail = document.getElementById('fornecedor-detail');
    if (detail) detail.style.display = 'none';
    const search = document.getElementById('forn-search');
    if (search) search.value = '';
    const pickerSearch = document.getElementById('forn-picker-search');
    if (pickerSearch) pickerSearch.value = '';
    setFornecedorPanelBtnActive(false);
  }

  function filterFornecedorPanel(query) {
    const q = (query || '').toLowerCase();
    document.querySelectorAll('#fornecedor-ranking-tbody .forn-rank-row').forEach((el) => {
      el.style.display = el.dataset.search.includes(q) ? '' : 'none';
    });
  }


  function getCompanyName() {
    return document.querySelector('.logo-text .company')?.textContent?.trim() || 'DU LANCHE';
  }

  function supplierKey(f) {
    return (f.cnpj && String(f.cnpj).trim()) || f.nome;
  }

  function getSupplierReportPeriodKey() {
    const sel = document.getElementById('supplierReportPeriod');
    return (sel && sel.value) || (state.fiscalMode === 'month' ? state.month : (state.fiscalMode || state.month));
  }

  function getPackForSupplierReport(periodKey) {
    if (periodKey === 'total') return buildFiscalTotalPack();
    if (periodKey === 'q1' || periodKey === 'q2') return buildFiscalTrimPack(periodKey);
    const fp = getUnitFiscal();
    return fp.porMes[periodKey] || null;
  }

  function periodLabelForReport(periodKey) {
    if (periodKey === 'total') return PERIODO_TOTAL.label;
    if (periodKey === 'q1' && TRIMESTRES.q1) return TRIMESTRES.q1.label;
    if (periodKey === 'q2' && TRIMESTRES.q2) return TRIMESTRES.q2.label;
    return (MONTH_LABELS[periodKey] || periodKey) + ' / 2026';
  }

  function hydrateSupplierReportPeriodSelect() {
    const sel = document.getElementById('supplierReportPeriod');
    if (!sel) return;
    let html = '';
    MONTH_KEYS.forEach((m) => {
      html += '<option value="' + m + '">' + MONTH_LABELS[m] + ' / 2026</option>';
    });
    if (TRIMESTRES.q1) html += '<option value="q1">' + TRIMESTRES.q1.label + '</option>';
    if (TRIMESTRES.q2) html += '<option value="q2">' + TRIMESTRES.q2.label + '</option>';
    html += '<option value="total">' + PERIODO_TOTAL.label + '</option>';
    sel.innerHTML = html;
    if (state.fiscalMode === 'month') sel.value = state.month;
    else if (state.fiscalMode === 'q1' || state.fiscalMode === 'q2' || state.fiscalMode === 'total') sel.value = state.fiscalMode;
    else sel.value = state.month;
  }

  function getCfopDadosForPrint() {
    const pack = getPackForSupplierReport(getSupplierReportPeriodKey());
    return (pack && pack.cfopEntradas) || [];
  }

  function collectUniqueSuppliers() {
    const map = new Map();
    getCfopDadosForPrint().forEach((cfop) => {
      (cfop.fornecedores || []).forEach((f) => {
        const key = supplierKey(f);
        if (!key || map.has(key)) return;
        map.set(key, { nome: f.nome, cnpj: f.cnpj || '—', uf: f.uf || '—', key: key });
      });
    });
    return Array.from(map.values()).sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));
  }

  function renderSupplierList() {
    const list = document.getElementById('supplierList');
    if (!list) return;
    const suppliers = collectUniqueSuppliers();
    list.innerHTML = suppliers.map((s) => {
      const search = (s.nome + ' ' + s.cnpj + ' ' + s.uf).toLowerCase();
      return '<label class="supplier-item" data-search="' + escHtml(search) + '">' +
        '<input type="checkbox" value="' + escHtml(s.cnpj) + '" data-key="' + escHtml(s.key) + '" data-nome="' + escHtml(s.nome) + '" data-uf="' + escHtml(s.uf) + '">' +
        '<span class="supplier-info"><strong>' + escHtml(s.nome) + '</strong>' +
        '<small>' + escHtml(s.cnpj) + ' · ' + escHtml(s.uf) + '</small></span></label>';
    }).join('') || '<p class="td-mute" style="padding:16px;">Nenhum fornecedor nesta competência.</p>';
  }

  function rowsForSupplierPrint(cfopDados, key, nome) {
    const rows = [];
    cfopDados.forEach((c) => {
      const f = (c.fornecedores || []).find((x) => supplierKey(x) === key || x.nome === nome);
      if (!f) return;
      let desc = c.descricao || ('CFOP ' + c.cfop);
      let fin = c.finalidade || c.grupo || '—';
      if (typeof cfopDescricaoFromItem === 'function') desc = cfopDescricaoFromItem(c);
      if (typeof cfopFinalidadeFromItem === 'function') fin = cfopFinalidadeFromItem(c);
      else if (typeof cfopGrupoFromItem === 'function') fin = cfopGrupoFromItem(c);
      else if (typeof getCfopInfo === 'function') {
        const info = getCfopInfo(c.cfop);
        desc = info.descricao || desc;
        fin = info.finalidade || info.grupo || fin;
      }
      rows.push({ cfop: c.cfop, desc: desc, fin: fin, qtd: f.qtd || 0, total: f.total || 0 });
    });
    return rows.sort((a, b) => b.total - a.total);
  }

  function aggregateDemaisByCfop(cfopDados, selectedKeys) {
    const map = {};
    cfopDados.forEach((c) => {
      (c.fornecedores || []).forEach((f) => {
        const key = supplierKey(f);
        if (!key || selectedKeys.has(key)) return;
        if (!map[c.cfop]) {
          let desc = c.descricao || ('CFOP ' + c.cfop);
          let fin = c.finalidade || c.grupo || '—';
          if (typeof cfopDescricaoFromItem === 'function') desc = cfopDescricaoFromItem(c);
          if (typeof cfopFinalidadeFromItem === 'function') fin = cfopFinalidadeFromItem(c);
          else if (typeof cfopGrupoFromItem === 'function') fin = cfopGrupoFromItem(c);
          map[c.cfop] = { cfop: c.cfop, desc: desc, fin: fin, qtd: 0, total: 0 };
        }
        map[c.cfop].qtd += f.qtd || 0;
        map[c.cfop].total += f.total || 0;
      });
    });
    return Object.values(map).filter((r) => r.total > 0).sort((a, b) => b.total - a.total);
  }

  function buildModalSupplierReportData() {
    const selected = Array.from(document.querySelectorAll('#supplierList input[type="checkbox"]:checked'));
    const includeDemais = document.getElementById('includeDemaisFornecedores')?.checked;
    if (!selected.length && !includeDemais) {
      return { error: 'Selecione ao menos um fornecedor ou marque "Demais fornecedores".' };
    }
    const periodKey = getSupplierReportPeriodKey();
    const cfopDados = getCfopDadosForPrint();
    if (!cfopDados.length) return { error: 'Sem entradas para a competência selecionada.' };
    const selectedKeys = new Set(selected.map((cb) => cb.dataset.key || cb.dataset.nome || cb.value));
    const suppliers = [];
    let totalGeral = 0;
    selected.forEach((cb) => {
      const key = cb.dataset.key || cb.dataset.nome || cb.value;
      const nome = cb.dataset.nome || '';
      const rows = rowsForSupplierPrint(cfopDados, key, nome);
      const subtotal = rows.reduce((s, r) => s + r.total, 0);
      if (!rows.length) return;
      totalGeral += subtotal;
      suppliers.push({ nome: nome, cnpj: cb.value || '—', uf: cb.dataset.uf || '—', rows: rows, subtotal: subtotal });
    });
    if (includeDemais) {
      const demaisRows = aggregateDemaisByCfop(cfopDados, selectedKeys);
      const subtotal = demaisRows.reduce((s, r) => s + r.total, 0);
      if (demaisRows.length) {
        totalGeral += subtotal;
        suppliers.push({ nome: 'Demais fornecedores', cnpj: '—', uf: '—', rows: demaisRows, subtotal: subtotal });
      }
    }
    if (totalGeral <= 0) {
      return { error: 'Nenhum dado encontrado para os fornecedores selecionados neste período.' };
    }
    let col3 = 'Finalidade';
    if (typeof cfopGrupoFromItem === 'function' && typeof cfopFinalidadeFromItem !== 'function') col3 = 'Grupo';
    return {
      suppliers: suppliers,
      totalGeral: totalGeral,
      companyName: getCompanyName(),
      competencia: periodLabelForReport(periodKey),
      col3Label: col3,
    };
  }

  function openSupplierModal() {
    const modal = document.getElementById('supplierModal');
    if (!modal) { toggleFornecedorPanel(); return; }
    hydrateSupplierReportPeriodSelect();
    renderSupplierList();
    const search = document.getElementById('supplierSearch');
    if (search) search.value = '';
    const demais = document.getElementById('includeDemaisFornecedores');
    if (demais) demais.checked = true;
    modal.style.display = 'flex';
    modal.setAttribute('aria-hidden', 'false');
  }

  function closeSupplierModal() {
    const modal = document.getElementById('supplierModal');
    if (modal) {
      modal.style.display = 'none';
      modal.setAttribute('aria-hidden', 'true');
    }
    const search = document.getElementById('supplierSearch');
    if (search) search.value = '';
  }

  function onSupplierReportPeriodChange() {
    renderSupplierList();
    const search = document.getElementById('supplierSearch');
    if (search) search.value = '';
  }

  function filterSuppliers(q) {
    const term = (q || '').toLowerCase();
    document.querySelectorAll('#supplierList .supplier-item').forEach((el) => {
      if (el.id === 'demaisFornecedoresOption' || el.classList.contains('supplier-item-demais')) return;
      el.style.display = (el.dataset.search || '').includes(term) ? '' : 'none';
    });
  }

  function toggleAllSuppliers(st) {
    document.querySelectorAll('#supplierList .supplier-item input[type="checkbox"]').forEach((cb) => {
      const row = cb.closest('.supplier-item');
      if (row && row.style.display === 'none') return;
      cb.checked = st;
    });
  }

  function printBySupplier() {
    const data = buildModalSupplierReportData();
    if (data.error) { alert(data.error); return; }
    let html = '<div class="supplier-print-root" style="font-family:Inter,sans-serif;padding:0;margin:0;color:#1a1a2e;background:#fff;width:100%;max-width:100%;box-sizing:border-box;">';
    html += '<h1 style="font-size:18px;margin-bottom:4px;">Relatório por Fornecedor</h1>';
    html += '<p style="font-size:12px;color:#555;margin-bottom:24px;">' +
      escHtml(data.companyName) + ' — Competência ' + escHtml(data.competencia) + ' — ' +
      new Date().toLocaleDateString('pt-BR') + '</p>';
    data.suppliers.forEach((s) => {
      html += '<div class="supplier-print-block" style="margin-bottom:12px;page-break-inside:auto;width:100%;max-width:100%;box-sizing:border-box;">';
      html += '<h2 style="font-size:14px;border-bottom:2px solid #22a329;padding-bottom:6px;">' + escHtml(s.nome) + '</h2>';
      html += '<p style="font-size:11px;color:#555;">CNPJ: ' + escHtml(s.cnpj) + ' · UF: ' + escHtml(s.uf) + '</p>';
      html += '<table style="width:100%;max-width:100%;border-collapse:collapse;margin-top:8px;font-size:10px;table-layout:fixed;"><colgroup><col class="cfop"><col class="desc"><col class="fin"><col class="qtd"><col class="val"></colgroup>';
      html += '<thead><tr style="background:#f0f0f0;"><th style="padding:4px 5px;text-align:left;">CFOP</th>';
      html += '<th style="padding:4px 5px;text-align:left;">Descrição</th><th style="padding:4px 5px;text-align:left;">' + escHtml(data.col3Label) + '</th>';
      html += '<th style="padding:4px 5px;text-align:right;">Qtd NFs</th><th style="padding:4px 5px;text-align:right;">Valor (R$)</th></tr></thead><tbody>';
      s.rows.forEach((r) => {
        html += '<tr><td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;">' + escHtml(r.cfop) + '</td>';
        html += '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;">' + escHtml(r.desc) + '</td>';
        html += '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;">' + escHtml(r.fin) + '</td>';
        html += '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;text-align:right;">' + r.qtd + '</td>';
        html += '<td style="padding:4px 5px;border-bottom:1px solid #ddd;word-wrap:break-word;text-align:right;font-weight:600;">' +
          r.total.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</td></tr>';
      });
      html += '</tbody><tfoot><tr><td colspan="4" style="padding:6px 5px;text-align:right;font-weight:700;">Subtotal:</td>';
      html += '<td style="padding:6px 5px;text-align:right;font-weight:700;">R$ ' +
        s.subtotal.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</td></tr></tfoot></table></div>';
    });
    html += '<div style="border-top:2px solid #1a1a2e;padding-top:12px;margin-top:16px;text-align:right;font-size:14px;font-weight:700;">';
    html += 'Total Geral: R$ ' + data.totalGeral.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + '</div></div>';
    closeSupplierModal();
    const old = document.getElementById('print-supplier-report');
    if (old) old.remove();
    const div = document.createElement('div');
    div.id = 'print-supplier-report';
    div.innerHTML = html;
    document.body.appendChild(div);
    document.body.classList.add('supplier-printing');
    const cleanup = () => {
      document.body.classList.remove('supplier-printing');
      div.remove();
      window.removeEventListener('afterprint', cleanup);
    };
    window.addEventListener('afterprint', cleanup);
    window.print();
  }

  function exportSupplierPdf() {
    const data = buildModalSupplierReportData();
    if (data.error) { alert(data.error); return; }
    if (!window.jspdf || !window.jspdf.jsPDF) {
      alert('Biblioteca jsPDF nao carregada.');
      return;
    }
    if (typeof window.jspdf.jsPDF.prototype.autoTable !== 'function') {
      alert('Biblioteca jspdf-autotable nao carregada.');
      return;
    }
    closeSupplierModal();
    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
    const margin = 14;
    const pageH = pdf.internal.pageSize.getHeight();
    let y = margin;
    const fmtBrl = (v) => 'R$ ' + Number(v).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const ensureSpace = (need) => {
      if (y + need > pageH - margin) { pdf.addPage(); y = margin; }
    };
    pdf.setFont('helvetica', 'bold');
    pdf.setFontSize(14);
    pdf.text('Relatorio por Fornecedor', margin, y);
    y += 7;
    pdf.setFont('helvetica', 'normal');
    pdf.setFontSize(9);
    pdf.setTextColor(80, 80, 80);
    pdf.text(data.companyName + ' — Competencia ' + data.competencia + ' — ' + new Date().toLocaleDateString('pt-BR'), margin, y);
    y += 10;
    pdf.setTextColor(0, 0, 0);
    data.suppliers.forEach((s) => {
      ensureSpace(20);
      pdf.setFont('helvetica', 'bold');
      pdf.setFontSize(11);
      pdf.text(String(s.nome || '').slice(0, 90), margin, y);
      y += 5;
      pdf.setFont('helvetica', 'normal');
      pdf.setFontSize(8);
      pdf.setTextColor(100, 100, 100);
      pdf.text('CNPJ: ' + s.cnpj + ' · UF: ' + s.uf, margin, y);
      y += 4;
      pdf.setTextColor(0, 0, 0);
      pdf.autoTable({
        startY: y,
        margin: { left: margin, right: margin },
        tableWidth: 'auto',
        head: [['CFOP', 'Descricao', data.col3Label, 'Qtd NFs', 'Valor (R$)']],
        body: s.rows.map((r) => [r.cfop, r.desc, r.fin, String(r.qtd), fmtBrl(r.total)]),
        foot: [['', '', '', 'Subtotal:', fmtBrl(s.subtotal)]],
        styles: { fontSize: 7, cellPadding: 1.5, overflow: 'linebreak' },
        headStyles: { fillColor: [34, 163, 41], textColor: 255 },
        footStyles: { fillColor: [241, 245, 249], textColor: [30, 41, 59], fontStyle: 'bold' },
        columnStyles: { 3: { halign: 'right' }, 4: { halign: 'right' } },
      });
      y = pdf.lastAutoTable.finalY + 8;
    });
    ensureSpace(12);
    pdf.setFont('helvetica', 'bold');
    pdf.setFontSize(11);
    pdf.text('Total Geral: ' + fmtBrl(data.totalGeral), margin, y);
    const safe = String(data.companyName || 'empresa').slice(0, 24).replace(/[\/:*?"<>|]/g, '');
    pdf.save('relatorio-fornecedor-' + safe + '.pdf');
  }

  function closeDrilldown() {
    const panel = document.getElementById('drilldown-panel');
    if (panel) panel.style.display = 'none';
    activeDrilldownCfop = null;
  }

  function openDrilldown(cfop) {
    if (activeDrilldownCfop === cfop) { closeDrilldown(); return; }
    activeDrilldownCfop = cfop;
    const item = getCfopDados().find((d) => d.cfop === cfop);
    const info = getCfopInfo(cfop);
    if (!item) return;
    const totalCfop = item.total || 0;
    const ddTitle = document.getElementById('dd-title');
    const ddSub = document.getElementById('dd-sub');
    if (ddTitle) ddTitle.textContent = 'CFOP ' + cfop + ' — ' + info.descricao;
    if (ddSub) ddSub.textContent = 'Finalidade: ' + info.finalidade + ' | Total: ' + fmtBRL(totalCfop) + ' | ' + (item.qtd || 0) + ' NFs';
    const tbody = document.getElementById('dd-tbody');
    if (tbody) {
      const forn = item.fornecedores || [];
      tbody.innerHTML = forn.length ? forn.map((f, i) =>
        '<tr><td>' + (i + 1) + '</td><td><div class="fw7">' + escHtml(f.nome) + '</div></td><td><span class="td-mute">' + escHtml(f.cnpj || '—') + '</span></td>' +
        '<td>' + escHtml(f.uf || '—') + '</td><td class="r">' + (f.qtd || 0) + '</td><td class="r td-val">' + fmtBRL(f.total) + '</td>' +
        '<td class="r">' + pbBar(totalCfop > 0 ? f.total / totalCfop * 100 : 0) + '</td></tr>'
      ).join('') : '<tr><td colspan="7" class="td-mute">Sem fornecedores detalhados neste CFOP</td></tr>';
    }
    const panel = document.getElementById('drilldown-panel');
    if (panel) {
      panel.style.display = 'block';
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  window.showTab = showTab;
  window.toggleSidebar = toggleSidebar;
  window.closeMob = closeMob;
  window.onFilterChange = onFilterChange;
  window.exportExcel = exportExcel;
  window.exportPDF = exportPDF;
  window.validateComprasPack = validateComprasPack;
  window.validateApuracaoPack = validateApuracaoPack;
  window.buildFiscalTotalPack = buildFiscalTotalPack;
  window.openSupplierModal = openSupplierModal;
  window.closeSupplierModal = closeSupplierModal;
  window.onSupplierReportPeriodChange = onSupplierReportPeriodChange;
  window.filterSuppliers = filterSuppliers;
  window.toggleAllSuppliers = toggleAllSuppliers;
  window.printBySupplier = printBySupplier;
  window.exportSupplierPdf = exportSupplierPdf;
  window.toggleFornecedorPanel = toggleFornecedorPanel;
  window.closeFornecedorPanel = closeFornecedorPanel;
  window.filterFornecedorPanel = filterFornecedorPanel;
  window.filterFornecedorPicker = filterFornecedorPicker;
  window.toggleFornecedorPicker = toggleFornecedorPicker;
  window.toggleAllFornecedorPicker = toggleAllFornecedorPicker;
  window.selectTopFornecedores = selectTopFornecedores;
  window.onFornecedorPickerChange = onFornecedorPickerChange;
  window.showFornecedorDetail = showFornecedorDetail;
  window.openDrilldown = openDrilldown;
  window.closeDrilldown = closeDrilldown;

  document.addEventListener('DOMContentLoaded', () => {
    hydrateStatic();
    showTab('visao-geral');
  });
})();

</script>
<script>
/* Relatório Gerencial PDF — DU LANCHE (descrições CFOP via mapa oficial) */
function exportRelatorioGerencial() {
  if (typeof DASHBOARD_DATA === 'undefined' || typeof jspdf === 'undefined') {
    alert('Dados ou jsPDF não carregados.');
    return;
  }
  const D = DASHBOARD_DATA;
  const catalog = D.cfopFinalidade || {};
  const mm = D.competencia.split('-')[1];
  const pack = D.fiscalPorMes.porMes[mm] || D.fiscalPorMes.porMes[D.meta.meses[D.meta.meses.length - 1]];
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });

  function cfopDesc(c) {
    const fromMap = catalog[c.cfop] || catalog[String(c.cfop || '').replace(/-/g, '')];
    return (fromMap && fromMap.descricao) || c.descricao || ('CFOP ' + c.cfop);
  }

  function cfopFin(c) {
    const fromMap = catalog[c.cfop] || catalog[String(c.cfop || '').replace(/-/g, '')];
    return (fromMap && fromMap.finalidade) || c.finalidade || '—';
  }

  doc.setFontSize(18);
  doc.text('Relatório Gerencial — DU LANCHE', 14, 20);
  doc.setFontSize(11);
  doc.text(D.empresa.nome, 14, 28);
  doc.text('CNPJ: ' + D.empresa.cnpj, 14, 34);
  doc.text('Competência: ' + D.competenciaLabel, 14, 40);
  doc.text('Gerado em: ' + new Date().toLocaleDateString('pt-BR'), 14, 46);

  doc.setFontSize(13);
  doc.text('Visão Geral — KPIs', 14, 58);
  const kpis = [
    ['Receita Bruta', 'R$ ' + pack.receitaBruta.toLocaleString('pt-BR', { minimumFractionDigits: 2 })],
    ['Total Compras', 'R$ ' + pack.totalCompras.toLocaleString('pt-BR', { minimumFractionDigits: 2 })],
    ['Deduções Tributárias', 'R$ ' + pack.deducoes.toLocaleString('pt-BR', { minimumFractionDigits: 2 })],
    ['% sobre RB', pack.dedPct + '%'],
  ];
  doc.autoTable({ startY: 62, head: [['Indicador', 'Valor']], body: kpis, theme: 'grid', styles: { fontSize: 10 } });

  doc.text('Impostos a Recolher', 14, doc.lastAutoTable.finalY + 12);
  const impBody = pack.impostosTabela.map((r) => [r.tributo, 'R$ ' + r.recolher.toLocaleString('pt-BR', { minimumFractionDigits: 2 }), r.pctRb + '%']);
  doc.autoTable({ startY: doc.lastAutoTable.finalY + 16, head: [['Tributo', 'A Recolher', '% RB']], body: impBody, theme: 'striped', styles: { fontSize: 9 } });

  if (pack.cfopEntradas && pack.cfopEntradas.length) {
    doc.addPage();
    doc.setFontSize(13);
    doc.text('Top CFOPs — Entradas', 14, 20);
    doc.autoTable({
      startY: 24,
      head: [['CFOP', 'Descrição', 'Finalidade', 'Valor']],
      body: pack.cfopEntradas.slice(0, 15).map((c) => [
        c.cfop,
        cfopDesc(c).slice(0, 48),
        cfopFin(c).slice(0, 22),
        'R$ ' + (c.total || c.contabil || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }),
      ]),
      styles: { fontSize: 7 },
      columnStyles: { 1: { cellWidth: 70 }, 2: { cellWidth: 35 } },
    });
  }

  if (pack.cfopSaidas && pack.cfopSaidas.length) {
    doc.addPage();
    doc.setFontSize(13);
    doc.text('Top CFOPs — Saídas', 14, 20);
    doc.autoTable({
      startY: 24,
      head: [['CFOP', 'Descrição', 'Valor']],
      body: pack.cfopSaidas.slice(0, 15).map((c) => [
        c.cfop,
        cfopDesc(c).slice(0, 55),
        'R$ ' + (c.total || c.contabil || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }),
      ]),
      styles: { fontSize: 8 },
    });
  }

  if (pack.sped && pack.sped.clientes && pack.sped.clientes.length) {
    doc.text('Top Clientes', 14, doc.lastAutoTable.finalY + 12);
    doc.autoTable({
      startY: doc.lastAutoTable.finalY + 16,
      head: [['Cliente', 'Total']],
      body: pack.sped.clientes.slice(0, 10).map((c) => [c.nome.slice(0, 45), 'R$ ' + c.total.toLocaleString('pt-BR', { minimumFractionDigits: 2 })]),
      styles: { fontSize: 8 },
    });
  }

  doc.save('Relatorio_Gerencial — ' + D.empresa.nome.slice(0, 20) + ' — ' + D.competenciaLabel + '.pdf');
}

</script>
<div id="print-supplier-report"></div>
</body>
