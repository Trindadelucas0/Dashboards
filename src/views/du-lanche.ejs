  function initCompras() {
    const pack = getPack();
    renderMesBar('cp-mes-bar', () => { tabsInit.compras = false; initCompras(); });
    const v = validateComprasPack(pack);
    setFiscalDataStatus('cp-data-status', v, 'Conferência OK — CFOPs = total compras', 'Divergência: CFOPs ' + fmt(v.sum) + ' vs total ' + fmt(v.total));

    const top = pack.cfopEntradas[0];
    const forn = pack.fornecedores || [];
    const topForn = forn[0];
    const concForn = topForn && pack.totalCompras ? ((topForn.total / pack.totalCompras) * 100).toFixed(1) + '%' : '—';
    document.getElementById('cp-kpi-grid').innerHTML =
      kpiCard('green', 'cart-shopping', '', fmtBRL(pack.totalCompras, true), 'Total de Compras', monthDeltaStr((p) => p.totalCompras, pack.totalCompras)) +
      kpiCard('cyan', 'file-lines', '', top ? top.cfop : '—', 'Maior CFOP entrada', top ? fmtBRL(top.total) : '') +
      kpiCard('orange', 'tags', '', pack.cfopEntradas.length, 'CFOPs distintos', '') +
      kpiCard('blue', 'truck', '', forn.length, 'Fornecedores distintos', '') +
      kpiCard('purple', 'chart-pie', '', concForn, 'Concentração top fornecedor', topForn ? topForn.nome.slice(0, 28) : '');

    const fp = getUnitFiscal();
    const comprasEv = fp.meses.map((m) => fp.porMes[m].totalCompras / 1000);
    const comprasMom = fp.meses.map((m, i) => {
      if (i === 0) return null;
      const prev = fp.porMes[fp.meses[i - 1]].totalCompras;
      const curr = fp.porMes[m].totalCompras;
      return prev ? Math.round((curr - prev) / prev * 1000) / 10 : null;
    });
    safeChart('chartComprasEv', {
      type: 'line',
      data: {
        labels: fp.monthShort,
        datasets: [
          { label: 'Compras (R$ mil)', data: comprasEv, borderColor: PAL[0], tension: 0.3, yAxisID: 'y' },
          { label: 'Var. % MoM', data: comprasMom, borderColor: PAL[2], borderDash: [4, 4], tension: 0.3, yAxisID: 'y1' },
        ],
      },
      options: {
        responsive: true, maintainAspectRatio: false, plugins: { legend: leg() },
        scales: {
          y: { ticks: { callback: (v) => 'R$' + v + 'K' } },
          y1: { position: 'right', grid: { drawOnChartArea: false }, ticks: { callback: (v) => v + '%' } },
        },
      },
    });

    const fornChart = forn;
    safeChart('chartFornecedores', {
      type: 'bar',
      data: { labels: fornChart.slice(0, 8).map((f) => f.nome.slice(0, 22)), datasets: [{ data: fornChart.slice(0, 8).map((f) => f.total / 1000), backgroundColor: PAL[4], borderRadius: 4 }] },
      options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } },
    });

    const ufMap = {};
    pack.cfopEntradas.forEach((c) => {
      const uf = raw_cfop_uf(c.cfop);
      ufMap[uf] = (ufMap[uf] || 0) + c.total;
    });
    const ufs = Object.entries(ufMap).sort((a, b) => b[1] - a[1]).slice(0, 10);
    safeChart('chartComprasUF', {
      type: 'bar',
      data: { labels: ufs.map((u) => u[0]), datasets: [{ data: ufs.map((u) => u[1] / 1000), backgroundColor: PAL[5], borderRadius: 4 }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } },
    });

    const tbody = document.getElementById('compras-ranking-tbody');
    if (tbody) {
      const max = pack.totalCompras || 1;
      const fornList = forn.slice(0, 15);
      tbody.innerHTML = fornList.map((f, i) =>
        '<tr><td><span class="rank ' + (i < 3 ? 'g' + (i + 1) : 'gn') + '">' + (i + 1) + '</span></td><td>' + escHtml(f.nome) +
        '</td><td>—</td><td class="r td-val">' + fmtBRL(f.total) + '</td><td>' + pbBar(f.total / max * 100) + '</td><td class="r">' + topCfopForFornecedor(f.nome) + '</td></tr>'
      ).join('') || '<tr><td colspan="6" class="td-mute">Sem fornecedores no período</td></tr>';
    }
  }

  function raw_cfop_uf(cfop) {
    const c = cfop.replace('-', '')[0];
    const map = { '1': 'PR', '2': 'BR', '5': 'PR', '6': 'BR' };
    return map[c] || '—';
  }

  function initFinalidade() {
    const pack = getPack();
    renderMesBar('fn-mes-bar', () => { tabsInit.finalidade = false; initFinalidade(); });

    const v = validateComprasPack(pack);
    setFiscalDataStatus(
      'fn-data-status',
      v,
      'Conferência OK — CFOPs = total compras (' + v.n + ' CFOPs)',
      'Divergência: CFOPs ' + fmtBRL(v.sum) + ' vs total ' + fmtBRL(v.total)
    );

    const compEl = document.getElementById('fn-sec-competencia');
    if (compEl) compEl.textContent = periodFull() + ' — por CFOP';
    const finSub = document.getElementById('fin-sec-sub');
    if (finSub) finSub.textContent = UNIT_LABEL + ' — classificação fiscal das entradas' + periodContext();

    const total = pack.totalCompras || 1;
    const tops = topFinalidades(pack.cfopEntradas, 4);
    const finGrid = document.getElementById('fin-kpi-grid');
    if (finGrid) {
      finGrid.innerHTML = tops.map(([fin, val], i) => {
        const cor = ['green', 'cyan', 'orange', 'purple'][i] || 'blue';
        return kpiCard(cor, 'layer-group', periodLbl(), fmtBRL(val, true), fin, pct1(val, total) + '% do total');
      }).join('') || kpiCard('blue', 'info-circle', '', '—', 'Sem entradas', '');
    }

    const finDistSub = document.getElementById('fn-chart-dist-sub');
    const finBarSub = document.getElementById('fn-chart-bar-sub');
    if (finDistSub) finDistSub.textContent = '% do valor total de entradas — ' + periodFull() + ' (' + fmtBRL(total) + ')';
    if (finBarSub) finBarSub.textContent = 'Comparativo dos grupos fiscais — ' + periodFull();

    const grupos = {};
    (pack.cfopEntradas || []).forEach((c) => {
      const fin = cfopFinalidadeFromItem(c);
      grupos[fin] = (grupos[fin] || 0) + c.total;
    });
    const labels = Object.keys(grupos).sort((a, b) => grupos[b] - grupos[a]);
    const vals = labels.map((k) => grupos[k]);
    const cores = labels.map((k) => FINALIDADE_CORES[k] || '#64748b');

    safeChart('chartFinalidadeDist', { type: 'doughnut', data: { labels, datasets: [{ data: vals, backgroundColor: cores }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right' } } } });
    safeChart('chartFinalidadeBar', { type: 'bar', data: { labels, datasets: [{ data: vals.map((v) => v / 1000), backgroundColor: cores, borderRadius: 4 }] }, options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } } });

    const tbody = document.getElementById('cfop-tbody');
    if (tbody) {
      const totalCf = pack.totalCompras || 1;
      const sorted = (pack.cfopEntradas || []).slice().sort((a, b) => (b.total || 0) - (a.total || 0));
      tbody.innerHTML = sorted.map((c) => {
        const fin = cfopFinalidadeFromItem(c);
        const desc = cfopDescricaoFromItem(c);
        const cor = FINALIDADE_CORES[fin] || '#64748b';
        const cred = cfopCreditoFromItem(c);
        const credChip = cred
          ? '<span class="chip gr"><i class="fas fa-check"></i> Sim</span>'
          : '<span class="chip rd"><i class="fas fa-times"></i> Não</span>';
        const p = pct1(c.total, totalCf);
        return '<tr><td><span class="chip" style="font-family:monospace;font-weight:700">' + c.cfop + '</span></td><td style="font-size:12px;color:var(--text-sec)">' + escHtml(desc) +
          '</td><td><span class="chip" style="background:' + cor + '22;color:' + cor + '">' + escHtml(fin) + '</span></td>' +
          '<td>' + credChip + '</td><td class="r">' + (c.qtd || 0) + '</td>' +
          '<td class="r td-val">' + fmtBRL(c.total) + '</td><td class="r">' + pbBar(p) + '</td>' +
          '<td class="c"><button type="button" onclick="openDrilldown(\'' + c.cfop.replace(/'/g, "\\'") + '\')" style="background:var(--bg-card-hover);border:1px solid var(--border);color:var(--accent);padding:4px 10px;border-radius:6px;cursor:pointer;font-size:11px;">Detalhes</button></td></tr>';
      }).join('') || '<tr><td colspan="8" class="td-mute">Sem entradas no período</td></tr>';
    }

    if (isFornecedorPanelOpen()) renderFornecedorPanel();
  }

