    if (sec) sec.classList.add('active');
    if (nav) nav.classList.add('active');
    const h = tabTitles[name] || ['Dashboard',''];
    document.getElementById('headerTitle').innerHTML = h[0] + ' <span>' + h[1] + '</span>';
