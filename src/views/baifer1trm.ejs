  function initDRE() {
    const grid = document.getElementById('dre-margin-grid');
    const tbody = document.getElementById('dre-tbody');
    const dreSub = document.getElementById('dre-sec-sub');
    if (dreSub) dreSub.textContent = UNIT_LABELS[state.unit] + ' — ' + PERIODO_TOTAL.label;
    if (!grid) return;
    const dre = D.dre?.porMes || {};
    if (D.pendentes.dre && !D.dre?._proxy) {
      grid.innerHTML = '<div class="placeholder-card" style="grid-column:1/-1;text-align:center;padding:40px;color:var(--text-muted)"><i class="fas fa-clock"></i> DRE pendente — sem planilha DRE nas pastas BAIFER</div>';
      if (tbody) tbody.innerHTML = '<tr><td colspan="' + (MONTH_KEYS.length + 1) + '" class="td-mute">Sem DRE — aguardando planilha contábil</td></tr>';
      return;
    }
    grid.innerHTML = MONTH_KEYS.map((m) => {
      const d = dre[m] || {};
      return '<div class="margin-card"><div class="margin-val">' + (d.margemBruta != null ? d.margemBruta + '%' : '—') + '</div><div class="margin-lbl">Margem bruta ' + MONTH_LABELS[m] + (D.dre._proxy ? ' (proxy)' : '') + '</div></div>';
    }).join('');
    if (tbody && dre[MONTH_KEYS[0]]) {
      const linhas = dre[MONTH_KEYS[0]].linhas || [];
      tbody.innerHTML = linhas.map((ln) => {
        const cells = MONTH_KEYS.map((m) => {
          const row = (dre[m]?.linhas || []).find((x) => x.id === ln.id);
          return '<td class="r">' + fmtBRL(row ? row.valor : 0) + '</td>';
        }).join('');
        return '<tr><td>' + ln.label + '</td>' + cells + '</tr>';
      }).join('');
    }
  }

  function initIndicadores() {
    const fp = getUnitFiscal();
    const indSub = document.getElementById('ind-sec-sub');
    const indTitleSmall = document.getElementById('ind-sec-title-small');
    const indMargensNote = document.getElementById('ind-margens-note');
    const trimLabel = TRIMESTRES.q1 && TRIMESTRES.q2
      ? TRIMESTRES.q1.label + ' + ' + TRIMESTRES.q2.label
      : PERIODO_TOTAL.label;
    if (indSub) indSub.textContent = UNIT_LABELS[state.unit] + ' — carga tributária — ' + trimLabel;
    if (indTitleSmall) indTitleSmall.textContent = trimLabel;
    if (indMargensNote) indMargensNote.textContent = 'Margens de Rentabilidade — ' + trimLabel + ' (requer DRE)';
    const indChartMargens = document.getElementById('ind-chart-margens-sub');
    if (indChartMargens) indChartMargens.textContent = trimLabel + ' — margens requerem DRE';

    const cargaS = fp.meses.map((m) => {
      const p = fp.porMes[m];
      return p.receitaBruta > 0 ? Math.round(p.deducoes / p.receitaBruta * 10000) / 100 : 0;
    });
    const firstCarga = cargaS[0] || 0;
    const lastCarga = cargaS[cargaS.length - 1] || 0;
    const cargaDelta = deltaPct(lastCarga, firstCarga);
    const cargaDeltaStr = cargaDelta !== null ? (parseFloat(cargaDelta) >= 0 ? '+' : '') + cargaDelta + ' p.p. Jan→Mai' : '—';

    const vendasTri = fp.meses.reduce((a, m) => a + fp.porMes[m].cfopSaidasTotal, 0);
    const dedTri = fp.meses.reduce((a, m) => a + fp.porMes[m].deducoes, 0);
    const cargaTri = vendasTri > 0 ? Math.round(dedTri / vendasTri * 10000) / 100 : 0;

    const margensGrid = document.getElementById('ind-margens-grid');
    if (margensGrid) {
      margensGrid.innerHTML =
        '<div class="ind-card"><div class="ind-head"><div class="ind-name">Carga Tributária Acum.</div></div><div class="ind-val t-warning">' + cargaTri + '%</div><div class="ind-formula">(PIS+COFINS+ICMS) / Vendas ' + PERIODO_TOTAL.label + '</div><div class="ind-interp">Calculado a partir das planilhas BAIFER extraídas.</div></div>' +
        '<div class="ind-card" style="opacity:.7"><div class="ind-head"><div class="ind-name">Margem Bruta</div></div><div class="ind-val t-muted">N/D</div><div class="ind-formula">Requer DRE / margens</div></div>' +
        '<div class="ind-card" style="opacity:.7"><div class="ind-head"><div class="ind-name">Margem Líquida</div></div><div class="ind-val t-muted">N/D</div><div class="ind-formula">Requer DRE / margens</div></div>' +
        '<div class="ind-card"><div class="ind-head"><div class="ind-name">Vendas Acum.</div></div><div class="ind-val t-success">' + fmtBRL(vendasTri, true) + '</div><div class="ind-formula">' + PERIODO_TOTAL.label + ' — saídas contábeis</div></div>' +
        '<div class="ind-card"><div class="ind-head"><div class="ind-name">Variação Carga Jan→Mai</div></div><div class="ind-val t-warning">' + cargaDeltaStr + '</div><div class="ind-formula">' + firstCarga + '% → ' + lastCarga + '% sobre RB</div></div>';
    }

    const cargaGrid = document.getElementById('ind-carga-grid');
    if (cargaGrid) {
      const mm = state.fiscalMode === 'total' ? '05' : state.month;
      const p = fp.porMes[mm];
      const cargaMes = p.receitaBruta > 0 ? Math.round(p.deducoes / p.receitaBruta * 10000) / 100 : 0;
      cargaGrid.innerHTML =
        '<div class="ind-card"><div class="ind-head"><div class="ind-name">Carga ' + MONTH_LABELS[mm] + '/2026</div></div><div class="ind-val t-warning">' + cargaMes + '%</div><div class="ind-formula">Ded ' + fmtBRL(p.deducoes) + ' / RB ' + fmtBRL(p.receitaBruta) + '</div></div>' +
        '<div class="ind-card"><div class="ind-head"><div class="ind-name">Liquidez Corrente</div></div><div class="ind-val t-muted">N/D</div><div class="ind-formula">Requer balancete</div></div>';
    }

    safeChart('chartIndicadores', {
      type: 'bar',
      data: { labels: fp.monthShort, datasets: [{ label: 'Carga %', data: cargaS, backgroundColor: PAL[4], borderRadius: 4 }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { ticks: { callback: (v) => v + '%' } } } },
    });
  }

  function initRecebimentos() { /* placeholder static */ }
  function initBalancete() {
    const meses = D.balancete?.meses || [];
    let balSel = window._balSel || state.month || meses[meses.length - 1];
    renderMesBar('bal-mes-bar', () => { window._balSel = balSel; tabsInit.balancete = false; initBalancete(); });
    const bar = document.getElementById('bal-mes-bar');
    if (bar) {
      bar.querySelectorAll('.mes-btn').forEach((btn) => {
        btn.onclick = () => { window._balSel = btn.dataset.m; balSel = btn.dataset.m; initBalancete(); };
        if (btn.dataset.m === balSel) btn.classList.add('active');
      });
    }
    const data = D.balancete?.porMes?.[balSel];
    const alertEl = document.getElementById('bal-alert');
    if (alertEl) {
      if (data && data._proxyBalancete) {
        alertEl.style.display = 'block';
        alertEl.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Balancete ' + (data.dataRef || '') + ': aguardando Apuração 5005 — exibindo saldos do último mês disponível.';
      } else if (data && data._copiaJan) {
        alertEl.style.display = 'block';
        alertEl.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Balancete Fev–Mai: mesmos saldos de Jan/2026 na planilha (cópia no xlsx).';
      } else {
        alertEl.style.display = 'none';
      }
    }
    if (!data) return;
    const contas = data.contas || [];
    const ativo = contas.filter((c) => c.grupo === 'ativo' && c.nivel <= 2).pop();
    const passivo = contas.filter((c) => c.grupo === 'passivo' && c.nivel <= 2).pop();
    const resultado = contas.filter((c) => c.grupo === 'resultado' && String(c.codigo).startsWith('3')).pop();
    const kpiEl = document.getElementById('bal-kpi-grid');
    if (kpiEl) {
      kpiEl.innerHTML =
        kpiCard('green', 'scale-balanced', '', fmtBRL(ativo?.saldoAtual, true), 'Ativo Total', data.dataRef || '') +
        kpiCard('red', 'landmark', '', fmtBRL(Math.abs(passivo?.saldoAtual || 0), true), 'Passivo Total', '') +
        kpiCard('blue', 'chart-pie', '', fmtBRL(Math.abs((ativo?.saldoAtual || 0) + (passivo?.saldoAtual || 0)), true), 'Patrimônio Líquido', '') +
        kpiCard('yellow', 'coins', '', fmtBRL(resultado?.saldoAtual, true), 'Resultado', '');
    }
    const tbody = document.getElementById('bal-tbody');
    if (tbody) {
      tbody.innerHTML = contas.map((c) =>
        '<tr><td style="padding-left:' + (c.nivel * 12) + 'px">' + c.codigo + '</td><td>' + c.descricao +
        '</td><td class="r">' + fmtBRL(c.saldoAnterior) + '</td><td class="r">' + fmtBRL(c.debito) +
        '</td><td class="r">' + fmtBRL(c.credito) + '</td><td class="r td-val">' + fmtBRL(c.saldoAtual) + '</td></tr>'
      ).join('');
    }
  }

