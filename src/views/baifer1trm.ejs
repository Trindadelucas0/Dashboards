      grupos[fin] = (grupos[fin] || 0) + c.total;
    });
    const labels = Object.keys(grupos).sort((a, b) => grupos[b] - grupos[a]);
    const vals = labels.map((k) => grupos[k]);
    const cores = labels.map((k) => FINALIDADE_CORES[k] || '#64748b');

    safeChart('chartFinalidadeDist', { type: 'doughnut', data: { labels, datasets: [{ data: vals, backgroundColor: cores }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right' } } } });
    safeChart('chartFinalidadeBar', { type: 'bar', data: { labels, datasets: [{ data: vals.map((v) => v / 1000), backgroundColor: cores, borderRadius: 4 }] }, options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } } });

    const tbody = document.getElementById('cfop-tbody');
    if (tbody) {
      const totalCf = pack.totalCompras || 1;
      const sorted = (pack.cfopEntradas || []).slice().sort((a, b) => (b.total || 0) - (a.total || 0));
      tbody.innerHTML = sorted.map((c) => {
        const fin = cfopFinalidadeFromItem(c);
        const desc = cfopDescricaoFromItem(c);
        const cor = FINALIDADE_CORES[fin] || '#64748b';
        const cred = cfopCreditoFromItem(c);
        const credChip = cred
          ? '<span class="chip gr"><i class="fas fa-check"></i> Sim</span>'
          : '<span class="chip rd"><i class="fas fa-times"></i> Não</span>';
        const p = pct1(c.total, totalCf);
        return '<tr><td><span class="chip" style="font-family:monospace;font-weight:700">' + c.cfop + '</span></td><td style="font-size:12px;color:var(--text-sec)">' + escHtml(desc) +
          '</td><td><span class="chip" style="background:' + cor + '22;color:' + cor + '">' + escHtml(fin) + '</span></td>' +
          '<td>' + credChip + '</td><td class="r">' + (c.qtd || 0) + '</td>' +
          '<td class="r td-val">' + fmtBRL(c.total) + '</td><td class="r">' + pbBar(p) + '</td>' +
          '<td class="c"><button type="button" onclick="openDrilldown(\'' + c.cfop.replace(/'/g, "\\'") + '\')" style="background:var(--bg-card-hover);border:1px solid var(--border);color:var(--accent);padding:4px 10px;border-radius:6px;cursor:pointer;font-size:11px;">Detalhes</button></td></tr>';
      }).join('') || '<tr><td colspan="8" class="td-mute">Sem entradas no período</td></tr>';
    }

    if (isFornecedorPanelOpen()) renderFornecedorPanel();
  }

