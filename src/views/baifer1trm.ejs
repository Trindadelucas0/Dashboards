  const PDF_CLONE_CSS = `
    .pdf-export-target {
      --bg:#f8fafc; --bg-card:#fff; --bg-card-hover:#f1f5f9;
      --text:#1e293b; --text-sec:#475569; --text-muted:#64748b;
      --border:rgba(0,0,0,.12);
      background:#f8fafc !important; color:#1e293b !important;
      padding:20px; opacity:1 !important; filter:none !important; animation:none !important;
    }
    .pdf-export-target * { opacity:1 !important; filter:none !important; }
    .pdf-export-target .sec-title,.pdf-export-target .kpi-val,.pdf-export-target .chart-ttl,
    .pdf-export-target .margin-val,.pdf-export-target .ind-val,.pdf-export-target .tax-cur,
    .pdf-export-target .table-head .ttl,.pdf-export-target tbody td,.pdf-export-target td,
    .pdf-export-target .kpi-lbl,.pdf-export-target .mem-row .lbl,.pdf-export-target .mem-row .val,
    .pdf-export-target .fw7,.pdf-export-target .fw8 { color:#1e293b !important; }
    .pdf-export-target .sec-sub,.pdf-export-target .kpi-sub,.pdf-export-target .chart-sub,
    .pdf-export-target .table-head .sub,.pdf-export-target .td-mute,.pdf-export-target .sec-title small,
    .pdf-export-target .margin-sub,.pdf-export-target .tax-prev,.pdf-export-target .ind-formula {
      color:#475569 !important;
    }
    .pdf-export-target .kpi-card,.pdf-export-target .chart-card,.pdf-export-target .table-card,
    .pdf-export-target .margin-card,.pdf-export-target .tax-card,.pdf-export-target .mem-card,
    .pdf-export-target .ind-card,.pdf-export-target .alert-box {
      background:#fff !important; border:1px solid #e2e8f0 !important;
      box-shadow:0 1px 3px rgba(0,0,0,.06) !important;
    }
    .pdf-export-target .export-bar { display:none !important; }
    .pdf-export-target thead th { background:#f1f5f9 !important; color:#475569 !important; }
  `;

  function applyPdfLiveTheme(el) {
    el.style.setProperty('--text', '#1e293b');
    el.style.setProperty('--text-sec', '#475569');
    el.style.setProperty('--text-muted', '#64748b');
    el.style.setProperty('--bg-card', '#ffffff');
    el.style.setProperty('--border', 'rgba(0,0,0,0.12)');
    el.style.opacity = '1';
    el.style.animation = 'none';
  }

  function clearPdfLiveTheme(el) {
    ['--text', '--text-sec', '--text-muted', '--bg-card', '--border', 'opacity', 'animation'].forEach((p) => el.style.removeProperty(p));
  }

  function applyPdfCloneTheme(doc, el) {
    el.classList.add('pdf-export-target');
    applyPdfLiveTheme(el);
    const bar = el.querySelector('.export-bar');
    if (bar) bar.style.display = 'none';
    const style = doc.createElement('style');
    style.textContent = PDF_CLONE_CSS;
    el.insertBefore(style, el.firstChild);
  }

  function solidifyRgba(color) {
    if (typeof color !== 'string' || !color.startsWith('rgba')) return color;
    return color.replace(/,\s*[\d.]+\)\s*$/, ', 1)');
  }

  function prepareChartsForPdf(section) {
    const saved = [];
    Object.entries(chartInst).forEach(([id, chart]) => {
      if (!chart?.canvas || !section.contains(chart.canvas)) return;
      const snap = { id, ticks: [], grids: [], legend: null, datasets: [] };
      if (chart.options.scales) {
        Object.keys(chart.options.scales).forEach((key) => {
          const s = chart.options.scales[key];
          if (!s) return;
          if (s.ticks) { snap.ticks.push({ key, color: s.ticks.color }); s.ticks.color = '#475569'; }
          if (s.grid) { snap.grids.push({ key, color: s.grid.color }); s.grid.color = 'rgba(0,0,0,0.1)'; }
        });
      }
      if (chart.options.plugins?.legend?.labels) {
        snap.legend = chart.options.plugins.legend.labels.color;
        chart.options.plugins.legend.labels.color = '#475569';
      }
      chart.data.datasets.forEach((d) => {
        snap.datasets.push({ backgroundColor: d.backgroundColor, borderColor: d.borderColor, fill: d.fill });
        if (d.fill && typeof d.backgroundColor === 'string' && d.backgroundColor.startsWith('rgba')) {
          d.backgroundColor = d.backgroundColor.replace(/,\s*[\d.]+\)/, ', 0.18)');
        } else {
          d.backgroundColor = solidifyRgba(d.backgroundColor);
        }
        if (d.borderColor) d.borderColor = solidifyRgba(d.borderColor) || d.borderColor;
      });
      chart.update('none');
      saved.push(snap);
    });
    return saved;
  }

  function restoreChartsFromPdf(saved) {
    saved.forEach((snap) => {
      const chart = chartInst[snap.id];
      if (!chart) return;
      snap.ticks.forEach(({ key, color }) => { if (chart.options.scales?.[key]?.ticks) chart.options.scales[key].ticks.color = color; });
      snap.grids.forEach(({ key, color }) => { if (chart.options.scales?.[key]?.grid) chart.options.scales[key].grid.color = color; });
      if (snap.legend != null && chart.options.plugins?.legend?.labels) chart.options.plugins.legend.labels.color = snap.legend;
      snap.datasets.forEach((orig, i) => {
        const d = chart.data.datasets[i];
        if (!d) return;
        d.backgroundColor = orig.backgroundColor;
        d.borderColor = orig.borderColor;
        d.fill = orig.fill;
      });
      chart.update('none');
    });
  }

  function ensureTabRendered(sectionId) {
    const tabName = sectionId.replace(/^tab-/, '');
    const fn = tabInits[tabName];
    if (fn) fn();
  }

  async function exportPDF(sectionId, filename) {
    const section = document.getElementById(sectionId);
    if (!section) return;
    if (typeof html2canvas === 'undefined') {
      alert('Biblioteca html2canvas não carregada.');
      return;
    }
    const btn = (typeof event !== 'undefined' && event?.currentTarget) ? event.currentTarget : null;
    const origHtml = btn?.innerHTML;
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Gerando...'; }

    ensureTabRendered(sectionId);
    await new Promise((r) => setTimeout(r, 200));

    const wasHidden = !section.classList.contains('active');
    if (wasHidden) section.classList.add('export-capture');
    section.classList.add('pdf-export-target');
    document.body.classList.add('pdf-capturing');
    section.scrollTop = 0;
    applyPdfLiveTheme(section);
    const chartSnap = prepareChartsForPdf(section);

    try {
      await new Promise((r) => setTimeout(r, 500));
      const canvas = await html2canvas(section, {
        scale: 2,
        useCORS: true,
        backgroundColor: '#f8fafc',
        logging: false,
        onclone: (doc, el) => applyPdfCloneTheme(doc, el),
      });
      const imgData = canvas.toDataURL('image/png');
      const { jsPDF } = window.jspdf;
      const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const pageW = pdf.internal.pageSize.getWidth();
      const pageH = pdf.internal.pageSize.getHeight();
      const margin = 10;
      const headerH = 12;
      const contentW = pageW - margin * 2;
      const pdfHeight = (canvas.height * contentW) / canvas.width;
      let heightLeft = pdfHeight;
      let position = margin + headerH;

      const addHeader = () => {
        pdf.setFontSize(10);
        pdf.setTextColor(26, 26, 46);
        pdf.text(getCompanyName() + ' — ' + new Date().toLocaleDateString('pt-BR'), margin, margin + 4);
        pdf.setDrawColor(200);
        pdf.line(margin, margin + 7, pageW - margin, margin + 7);
      };

      addHeader();
      pdf.addImage(imgData, 'PNG', margin, position, contentW, pdfHeight);
      heightLeft -= (pageH - margin - headerH);

      while (heightLeft > 0) {
        position = margin + headerH - (pdfHeight - heightLeft);
        pdf.addPage();
        addHeader();
        pdf.addImage(imgData, 'PNG', margin, position, contentW, pdfHeight);
        heightLeft -= (pageH - margin - headerH);
      }

      pdf.save((filename || sectionId) + '_' + getExportDate() + '.pdf');
    } catch (err) {
      console.error(err);
      alert('Erro ao gerar PDF. Tente novamente.');
    } finally {
      restoreChartsFromPdf(chartSnap);
      clearPdfLiveTheme(section);
      document.body.classList.remove('pdf-capturing');
      section.classList.remove('pdf-export-target', 'export-capture');
      if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
    }
  }

  let activeDrilldownCfop = null;
  let activeFornecedorNome = null;
  let fornecedorSelected = new Set();
  let fornecedorCatalogCache = [];
  let fornecedorSelectionPeriodKey = '';

  function escHtml(v) {
    return String(v || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  }

  function getCfopDados() {
    return getPack().cfopEntradas || [];
  }

  function topCfopForFornecedor(nome) {
    let best = null;
    getCfopDados().forEach((c) => {
      const f = (c.fornecedores || []).find((x) => x.nome === nome);
      if (f && (!best || f.total > best.total)) best = { cfop: c.cfop, total: f.total };
    });
    return best ? best.cfop : '—';
  }

  function dominantUf(ufMap) {
    const entries = Object.entries(ufMap || {}).filter(([k]) => k && k !== '—');
    if (!entries.length) return '—';
    entries.sort((a, b) => b[1] - a[1]);
    return entries[0][0];
  }

  function fornecedorPeriodKey() {
    return state.unit + '|' + state.fiscalMode + '|' + state.month;
  }

  function buildFornecedorCatalog() {
    const map = new Map();
    getCfopDados().forEach((c) => {
      const cfopUf = raw_cfop_uf(c.cfop);
      (c.fornecedores || []).forEach((f) => {
        if (!f.nome) return;
        if (!map.has(f.nome)) {
          map.set(f.nome, { nome: f.nome, total: 0, qtd: 0, cfops: new Set(), ufs: {}, cnpj: f.cnpj || '', uf: f.uf && f.uf !== '—' ? f.uf : '' });
        }
        const entry = map.get(f.nome);
        entry.total += f.total || 0;
        entry.qtd += f.qtd || 0;
        entry.cfops.add(c.cfop);
        entry.ufs[cfopUf] = (entry.ufs[cfopUf] || 0) + (f.total || 0);
        if (f.cnpj && !entry.cnpj) entry.cnpj = f.cnpj;
        if (f.uf && f.uf !== '—') entry.uf = f.uf;
      });
    });
    const packList = getPack().fornecedores || [];
    packList.forEach((f) => {
      if (!f.nome) return;
      if (!map.has(f.nome)) map.set(f.nome, { nome: f.nome, total: f.total || 0, qtd: 0, cfops: new Set(), ufs: {}, cnpj: '', uf: '' });
      else if ((map.get(f.nome).total || 0) < (f.total || 0)) map.get(f.nome).total = f.total;
    });
    return Array.from(map.values()).map((e) => ({
      nome: e.nome,
      total: Math.round(e.total * 100) / 100,
      qtd: e.qtd,
      cfopCount: e.cfops.size,
      topCfop: topCfopForFornecedor(e.nome),
      uf: e.uf || dominantUf(e.ufs),
      cnpj: e.cnpj || '',
    })).sort((a, b) => b.total - a.total);
  }

  function ensureFornecedorSelection(catalog) {
    const key = fornecedorPeriodKey();
    if (key !== fornecedorSelectionPeriodKey) {
      fornecedorSelectionPeriodKey = key;
      fornecedorSelected = new Set(catalog.slice(0, 20).map((f) => f.nome));
    }
    if (!fornecedorSelected.size && catalog.length) {
      fornecedorSelected = new Set(catalog.slice(0, 20).map((f) => f.nome));
    }
    Array.from(fornecedorSelected).forEach((nome) => {
      if (!catalog.find((x) => x.nome === nome)) fornecedorSelected.delete(nome);
    });
  }

  function buildFornecedorRanking() {
    fornecedorCatalogCache = buildFornecedorCatalog();
    ensureFornecedorSelection(fornecedorCatalogCache);
    return fornecedorCatalogCache.filter((f) => fornecedorSelected.has(f.nome));
  }

  function updateFornecedorPickerCount() {
    const el = document.getElementById('forn-picker-count');
    const total = fornecedorCatalogCache.length;
    if (el) el.textContent = fornecedorSelected.size + ' de ' + total + ' selecionados';
  }

  function renderFornecedorPicker() {
    const list = document.getElementById('forn-picker-list');
    if (!list) return;
    fornecedorCatalogCache = buildFornecedorCatalog();
    ensureFornecedorSelection(fornecedorCatalogCache);
    const packTotal = getPack().totalCompras || 1;
    list.innerHTML = fornecedorCatalogCache.map((f) => {
      const checked = fornecedorSelected.has(f.nome) ? ' checked' : '';
      const search = (f.nome + ' ' + (f.cnpj || '') + ' ' + f.uf).toLowerCase();
      const meta = fmtBRL(f.total) + ' · ' + (f.qtd || 0) + ' NFs · ' + f.cfopCount + ' CFOP(s) · UF ' + f.uf;
      return '<label class="supplier-item forn-picker-item" data-search="' + escHtml(search) + '">' +
        '<input type="checkbox" data-nome="' + escHtml(f.nome) + '"' + checked + ' onchange="onFornecedorPickerChange(this)">' +
        '<span class="supplier-info"><strong>' + escHtml(f.nome) + '</strong><small>' + escHtml(meta) +
        (packTotal > 0 ? ' · ' + pct1(f.total, packTotal) + '% das compras' : '') + '</small></span></label>';
    }).join('') || '<p class="td-mute">Nenhum fornecedor no período selecionado.</p>';
    updateFornecedorPickerCount();
    const note = document.getElementById('forn-data-note');
    if (note) {
      note.textContent = 'Fonte: notas de entrada por CFOP (SPED/apuração). Valores somam o contábil do período; até 15 fornecedores por CFOP no ETL. CNPJ/UF aparecem quando disponíveis na planilha.';
    }
  }

  function renderFornecedorStats(ranking) {
    const el = document.getElementById('forn-panel-stats');
    if (!el) return;
    const pack = getPack();
    const totalCompras = pack.totalCompras || 0;
    const selTotal = ranking.reduce((s, f) => s + (f.total || 0), 0);
    const selNfs = ranking.reduce((s, f) => s + (f.qtd || 0), 0);
    const catalogTotal = fornecedorCatalogCache.reduce((s, f) => s + (f.total || 0), 0);
    el.innerHTML =
      '<div class="forn-stat"><div class="lbl">Exibindo</div><div class="val">' + ranking.length + ' fornecedor(es)</div></div>' +
      '<div class="forn-stat"><div class="lbl">Valor selecionado</div><div class="val">' + fmtBRL(selTotal) + '</div></div>' +
      '<div class="forn-stat"><div class="lbl">NFs (selecionados)</div><div class="val">' + selNfs + '</div></div>' +
      '<div class="forn-stat"><div class="lbl">Cobertura vs compras</div><div class="val">' + pct1(selTotal, totalCompras) + '%</div></div>' +
      '<div class="forn-stat"><div class="lbl">Total catalogado</div><div class="val">' + fornecedorCatalogCache.length + ' · ' + fmtBRL(catalogTotal) + '</div></div>';
  }

  function onFornecedorPickerChange(cb) {
    const nome = cb.dataset.nome;
    if (cb.checked) fornecedorSelected.add(nome);
    else {
      fornecedorSelected.delete(nome);
      if (activeFornecedorNome === nome) {
        activeFornecedorNome = null;
        const detail = document.getElementById('fornecedor-detail');
        if (detail) detail.style.display = 'none';
      }
    }
    updateFornecedorPickerCount();
    renderFornecedorRankingTable();
  }

  function toggleAllFornecedorPicker(state) {
    document.querySelectorAll('#forn-picker-list .forn-picker-item').forEach((el) => {
      if (el.style.display === 'none') return;
      const cb = el.querySelector('input');
      if (!cb) return;
      cb.checked = state;
      if (state) fornecedorSelected.add(cb.dataset.nome);
      else fornecedorSelected.delete(cb.dataset.nome);
    });
    if (!state) {
      activeFornecedorNome = null;
      const detail = document.getElementById('fornecedor-detail');
      if (detail) detail.style.display = 'none';
    }
    updateFornecedorPickerCount();
    renderFornecedorRankingTable();
  }

  function selectTopFornecedores(n) {
    fornecedorSelected = new Set(fornecedorCatalogCache.slice(0, n).map((f) => f.nome));
    renderFornecedorPicker();
    renderFornecedorRankingTable();
  }

  function filterFornecedorPicker(query) {
    const q = (query || '').toLowerCase();
    document.querySelectorAll('#forn-picker-list .forn-picker-item').forEach((el) => {
      el.style.display = el.dataset.search.includes(q) ? '' : 'none';
    });
  }

  function toggleFornecedorPicker() {
    const body = document.getElementById('forn-picker-body');
    if (!body) return;
    const open = body.style.display === 'none';
    body.style.display = open ? 'block' : 'none';
    const btn = document.getElementById('forn-picker-toggle');
    if (btn) btn.innerHTML = '<i class="fas fa-list-check"></i> ' + (open ? 'Ocultar lista' : 'Escolher fornecedores');
  }

  function renderFornecedorRankingTable() {
    const pack = getPack();
    const total = pack.totalCompras || 1;
    const ranking = fornecedorCatalogCache.filter((f) => fornecedorSelected.has(f.nome));
    renderFornecedorStats(ranking);
    const tbody = document.getElementById('fornecedor-ranking-tbody');
    if (!tbody) return;
    if (!ranking.length) {
      tbody.innerHTML = '<tr><td colspan="8" class="td-mute">Marque fornecedores na lista acima para exibir o ranking.</td></tr>';
      return;
    }
    tbody.innerHTML = ranking.map((f, i) => {
      const search = (f.nome + ' ' + f.uf + ' ' + f.topCfop).toLowerCase();
      const rowStyle = activeFornecedorNome === f.nome ? ' style="background:rgba(34,163,41,0.08)"' : '';
      return '<tr class="forn-rank-row" data-search="' + escHtml(search) + '" data-nome="' + escHtml(f.nome) + '"' + rowStyle + '>' +
        '<td><span class="rank ' + (i < 3 ? 'g' + (i + 1) : 'gn') + '">' + (i + 1) + '</span></td>' +
        '<td class="fw7">' + escHtml(f.nome) + '</td>' +
        '<td>' + escHtml(f.uf || '—') + '</td>' +
        '<td class="r">' + (f.qtd || 0) + '</td>' +
        '<td class="r">' + f.cfopCount + '</td>' +
        '<td class="r td-val">' + fmtBRL(f.total) + '</td>' +
        '<td>' + pbBar(total > 0 ? f.total / total * 100 : 0) + '</td>' +
        '<td class="r">' + escHtml(f.topCfop || '—') + '</td></tr>';
    }).join('');
    tbody.querySelectorAll('.forn-rank-row').forEach((row) => {
      row.onclick = () => showFornecedorDetail(row.dataset.nome);
    });
    const q = (document.getElementById('forn-search') || {}).value;
    if (q) filterFornecedorPanel(q);
  }

  function isFornecedorPanelOpen() {
    const panel = document.getElementById('fornecedor-panel');
    return panel && panel.style.display !== 'none';
  }

  function setFornecedorPanelBtnActive(active) {
    const btn = document.getElementById('btn-fornecedor-panel');
    if (btn) btn.classList.toggle('fornecedor-panel-active', active);
  }

  function renderFornecedorPanel() {
    fornecedorCatalogCache = buildFornecedorCatalog();
    ensureFornecedorSelection(fornecedorCatalogCache);
    const pack = getPack();
    const total = pack.totalCompras || 1;
    const sub = document.getElementById('forn-panel-sub');
    if (sub) {
      sub.textContent = UNIT_LABELS[state.unit] + ' — ' + periodFull() + periodContext() +
        ' — Total compras ' + fmtBRL(total) + ' — ' + fornecedorCatalogCache.length + ' fornecedores catalogados';
    }
    renderFornecedorPicker();
    renderFornecedorRankingTable();
    if (activeFornecedorNome && fornecedorSelected.has(activeFornecedorNome)) showFornecedorDetail(activeFornecedorNome, true);
    else {
      activeFornecedorNome = null;
      const detail = document.getElementById('fornecedor-detail');
      if (detail) detail.style.display = 'none';
    }
  }

  function showFornecedorDetail(nome, skipScroll) {
    activeFornecedorNome = nome;
    const pack = getPack();
    const totalCompras = pack.totalCompras || 1;
    const catalog = fornecedorCatalogCache.find((f) => f.nome === nome) || {};
    const rows = [];
    let subtotal = 0;
    let totalNfs = 0;
    const finalidades = {};
    getCfopDados().forEach((c) => {
      const f = (c.fornecedores || []).find((x) => x.nome === nome);
      if (f) {
        subtotal += f.total || 0;
        totalNfs += f.qtd || 0;
        const fin = cfopFinalidadeFromItem(c);
        finalidades[fin] = (finalidades[fin] || 0) + (f.total || 0);
        rows.push({
          cfop: c.cfop,
          descricao: cfopDescricaoFromItem(c),
          finalidade: fin,
          qtd: f.qtd || 0,
          total: f.total || 0,
        });
      }
    });
    rows.sort((a, b) => b.total - a.total);
    const title = document.getElementById('forn-detail-title');
    const sub = document.getElementById('forn-detail-sub');
    const meta = document.getElementById('forn-detail-meta');
    if (title) title.textContent = nome;
    if (sub) {
      sub.textContent = 'Subtotal: ' + fmtBRL(subtotal) + ' · ' + totalNfs + ' NFs · ' + rows.length + ' CFOP(s) · ' +
        pct1(subtotal, totalCompras) + '% das compras do período';
    }
    if (meta) {
      const finTxt = Object.entries(finalidades).sort((a, b) => b[1] - a[1]).map(([k, v]) => k + ' ' + fmtBRL(v)).join(' · ');
      meta.textContent = 'UF: ' + (catalog.uf || '—') +
        (catalog.cnpj ? ' · CNPJ: ' + catalog.cnpj : '') +
        (finTxt ? ' · Finalidades: ' + finTxt : '');
    }
    const dtbody = document.getElementById('fornecedor-detail-tbody');
    if (dtbody) {
      dtbody.innerHTML = rows.length ? rows.map((r) =>
        '<tr><td class="fw7">' + escHtml(r.cfop) + '</td><td>' + escHtml(r.descricao) + '</td><td>' + escHtml(r.finalidade) + '</td><td class="r">' + r.qtd +
        '</td><td class="r td-val">' + fmtBRL(r.total) + '</td><td class="r">' + pbBar(subtotal > 0 ? r.total / subtotal * 100 : 0) +
        '</td><td class="r">' + pct1(r.total, totalCompras) + '%</td></tr>'
      ).join('') : '<tr><td colspan="7" class="td-mute">Sem CFOPs para este fornecedor</td></tr>';
    }
    const detail = document.getElementById('fornecedor-detail');
    if (detail) {
      detail.style.display = 'block';
      if (!skipScroll) detail.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
    document.querySelectorAll('#fornecedor-ranking-tbody .forn-rank-row').forEach((row) => {
      row.style.background = row.dataset.nome === nome ? 'rgba(34,163,41,0.08)' : '';
    });
  }

  function toggleFornecedorPanel() {
    const panel = document.getElementById('fornecedor-panel');
    if (!panel) return;
    if (panel.style.display === 'none' || !panel.style.display) {
      panel.style.display = 'block';
      setFornecedorPanelBtnActive(true);
      const search = document.getElementById('forn-search');
      if (search) search.value = '';
      const pickerSearch = document.getElementById('forn-picker-search');
      if (pickerSearch) pickerSearch.value = '';
      renderFornecedorPanel();
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else {
      closeFornecedorPanel();
    }
  }

  function closeFornecedorPanel() {
    const panel = document.getElementById('fornecedor-panel');
    if (panel) panel.style.display = 'none';
    activeFornecedorNome = null;
    const detail = document.getElementById('fornecedor-detail');
    if (detail) detail.style.display = 'none';
    const search = document.getElementById('forn-search');
    if (search) search.value = '';
    const pickerSearch = document.getElementById('forn-picker-search');
    if (pickerSearch) pickerSearch.value = '';
    setFornecedorPanelBtnActive(false);
  }

  function filterFornecedorPanel(query) {
    const q = (query || '').toLowerCase();
    document.querySelectorAll('#fornecedor-ranking-tbody .forn-rank-row').forEach((el) => {
      el.style.display = el.dataset.search.includes(q) ? '' : 'none';
    });
  }

  function openSupplierModal() {
    toggleFornecedorPanel();
  }

  function closeDrilldown() {
    const panel = document.getElementById('drilldown-panel');
    if (panel) panel.style.display = 'none';
    activeDrilldownCfop = null;
  }

  function openDrilldown(cfop) {
    if (activeDrilldownCfop === cfop) { closeDrilldown(); return; }
    activeDrilldownCfop = cfop;
    const item = getCfopDados().find((d) => d.cfop === cfop);
    if (!item) return;
    const totalCfop = item.total || 0;
    const ddTitle = document.getElementById('dd-title');
    const ddSub = document.getElementById('dd-sub');
    if (ddTitle) ddTitle.textContent = 'CFOP ' + cfop + ' — ' + cfopDescricaoFromItem(item);
    if (ddSub) ddSub.textContent = 'Finalidade: ' + cfopFinalidadeFromItem(item) + ' | Total: ' + fmtBRL(totalCfop) + ' | ' + (item.qtd || 0) + ' NFs';
    const tbody = document.getElementById('dd-tbody');
    if (tbody) {
      const forn = item.fornecedores || [];
      tbody.innerHTML = forn.length ? forn.map((f, i) =>
        '<tr><td>' + (i + 1) + '</td><td><div class="fw7">' + escHtml(f.nome) + '</div></td><td><span class="td-mute">' + escHtml(f.cnpj || '—') + '</span></td>' +
        '<td>' + escHtml(f.uf || '—') + '</td><td class="r">' + (f.qtd || 0) + '</td><td class="r td-val">' + fmtBRL(f.total) + '</td>' +
        '<td class="r">' + pbBar(totalCfop > 0 ? f.total / totalCfop * 100 : 0) + '</td></tr>'
      ).join('') : '<tr><td colspan="7" class="td-mute">Sem fornecedores detalhados neste CFOP</td></tr>';
    }
    const panel = document.getElementById('drilldown-panel');
    if (panel) {
      panel.style.display = 'block';
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  window.showTab = showTab;
  window.toggleSidebar = toggleSidebar;
  window.closeMob = closeMob;
  window.onFilterChange = onFilterChange;
  window.exportExcel = exportExcel;
  window.exportPDF = exportPDF;
  window.validateComprasPack = validateComprasPack;
  window.validateApuracaoPack = validateApuracaoPack;
  window.buildFiscalTotalPack = buildFiscalTotalPack;
  window.openSupplierModal = openSupplierModal;
  window.toggleFornecedorPanel = toggleFornecedorPanel;
  window.closeFornecedorPanel = closeFornecedorPanel;
  window.filterFornecedorPanel = filterFornecedorPanel;
  window.filterFornecedorPicker = filterFornecedorPicker;
  window.toggleFornecedorPicker = toggleFornecedorPicker;
  window.toggleAllFornecedorPicker = toggleAllFornecedorPicker;
  window.selectTopFornecedores = selectTopFornecedores;
  window.onFornecedorPickerChange = onFornecedorPickerChange;
  window.showFornecedorDetail = showFornecedorDetail;
  window.openDrilldown = openDrilldown;
  window.closeDrilldown = closeDrilldown;

  document.addEventListener('DOMContentLoaded', () => {
    hydrateStatic();
    showTab('visao-geral');
  });
})();

</script>
<script>
/* Relatório Gerencial PDF — BAIFER */
function exportRelatorioGerencial() {
  if (typeof DASHBOARD_DATA === 'undefined' || typeof jspdf === 'undefined') {
    alert('Dados ou jsPDF não carregados.');
    return;
  }
  const D = DASHBOARD_DATA;
  const mm = D.competencia.split('-')[1];
  const pack = D.fiscalPorMes.porMes[mm] || D.fiscalPorMes.porMes[D.meta.meses[D.meta.meses.length - 1]];
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });

  doc.setFontSize(18);
  doc.text('Relatório Gerencial — BAIFER', 14, 20);
  doc.setFontSize(11);
  doc.text(D.empresa.nome, 14, 28);
  doc.text('CNPJ: ' + D.empresa.cnpj, 14, 34);
  doc.text('Competência: ' + D.competenciaLabel, 14, 40);
  doc.text('Gerado em: ' + new Date().toLocaleDateString('pt-BR'), 14, 46);

  doc.setFontSize(13);
  doc.text('Visão Geral — KPIs', 14, 58);
  const kpis = [
    ['Receita Bruta', 'R$ ' + pack.receitaBruta.toLocaleString('pt-BR', { minimumFractionDigits: 2 })],
    ['Total Compras', 'R$ ' + pack.totalCompras.toLocaleString('pt-BR', { minimumFractionDigits: 2 })],
    ['Deduções Tributárias', 'R$ ' + pack.deducoes.toLocaleString('pt-BR', { minimumFractionDigits: 2 })],
    ['% sobre RB', pack.dedPct + '%'],
  ];
  doc.autoTable({ startY: 62, head: [['Indicador', 'Valor']], body: kpis, theme: 'grid', styles: { fontSize: 10 } });

  doc.text('Impostos a Recolher', 14, doc.lastAutoTable.finalY + 12);
  const impBody = pack.impostosTabela.map((r) => [r.tributo, 'R$ ' + r.recolher.toLocaleString('pt-BR', { minimumFractionDigits: 2 }), r.pctRb + '%']);
  doc.autoTable({ startY: doc.lastAutoTable.finalY + 16, head: [['Tributo', 'A Recolher', '% RB']], body: impBody, theme: 'striped', styles: { fontSize: 9 } });

  if (pack.cfopEntradas.length) {
    doc.addPage();
    doc.text('Top CFOPs — Entradas', 14, 20);
    doc.autoTable({
      startY: 24,
      head: [['CFOP', 'Descrição', 'Valor']],
      body: pack.cfopEntradas.slice(0, 15).map((c) => [c.cfop, (c.descricao || '').slice(0, 40), 'R$ ' + c.total.toLocaleString('pt-BR', { minimumFractionDigits: 2 })]),
      styles: { fontSize: 8 },
    });
  }

  if (pack.sped.clientes && pack.sped.clientes.length) {
    doc.text('Top Clientes', 14, doc.lastAutoTable.finalY + 12);
    doc.autoTable({
      startY: doc.lastAutoTable.finalY + 16,
      head: [['Cliente', 'Total']],
      body: pack.sped.clientes.slice(0, 10).map((c) => [c.nome.slice(0, 45), 'R$ ' + c.total.toLocaleString('pt-BR', { minimumFractionDigits: 2 })]),
      styles: { fontSize: 8 },
    });
  }

  doc.save('Relatorio_Gerencial — ' + D.empresa.nome.slice(0, 20) + ' — ' + D.competenciaLabel + '.pdf');
}

</script>
<div id="print-supplier-report"></div>
</body>
</html>
